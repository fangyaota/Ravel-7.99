# **`mkadaptor`** —— 从 .NET 反射里生成适配层的 C#（命令行的壳）。
#
#     dotnet out/ravel.dll tools/mkadaptor.rav <类型> [模块名] [成员...] [--all] [--class] [--dll 路径]
#
# **静态那半**（默认）—— 生成**模块函数**（`[RavelFn]`）：
#
#     … System.Math NMath Max Min Sqrt        # 点名几个成员
#     … System.Math NMath --all               # 全部静态方法（不用逐个列）
#     … System.Math --all                     # 连模块名都省了 —— 取类型短名
#
# **实例那半**（`--class`）—— 生成**类**（`[RavelClass]` + `[ClassCtor]` + `[ClassMethod]`
# + `[ClassProperty]`）：
#
# 属性**不用点名**：`.NET` 的属性在反射里是 `get_X` / `set_X` 两个方法（`IsSpecialName`），
# 成员表里根本看不见 —— 生成器自己从类型上扫（`Adaptor.PropsOf`），扫到的都生成。
# 于是 `sb.Length` 读、`sb.Length = 2` 写、`sb.Length += 3` 也认（引擎那边落成 `by` 槽）。
# **静态那半没有属性**：那一半的成员是你点名的，属性得另说。
#
#     … System.Text.StringBuilder NSb --class     # 模块 NSb / 类 StringBuilder
#
# 两半是**两个形状**（静态的体里是 `System.Math.Max (…)`；实例的体里 `self` 要先脱壳），
# 所以是两个开关、两份产物，不是一个开关。要两半就各跑一次。
#
# **`--class` 不做值类型**（`DateTime` / `Point` 那种）：装箱之后改不了原值，
# 可变结构体的方法会**静默失效**。碰到当场报，不生成。
#
# 产出 `Ravel.Generated/<模块名>.cs`。加了 `--dll <路径>` 就顺手**就地编**一份 dll
# （Roslyn 当库调，不经过 `dotnet build`），于是只有 runtime 的机器上也走得完。
# 在仓库里（有 SDK）就不用 `--dll`：`bash build.sh` 会连 `Ravel.Generated/` 一起编。
#
# **生成逻辑不在这里** —— 在 `lib/adaptor.rav`（模块 `Adaptor`），所以 `.rav` 文件里也能直接调：
#
#     using "adaptor.rav"
#     Adaptor.Build (Adaptor.Cs "System.Math" "NMath" (Adaptor.AllOf "System.Math")) cs dll
#
# 这一份就三件事：解析参数、拼路径、调那几个函数。

using "adaptor.rav"
using "args.rav"

opts := Args.ParseWith (System.Args ()) {"dll" -> "string" "all" -> "flag" "class" -> "flag"}
位置 := Args.Positional opts
全扫 := Args.Has opts "all"
实例 := Args.Has opts "class"

类型 := 位置.At 0
# `(位置.Count ()) > 1` —— 括号**不能省**：`.Count` 的实参是那个 `()`，
# 它会一路吃到运算符为止，写成 `位置.Count () > 1` 就成了 `.Count ((() > 1))`，
# 报的是「类型 Void 不支持运算符 '>'」（跟这件事看着没关系的那种错）。
模块 := (位置.Count ()) > 1 { 位置.At 1; } { Adaptor.ShortName 类型; }
类名 := Adaptor.ShortName 类型
成员 := 全扫 {
    Adaptor.AllOf 类型;
} {
    实例 { Adaptor.AllOfClass 类型; } { 位置.Skip 2; }
}

Cs路径  := "Ravel.Generated/" + 模块 + ".cs"
Dll路径 := Args.Get opts "dll" ""
源码    := 实例 {
    Adaptor.CsClass 类型 模块 类名 成员;
} {
    Adaptor.Cs 类型 模块 成员;
}

# 生成的代码里 `typeof (X)` / `(X) 值` 那些 X 得在**编译引用集**里。框架和主程序自带的
# `Compile` 那边自己会加；**插件拖进来的**（`Microsoft.Data.Sqlite` 那种）不在 ——
# 得把这一串递过去，不然是一句离题万里的 `CS0234 'Data' does not exist in …`。
引用 := Adaptor.RefsOf 类型 成员

# 属性（`[ClassProperty]`）**不由 `成员` 点名** —— `CsClass` 自己从类型上扫
# （`.NET` 的属性在反射里是 `get_X` / `set_X` 两个方法，`--class` 的成员表里看不见它们）。
# 静态那半不做属性（那一半的成员是你点名的，属性得另说）—— 所以这一格只报实例那半。
属性 := 实例 { Adaptor.PropsOf 类型; } { []; }

Dll路径 != "" {
    Adaptor.Build 源码 Cs路径 Dll路径 引用
    print ("写好了：" + Cs路径)
    print ("  编好了：" + Dll路径 + "（Roslyn 就地编，没走 dotnet build）")
} {
    Adaptor.Write 源码 Cs路径
    print ("写好了：" + Cs路径)
}
尾巴 := 实例 { " + " + (string (属性.Count ())) + " 个属性"; } { ""; }
print ("  类型 " + 类型 + " → " + (实例 { "类 " + 类名; } { "模块 " + 模块; })
       + "；要 " + (string (成员.Count ())) + " 个成员" + 尾巴)

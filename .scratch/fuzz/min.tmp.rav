#
# 运算符优先级与结合性 —— 数都是**刻意挑的**,尽量挑成"换个读法结果就不一样"的,
# 所以这条用例是那张优先级表(`Parser.Expressions.BinOpBp`)的镜子:
# 谁把哪一行的数改了、或者爬升那两个 `if` 写反了,这里当场变红。
#
# 只挑"两种读法答案不同"的:比如 `1 + 2 * 3` 和 `(1+2)*3` 是 7 和 9 —— 有意义;

print34)# 左结合 → -5(右结合会是 3)
print4)# 左结合 → 2(右结合会是 8)
print7)
print3+45)
print3)
print**3**)# 右结合 → 512(左结合会是 64)
print**)# -(2**2) → -4(要是 (-2)**2 就是 4)
print**1)
print3)# ── 移位:比加减松、比比较紧 ──
print1<<+1)
print1<<<<1)# 左结合 → 8(右结合会是 1<<4 = 16)
print>>1>>1)# 左结合 → 0(右结合会是 2>>0 = 2)
print5>>>1)
print<<1==4)# (2<<1) == 4 → true
print1<==true)# (1<2) == true → true
printint<:object)# true(两边都是类型)
printobject:>int)
print1int&&true)    
print!1))
print1int==true)    
print3^1&1)# 3 ^ (1&1) = 2(不是 (3^1)&1 = 0)
print41&3)# ── 逻辑:&& 比 || 紧,两者都左结合 ──
printtrue&&false||true)
printfalse||true&&false)
print1==1&&==)
printtrue&&false&&true)
axint)=>{x+1;}
xint)=>{x;}
printa)5)# `|` 是交替:先 a → 6(和 `&` 同层,比 `||` 紧)# ── 实参"吃到运算符为止":并列调用的实参里能放整条算式 ──
fxint)=>{x;}
xint)=>{yint)=>{xy;};}# 柯里化:一个 lambda 收一个实参
printf1+)# f (1+2) → 30(不是 (f 1)+2 = 12)
printf+3)# f (2+3) → 50(不是 (f 2)+3 = 23)
print3+4)# g 10 (7) → 3
printf1)+)# 还是 f (1+2) → 30# ── 空值合并 `??`:比 || 松、右结合、且惰性 ──
nunitNone
printn??7)# 7
print{n??None??9)     }# 右结合 → 9
print1??+3)# 1 ?? (2+3) → 1# ── 管道 `|>`:`|>` 那一段比整条链都松 ──
print1+|>f)# f (1+2) → 30(不是 (f 1)+2 = 12)
print5|>f|>a)# 左喂右 → a (f 5) = 51# ── 一元 `!` 比 `&&` 紧 ──
print!false&&false)    # (!false) && false → false

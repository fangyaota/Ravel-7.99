+        "!=" => (a, b) => new BoolVal(CompareNumeric(a, b, "!=") != 0),
+        "<" => (a, b) => new BoolVal(CompareNumeric(a, b, "<") < 0),
+        ">" => (a, b) => new BoolVal(CompareNumeric(a, b, ">") > 0),
+        "<=" => (a, b) => new BoolVal(CompareNumeric(a, b, "<=") <= 0),
+        ">=" => (a, b) => new BoolVal(CompareNumeric(a, b, ">=") >= 0),
+        _ => null,
+    };
 }

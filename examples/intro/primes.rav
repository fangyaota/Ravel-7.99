Primes := () => {
    IsPrime := (k: int) => {
        (k < 2) { false; } {
            d := 2
            ok := true
            while { (((d * d) <= k) && ok); } {
                ((k % d) == 0) { ok = false; } { d += 1; }
            }
            ok
        }
    }
    System.Write "上限?(50) "
    line := input ""
    n := (line == "") { 50; } { int line; }
    out := [2..n].Where ((k: int) => { IsPrime k; })
    print (out.Join " ")
}

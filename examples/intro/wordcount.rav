WordCount := (text: string) => {
    counts := {->}
    text.Split " " |> (ws) => {
        ws.Foreach ((w: string) => {
            (w == "") { 0; } { counts.Set w ((counts.GetOr w 0) + 1); }
        })
    }
    rows := counts.Keys () |> (ks) => {
        ks.Map ((k: string) => { [k (counts.GetOr k 0)]; })
    }
    ranked := rows.SortBy ((p) => { 0 - p[1]; })
    top := ranked.Take 5
    lines := top.Map ((p) => { p[0] + "=" + (string p[1]); })
    lines.Join ", "
}

(
    () => {
        System.Write "一段话?(the quick brown fox the lazy dog) "
        line := input ""
        print (WordCount ((line == "") { "the quick brown fox the lazy dog"; } { line; }))
    }
) ()

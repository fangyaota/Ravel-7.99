Hanoi := () => {
    moves := []
    Move := (k: int from: string to: string via: string) => {
        (k == 0) { 0; } {
            Move (k - 1) from via to
            moves.Add (from + "->" + to)
            Move (k - 1) via to from
        }
    }
    System.Write "几层?(3) "
    line := input ""
    n := (line == "") { 3; } { int line; }
    Move n "A" "C" "B"
    print (moves.Join " ")
    print ("共 " + (string (moves.Count ())) + " 步")
}

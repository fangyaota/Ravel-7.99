BubbleSort := (xs: list) => {
    a := xs.Copy ()
    n := a.Count ()
    i := 0
    while { i < (n - 1); } {
        j := 0
        while { j < ((n - 1) - i); } {
            (a[j] > a[j + 1]) {
                t := a[j]
                a[j] = a[j + 1]
                a[j + 1] = t
            } { 0; }
            j += 1
        }
        i += 1
    }
    a.Join " "
}

BinarySearch := (xs: list target: int) => {
    lo := 0
    hi := (xs.Count ()) - 1
    found := -1
    while { ((lo <= hi) && (found < 0)); } {
        mid := int (((lo + hi) / 2))
        v := xs[mid]
        (v == target) { found = mid; } {
            (v < target) { lo = mid + 1; } { hi = mid - 1; }
        }
    }
    found
}

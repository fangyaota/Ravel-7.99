SortDemo := () => {
    ParseInts := (s: string) => {
        (s == "") { []; } {
            ws := s.Split " "
            kept := ws.Where ((w: string) => { w != ""; })
            kept.Map ((w: string) => { int w; })
        }
    }
    BubbleSort := (xs: list) => {
        a := xs.Copy ()
        n := a.Count ()
        i := 0
        while { i < (n - 1); } {
            j := 0
            while { j < ((n - 1) - i); } {
                (a[j] > a[j + 1]) {
                    t := a[j]
                    a[j] = a[j + 1]
                    a[j + 1] = t
                } { 0; }
                j += 1
            }
            i += 1
        }
        a
    }
    BinarySearch := (xs: list target: int) => {
        lo := 0
        hi := (xs.Count ()) - 1
        found := -1
        while { ((lo <= hi) && (found < 0)); } {
            mid := int (((lo + hi) / 2))
            v := xs[mid]
            (v == target) { found = mid; } {
                (v < target) { lo = mid + 1; } { hi = mid - 1; }
            }
        }
        found
    }
    System.Write "一串整数?(5 3 9 1 7) "
    line := input ""
    xs := ParseInts ((line == "") { "5 3 9 1 7"; } { line; })
    sorted := BubbleSort xs
    print ("排序后:" + (sorted.Join " "))
    System.Write "要找哪个?(7) "
    tline := input ""
    target := (tline == "") { 7; } { int tline; }
    print ((string target) + " 在下标 " + (string (BinarySearch sorted target)))
}

Caesar := () => {
    Rot := (c: char shift: int) => {
        n := int c
        ((n >= 97) && (n <= 122)) {
            char (((((n - 97) + shift) % 26) + 97));
        } {
            ((n >= 65) && (n <= 90)) {
                char (((((n - 65) + shift) % 26) + 65));
            } { c; }
        }
    }
    System.Write "文本?(hello world) "
    line := input ""
    text := (line == "") { "hello world"; } { line; }
    System.Write "位移?(3) "
    nline := input ""
    shift := (nline == "") { 3; } { int nline; }
    letters := text.Chars ()
    letters.Map ((c: char) => { Rot c shift; }) |> (cs) => { print (cs.Join ""); }
}

Caesar := (text: string shift: int) => {
    Rot := (c: char) => {
        n := int c
        ((n >= 97) && (n <= 122)) {
            char (((((n - 97) + shift) % 26) + 97));
        } {
            ((n >= 65) && (n <= 90)) {
                char (((((n - 65) + shift) % 26) + 65));
            } { c; }
        }
    }
    letters := text.Chars ()
    letters.Map (Rot) |> (cs) => { cs.Join ""; }
}

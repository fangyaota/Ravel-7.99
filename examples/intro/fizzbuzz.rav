FizzBuzz := (n: int) => {
    out := [1..n].Map ((i: int) => {
        ((i % 15) == 0) { "FizzBuzz"; } {
            ((i % 3) == 0) { "Fizz"; } {
                ((i % 5) == 0) { "Buzz"; } { string i; }
            }
        }
    })
    print (out.Join " ")
}

(
    () => {
        System.Write "数到几?(15) "
        line := input ""
        FizzBuzz ((line == "") { 15; } { int line; })
    }
) ()

# **实例那半** —— 生成的不是一个模块，是一个**类**。
#
#     dotnet out/ravel.dll examples/adaptor_class.rav
#
# 静态那半（`Adaptor.Cs`）生成的是**模块函数**（`[RavelFn]`，体里 `System.Math.Max (…)`）；
# 这一半生成的是**类**（`[RavelClass]` + `[ClassCtor]` + `[ClassMethod]`，体里 `self`
# 先经 `Me (self)` 脱壳）。**两个形状，所以是两个函数，不是一个开关**：
#
#     Adaptor.Cs      类型 模块 成员          # 静态 → 模块
#     Adaptor.CsClass 类型 模块 类名 成员      # 实例 → 类
#     Adaptor.AllOf       类型                # 全部静态方法名
#     Adaptor.AllOfClass  类型                # 全部实例方法名
#
# 产物落在 `out/`（构建目录，`build.sh` 会整个删掉）。
using "adaptor.rav"

# ① **引用类型**：`Random` 那种"有身份"的
类型 := "System.Random"
源码 := Adaptor.CsClass 类型 "Rnd" "Random" (Adaptor.AllOfClass 类型)
Adaptor.Build 源码 "out/Rnd.cs" "out/plugins/Rnd.dll"
print ("① 扫出 " + (string ((Adaptor.AllOfClass 类型).Count ())) + " 个实例方法名")
using "Rnd"
r := Rnd.Random ()                 # 构造器（`[RavelClass]` 挂了 `[RavelModule]`，类对象也进模块）
print ("   Next ()：" + (string (r.Next ())))
print ("   NextDouble ()：" + (string (r.NextDouble ())))

# ② **值类型也做**（`DateTime` / `Guid` / `TimeSpan` 那一族）。
#
# 它跟 `IntVal` 是**一个形状**：不可变，方法交回**新值**（量过：`DateTime` 42 个实例
# 方法里只有 2 个返回 `void`，那两个还是 `out` 参数 / 序列化那种）。所以生成的类上是
#
#     [RavelClass("DateTime", Implements = "IValue")]
#
# —— 标了 `IValue`，它**就是** Ravel 意义上的值（能当字典的键、去重那套认它）。
#
# 唯一要挡的是**返回 `void` 的实例方法**：那个签名是"改原地"，而值类型上改的是
# **装箱那份副本**，改完丢掉 —— 静默白做。产物里会留一行「跳过 Deconstruct：…」。
dt := "System.DateTime"
源码2 := Adaptor.CsClass dt "NDate" "DateTime" (Adaptor.AllOfClass dt)
Adaptor.Build 源码2 "out/NDate.cs" "out/plugins/NDate.dll"
using "NDate"
d := NDate.DateTime 638000000000000000     # 构造器：`DateTime(long ticks)`
print ("② 原值：" + (string (d.ToLongDateString ())))
# **`AddDays` 交回的是新值** —— 生成的代码包的是**那个副本**，不是 `self`。
# 交 `self` 就成静默给旧值了（`d.AddDays 1` 看着成了、其实等于没调）。
print ("   AddDays 1：" + (string ((d.AddDays 1.0).ToLongDateString ())))
print ("   原值没动：" + (string (d.ToLongDateString ())))

# ③ **认不出的参数：照常生成，转换退到运行期。**
#
# `DateTime.Add (TimeSpan)` 里的 `TimeSpan` **不在映射表里** —— 但这一版不再整个跳过：
# 生成的代码走 `(System.TimeSpan) PluginKit.ToObject (x0, typeof (System.TimeSpan), "…")`，
# 先 `ToNet` 再按目标类型收。于是**手里真有个 `TimeSpan` 就转得动**：
using "plugins/Ravel.Reflect.dll"
span := Reflect.New (Reflect.Type "System.TimeSpan") [24 0 0]     # 24 小时
print ("③ 原值：" + (string (d.ToLongDateString ())))
print ("   Add 24 小时：" + (string ((d.Add span).ToLongDateString ())))
# 喂错类型则是**调用时**一句能 `try` 住的报错（表在运行期、插件还能往上加规则 ——
# `PluginKit.RegisterConverter`），不是生成阶段就什么都不给你。
try { d.Add 5; } (e: Exception) => { print ("   " + e.Message); }

print "实例那半跑通了"

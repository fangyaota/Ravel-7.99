# **实例那半** —— 生成的不是一个模块，是一个**类**。
#
#     dotnet out/ravel.dll examples/adaptor_class.rav
#
# 静态那半（`Adaptor.Cs`）生成的是**模块函数**（`[RavelFn]`，体里 `System.Math.Max (…)`）；
# 这一半生成的是**类**（`[RavelClass]` + `[ClassCtor]` + `[ClassMethod]`，体里 `self`
# 先经 `Me (self)` 脱壳）。**两个形状，所以是两个函数，不是一个开关**：
#
#     Adaptor.Cs      类型 模块 成员          # 静态 → 模块
#     Adaptor.CsClass 类型 模块 类名 成员      # 实例 → 类
#     Adaptor.AllOf       类型                # 全部静态方法名
#     Adaptor.AllOfClass  类型                # 全部实例方法名
#
# 产物落在 `out/`（构建目录，`build.sh` 会整个删掉）。
using "adaptor.rav"

# ① **引用类型**：`Random` 那种"有身份"的
类型 := "System.Random"
源码 := Adaptor.CsClass 类型 "Rnd" "Random" (Adaptor.AllOfClass 类型)
Adaptor.Build 源码 "out/Rnd.cs" "out/plugins/Rnd.dll" (Adaptor.RefsOf 类型 (Adaptor.AllOfClass 类型))
print ("① 扫出 " + (string ((Adaptor.AllOfClass 类型).Count ())) + " 个实例方法名")
using "Rnd"
r := Rnd.Random ()                 # 构造器（`[RavelClass]` 挂了 `[RavelModule]`，类对象也进模块）
print ("   Next ()：" + (string (r.Next ())))
print ("   NextDouble ()：" + (string (r.NextDouble ())))

# ② **值类型也做**（`DateTime` / `Guid` / `TimeSpan` 那一族）。
#
# 它跟 `IntVal` 是**一个形状**：不可变，方法交回**新值**（量过：`DateTime` 42 个实例
# 方法里只有 2 个返回 `void`，那两个还是 `out` 参数 / 序列化那种）。所以生成的类上是
#
#     [RavelClass("DateTime", Implements = "IValue")]
#
# —— 标了 `IValue`，它**就是** Ravel 意义上的值（能当字典的键、去重那套认它）。
#
# 唯一要挡的是**返回 `void` 的实例方法**：那个签名是"改原地"，而值类型上改的是
# **装箱那份副本**，改完丢掉 —— 静默白做。产物里会留一行「跳过 Deconstruct：…」。
dt := "System.DateTime"
源码2 := Adaptor.CsClass dt "NDate" "DateTime" (Adaptor.AllOfClass dt)
Adaptor.Build 源码2 "out/NDate.cs" "out/plugins/NDate.dll" (Adaptor.RefsOf dt (Adaptor.AllOfClass dt))
using "NDate"
d := NDate.DateTime 638000000000000000     # 构造器：`DateTime(long ticks)`
print ("② 原值：" + (string (d.ToLongDateString ())))
# **`AddDays` 交回的是新值** —— 生成的代码包的是**那个副本**，不是 `self`。
# 交 `self` 就成静默给旧值了（`d.AddDays 1` 看着成了、其实等于没调）。
print ("   AddDays 1：" + (string ((d.AddDays 1.0).ToLongDateString ())))
print ("   原值没动：" + (string (d.ToLongDateString ())))

# ③ **认不出的参数：照常生成，转换退到运行期。**
#
# `DateTime.Add (TimeSpan)` 里的 `TimeSpan` **不在映射表里** —— 但这一版不再整个跳过：
# 生成的代码走 `(System.TimeSpan) PluginKit.ToObject (x0, typeof (System.TimeSpan), "…")`，
# 先 `ToNet` 再按目标类型收。于是**手里真有个 `TimeSpan` 就转得动**：
using "plugins/Ravel.Reflect.dll"
span := Reflect.New (Reflect.Type "System.TimeSpan") [24 0 0]     # 24 小时
print ("③ 原值：" + (string (d.ToLongDateString ())))
print ("   Add 24 小时：" + (string ((d.Add span).ToLongDateString ())))
# 喂错类型则是**调用时**一句能 `try` 住的报错（表在运行期、插件还能往上加规则 ——
# `PluginKit.RegisterConverter`），不是生成阶段就什么都不给你。
try { d.Add 5; } (e: Exception) => { print ("   " + e.Message); }

# ④ **属性**：一个名字、两个方向。
#
# .NET 的属性（`sb.Length` / `d.Year`）在反射里是 `get_X` / `set_X` 两个方法
# （`IsSpecialName`）—— 方法那条路把"别的东西"滤掉了，所以从前整个跳过。现在生成的是
#
#     [ClassProperty("Length")]
#     public static RuntimeValue Length (RuntimeValue self, RuntimeValue arg)   # 那格收到 `()` 就是读
#
# 引擎把它落成 **`by` 槽** —— 和 `by x := property g s`、接口体里那条 `instance`
# 是**同一个机制**。于是：
#
#     sb.Length          # 读走 getter
#     sb.Length = 2      # 写走 setter（`.NET` 那边真改）
#     sb.Length += 3     # 复合赋值两边都走
#
# **不必发明 `SetLength` / `PutLength` 那种名字** —— `by` 本来就是为"一个名字两个方向"
# 存在的，生成器没有理由自己再造一套约定（那三个约定也正是在这一版删掉的）。
#
# 只读的两种情形都在产物里说明白：
#   * `.NET` 那边**没有 setter**（`StringBuilder.MaxCapacity`）—— 标 `ReadOnly`，写由引擎在槽上拦；
#   * **值类型上的属性一律只给读**（`DateTime.Year`）：`Me (self)` 拆出来的是装箱那份**副本**，
#     写回去改的是副本、改完丢掉。宁可在生成时就标清楚，也不要"看着成了、其实没改"那种静默。
using "plugins/Ravel.Generated.dll"
sb := NSb.StringBuilder ()
sb.Append_3 "hello"                        # 排位第一的 `Append` 是 `(int)` 那个，字符串那格叫 `Append_3`
print ("④ 读长度：" + (string (sb.Length)))
sb.Length = 2
print ("   写 2：" + (sb.ToString ()))
sb.Length += 3
print ("   += 3：" + (string (sb.Length)))
try { sb.MaxCapacity = 1; print "   只读没拦住"; } (e: Exception) => { print ("   只读拦住了：" + e.Message); }
print ("   值类型（DateTime.Year）：" + (string (d.Year)))

# ⑤ **字段**：和属性走同一条路（实例那半从类型上**属性和字段一起扫**）。
#
# `.NET` 的字段（`Vector3.X`）连 `GetMethods` 都进不去（属性好歹还是 `get_X` / `set_X`
# 两个方法），所以从前同样整个跳过。生成的是同一个 `[ClassProperty]`：
#
#     v.X          # 读
#     v.X = 1.0    # 写 —— 但**值类型上只给读**
#
# 为什么值类型只给读：`Me (self)` 拆出来的是**装箱那份副本**，写回去改的是副本、改完丢掉
# —— `v.X = 1.0` 看着成了、`v.X` 还是旧值，**一声不响**。产物里那一格会带一行说明，
# 不让人猜。引用类型的字段（`readonly` 的除外）照常给写 —— 写的就是那个对象本身。
类型2 := "System.Numerics.Vector3"
源码3 := Adaptor.CsClass 类型2 "NVec" "Vector3" (Adaptor.AllOfClass 类型2)
Adaptor.Build 源码3 "out/NVec.cs" "out/plugins/NVec.dll" (Adaptor.RefsOf 类型2 (Adaptor.AllOfClass 类型2))
using "NVec"
v := NVec.Vector3 3.0                     # 构造器：`Vector3 (float)`
print ("⑤ x / y / z：" + (string (v.X)) + " / " + (string (v.Y)) + " / " + (string (v.Z)))
# 注意 `Length` 在这里是**方法**（`Vector3.Length ()`），所以照旧要括号 ——
# 属性那条路的名字得看产物里是 `[ClassProperty]` 还是 `[ClassMethod]`（重名的以方法为准）
print ("   Length ()：" + (string (v.Length ())))
try { v.X = 1.0; print "   值类型没拦住"; } (e: Exception) => { print "   值类型那一格只给读"; }
# 要"改"它得走**值语义**那条路：`d = d.AddDays 1`（方法交回新值，② 演示过），
# 或者拿 `by` 包一层、让 setter 给**装它的那个变量**换一份新值（`tests/class/352`）。
# 轮不到"就地改那份值" —— `w := v` 之后两份值共用一个箱子，改了会静默影响别处。
# 连"换槽"都不行：引擎在值类型那些格上标了 `ReadOnly`（`by v.X = …` 报「无法给只读变量」）。

print "实例那半跑通了"

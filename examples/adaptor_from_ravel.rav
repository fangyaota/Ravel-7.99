# **在 `.rav` 文件里生成 dll** —— 不用开命令行。
#
#     dotnet out/ravel.dll examples/adaptor_from_ravel.rav
#
# 生成逻辑是个**库**（`lib/adaptor.rav`，模块 `Adaptor`），`tools/mkadaptor.rav`
# 只是它的命令行壳。所以一条 `using` 就能调：
#
#     Adaptor.Cs    类型 模块 成员              # → 生成的 C# 源码（字符串，不落盘）
#     Adaptor.Write 源码 cs路径                 # → 写 .cs
#     Adaptor.Build 源码 cs路径 dll路径          # → 写 .cs + **就地编** dll
#
# `Write` / `Build` 收的是**源码**，不是「类型 + 成员」—— 于是「静态那半 / 实例那半」
# （`Cs` / `CsClass`）和「写 / 写+编」两件事**正交**地拼，加形状不用加分支。
#
# **成员那一格不用手数** —— `Adaptor.AllOf 类型` 就是"这个类型全部该适配的静态方法名"
# （去重、排序、滤掉属性访问器和运算符）。第 ⑤ 段走的就是它。
#
# 产物落在 `out/` 里 —— 那是构建目录，`build.sh` 会整个删掉重来，不用管它。
using "adaptor.rav"

类型 := "System.Math"
模块 := "NFromRavel"
成员 := ["Max" "Min" "Sqrt" "Pow" "BigMul"]

# ① 只要源码，拿在手里随便处置（往别处贴、比一比、塞进别的生成器都行）
src := Adaptor.Cs 类型 模块 成员
print ("① 源码 " + (string (src.Length ())) + " 个字符")

# ② 落成 .cs
Cs路径 := "out/" + 模块 + ".cs"
Adaptor.Write (Adaptor.Cs 类型 模块 成员) Cs路径
print ("② 写好了：" + Cs路径)

# ③ 顺手**就地编**成 dll —— Roslyn 当库调，不经过 `dotnet build`，
#    所以只有 runtime（没装 SDK）的机器上这一步一样走得完。
Dll路径 := "out/plugins/" + 模块 + ".dll"
Adaptor.Build (Adaptor.Cs 类型 模块 成员) Cs路径 Dll路径
print ("③ 编好了：" + Dll路径)

# ④ 装上它 —— 就在同一份脚本里，往后就是普通模块了
using "NFromRavel"
print (NFromRavel.Max 3 7)                 # 7
print (NFromRavel.Sqrt 16)                 # 4
print (NFromRavel.BigMul 2000000000 2)     # 4000000000（装不下 int，升 bigint）
# ⑤ **不用逐个列成员**：`AllOf` 把这个类型全部该适配的静态方法名扫出来。
#    类型名给一个就够 —— 短名（`System.Math` → `Math`）能当模块名使，
#    但**别真拿短名去建模块**：库里可能已经有一个同名的了（`Math` 就是），
#    两个同名模块谁后 `using` 谁赢，那是静默的坏。
名字 := Adaptor.AllOf 类型
print ("⑤ 扫出 " + (string (名字.Count ())) + " 个静态方法名，"
       + "短名是 " + (Adaptor.ShortName 类型))

全模块 := "NMathAll"
Adaptor.Build (Adaptor.Cs 类型 全模块 名字) ("out/" + 全模块 + ".cs") ("out/plugins/" + 全模块 + ".dll")
using "NMathAll"
print (NMathAll.Tanh 1.0)              # 0.7615941559557649
print (NMathAll.ILogB 8.0)             # 3
print (NMathAll.Truncate (0 - 2.7))    # -2
print "在 .rav 里走完了 生成 → 编译 → 用"

# **生成出来的适配层** —— `.rav` 一路交给 .NET，拿回来一个真 dll。
#
# 这条链是：
#
#     规格（Ravel）→ ①生成 .cs → ②编译 → ③`using` 用上
#                     ↑                ↑
#              tools/mkadaptor.rav   两条路，见下
#
# 1) 生成：
#
#     dotnet out/ravel.dll tools/mkadaptor.rav System.Math NMath \
#         Max Min Abs Sign Clamp Sqrt Pow Sin Cos Floor Ceiling Round Exp Log BigMul
#     → Ravel.Generated/NMath.cs        # 一个 [RavelModule] / [RavelFn] 的插件源码
#
# 2) 编译 —— **看现场有没有 SDK**：
#
#    a. 在仓库里（有 SDK）：`bash build.sh` 连它一起编（见 `Ravel.csproj` 的 `BuildPlugins`）
#    b. 手上只有 `out/`（**只有 runtime**）：生成时加 `--dll <路径>`，用 `Ravel.Compile`
#       那个插件**就地**编 —— `out/` 是 framework-dependent 发布，那种机器上
#       `dotnet build` 这个命令根本不存在，这就是 `--dll` 存在的全部理由：
#
#         dotnet out/ravel.dll tools/mkadaptor.rav System.Math NMath Max Min Sqrt BigMul \
#             --dll out/plugins/Ravel.Generated.dll
#
#        （两条路编出来的是**同一个东西**：同一个 `.cs`、同一个模块名。Roslyn 在那条路上
#          是**当库调**的，引用集直接从当前进程取 —— 框架那一套走
#          `TRUSTED_PLATFORM_ASSEMBLIES`，引擎自己走 `typeof(RuntimeValue).Assembly.Location`。
#          于是编出来的 dll 引用的就是**跑着的那个 `Ravel.dll`**，版本天然对齐。）
#
# 3) 用：
using "plugins/Ravel.Generated.dll"

# ── 重载是**编译期**挑好的，而且挑"丢信息最少"的那个 ──
#
# `Math.Max` 有 11 个同名重载（byte / decimal / double / short / int / long …），
# 生成器按「参数少 → 丢的信息少 → 签名」排，`Int32` 排在最前、`Double` 在后，
# 于是挑中的是 `(int, int) -> int` —— 交回一个真 `int`：
print (NMath.Max 3 7)
print (NMath.Min 3 7)
print (NMath.Abs (0 - 5))
print (NMath.Sign (0 - 9))
print (NMath.Clamp 3 1 5)          # 三个实参的那个（值, 最小, 最大）
print ((NMath.Max 3 7) + 1)        # 接着算也行

# ── `real` 也进来了（`PluginKit.Num` 把五种数值类型全收成一个 `double`）──
print (NMath.Sqrt 16)
print (NMath.Pow 2 10)
print (NMath.Floor 2.7)
print (NMath.Ceiling 2.1)
print (NMath.Round 2.6)
print (NMath.Sin 0)
print (NMath.Exp 1)

# ── 比 `int` 大的整数**自动升 `bigint`**，不是报错也不是回绕 ──
#
# `Math.BigMul` 交回一个 `long`；`PluginKit.Narrow` 装得下就给 `int`、
# 装不下升 `bigint`。这条对"字节数 / ticks / 文件大小"那一族很关键 ——
# 从前是**当场抛错**（文档说着"给 bigint"，实现却转给了算术语义那条）。
print (NMath.BigMul 3 7)           # 21（装得下 int）
print (NMath.BigMul 2000000000 2)  # 4000000000（装不下，升 bigint）

# ── 同一个 dll 里装好几个模块 ──
#
# `Ravel.Generated/` 是**一个**插件项目，加适配器 = 多跑一次生成器，不用动 csproj。
using "plugins/Ravel.Generated.dll"
print (NStr.IsNullOrEmpty "")
print (NStr.Concat "生成" " 的")
print (NStr.Compare "a" "b")
print (NStr.IsNullOrWhiteSpace "   ")

# ── 被调方抛的也接得住 ──
#
# 生成的每个方法外面都套着 `PluginKit.Guarded` —— 引擎那条"别让 C# 异常漏到顶层"
# 的老规矩（不兜的话会绕过 Ravel 的 `try`，直接打成"解释器内部错误"）。
# 这条**不是可选项**，是实测踩出来的：没兜的时候 `Math.Clamp` 一句
# `ArgumentException` 把整个脚本打掉了。
try {
    NMath.Clamp 1 5 3;             # 最小 > 最大，`Math.Clamp` 自己要抛
} (e: Exception) => {
    print ("接住了：" + e.Message);
}

# ── 跟 `Reflect.Call` 那条路比一比 ──
#
# 同一件事，`Reflect.Call` 是**运行期**挨个试重载：
using "plugins/Ravel.Reflect.dll"
print (Reflect.Unwrap (Reflect.Call (Reflect.Type "System.Math") "Max" [3 7]))

# 生成的这条是**编译期**定死的：`Math.Max(x0, x1)` 直接写进 C#，Roslyn 早就挑好了，
# 而且不走 `Invoke` + 装箱 + `DotNetObject` 那圈绕行。代价是它只认生成时挑中的那个
# 重载 —— `NMath.Max 3.5 7.5` 会当场报类型错，而 `Reflect` 那条路能接住。

# ── 生成器拒绝的东西，写在产物里 ──
#
# `String.Join` 13 个重载全要 `string[]` / `object[]`，`String.Format` 15 个全要
# `object` —— 映射表里都没有（v0 是 int / long / string / bool / char / real），
# 于是 `Ravel.Generated/NStr.cs` 里留着：
#
#     // 跳过 Join：没有能映射的重载（同名静态方法 13 个，0 个类型认得出，13 个被筛掉）
#
# **挑不中就明说，不猜** —— 猜错比不生成难查得多。要数组参数的话，
# `examples/net_scaffold.rav` 里那个 `ArrayOf` 能造，但那得人来补（产物是脚手架）。
print "生成出来的适配层跑通了"

# 模式：按形状绑名字，形状不对就**拒收**（不是硬错），所以 `|` 的交替和 `try` 都接得住。
# 镜子是 tests/lang/318/319/322/323 那几条用例。
using "monad.rav"

# ── 一、解构：右边什么形状，左边照着写 ──
[x y] := [10 20]
[ka _ kc ..剩下] := [1 2 3 4 5]
Point ::= class { px: int = 0; py: int = 0 }
{px py} := Point ()
print "${x} ${y} | ${ka} ${kc} ${剩下.ToList ()} | ${px} ${py}"

# ── 二、每一格能带类型、也能带条件（名字取条件里最左那个标识符）──
keep := ([u == 1 v: string]) => { "要的：${u} ${v}"; } | (_) => { "不是"; }
print (keep [1 "看"])
print (keep [2 "看"])

# ── 三、整块的条件写 `|>`：复合的那几格自己没名字，把值喂出去 ──
LongerThanThree := (s) => { (s.Count ()) > 3; }
Pos := (n) => { n > 0; }

[a b] |> LongerThanThree := [1 2 3 4]      # 贴在 `]` 后面 → 喂的是**整个**列表
print "${a} ${b}"
[c |> Pos d] := [5 6]                      # 贴在名字后面 → 喂的是**那一个**元素
print "${c} ${d}"

# ── 三·五、一格直接写字面量：要求**等于**它（参数位就是按值分派）──
[1 v] := [1 2]
print v
pick := (1) => { "一"; } | (()) => { "空"; } | (_) => { "别的"; }
print (pick 1)
print (pick ())
print (pick 9)

# ── 四、带标签的分派：整块先认标签、`[]` 认"空的"那一半 ──
kind := ([v] : Option) => { "有的 ${v}"; } | ([] : Option) => { "空的"; } | (_) => { "别的"; }
print (kind (Some 7))
print (kind None)
print (kind 9)

# ── 五、参数位置解构：拆不成就是"这一支不收"，能当分派的头一格 ──
k := ([a b]) => { "一对 ${a + b}"; } | ({px py}) => { "一条 ${px + py}"; } | (_) => { "别的"; }
print (k [3 4])
print (k (Point ()))
print (k "x")

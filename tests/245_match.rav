# `match v cases dflt`:从头试每一对 `[条件 结果]`,第一对条件为真的交出它的结果;都不真给 `dflt`。
# 条件是个**谓词**(`is.int` 这种运算符节就是它);结果**写成块就是延迟的** —— 命中那一支才跑。

kind := (v: object) => {
    match v [
        [is.int    {"整数";}]
        [is.bool   {"布尔";}]
        [is.string {"字符串";}]
        [is.list   {"列表";}]
    ] {"别的";}
}
print (kind 3)
print (kind true)
print (kind "x")
print (kind [1 2])
print (kind 1.5)

# 比值也这么写:`<=.0` 这种节
sign := (n: int) => { match n [[<.0 {"负";}] [==.0 {"零";}] [>.0 {"正";}]] {"?";}; }
print (sign (0 - 3))
print (sign 0)
print (sign 9)

# 条件是普通函数:`(x) => bool`
IsLong := (s: string) => { (s.Length ()) > 3; }
print (match "hi" [[IsLong {"长";}]] {"短";})
print (match "hello" [[IsLong {"长";}]] {"短";})

# 块是**延迟**的:没走到的分支根本不跑(写成值就不是了 —— 见最后一段)
Asked := 0
print (match 3 [[is.int {"甲";}] [is.string { Asked += 1; "乙"; }]] {"丙";})
print Asked
print (match "s" [[is.int {"甲";}] [is.string { Asked += 1; "乙"; }]] {"丙";})
print Asked

# 块的值 = 最后一条语句的值:分支里想干什么都行
print (match 1 [[is.int { print "命中"; 7; }]] { 0; })

# 一对都不真 -> 默认那一支(默认也照同一个规矩)
print (match 1 [] {"默认";})
print (match 1.5 [[is.int {"整数";}]] {"默认";})

# 结果/默认值必须是**可调用的**(推荐写成块):拿普通值糊弄当场报错
try { match 1 [[is.int 5]] {"默认";} } (e: Exception) => { print ("1: " + string e); }
try { match 9 [[is.int {"整数";}]] 0; } (e: Exception) => { print ("2: " + string e); }

# lambda 也认(它同样可调用),而且一样是延迟的
Ran := 0
print (match 1 [[is.int (() => { Ran += 1; "跑过了"; })]] {"默认";})
print Ran

# 每对必须正好两项:不是就当场报错(说清是第几对)
try { match 1 [[1 2 3]] {"默认";} } (e: Exception) => { print ("1: " + string e); }
try { match 1 [[1]] {"默认";} } (e: Exception) => { print ("2: " + string e); }
print "end"
# --- expected ---
# 整数
# 布尔
# 字符串
# 列表
# 别的
# 负
# 零
# 正
# 短
# 长
# 甲
# 0
# 乙
# 1
# 命中
# 7
# 默认
# 默认
# 1: match 第 1 对的结果要写成块（块里最后一条语句的值就是它的值）
# 2: match 的默认值要写成块（块里最后一条语句的值就是它的值）
# 跑过了
# 1
# 1: match 的每一对要写成 [条件 结果]：第 1 对不是（它 3 项）
# 2: match 的每一对要写成 [条件 结果]：第 1 对不是（它 1 项）
# end

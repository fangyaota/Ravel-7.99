# 接口继承:**一个父**,外加一串**要求**。
#
#     supTrait    ::= interface myTrait { by c : int = default }        # 一个父(继承)
#     masterTrait ::= interface supTrait [IEnumerable] { () }           # 父 + 要求
#
# 光有要求、没写父的 `interface [A B] { … }` 不收(要求得跟在父后面)。
#
# 「父」和「要求」是两回事:
# - 父是**继承**:槽并进来(`by … = default` 抄进子接口的类体)、`<:` 成立;
# - 要求是**前置条件**:实现这个接口的类必须**已经**有那些接口的实现 —— 槽不并、
#   `<:` 也不成立(`masterTrait <: IEnumerable` 是 false),只在造实现那一步查有没有。
#
# `parent` 给链上那个(接口也只继承一个,和类一样)。

myTrait ::= interface {
    by a : int = default
    by b : function = default
}

supTrait ::= interface myTrait {
    by c : int = default
    by d : function = default
}

masterTrait ::= interface supTrait [IEnumerable] {
    ()
}

# ---- 谁继承谁 ----
print (supTrait.parent)
print (masterTrait.parent)
print (supTrait <: myTrait)
print (masterTrait <: supTrait)
print (masterTrait <: myTrait)

# ---- 要求不是继承:`<:` 不成立 ----
print (masterTrait <: IEnumerable)


C ::= class {
    x : int = 0
}
D ::= class {
    y : int = 0
}

# ---- 要求是前置条件:还没实现 IEnumerable 就造实现 → 报错 ----
try {
    impl (masterTrait C {
        by a = property (() => { instance.x; }) ((v: int) => { instance.x = v; })
        by c = property (() => { instance.x * 2; }) ((v: int) => { instance.x = v; })
    })
} (e: Exception) => { print ("1: " + string e); }

# ---- 先给它一条 IEnumerable 的实现,再实现 masterTrait ----
impl (IEnumerable C {
    by GetEnumerator = property (() => { () => { Enumerator [instance.x]; }; }) ((v: function) => { (); })
})
impl (masterTrait C {
    by a = property (() => { instance.x; }) ((v: int) => { instance.x = v; })
    by c = property (() => { instance.x * 2; }) ((v: int) => { instance.x = v; })
})

u := C ()
u.a = 5
print u.c
print (u is masterTrait)
print (u is supTrait)
print (u is myTrait)
print (u is IEnumerable)
foreach u (v: int) => { print ("each " + string v); }
print (C.GetImplements ())

# ---- 同名槽:现在**报错** —— 父接口声明过的槽不能再声明一次(`:=` 是定义不是覆盖;
#      要换掉它的实现,写的是实现体里那句 `by a = property …`)----
SameTrait ::= interface myTrait {
    by a : string = default
}
E ::= class {
    s : string = ""
}
try { impl (SameTrait E { () }); } (e: Exception) => { print ("8: " + string e); }
# 槽上的类型约束:写进去的值要过声明那个类型

try { u.a = "x"; } (err: Exception) => { print ("3: " + string err); }

# ---- 注解、参数(和 `is` 同一个判据) ----
takeBase := (xs: myTrait) => { xs.a; }
print (takeBase u)

# ---- 写错了要报得清楚 ----
try {
    interface 5 { () }
} (err: Exception) => { print ("4: " + string err); }
try {
    interface supTrait [myTrait 5] { () }
} (err: Exception) => { print ("5: " + string err); }
try {
    interface C { () }
} (err: Exception) => { print ("6: " + string err); }
try {
    interface [IEnumerable] { () }
} (err: Exception) => { print ("7: " + string err); }

# ═══ 219_interface_operator(并入) ═══
ravel "219_interface_operator"
# **槽里放运算符**:`by + := property g s`。
#
# 运算符本来两跳都在"类"那一侧(类型表里的 ClassOperatorFactory → 实例作用域里的实现),
# 而 `by` 槽住在**实现**身上(接口体跑一遍就落在实现 scope 里),两跳都够不着它。
# 现在补上这一段:
#
#   * 接口里写 `by + := property …` → 实现这个接口的类就有了这个运算符(随作用域在/不在);
#   * 实现块里 `by + = property …` 换掉它(和普通槽一个写法);
#   * 类体里直接写 `by * := property …` 也行(不经接口)。
#
# 那一格的**值是 property**,所以用它是**两级**:先读槽(推 getter)拿到运算符函数,
# 再拿那个函数收右操作数 —— `TraitOp` 帧专门管这个。
#
# 两边看得见的东西不一样:trait 那边是 `instance`(实现里那个"当下这个实例"),
# 类体那边是 `this`。

T ::= interface {
    by a : int = default
    by + := property (() => { (o: object) => { instance.a + 100; }; }) ((v: function) => { (); })
}

C ::= class {
    x : int = 0
}

use (T C {
    by a = property (() => { instance.x; }) ((v: int) => { instance.x = v; })
    by + = property (() => { (o: object) => { instance.x * 2; }; }) ((v: function) => { (); })
})

u := C ()
u.a = 5
print (u + 1)          # 实现里换掉的那条:5 * 2
print (u.+ 7)          # 节形式一样走槽
print (u + u)

# 复合赋值:算子交回同类型的东西才写得回去
E ::= class {
    v : int = 0
    init = (k: int) => { v = k; this; }
    by + := property (() => { (o: object) => { E (this.v + o.v); }; }) ((f: function) => { (); })
}
e := E 1
e += E 2
print e.v

# 类体里自己声明一条(不经接口):这边看得见的是 `this`
D ::= class {
    n : int = 1
    by * := property (() => { (o: object) => { this.n * 10; }; }) ((v: function) => { (); })
}
print ((D ()) * 3)

# 只有默认值(`= default`,那对什么都不做的 getter/setter):响亮地报错,不静默
Loose ::= class {
    by + := default
}
try { print ((Loose ()) + 1); } (err: Exception) => { print ("1: " + string err); }

# 没有实现的对象:类型那两个都不支持
Out ::= class {
    y : int = 0
}
try { print ((Out ()) + 1); } (err: Exception) => { print ("2: " + string err); }

# 随作用域在/不在:`use` 写在函数里,出了那次调用就没有运算符了
# (用一个**只有那个函数里才实现过**的类,免得被上面那条 use 兜住)
S ::= class {
    w : int = 0
}
scoped := () => {
    use (T S {
        by a = property (() => { instance.w; }) ((v: int) => { instance.w = v; })
    })
    print ((S ()) + 1)   # 接口里那条默认的:0 + 100
}
scoped ()
try { print ((S ()) + 1); } (err: Exception) => { print ("3: " + string err); }
ravel ""
# --- expected ---
# myTrait
# supTrait
# true
# true
# true
# false
# 1: `masterTrait` 要求 C 已经实现了 IEnumerable（先给它 impl/use 一条）
# 10
# true
# true
# true
# true

# 运算符节:`+.2` 左操作数留空,等价于 `(_ + 2)`
add2 := +.2
print (add2 5)

# 右操作数只吃一个 primary,复杂式要自己加括号
print ((+.(2 * 3)) 10)

# 括号界定 section 的范围:(+.1) 先变成 lambda,再让 41 应用上去
print ((+.1) 41)
print ((_ + 1) 41)

# 右操作数可以是成员访问
C := class { init = () => { 0; this; }; v: int = 100; }
c := C ()
print ((+.c.v) 1)

# 各符号都行
print ((*.3) 5)
print ((==.5) 5)
print ((<.5) 3)

# 与成员访问形式对称:`2.+` 是等右操作数,`+.2` 是等左操作数
d := 2.+
print (d 3)
# --- expected ---
# 7
# 16
# 42
# 42
# 101
# 15
# true
# true
# 5

# 构造器调用和普通函数一样柯里化:Point 3 4 ≡ ((Point 3) 4)
Point := class {
    init := (x0: int y0: int) => {
        x = x0
        y = y0
    }
    x: int = 0
    y: int = 0
}

# 1) 一次写全
p := Point 3 4
print (p.x)
print (p.y)

# 2) 少参 → 半成品,补上参数才得到对象
half := Point 10
q := half 20
print (q.x)
print (q.y)

# 3) 三参
Vec := class {
    init := (a: int b: int c: int) => { s = a + b + c; }
    s: int = 0
}
v := Vec 1 2 3
print (v.s)

# 4) 单参/零参:init 一次应用完,直接是对象(不变成半成品)
Box := class {
    init := (n: int) => { x = n; }
    x: int = 0
}
bx := Box 5
print (bx.x)
Zero := class {
    init := () => { z = 9; }
    z: int = 0
}
zz := Zero ()
print (zz.z)
# --- expected ---
# 3
# 4
# 10
# 20
# 6
# 5
# 9

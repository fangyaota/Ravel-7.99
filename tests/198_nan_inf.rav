# NaN / Inf —— 特殊浮点值,和 `true`/`false` 同款:
# System 模块里的一个值(`System.NaN` / `System.Inf`),`predefined.rav` 给全局别名。
# `-Inf` 不用另设:一元 `-` 对 Float 就是取负。

print NaN
print Inf
print (-Inf)
print (typeof NaN)
print (typeof Inf)
print (NaN is float)
print (NaN isnot int)
print (Inf is float)

# 打印是 ASCII 的:别交给 double.ToString —— 它的无穷是文化相关的 `∞`
print (0.0 / 0.0)
print (1.0 / 0.0)
print (-1.0 / 0.0)
print (Inf == 1.0 / 0.0)

# IEEE 语义:NaN 不等于自己
print (NaN == NaN)
print (NaN != NaN)
print (Inf > 1)
print (1 / Inf)
print (Inf + 1)
print (Inf - Inf)

# 进了别的值里也照样
using "math.rav"
print ([NaN Inf])
print ({a: Inf})
print (string Inf)
print (string NaN)
print (Math.floor NaN)
print (Math.sqrt Inf)

# 折不成 int:报错而不是静默(以前 double 那条是"饱和"转换,一个字都不说)
using "try.rav"
Ex.try { int Inf; } (e: Exception) => { print ("int Inf: " + string e); }
Ex.try { int NaN; } (e: Exception) => { print ("int NaN: " + string e); }
print "done"
# --- expected ---
# NaN
# Inf
# -Inf
# Float
# Float
# true
# true
# true
# NaN
# Inf
# -Inf
# true
# false
# true
# true
# 0
# Inf
# NaN
# [NaN Inf]
# {a: Inf}
# Inf
# NaN
# NaN
# Inf
# int Inf: 数值 Inf 超出 int 范围（int 是 32 位，大数用 bigint）
# int NaN: NaN 不能转换为 int
# done

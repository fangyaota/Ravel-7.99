# 请求正文的上限 —— **对面说多大,我们不能就分配多大**。
#
# 顶设在本机那一层(`Httpd.Server {"max": …}`,默认 16 MB,和客户端那条一个数)。
# 超了的请求:**正文一个字都不读**,回 413 再断。
#
# 为什么不"读完再丢":那等于"对面说多大我们就读多大",这个顶就白设了 ——
# 一句 `Content-Length: 2000000000` 照样能让这台读上两个 G。
using "httpd.rav"
using "tasks.rav"
using "http.rav"

srv := Httpd.Server {"port"-> 0 "max"-> 1024}
srv.Route "POST" "/in" (req g) => { Httpd.Text ("收到 " + (string ((req.Body).Count ()))); }
base := "http://127.0.0.1:" + (string (srv.Port))

Tasks.Cycle [
    (Tasks.Task (g: Tasks.TaskGroup) => { srv.RunIn g; })
    (Tasks.Task (g: Tasks.TaskGroup) => {
        # 一、顶以下的照常("小东西" UTF-8 是 9 个字节)
        ok := g.Await (Http.PostTask (base + "/in") "小东西")
        print ((string (ok.status)) + " " + (ok.Text ()))

        # 二、顶以上:413,而且那句话里说的是**上限和它说的那个数**
        st := 0
        why := ""
        try { r := g.Await (Http.PostTask (base + "/in") ("x" * 4000)); st = r.status; why = r.Text (); } (e: Exception) => { st = -1; }
        print (string st)
        print why

        srv.Stop ()
    })
]
# --- expected ---
# 200 收到 9
# 413
# 请求正文太大（超过 1 KB，它说 3 KB）

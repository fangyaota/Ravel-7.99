# todo
# metaclass：继承 class 的类型构造器
MyMeta := class class {
    init ctor := (parent: type block: function) => {
        base.init parent block
    }
}
print (typeof MyMeta)

# 用 MyMeta 创建类
MyClass := MyMeta {
    init ctor := () => { 0; }
    x: int = 42
}
c := MyClass ()
print (c.x)
# --- expected ---
# Class
# 42

# todo
# metaclass:继承 type 的类型构造器(没有 Class 类型了,类的元类就是 Type)
MyMeta := class class {
    init := (parent: type block: function) => {
        base.init parent block
        this;
    }
}
print (typeof MyMeta)

# 用 MyMeta 创建类
MyClass := MyMeta {
    init := () => { 0; this; }
    x: int = 42
}
c := MyClass ()
print (c.x)
# --- expected ---
# Type
# 42

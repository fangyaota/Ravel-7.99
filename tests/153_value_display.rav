# 值和容器的打印形式

# 对象:类名 + 数据字段。方法(含 init)和 this/block 这些机制字段不显示
C := class { init := () => { 0; this; }; x: int = 1; s: string = "hi"; }
c := C ()
print c
print ([c c])

# `base` 从前也是机制字段(那套 super 机制早删了),于是**用户一个叫 base 的字段会被藏起来**。
# 现在它只是普通名字,照常列出来。
B := class { init := () => { 0; this; }; base: int = 9; }
print (B ())

# `:=` 建的类没有名字(只有 `::=` 命名),显示和报错时退化成 "class",
# 而不是空串——否则错误信息是「类型 '' 不支持运算符」
print (typeof c).name
print (typeof c)

# 函数打印成**它的代码**(函数值没有可显示的标量),::= 命名的带上名字。
# 以前这些 record 会吐 C# 的自动 dump(System.Func`2[Ravel.Runtime...])
print ((x: int) => { x; })
add ::= (x: int) => { x; }
print add
# 柯里化喂过的实参跟在后面;签名里是**还等着**的那几个
add2 := (a: int b: int) => { a + b; }
print add2
print (add2 1)
print ((add2 1) 2)

# 自引用容器靠深度护栏收住——以前是直接爆 C# 栈,进程都没了
loop := []
loop.Add loop
print loop

# 深度以内的嵌套照常展开
print ([[[1]]])

# 字典/集合
print ({"a": 1 "b": "x"})
print ({1 2 3})
# --- expected ---
# class { x = 1, s = hi }
# [class { x = 1, s = hi } class { x = 1, s = hi }]
# class { base = 9 }
# class
# class
# <function (x: int) => { x; }>
# <function add (x: int) => { x; }>
# <function (a: int b: int) => { a + b; }>
# <function (b: int) => { a + b; } applied a=1>
# 3
# [[[...]]]
# [[[1]]]
# {a: 1 b: x}
# {1 2 3}

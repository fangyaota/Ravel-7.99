# 调用比运算符**松**：实参吃到运算符为止。
#
#     f 1 + 2      ≡  f (1 + 2)       —— 调用"抓住"它右边那一整条算式
#     f (1) + 2    ≡  (f 1) + 2       —— **括号开头的实参**是个完整的表达式，运算符落在调用结果上
#     f a b        ≡  ((f a) b)       —— 并列照旧是多个实参（柯里化不受影响）
#
# 这条规矩带来的两个写法要求（教程 3.7 / 常见陷阱）：
#   * 转换器式调用（`string x` / `bigint n` / `typeof x`）后面还要接东西时，实参要括起来；
#   * "先算调用再运算"就自己加括号（或者对成员用 `@`）。
print 1 + 2
print (1 + 2)
print "a" + "b"

inc := (n: int) => { n + 1; }
print (inc 1 * 5)              # inc (1 * 5)
print ((inc 1) * 5)            # 先算调用

add := (a: int) => { (b: int) => { a + b; }; }
print (add 1 2 * 3)            # ((add 1) (2 * 3)) —— 还是两个实参
print (add 1 2 + 3)            # ((add 1) 2) + 3

xs := [10 20 30]
print (xs.Count () + 1)        # `()` 是括号实参 → 数完再加一
print (xs.At (0) + 1)          # 取第 0 个再加一
print (xs.At 0 + 1)            # 新规矩下的读法：取第 (0+1) 个 —— 别这么写

str := (v: object) => { "[" + string (v) + "]"; }
print (str 5)                  # 转换器的实参括起来才安稳
print (str $ 5)                # `$` 把右边整个封成一个实参
print (str 5 + 1)              # 不括：string 把 `+ 1` 也吃进去 → "[(5 + 1)]"

f := (x: int) => { x is int; }
print (f 3)                    # 词形运算符一样被吃：f (3 is int)
print (f 3 + 1)                # f (3 + 1) → 4 is int
print ((f 3) == true)          # 先算调用要加括号
print "end"
# --- expected ---
# 3
# 3
# ab
# 6
# 10
# 7
# 6
# 4
# 11
# 20
# [5]
# [5]
# [6]
# true
# true
# true
# end

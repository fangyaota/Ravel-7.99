# ===== 多运算符 + 自定义名 =====
Vec := class {
    init ctor := () => { this.v = 10; }
    v: int = 0
    operator+ add := (x: int) => { v + x; }
    operator* mul := (x: int) => { v * x; }
    operator- sub := (x: int) => { v - x; }
}
a := Vec ()
print (a + 5)
print (a * 3)
print (a - 2)
# 运算符作变量
addFn := a.operator+
print (addFn 100)
# --- expected ---
# 15
# 30
# 8
# 110

# ===== 多运算符 + 自定义名 =====
Vec := class {
    init = () => { this.v = 10; this; }
    v: int = 0
    + := (x: int) => { v + x; }
    * := (x: int) => { v * x; }
    - := (x: int) => { v - x; }
}
a := Vec ()
print (a + 5)
print (a * 3)
print (a - 2)
# 运算符作变量
addFn := a.+
print (addFn 100)

# ═══ 65_operator_inherit(并入) ═══
ravel "65_operator_inherit"
Node := class { init = () => { 0; this; }; }
Child := class Node {
    init = () => { 0; this; }
    v: int = 42
    + := (x: int) => { v + x; }
}
c := Child ()
print (c + 8)

# 子类用 `+ = f` 覆盖父类层定义的运算符(父类自己不受影响)
Base := class {
    init = () => { 0; this; }
    n: int = 1
    + := (x: int) => { n + x; }
}
Derived := class Base {
    init = () => { 0; this; }
    + = (x: int) => { n * 100 + x; }
}
d := Derived ()
b := Base ()
print (d + 5)
print (b + 5)
ravel ""

# ═══ 66_operator_isolation(并入) ═══
ravel "66_operator_isolation"
A := class {
    init = () => { this.n = 1; this; }
    n: int = 0
    + := (x: int) => { n + x; }
}
a1 := A ()
a2 := A ()
a1.n = 100
print (a1 + 0)
print (a2 + 0)
ravel ""

# ═══ 67_operator_this(并入) ═══
ravel "67_operator_this"
B := class {
    init = () => { this.val = 10; this; }
    val: int = 0
    + := (x: int) => { val + x; }
    * := (x: int) => { this.val * x; }
}
b := B ()
print (b + 5)
print (b * 3)
b.val = 50
print (b + 5)
print (b * 3)
ravel ""

# ═══ 151_operator_section(并入) ═══
ravel "151_operator_section"
# 运算符节:`+.2` 左操作数留空,等价于 `(_ + 2)`
add2 := +.2
print (add2 5)

# 右操作数只吃一个 primary,复杂式要自己加括号
print ((+.(2 * 3)) 10)

# 括号界定 section 的范围:(+.1) 先变成 lambda,再让 41 应用上去
print ((+.1) 41)
print ((_ + 1) 41)

# 右操作数可以是成员访问
C := class { init = () => { 0; this; }; v: int = 100; }
c := C ()
print ((+.c.v) 1)

# 各符号都行
print ((*.3) 5)
print ((==.5) 5)
print ((<.5) 3)

# 与成员访问形式对称:`2.+` 是等右操作数,`+.2` 是等左操作数
d := 2.+
print (d 3)
ravel ""

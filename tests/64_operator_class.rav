# ===== 多运算符 + 自定义名 =====
Vec := class {
    init = () => { this.v = 10; this; }
    v: int = 0
    + := (x: int) => { v + x; }
    * := (x: int) => { v * x; }
    - := (x: int) => { v - x; }
}
a := Vec ()
print (a + 5)
print (a * 3)
print (a - 2)
# 运算符作变量
addFn := a.+
print (addFn 100)
# --- expected ---
# 15
# 30
# 8
# 110

C := class {
    init := () => { 0; this; }
    x: int = 10
}
a := C ()
b := a.Copy ()
b.x = 99
print (a.x)
print (b.x)
print (a.Fields ())
using "math.rav"
print (ValueType.Subtypes ())
a: Any = 5
print a
a = "changed"
print a
print (Math.e)
print (Math.cube 3)
print ("abc" + "def")
print ("abc" == "abc")
print ("abc" != "abd")
print (true == true)
print (true != false)
print (int == int)
print (int != string)
C := class {
    init := () => { 0; this; }
    core secret: int = 99
    show := () => { unsafe (); print secret; }
}
c := C ()
c.show ()
C := class {
    init := () => { 0; this; }
    check := () => {
        s := currentScope ()
        print (typeof s)
    }
}
c := C ()
c.check ()
s := currentScope ()
s.Define "x" int
p := s.Lookup "x"
p.set 42
print (p.get ())
s2 := s.Push ()
print (typeof s2)
d := s.Variables ()
print (d.Has "x")
System.Write "ab"
print "cd"
r := randint 1 10
assert (1 <= r && r <= 9) "randint out of range"
print "range ok"

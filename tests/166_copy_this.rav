# obj.Copy () 的副本里 this 要指向副本。
# 以前只有 with 这么绑(StepWith 里显式写),Copy() 漏了,于是副本里
# `this.v = n` 落到原对象上,而裸写 `v = n` 是对的——同一个副本两种行为。
# 现在两者共用一个 CopyObject。
C := class {
    init := () => { 0; }
    v: int = 1
    setThis := (n: int) => { this.v = n; }
    setBare := (n: int) => { v = n; }
    get := () => { v; }
}
c := C ()
c2 := c.Copy ()
c2.setThis 99
print (c.get ())
print (c2.get ())
c3 := c.Copy ()
c3.setBare 42
print (c.get ())
print (c3.get ())
# --- expected ---
# 1
# 99
# 1
# 42

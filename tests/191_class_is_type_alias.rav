# 没有单独的 Class 类型了:`class` 就是 `type` 的别名(同一个值)
# 用户类直接挂在 Type 下面,所以 `typeof Person` 和 `typeof int` 都是 Type。
print (class == type)
print (typeof type)
print (typeof class)
C := class { init = () => { 0; this; }; x: int = 1; }
print (typeof C)
print (typeof (C ()))
# 别名是同一个值,所以 type 也能建类(以前它被禁止建类)
D := type { init = () => { 0; this; }; y: int = 2; }
print ((D ()).y)
print (typeof D)
# 继承照旧:class Parent { ... } 走「参数是类型」那条分支
E := class C { init = () => { x = 9; this; } }
print ((E ()).x)
print (type.Parent ())
# --- expected ---
# true
# Type
# Type
# Type
# class
# 2
# Type
# 9
# Function

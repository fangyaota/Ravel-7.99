# `IKey` / `IDict`:字典的键操作**分两层**。
#
#   * 引擎那套叫 `SysGet` / `SysSet` / `SysHas` / `SysRemove` / `SysGetOr` —— 同步的 C#,
#     只吃**值类型**键(它够不着你写的 `Key`:调 Ravel 函数要推帧,而查表那一步还在
#     .NET 字典的内部,那儿更插不进帧);
#   * 日常敲的 `d.Get` / `d.Set` / `d.Has` / `d.Remove` / `d.GetOr` 是**库注入**的
#     (`lib/keys.rav` 的 `IDict` 接口槽):先把键规范成值类型、再转到 `Sys*` 上,
#     于是"内容一样的两个对象"是同一条。
#
# 名字腾出来是前提:类链上还占着 `Get` 的话,接口槽**够不着而且静默**(`TraitSlot` 的规矩)。

# ① 协议:每个值都有(`Key ()` = "我当键时等于什么";默认那把尺子只对值类型有话说)
print (5.Key ())
print ("a".Key ())
print ((Keys.Of 5) == 5)
print ((Keys.Of "a") == "a")
try { print ((Some 5).Key ()); } (e: Exception) => { print ("1: " + string e); }

# ② dict:键是值类型,相等就是值自己的
d := {}
d.Set 1 "int"
d.Set "1" "str"
d.Set 1.0 "float"
print (d.Count ())
print (d.Get 1)
print (d.Get "1")
print (d.Get 1.0)
print (d.Has 2)
print (d.Keys ())
print ({1: "a"}.Get 1)
print (d is IDict)
try { d.Set ([1 2]) "x"; } (e: Exception) => { print ("2: " + string e); }
try { print (d.Get 999); } (e: Exception) => { print ("3: " + string e); }

# ③ 字面量的键是**表达式**:`{"a": 1}` 而不是 `{a: 1}`(那个 `a` 是变量)
print {"a": 1}
print {1: 2}
print {1 2}
k := "kk"
print {k: 1}
n := 7
print {n: 1}
print {"a" + "b": 1}
try { print {zz: 1}; } (e: Exception) => { print ("4: " + string e); }

# ④ 登记 = "这个类型自己讲了怎么当键"这个类型层面的事实(内建那几个值类型也登记过)
print (5 is IKey)
print ("a" is IKey)
print ([1 2] is IKey)
print (IKey.GetImplementors ())

# ⑤ 值语义:类里写一条 `Key`(它盖掉 `Object` 那条),再 impl 登记
Rec ::= class {
    X: int = 0
    N: string = ""
    init = (x: int n: string) => { X = x; N = n; this; }
    Key := () => { X; }
}
impl (IKey Rec {
    ()
})
print ((Rec 1 "a") is IKey)
print (Rec.GetImplements ())
print (Keys.Of (Rec 7 "x"))

d2 := {}
d2.Set (Rec 1 "甲") "one"
d2.Set (Rec 2 "乙") "two"
print (d2.Get (Rec 1 "别的"))
print (d2.Has (Rec 2 "别的"))
print (d2.Count ())
print (d2.Keys ())
print (d2.GetOr (Rec 9 "z") "缺")
print (d2.Remove (Rec 1 "别"))
print (d2.Has (Rec 1 "别"))

# 引擎那套(raw)不认对象 —— 它只吃值类型
try { print (d2.SysGet (Rec 1 "别")); } (e: Exception) => { print ("5: " + string e); }

# 没写 `Key` 的类型:引擎那句(指向"在类里写一条 Key")
B ::= class {
    X: int = 0
    init = (x: int) => { X = x; this; }
}
try { d2.Get (B 1); } (e: Exception) => { print ("6: " + string e); }

# `Key` 交回的不是值类型:库这层当场说清楚
C ::= class {
    X: int = 0
    init = (x: int) => { X = x; this; }
    Key := () => { [X]; }
}
try { Keys.Of (C 1); } (e: Exception) => { print ("7: " + string e); }

# ⑥ `Keyed`:以任意值为键、还能把**原对象**拿回来(普通 dict 里只剩规范键)
t := Keyed ()
t.Set (Rec 1 "甲") "one"
t.Set (Rec 2 "乙") "two"
print (t is IDict)
print (t.Get (Rec 1 "丙"))
print (t.Has (Rec 2 "丁"))
print (t.Count ())
print ((t.Keys ()).Map ((r: Rec) => { r.N; }))
print (t.Values ())
print (t.GetOr (Rec 5 "x") "缺")
print (t.Remove (Rec 1 "戊"))
print (t.Count ())
print ((t.Keys ()).Map ((r: Rec) => { r.N; }))
t.Clear ()
print (t.Count ())
print "end"
# --- expected ---
# 5
# a
# true
# true
# 1: Key: Option 没有默认的键（只有值类型有：数、字符串）。要拿它当键，就在类里写一条 Key，交回一个值类型的键
# 3
# int
# str
# float
# false
# [1 1 1]
# a
# true
# 2: Key: List 没有默认的键（只有值类型有：数、字符串）。要拿它当键，就在类里写一条 Key，交回一个值类型的键
# 3: 键不存在: 999
# {a: 1}
# {1: 2}
# {1 2}
# {kk: 1}
# {7: 1}
# {ab: 1}
# 4: 未定义的变量 'zz'
# true
# true
# false
# [String Char BigFraction Fraction BigInt Float Integer]
# true
# [IKey BaseInterface]
# 7
# one
# true
# 2
# [1 2]
# 缺
# true
# false
# 5: dict.SysGet 的键得是值类型（数 / 字符串），得到 Rec
# 6: Key: B 没有默认的键（只有值类型有：数、字符串）。要拿它当键，就在类里写一条 Key，交回一个值类型的键
# 7: `Key` 要交回一个值类型的键（数 / 字符串），得到 List
# true
# one
# true
# 2
# [甲 乙]
# [one two]
# 缺
# true
# 1
# [乙]
# 0
# end

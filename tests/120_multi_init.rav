# 多 init：根据参数匹配第一个合适的
Multi := class {
    init with_val := (v: int) => {
        x = v
        y = 0
    }
    init empty := () => {
        x = 0
        y = 0
    }
    x: int = 0
    y: int = 0
}
a := Multi 10
b := Multi ()
print (a.x)
print (a.y)
print (b.x)
print (b.y)
# --- expected ---
# 10
# 0
# 0
# 0

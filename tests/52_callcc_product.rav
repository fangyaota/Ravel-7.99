product := (list: list) => {
    callcc (return: function) => {
        result := 1
        i := 0
        while {
            i < list.Count ()
        } {
            val := list.At i
            if {
                val == 0
            } {
                return 0
            } {
                0
            }
            result = result * val
            i += 1
        }
        result
    }
}
print (product [2 3 4])
print (product [2 0 4])
# --- expected ---
# 24
# 0

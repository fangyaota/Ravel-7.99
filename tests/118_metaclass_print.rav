# metaclass:在 init 里挂钩建类过程
# `parentInit parent body` 就是"走默认那套建类逻辑",它返回建出来的那个类。
LoggingMeta ::= class type {
    private parentInit := init;
    init = (parent: type body: function) => {
        print "meta: creating..."
        r := parentInit parent body
        print "meta: done"
        r
    } | (body: function) => {
        print "meta: creating..."
        r := parentInit object body
        print "meta: done"
        r
    }
}
M2 := LoggingMeta object {
    init = () => { 0; this; }
    name: string = "hello"
}
m := M2 ()
print (m.name)
# --- expected ---
# meta: creating...
# meta: done
# hello

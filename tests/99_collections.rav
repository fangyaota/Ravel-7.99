# 集合/字典/列表(合并 99-103/135/62)
s := {1 2 3}
print (s.Count ())
print (typeof s)
s = {1 2 3}
s.Add 4
print (s.Count ())
s.Remove 2
print (s.Count ())
print (s.Contains 1)
print (s.Contains 2)
d := {"a": 1 "b": 2 "c": 3}
print (d.Count ())
print (typeof d)
print (d.Has "a")
print (d.Has "x")
d = {"x": 10 "y": 20}
print (d.Get "x")
print (d.Get "y")
d.Set "z" 30
print (d.Get "z")
print (d.Count ())
a := 1
b := 2
s = {a b a + b}
print (s.Count ())
print (s.Contains 1)
print (s.Contains 3)
d = {"a": 1 "b": 2}
ks := d.Keys ()
vs := d.Values ()
print (ks.Count ())
print (vs.Count ())
xs := [1 2 3]
xs.Add 4
xs.Add 5
print xs
xs.Remove 1
print xs
xs.Insert 2 99
print xs
xs.Set 0 100
print xs
print (xs.Count ())
print (xs.At 0)
# --- expected ---
# 3
# Set
# 4
# 3
# true
# false
# 3
# Dict
# true
# false
# 10
# 20
# 30
# 3
# 3
# true
# true
# 2
# 2

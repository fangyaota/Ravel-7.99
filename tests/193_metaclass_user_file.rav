# 用户手写的元类(原样收进来,只动了两处,见下)
#
# 相对 myMetaClass.rav 的两处改动:
#   1. `parent: Type` → `parent: type` —— 大写 `Type` 不是全局别名,
#      predefined.rav 只给小写别名(`type := System.Type`)。
#   2. `print` 挪到 `parentInit` 之前 —— 构造**交出 init 的返回值**,
#      而以 `print` 收尾时块的值是 `()`。要"建完再打"就用中间变量(见 118)。
myMetaclass := class type {
    private parentInit := init;
    init = (parent: type body: function) => {
        print "created by myMetaclass"
        parentInit parent body
    } | (body: function) => {
        print "created by myMetaclass"
        parentInit object body
    }
}
MyClass ::= myMetaclass { init := () => { 0; this; }; x: int = 42; }
c := MyClass ()
print (c.x)
print (typeof MyClass)          # 元类是 myMetaclass —— 它用 `:=` 建的、没名字,所以显示 class
print (typeof c)                # 实例的类型是它的类
print (typeof MyClass.block)    # 类体装上了
print (typeof myMetaclass)
# --- expected ---
# created by myMetaclass
# 42
# class
# MyClass
# Block
# Type

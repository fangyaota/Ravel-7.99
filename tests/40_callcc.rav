# callcc 单发/多发/生成器/try(合并 40/41/42/50/51/52/85/86/87/88/89/94)
result := callcc (k: function) => {
    k 42
}
print result
result := callcc (k: function) => {
    k (1 + 2)
}
print result
F := (x: int) => {
    callcc (return: function) => {
        if {
            x < 0
        } {
            return 0
        } {
            return x
        }
    }
}
print (F 10)
print (F (-5))
F := (x: int) => {
    callcc (exit: function) => {
        i := 1
        while {
            true
        } {
            if {
                i > x
            } {
                exit i
            } {
                0
            }
            i += 1
        }
        0
    }
}
print (F 5)
X := [1 2 3 4 5]
result := callcc (found: function) => {
    i := 0
    while {
        i < X.Count ()
    } {
        val := X.At i
        if {
            val > 3
        } {
            found val
        } {
            0
        }
        i += 1
    }
    0
}
print result
product := (list: list) => {
    callcc (return: function) => {
        result := 1
        i := 0
        while {
            i < list.Count ()
        } {
            val := list.At i
            if {
                val == 0
            } {
                return 0
            } {
                0
            }
            result = result * val
            i += 1
        }
        result
    }
}
print (product [2 3 4])
print (product [2 0 4])
# 统一语义:续延 = callcc 之后的剩余计算。调用它 → 丢弃当前帧链,把值当作
# callcc 的返回值、从捕获点继续(所以 callcc 之后的语句会被重新执行)。
saved := (x: int) => { x; }
trace := []
n := 0
n = 1 + callcc (k: function) => {
    saved = k
    0
}
trace.Add n
if { n < 10; } { saved 10; } { 0; }
print trace

# 续延可反复调用:每次带新值从捕获点重来(靠守卫终止)
seen := []
m := 0
m = callcc (k: function) => {
    saved = k
    0
}
seen.Add m
if { m < 3; } { saved (m + 1); } { 0; }
print seen

# 丢弃当前链 → 续延可以当跳转用,帧链不随迭代增长
i := 0
total := 0
again := (x: int) => { x; }
callcc (k: function) => { again = k; }
i += 1
total += i
if { i < 5; } { again 0; } { 0; }
print total

result := 0
Ex.Try {
    Ex.Throw (Exception "boom")
    result = 1
} (e: Exception) => {
    result = 99
}
print result
result := callcc (k: function) => {
    k (k 3)
}
print result

# 帧链长度不随迭代增长:每次 loop 0 都丢弃当前链。若退化成 O(N) 帧链,
# 50 万轮 ≈ 250 万常驻帧会撞穿测试的 256MB 堆上限,这一行就跑不到 500000。
big := 0
loop := (x: int) => { x; }
callcc (k: function) => { loop = k; }
big += 1
if { big < 500000; } { loop 0; } { 0; }
print big
# --- expected ---
# 42
# 3
# 10
# 0
# 6
# 4
# 24
# 0
# [1 11]
# [0 1 2 3]
# 15
# 99
# 3
# 500000

# 拷贝要连 attrs 一起带。以前 CopyScope 只复制值和类型约束,属性全丢了,
# 于是副本上 `by` 属性的赋值不走 setter(变成给 Property 本身赋 Integer,报类型错),
# readonly / private / core 也等于被副本绕过。
C := class {
    init := () => { 0; this; }
    _v: int = 1
    by v := property (() => { _v; }) ((n: int) => { _v = n; })
    readonly w: int = 5
}
c := C ()
print (c.v)
c2 := with c { 0; }
c2.v = 10
print (c.v)
print (c2.v)
print (c2.w)
print (c2.Fields ())
# --- expected ---
# 1
# 1
# 10
# 5
# [init _v v w ToString Copy Fields]

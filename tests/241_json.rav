# 内置 `Json` 类(Newtonsoft.Json):**先看再转**。
#
#   `Json v`            原生值(dict / list / 值类型 / ())→ Json
#   `Json.FromString s` 字符串 → Json(唯一的解析入口)
#   `j.Extract ()`      Json → 原生值(那一步是**显式**的,不是解析时被迫选一次)
#
# 留着那棵树的好处:JSON 的 null、整数与小数的写法、键的顺序都还在,想问就问
# (Kind / IsNull / Get / At / Count / Keys),想转再转。写回去用 `j.Text ()`(紧凑)或 `j.Text n`。

j := Json {"a": [1 2.5 ()] "b": {"c": true} "s": "你好"}
print (typeof j)
print (j)                                   # print 直接给紧凑 JSON
print (j.Kind ())
print ((j.Get "a").Kind ())
print ((j.Get "a").Count ())
print (j.Keys ())                           # 保 JSON 里的原顺序

# 一层层往下看,到叶子再 Extract
print (((j.Get "a").At 0).Extract ())
print (((j.Get "a").At 1).Extract ())
print (((j.Get "a").At 2).IsNull ())        # 要问"是不是 null"就在 Json 这层问
print (((j.Get "a").At 2).Extract ())       # null 转出来是 ()
print (((j.Get "b").Get "c").Extract ())
print ((j.GetOr "zz" 0).Kind ())            # 没有就给替代值(也包成 Json)
print ((j.GetOr "s" 0).Extract ())

# 整棵树一次转成原生:dict / list / 数 / string / bool / ()
d := j.Extract ()
print (typeof d)
print (d.Get "a")
print ((d.Get "b").Get "c")
print (d.Get "s")

# 标量也能包:Json 里字符串是带引号的,数就是数
print (Json 5)
print ((Json 5).Extract ())
print (Json "x")
print ((Json 3.5).Extract ())

# 写回文本:紧凑 / 缩进 n 格
print ((Json [1 2 3]).Text ())
print ((Json {"a": 1 "b": [2 3]}).Text 2)

# 解析:空白无所谓,数字按"装得下 int 就 int、太大退 bigint、带小数/指数是 float"
print (Json.FromString "{\"x\": 1}")
print ((Json.FromString "[1,2,3]").At 2 @ .Extract ())
print ((Json.FromString "1e3").Extract ())
print ((Json.FromString "12345678901234567890").Extract ())
print (typeof ((Json.FromString "12345678901234567890").Extract ()))
print (Json.FromString "  \"текст\"  ")
print ((Json.FromString "\"é\"").Extract ())
print (Json.FromString "null")
print ((Json.FromString "null").Extract ())

# 日期样的字符串**不许**被悄悄变成日期(DateParseHandling.None)
print (Json.FromString "\"2020-01-01\"")
print (typeof ((Json.FromString "\"2020-01-01\"").Extract ()))

# 注解是 Json 时,原生值直接转换过去
x: Json = {"k": true}
print (x)

# 坏输入说人话(带行列)
try { print (Json.FromString "{bad}"); } (e: Exception) => { print ("1: " + string e); }
try { print (Json.FromString "1 2"); } (e: Exception) => { print ("2: " + string e); }
try { print ((Json {"d": 1}).Get "zz"); } (e: Exception) => { print ("3: " + string e); }
try { print ((Json [1]).At 5); } (e: Exception) => { print ("4: " + string e); }

# JSON 里没有的类型:当场报错,不悄悄降级
Own ::= class {
    v: int = 1
}
try { print (Json (Own ())); } (e: Exception) => { print ("5: " + string e); }
try { print (Json (fraction 1 2)); } (e: Exception) => { print ("6: " + string e); }
# 实例方法挂在**类**上,靠 forInstance + private 分两侧:实例读得到,类对象那一侧读不到
# (该报「没有方法」,而不是解析成"类上的方法"再把 self 强转炸掉)
try { print (Json.Kind); } (e: Exception) => { print ("7: " + string e); }
print ((Json 5).Kind ())
print (Json.Fields ())                 # 类对象身上:这一侧读得到的那些 + 元类链
                                       # (九个实例方法带 private → 类这一侧读不到,也就不列)
j2 := Json 2
j2.tag := 99                           # 值自己的那层留给用户挂的东西:只影响这一个
print (j2.tag)
try { print (j.tag); } (e: Exception) => { print ("8: " + string e); }
# `Copy ()` —— 浅拷那棵树、拷一份成员表(新加一个 ObjectVal record 都得记着去
# `CopyValue` 里加一条,不然会退化成普通对象、数据全丢)
c := j.Copy ()
print (c)
print ((c.Extract ()).Get "a")
print (c is Json)
print "end"

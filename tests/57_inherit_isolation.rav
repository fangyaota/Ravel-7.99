Animal := class {
    init ctor := () => { 0; }
    name: string = ""
}
Dog := class Animal {
    init ctor := () => { base = Animal (); name = "hacked"; }
}
Dog2 := class Animal {
    init ctor := () => { base = Animal (); }
}
d := Dog ()
d2 := Dog2 ()
print (d.name)
print (d2.name)
# --- expected ---
# hacked

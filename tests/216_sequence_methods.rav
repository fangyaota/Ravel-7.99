# 容器上的**序列方法** —— 三种容器共用的一份(BuiltinClasses.Sequences.cs),
# 也就是将来 `IEnumerable` 那一层的落点:它们只跟元素顺序有关,跟容器是什么无关。
#
# 名字照 C# 的集合 / Linq API 起,语义也对齐:
# - 变换与查询**交回新的 list**(今天"一串值"就是 list),要 Set 自己 `ToSet ()`;
# - 顺序类的按**枚举顺序**(Set/Dict 的顺序是枚举器给的,别当插入顺序用);
# - 比大小一律走 `<`(`Min`/`Max`/`Sort`/`SortBy` 一个口径),比不了**报错**不给假答案;
# - 字典的"元素"是**值**(按键找用 `Has` / `Keys ()`)。
#
# 收函数的那些(Each/Map/Where/Fold/All/Any/Find/SortBy)是控制帧 —— 原生闭包调不了
# Ravel 函数,所以成员值是个 `SeqMethod`(读出来绑好接收者再推帧)。

xs := [3 1 2 2]

# ---- 不收函数的:个数 / 查询 / 切片 / 聚合 ----
print (xs.Count ())
print (xs.IsEmpty ())
print (xs.Any ())
print (xs.Contains 2)
print (xs.First ())
print (xs.Last ())
print (xs.Distinct ())
print (xs.Reverse ())
print (xs.Take 2)
print (xs.Skip 2)
print (xs.Concat [9 9])
print (xs.Sum ())
print (xs.Min ())
print (xs.Max ())
print (xs.Join "-")
print (xs.Sort ())
print (xs.IndexOf 2)
print (xs.RemoveAt 0)      # 和 `xs.Remove 0` 是一件事(名字对齐 C# 的 List.RemoveAt)
print xs
xs.AddRange [7 8]
print xs
print ([].IsEmpty ())
print ([].Sum ())          # 空的和给 0(C# 的 Sum() 也是这样)
print ([10 20].Join ",")
xs.Clear ()
print (xs.Count ())

# ---- 收函数的:每个元素调一次 ----
ys := [1 2 3 4]
ys.Each (x: int) => { print ("each " + string x); }
print (ys.Map (x: int) => { x * 10; })
print (ys.Where (x: int) => { x % 2 == 0; })
print (ys.Fold 0 (acc: int x: int) => { acc + x; })
print (ys.All (x: int) => { x > 0; })
print (ys.All (x: int) => { x > 2; })
print (ys.Any (x: int) => { x > 3; })
print (ys.Any (x: int) => { x > 9; })
print (ys.Find (x: int) => { x > 2; })
print ([5 2 9 1].SortBy (x: int) => { 0 - x; })   # 按键降序,稳定

# ---- 集合代数(Set 独有) ----
s := {1 2 3}
print (s.Union {3 4})
print (s.Intersect {2 3 9})
print (s.Except {1})
print (s.IsSubsetOf {1 2 3 4})
print (s.Contains 3)
print (s.Max ())
print (s.Where (x: int) => { x >= 2; })

# ---- 字典:元素是值 ----
d := {a: 3 b: 1 c: 2}
print (d.Count ())
print (d.Min ())
print (d.Max ())
print (d.Join ",")
print (d.Contains 2)
print (d.HasValue 1)
print (d.GetOr "a" 0)
print (d.GetOr "zz" 0)
print (d.Remove "a")
print (d.Count ())
print (d.Map (v: int) => { v * 100; })
print (d.Keys ())

# ---- 边界与错误:空容器、比不了、谓词不是 bool ----
Ex.Try { print (ys.Where (x: int) => { 1; }); } (e: Exception) => { print ("1: " + string e); }
Ex.Try { print (ys.Find (x: int) => { false; }); } (e: Exception) => { print ("2: " + string e); }
Ex.Try { print (ys.Any 5); } (e: Exception) => { print ("3: " + string e); }
Ex.Try { print ([].First ()); } (e: Exception) => { print ("4: " + string e); }
Ex.Try { print ([].Min ()); } (e: Exception) => { print ("5: " + string e); }
Ex.Try { print ([1 "a"].Sort ()); } (e: Exception) => { print ("6: " + string e); }
Ex.Try { print ([1 "a"].Max ()); } (e: Exception) => { print ("7: " + string e); }
Ex.Try { print ([1 2].Concat 5); } (e: Exception) => { print ("8: " + string e); }
print ([].Map (x: int) => { x; })
print ([].Fold 7 (acc: int x: int) => { acc + x; })
print ([].Any ())
print ([].All (x: int) => { false; })

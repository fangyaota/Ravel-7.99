# 单行块要用 `;` 收尾 —— lambda 体也不例外
# `;` 和换行都是 Newline token,它是「这是块」的标记:没换行时 `{ x }` 是集合、
# `{ a: 1 }` 是字典,只有见到 Newline 才当块。这条规则不分位置,
# `=>` 后面的 lambda 体一样适用。
double := (x: int) => { x * 2; }
add ::= (x: int y: int) => { x + y; }
init := () => { 42; }
print (double 5)
print (add 3 4)
print (init ())
C := class {
    init := () => { 0; this; }
    probe := () => { print "hi"; }
}
c := C ()
c.probe ()
# 表达式位置同理
print ({ 1 2 })
# --- expected ---
# 10
# 7
# 42
# hi
# {1 2}

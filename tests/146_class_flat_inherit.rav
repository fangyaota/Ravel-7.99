# 平铺继承:各层类体的字段落在同一个作用域,不做链式查找。
# **同名就是错**(`:=` 是定义不是覆盖)—— 子类再声明父类已声明过的字段,实例化时当场报错。
# 1) 子类没声明的字段 → 从父类那层可见;子类自己声明的另起一个名字
Base := class {
    init = () => { 0; this; }
    x: int = 1
    y: int = 5
}
Child := class Base {
    init = () => { 0; this; }
    x2: int = 100
}
c := Child ()
print (c.x)
print (c.x2)
print (c.y)

# 同名字段 → 报错(建类时不报,实例化那一刻各层类体跑进同一个作用域才撞上)
Bad := class Base {
    x: int = 100
}
try { Bad (); } (e: Exception) => { print ("1: " + string e); }
# 2) 父类 init 不自动调用:父类 init 里的赋值不生效,初始值看字段声明
Deferred := class {
    init = () => { v = 10; this; }
    v: int = 0
}
Child2 := class Deferred { init = () => { 0; this; } }
c2 := Child2 ()
print (c2.v)

# 3) 只有最具体层的 init 被调用;祖先的 init 不跑
A := class {
    init = () => { a = 1; this; }
    a: int = 0
}
B := class A {
    init = () => { b = 2; this; }
    b: int = 0
}
obj := B ()
print (obj.a)
print (obj.b)
# --- expected ---
# 1
# 100
# 5
# 1: 'x' 在这个作用域里已经定义过 —— `:=` 是定义不是覆盖（要改值/覆盖继承来的成员，用 `=`）
# 0
# 0
# 2

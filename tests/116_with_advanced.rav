# with 基础：复制并修改
Point := class {
    init ctor := () => { 0; }
    x: int = 0
    y: int = 0
}
p := Point ()
p.x = 1
p.y = 2

q := with p { x = 10; }
print (p.x)
print (q.x)
print (q.y)

# with 中 := 不影响副本
r := with p {
    x = 100
    tmp := 999
}
print (r.x)

# 继承类 with
Animal := class {
    init ctor := () => { 0; }
    name: string = ""
}
Dog := class Animal {
    init ctor := () => {
        base.init ()
        breed = ""
    }
    breed: string = ""
}
dog := Dog ()
dog.name = "Rex"
dog.breed = "Husky"
dog2 := with dog { name = "Max"; }
print (dog.name)
print (dog2.name)
print (dog2.breed)
# --- expected ---
# 1
# 10
# 2
# 100
# Rex
# Max
# Husky

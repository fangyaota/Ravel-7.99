# metaclass: typeof 检查链
MyMeta ::= class class {
    init := (parent: type block: function) => {
        base.init parent block
        this
        this;
    }
}
A ::= MyMeta object { init := () => { 0; this; }; }
B ::= class { init := () => { 0; this; }; }
# metaclass 创建的类
print (typeof A)
# 普通类
print (typeof B)
# metaclass 本身
print (typeof MyMeta)
# --- expected ---

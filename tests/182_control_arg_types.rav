# 控制内建的参数类型不对:报 Ravel 错误,不要抛 C# 的 InvalidCastException
# 从前控制帧一律 `(BlockVal)cf.Args.At(1)` 硬转,`with 5 6` 直接
# InvalidCastException —— 它不是 RuntimeException,Ravel 的 try 接不住,程序被打掉。
using "try.rav"
Ex.Try { with 5 6; } (e: Exception) => { print ("1: " + string e); }
Ex.Try { with 5 {}; } (e: Exception) => { print ("2: " + string e); }
Ex.Try { using 5; } (e: Exception) => { print ("3: " + string e); }
Ex.Try { eval 5; } (e: Exception) => { print ("4: " + string e); }
# 正常调用照常
C := class {
    init := () => { 0; this; }
    x: int = 7
}
# 注意 (C ()) 的括号:with 收两个参数,写成 `with C () {...}` 会变成三参
w := with (C ()) { x = 99; }
print w.x
# --- expected ---
# 1: with 的第 2 个参数需要代码块，得到 Integer
# 2: with 的第 2 个参数需要代码块，得到 Dict
# 3: using 的第 1 个参数需要 string，得到 Integer
# 4: eval 的第 1 个参数需要 string，得到 Integer
# 99

# `Range` —— **内置值类型**:一个区间。四种写法(那一对括号各带**一半**的意思):
#
#     [1..3]   两端都含          (3..5)   两端都不含
#     [1..5)   左闭右开          (1..5]   左开右闭
#
# 打印出来就是写出来那个样子(`Text ()` 同一个);它同时也是一个 `IEnumerable`
# (impl 在 lib/iterator.rav,枚举走生成器的光标、**惰性**),所以整套方法白拿。
# 两端都得是 int —— 别的类型当场报错。

# ---- 四种开闭 ----
lo := [1..3]
print lo
print (lo.ToList ())
half := [1..5)
print half
print (half.ToList ())
allOpen := (3..5)
print allOpen
print (allOpen.ToList ())
rightOnly := (1..5]
print rightOnly
print (rightOnly.ToList ())

# ---- 端点 / 个数 / 包含 ----
print (lo.Start ())
print (lo.End ())
print (lo.Count ())
print (allOpen.Count ())
print ((3..5).Count ())          # 两端都不含 → 只剩 4
print ((3..3).Count ())          # 空
print ([3..3].Count ())          # 只含 3
print (lo.Contains 1)
print (lo.Contains 3)
print (lo.Contains 4)
print (allOpen.Contains 3)
print ((5..1).IsEmpty ())
print (lo.IsEmpty ())
print (lo.Text ())

# ---- 空的那几种:开区间套同样的两端、或者起点在后 ----
print ([3..3].ToList ())
print ((3..3).ToList ())
print ((5..1).ToList ())
print ([5..1].ToList ())

# ---- 值语义:类型、按内容比 ----
print (typeof lo)
print (lo is Range)
print (lo is ValueType)
print (lo == [1..3])
print (lo == [1..4])
print (lo != allOpen)

# ---- 它也是一串:IEnumerable 那一整套白拿 ----
seen := []
foreach [1..4] (i: int) => { seen.Add i; }
print seen
foreach (1..4) (i: int) => { seen.Add i; }
print seen
print (([1..4]).Sum ())
sq := ([1..4]).Map ((i: int) => { i * i; })
print (sq.ToList ())
print (([1..4]).Any ((i: int) => { i > 3; }))
thirds := ([1..10]).Where ((i: int) => { (i % 3) == 0; })
print (thirds.ToList ())
print (([1..5]).Join "-")
# 惰性那两条:要是先铺成表就回不来了(100 万 / 10 亿个)
print (([1..1000000]).First ())
big := ([1..1000000000]).Take 3
print (big.ToList ())
print (([1..1000000000]).Count ())   # 这条走引擎那份 O(1) 的,不数

# ---- 切一段:`Slice` 收区间(字符串那条 `Slice` 也认,两种写法都行)----
xs := [10 20 30 40 50]
print (xs.Slice [1..3])
print (xs.Slice [1..4))
print (xs.Slice (0..2])
print ((xs.Slice (3..3)).ToList ())
print ((xs.Slice [9..9]).ToList ())          # 越过尾巴不报错,空的
tail := ([1..1000000000]).Slice [5..7]       # 惰性:后端是无限的
print (tail.ToList ())
# 头一个 / 末一个**元素**(不是那两个端点 —— 开区间的端点在区间外),O(1)
print ([1..9].First ())
print ([1..9].Last ())
print ((1..9).First ())
print ((1..9).Last ())

# ---- 普通列表照旧:`..` 才算区间 ----
print [1 2 3]
print [[1..3]]
lst := [1 2 3]
print ((lst.Count ()) + (lo.Count ()))

# ---- 两端不是 int:当场报错 ----
try { [1.5..3]; } (e: Exception) => { print ("1: " + string e); }
try { ["a"..3]; } (e: Exception) => { print ("2: " + string e); }
print "end"
# --- expected ---
# [1..3]
# [1 2 3]
# [1..5)
# [1 2 3 4]
# (3..5)
# [4]
# (1..5]
# [2 3 4 5]
# 1
# 3
# 3
# 1
# 1
# 0
# 1
# true
# true
# false
# false
# true
# false
# [1..3]
# [3]
# []
# []
# []
# Range
# true
# true
# true
# false
# true
# [1 2 3 4]
# [1 2 3 4 2 3]
# 10
# [1 4 9 16]
# true
# [3 6 9]
# 1-2-3-4-5
# 1
# [1 2 3]
# 1000000000
# [20 30 40]
# [20 30 40]
# [20 30]
# []
# []
# [6 7 8]
# 1
# 9
# 2
# 8
# [1 2 3]
# [[1..3]]
# 6
# 1: Range 的两端需要 int，得到 Float 与 Integer
# 2: Range 的两端需要 int，得到 String 与 Integer
# end

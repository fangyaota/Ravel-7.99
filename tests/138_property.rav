# property C# factory
using "try.rav"
C := class {
    init := () => { this._val = 0; this; }
    _val: int = 0
    by val := property (() => { _val; }) ((v: int) => { _val = v; })
    get := () => { val; }
}
c := C ()
c.val = 99
print (c.get ())

# 赋值交出去的值:by 属性那条一直是新值,现在普通变量/字段也统一成新值(tests/148)
print (c.val = 7)
print (c.get ())
print (c._val)

# `by` 的值必须由 `property getter setter` 造。标了 by 却给别的东西,四条读写路
# 从前各有各的下场:`d.bad` 报「没有方法 'Get'」,而**裸读**会把那个值悄悄交出去、
# **裸写**更是什么都不发生。现在四条路报同一句话。
D ::= class {
    init := () => { 0; this; }
    by bad := 5
    read := () => { bad; }
    write := (q: int) => { bad = q; }
}
d := D ()
Ex.Try { d.bad; } (e: Exception) => { print ("1: " + string e); }
Ex.Try { d.bad = 1; } (e: Exception) => { print ("2: " + string e); }
Ex.Try { d.bad += 1; } (e: Exception) => { print ("3: " + string e); }
Ex.Try { d.read (); } (e: Exception) => { print ("4: " + string e); }
Ex.Try { d.write 1; } (e: Exception) => { print ("5: " + string e); }

# 例外只有 `default`:它是**属性的默认值**(一对什么都不做的 getter/setter,见 tests/212),
# 槽里于是有个能读能写、只是都不做事的属性。别的非 property 值(上面那些 bad)照旧报错。
DL ::= class {
    init := () => { 0; this; }
    by dl: int = default
}
dl := DL ()
print (dl.dl)
print (dl.dl = 1)
print (dl.dl)

# `by a: int = …` 的注解管的是**写进来的值**(和普通字段一个道理):
# 从前这条注解会被拿去比那个 PropertyVal,一实例化就报「无法将 Property 赋值给 Integer」。
E ::= class {
    init := () => { 0; this; }
    _n: int = 1
    _f: float = 1.0
    _s: object = ""
    by n: int = property (() => { _n; }) ((q: int) => { _n = q; })
    by loose := property (() => { _s; }) ((q: object) => { _s = q; })
    by lying: string = property (() => { 42; }) ((q: object) => { 0; })
    by m: int = property (() => { _f; }) ((q: object) => { _f = q; })
}
e := E ()
print (e.n)
e.n = 7
print (e.n)
print (e.n = 9)
Ex.Try { e.n = "str"; } (e2: Exception) => { print ("6: " + string e2); }
Ex.Try { e.m += 1; } (e2: Exception) => { print ("7: " + string e2); }
# 没写注解 = 写什么都行(`:=` 定义时那个约束是 Any,不是 Property)
e.loose = "anything"
print (e.loose)
# 读那侧不管:注解约束的是"谁能写进来"(Ravel 从不检查函数返回什么,getter 也一样)
print (e.lying)

# `by n = X` 换掉**槽里的那份 property**(不走旧 setter、也不查类型约束):
# 和 `n = v`(过 setter)、`by n := property …`(定义槽)是三件事。
OldSet := 0
NewSet := 0
S ::= class {
    init := () => { _n = 1; this; }
    _n: int = 1
    by n: int = property (() => { _n; }) ((q: int) => { OldSet += 1; _n = q; })
    swap := () => {
        by n = property (() => { _n * 100; }) ((q: int) => { NewSet += 1; _n = q; })
    }
}
s := S ()
s.n = 5
print (s.n)
print ("换之前 旧 " + string OldSet + " 新 " + string NewSet)
s.swap ()
print (s.n)
s.n = 7
print (s.n)
print ("换之后 旧 " + string OldSet + " 新 " + string NewSet)
print (s.Fields ())
# 目标必须是个 by 属性;找不到变量也报出来
plain := 1
Ex.Try { by plain = 2; } (e2: Exception) => { print ("8: " + string e2); }
Ex.Try { by nope = 2; } (e2: Exception) => { print ("9: " + string e2); }

# `by a` / `by a.x`:取**槽里的 property 本身**,不过 getter(和 `by a = X` 对称的那一半)。
# 拿到手就是个普通值 —— 能存进表里、传给别的函数,还能自己 `.Get ()` / `.Set v`。
GetCalls := 0
P ::= class {
    init := () => { _v = 1; this; }
    _v: int = 1
    by v := property (() => { GetCalls += 1; _v; }) ((q: int) => { _v = q; })
}
pp := P ()
p1 := by pp.v
print p1
print ("取完 getter 被调了 " + string GetCalls + " 次")
p1.Set 9
print (pp.v)
print (by pp.v == p1)
Bag := []
Bag.Add (by pp.v)
print ((Bag.At 0).Get ())
print ("至此 getter 被调了 " + string GetCalls + " 次")
Ex.Try { print (by pp._v); } (e2: Exception) => { print ("10: " + string e2); }
Ex.Try { print (by plain); } (e2: Exception) => { print ("11: " + string e2); }

# `by a.x = X`:换**别的对象**上的槽(和取槽那边的 `by a.x` 对称,同一个槽路径)
Old2 := 0
New2 := 0
Q ::= class {
    init := () => { _q = 1; this; }
    _q: int = 1
    by q: int = property (() => { _q; }) ((v: int) => { Old2 += 1; _q = v; })
}
qq := Q ()
R ::= class {
    init := () => { 0; this; }
    swapOn := (o: object) => {
        by o.q = property (() => { 1000; }) ((v: int) => { New2 += 1; })
    }
}
r := R ()
print (qq.q)
r.swapOn qq
print (qq.q)
qq.q = 5
print ("旧 " + string Old2 + " 新 " + string New2)
Ex.Try { by qq._q = property (() => { 1; }) ((v: int) => { 0; }); } (e2: Exception) => { print ("12: " + string e2); }
Ex.Try { by qq.nope = property (() => { 1; }) ((v: int) => { 0; }); } (e2: Exception) => { print ("13: " + string e2); }

# `by a.x := X` 在**那个对象上建槽**(成员不存在也行)—— `:=` 定义 / `=` 换,
# 和语言里别处一个规矩;所以 `=` 那条撞上不存在的成员才报错(上面那条 13)
T ::= class { init := () => { 0; this; }; }
t := T ()
by t.added := property (() => { 42; }) ((v: int) => { 0; })
print (t.added)
print (t.Fields ())
print (by t.added)
# `=` 那边的正例:槽已经在了,换掉它
by t.added = property (() => { 43; }) ((v: int) => { 0; })
print (t.added)

# readonly 对 by 槽也管:赋值走的是 setter(不经过 `Variable.Assign`),
# 漏了的话"只读"在属性上就是句空话。`by` 那条路一个都不放过:赋值/复合赋值/换槽。
Ro ::= class {
    init := () => { _r = 1; this; }
    _r: int = 1
    readonly by r := property (() => { _r; }) ((v: int) => { _r = v; })
    readonly by d: int = default
}
ro := Ro ()
print (ro.r)
Ex.Try { ro.r = 9; } (e2: Exception) => { print ("14: " + string e2); }
Ex.Try { ro.r += 1; } (e2: Exception) => { print ("15: " + string e2); }
Ex.Try { by ro.r = property (() => { 1; }) ((v: int) => { 0; }); } (e2: Exception) => { print ("16: " + string e2); }
Ex.Try { ro.d = 2; } (e2: Exception) => { print ("17: " + string e2); }
print (ro.r)
# 混着别的修饰符的换槽写法没有定义(`=` 那条只在**只有** by 时才是换槽)——
# 从前这种会被当成换槽、然后把它静默丢掉
Ex.Try { eval "readonly by z = 1"; } (e2: Exception) => { print ("18: " + string e2); }

# property C# factory
C := class {
    init = () => { this._val = 0; this; }
    _val: int = 0
    by val := property (() => { _val; }) ((v: int) => { _val = v; })
    get := () => { val; }
}
c := C ()
c.val = 99
print (c.get ())

# 赋值交出去的值:by 属性那条一直是新值,现在普通变量/字段也统一成新值(tests/148)
print (c.val = 7)
print (c.get ())
print (c._val)

# `by` 的值必须由 `property getter setter` 造。标了 by 却给别的东西,四条读写路
# 从前各有各的下场:`d.bad` 报「没有方法 'Get'」,而**裸读**会把那个值悄悄交出去、
# **裸写**更是什么都不发生。现在四条路报同一句话。
D ::= class {
    init = () => { 0; this; }
    by bad := 5
    read := () => { bad; }
    write := (q: int) => { bad = q; }
}
d := D ()
try { d.bad; } (e: Exception) => { print ("1: " + string e); }
try { d.bad = 1; } (e: Exception) => { print ("2: " + string e); }
try { d.bad += 1; } (e: Exception) => { print ("3: " + string e); }
try { d.read (); } (e: Exception) => { print ("4: " + string e); }
try { d.write 1; } (e: Exception) => { print ("5: " + string e); }

# 例外只有 `default`:它是**属性的默认值**(一对什么都不做的 getter/setter,见 tests/212),
# 槽里于是有个能读能写、只是都不做事的属性。别的非 property 值(上面那些 bad)照旧报错。
DL ::= class {
    init = () => { 0; this; }
    by dl: int = default
}
dl := DL ()
print (dl.dl)
print (dl.dl = 1)
print (dl.dl)

# `by a: int = …` 的注解管的是**写进来的值**(和普通字段一个道理):
# 从前这条注解会被拿去比那个 PropertyVal,一实例化就报「无法将 Property 赋值给 Integer」。
E ::= class {
    init = () => { 0; this; }
    _n: int = 1
    _f: float = 1.0
    _s: object = ""
    by n: int = property (() => { _n; }) ((q: int) => { _n = q; })
    by loose := property (() => { _s; }) ((q: object) => { _s = q; })
    by lying: string = property (() => { 42; }) ((q: object) => { 0; })
    by m: int = property (() => { _f; }) ((q: object) => { _f = q; })
}
e := E ()
print (e.n)
e.n = 7
print (e.n)
print (e.n = 9)
try { e.n = "str"; } (e2: Exception) => { print ("6: " + string e2); }
try { e.m += 1; } (e2: Exception) => { print ("7: " + string e2); }
# 没写注解 = 写什么都行(`:=` 定义时那个约束是 Any,不是 Property)
e.loose = "anything"
print (e.loose)
# 读那侧不管:注解约束的是"谁能写进来"(Ravel 从不检查函数返回什么,getter 也一样)
print (e.lying)

# `by n = X` 换掉**槽里的那份 property**(不走旧 setter、也不查类型约束):
# 和 `n = v`(过 setter)、`by n := property …`(定义槽)是三件事。
OldSet := 0
NewSet := 0
S ::= class {
    init = () => { _n = 1; this; }
    _n: int = 1
    by n: int = property (() => { _n; }) ((q: int) => { OldSet += 1; _n = q; })
    swap := () => {
        by n = property (() => { _n * 100; }) ((q: int) => { NewSet += 1; _n = q; })
    }
}
s := S ()
s.n = 5
print (s.n)
print ("换之前 旧 " + (string (OldSet)) + " 新 " + (string NewSet))
s.swap ()
print (s.n)
s.n = 7
print (s.n)
print ("换之后 旧 " + (string (OldSet)) + " 新 " + (string NewSet))
print (s.Fields ())
# 目标必须是个 by 属性;找不到变量也报出来
plain := 1
try { by plain = 2; } (e2: Exception) => { print ("8: " + string e2); }
try { by nope = 2; } (e2: Exception) => { print ("9: " + string e2); }

# `by a` / `by a.x`:取**槽里的 property 本身**,不过 getter(和 `by a = X` 对称的那一半)。
# 拿到手就是个普通值 —— 能存进表里、传给别的函数,还能自己 `.Get ()` / `.Set v`。
GetCalls := 0
P ::= class {
    init = () => { _v = 1; this; }
    _v: int = 1
    by v := property (() => { GetCalls += 1; _v; }) ((q: int) => { _v = q; })
}
pp := P ()
p1 := by pp.v
print p1
print ("取完 getter 被调了 " + (string (GetCalls)) + " 次")
p1.Set 9
print (pp.v)
print (by pp.v == p1)
Bag := []
Bag.Add (by pp.v)
print ((Bag.At 0).Get ())
print ("至此 getter 被调了 " + (string (GetCalls)) + " 次")
try { print (by pp._v); } (e2: Exception) => { print ("10: " + string e2); }
try { print (by plain); } (e2: Exception) => { print ("11: " + string e2); }

# `by a.x = X`:换**别的对象**上的槽(和取槽那边的 `by a.x` 对称,同一个槽路径)
Old2 := 0
New2 := 0
Q ::= class {
    init = () => { _q = 1; this; }
    _q: int = 1
    by q: int = property (() => { _q; }) ((v: int) => { Old2 += 1; _q = v; })
}
qq := Q ()
R ::= class {
    init = () => { 0; this; }
    swapOn := (o: object) => {
        by o.q = property (() => { 1000; }) ((v: int) => { New2 += 1; })
    }
}
r := R ()
print (qq.q)
r.swapOn qq
print (qq.q)
qq.q = 5
print ("旧 " + (string (Old2)) + " 新 " + (string New2))
try { by qq._q = property (() => { 1; }) ((v: int) => { 0; }); } (e2: Exception) => { print ("12: " + string e2); }
try { by qq.nope = property (() => { 1; }) ((v: int) => { 0; }); } (e2: Exception) => { print ("13: " + string e2); }

# `by a.x := X` 在**那个对象上建槽**(成员不存在也行)—— `:=` 定义 / `=` 换,
# 和语言里别处一个规矩;所以 `=` 那条撞上不存在的成员才报错(上面那条 13)
T ::= class { init = () => { 0; this; }; }
t := T ()
by t.added := property (() => { 42; }) ((v: int) => { 0; })
print (t.added)
print (t.Fields ())
print (by t.added)
# `=` 那边的正例:槽已经在了,换掉它
by t.added = property (() => { 43; }) ((v: int) => { 0; })
print (t.added)

# readonly 对 by 槽也管:赋值走的是 setter(不经过 `Variable.Assign`),
# 漏了的话"只读"在属性上就是句空话。`by` 那条路一个都不放过:赋值/复合赋值/换槽。
Ro ::= class {
    init = () => { _r = 1; this; }
    _r: int = 1
    readonly by r := property (() => { _r; }) ((v: int) => { _r = v; })
    readonly by d: int = default
}
ro := Ro ()
print (ro.r)
try { ro.r = 9; } (e2: Exception) => { print ("14: " + string e2); }
try { ro.r += 1; } (e2: Exception) => { print ("15: " + string e2); }
try { by ro.r = property (() => { 1; }) ((v: int) => { 0; }); } (e2: Exception) => { print ("16: " + string e2); }
try { ro.d = 2; } (e2: Exception) => { print ("17: " + string e2); }
print (ro.r)
# 混着别的修饰符的换槽写法没有定义(`=` 那条只在**只有** by 时才是换槽)——
# 从前这种会被当成换槽、然后把它静默丢掉
try { eval "readonly by z = 1"; } (e2: Exception) => { print ("18: " + string e2); }

# ═══ 142_property_attrs(并入) ═══
ravel "142_property_attrs"
# Property.Attrs —— 属性的 attrs 会跟着 Property 值走
# (原来靠 C.Proto () 拿实例 scope,但 Proto 已不存在,得在类方法里用 currentScope ())
C := class {
    init = () => { 0; this; }
    readonly x: int = 42
    probe := () => {
        p := (currentScope ()).Lookup "x"
        print ((p.Attrs ()).Count ())
    }
}
c := C ()
c.probe ()
ravel ""

# ═══ 211_default_init(并入) ═══
ravel "211_default_init"
# 默认构造器:`object` 的类体里有一份 `init = () => { this; }` ——
# 什么都不做,把正在建的那个对象交回去。每个类的祖先链都到 object,所以
# **任何类只要没写 init 就继承这一份**,`C ()` 不再报「类型 C 没有构造器（init）」。
#
# 和 `function default` 给一个空函数(`() => { (); }`)是一个道理:空缺的地方给个
# 什么都不做的对应物,而不是报错。

# 没有 init 的类:两种构造写法都行
C ::= class { x: int = 1; }
print (C ())
print ((C ()).x)
print (C default)
print (typeof (C ()))

# 继承:子类没写就落回父类那份,一路都没写就落回 object 那份
B ::= class C { y: int = 2; }
print (B ())
print ((B ()).x)
print ((B ()).y)

# 自己写了 init 就覆盖掉默认那份(和覆盖别的继承成员一个机制)
D ::= class {
    init = () => { print "D.init"; this; }
    z: int = 3
}
d := D ()
print (d.z)

# 内建的构造器比默认那份具体,所以仍然赢:object 的类体先跑,List 的预设类体后跑
MyInt ::= class int { 0; }
print (MyInt "42")
MyList ::= class list { 0; }
print (MyList default)
try { MyList (); } (e: Exception) => { print ("1: " + string e); }

# object 自己现在也能构造了(它的类体就是那份默认构造器)
print (System.Object ())

# 但**没有自己类体**的类型还是不能当构造器调(护栏在 CallClassInto 上)
try { System.Void (); } (e: Exception) => { print ("2: " + string e); }
try { System.Every (); } (e: Exception) => { print ("3: " + string e); }
ravel ""

# ═══ 212_default_property(并入) ═══
ravel "212_default_property"
# `by a: int = default` —— `default` 是**属性的默认值**:一对什么都不做的函数
#
#     Get = () => { (); }
#     Set = (_ : object) => { (); }
#
# 和 `int default` 给 0、`function default` 给空函数是同一个道理。
# 于是"先声明、之后再装实现"这套写法通了(trait 要的正是这个形状):默认那份能读能写,
# 只是都不做事 —— 读出来是 (), 写进去丢掉。之后用 `by a = property g s` 换掉它。

Trait ::= class {
    init = () => { 0; this; }
    by a: int = default
    by b: function = default
}
t := Trait ()

# 装实现之前:读 ()、写丢掉、不报错
print (t.a)
print (t.a = 1)
print (t.a)
print (t.b)
t.b = (x: int) => { x; }
print (t.b)
print (t.Fields ())

# 装实现:换掉槽里的那份 property
Install := (o: object) => {
    by o.a = property (() => { 100; }) ((v: int) => { print ("装了 setter: " + string v); })
    by o.b = property (() => { (x: int) => { x * 2; }; }) ((v: function) => { 0; })
}
Install t
print (t.a)
t.a = 5
print (t.b 21)

# 在**别的对象**身上建一个默认属性(`:=` 定义那条)
Empty ::= class { init = () => { 0; this; }; }
e := Empty ()
by e.nick := default
print (e.nick)
by e.nick = property (() => { "someone"; }) ((v: string) => { 0; })
print (e.nick)

# 默认属性没有状态 —— 复制出来的副本和原件共享同一个,谁都不会被写坏
print ((with t { 0; }).a)
print (t.a)
ravel ""

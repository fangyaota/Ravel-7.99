# 运算符成员/with/类/多init/throw/eval/模块(合并 63/137/148/115/116/120/105/82/84/75/76/77/80/81/83/96/97)
print (2.* 7)
print ("aaa".== "aaa")
print ("aaa".== "bbb")
print (3.+ 4)
print (10.- 3)
b: object = { print "world"; }
c := b.Prepend { print "hello"; }
c ()
f := () => { print "hi"; }
print ("[" + f.name + "]")
f.name = "hello"
print (f.name)
g := f.Append { print " there"; }
g ()
Point := class {
    init = () => { 0; this; }
    x: int = 0
    y: int = 0
}
p := Point ()
p.x = 1
p.y = 2
# `with p { … }` **不拷**:块跑在 p 的成员表上,`x = 10` 改的就是 p;
# 交回的也是 p 本身(要副本请写 `p.Copy ()`)。
q: object = with p {
    x = 10
}
print (p.x)
print (p.y)
print (q.x)
print (q.y)
r: object = with p {
    x = 100
    tmp := 999
}
print (r.x)
Point2 := class {
    init = () => { 0; this; }
    x: int = 0
    y: int = 0
}
p2 := Point2 ()
p2.x = 1
p2.y = 2
q = with p { x = 10; }
print (p.x)
print (q.x)
print (q.y)
r = with p {
    x = 100
    tmp2 := 999      # 第二次落定义:同一个对象上 `tmp` 已经定义过了（`:=` 是定义不是覆盖）
}
print (r.x)
Animal := class {
    init = () => { 0; this; }
    name: string = ""
}
Dog := class Animal {
    init = () => {
        breed = ""
        this;
    }
    breed: string = ""
}
dog := Dog ()
dog.name = "Rex"
dog.breed = "Husky"
dog2 := with dog { name = "Max"; }     # 就地改:dog 也成了 "Max"、dog2 就是 dog
print (dog.name)
print (dog2.name)
print (dog2.breed)
# 一个类只有一个构造器,要按参数分派就在 init 里自己判断
Multi := class {
    init = (v: object) => {
        x = 0
        y = 0
        if { (typeof (v)) == int; } {
            x = int v
        } { 0; }
        this;
    }
    x: int = 0
    y: int = 0
}
a := Multi 10
b = Multi ()
print (a.x)
print (a.y)
print (b.x)
print (b.y)
try {
    throw (Exception "boom")
} (e: Exception) => {
    print "caught"
}
print "done"
try {
    throw (Exception "oops")
} (e: Exception) => {
    print "caught"
}
print "done"
result: object = try {
    42
} (e: Exception) => {
    0
}
print result
x := 10
eval "print x"
eval "y := 20"
eval "print (x + y)"
result = callcc (k: function) => {
    eval "k 42"
}
print result
eval "F := (a: int) => { a * 2; }"
print (F 5)
# 自己建一个叫 `Math` 的模块 —— 里面两样都是自己的
ravel "Math"
Pi := 3.14159
MySquare := (x: int) => { x * x; }
ravel ""
print (Math.Pi)
print (Math.MySquare 5)

# 再装上真的 `math.rav`:它往**同一个**模块里补 C# 那半边(名字撞上就以它为准 ——
# 装模块用的 `Define` 不带 site,走的是"覆盖"那条规矩,和 `:=` 的"不许重定义"不是一回事)。
# 从前 `ravel "Math"` 自己就会填 C# 那半边,所以那会儿这两句得分开写。
using "math.rav"
print (Math.Pi)
print (Math.Square 6)

using "math.rav"
ravel "Math"
Tau = 6.28318                 # 这一枚是扩展填进来的,`=` 能改
ravel ""
print (Math.Pi)
print (Math.Tau)
ReferencesPath = ["./tests/module/"]
using "132_mod_simple.rav"
print "first done"
using "132_mod_simple.rav"
print "second done"
ReferencesPath = ["./tests/module/"]
using "132_mod_simple.rav"
print "done"

# ═══ 108_module_private(并入:原本钉的是"报错",改成 try+eval 把消息钉成一行) ═══
try { eval "# 模块 private 变量外部不可访问\nReferencesPath = [\"tests/module/\"]\nusing \"131_mod_lib.rav\"\nprint (Lib.priv_y)"; } (e: Exception) => { print ("108_module_private: " + string e); }

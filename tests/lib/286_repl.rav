# `Repl` —— **用 Ravel 写的 REPL 编辑器**(见 lib/repl.rav)。**要显式引用**。
#
# 这一条钉的是它**纯的那一半**:一行源码进、一串标记出 —— 不碰键盘也不碰屏幕。
# 壳那一半(按键、重画、菜单)要有真键盘才跑得动,所以它在 `examples/repl.rav` 里。
#
# **`# warn` 开着的**:下面还顺手把壳里"不用键盘也跑得动"的那几条驱动一遍
# (算编辑缓冲区、翻页、菜单项、页码那一步),让"是不是忘了调用"那个筛子照着它们也过一遍 ——
# 写这个库的时候正是这个筛子逮到一句两块的 `if`(菜单项一个都加不进去),而那时候
# 我已经查了三轮。**这条用例就是那次踩坑留下的闸**。
#
# warn
using "repl.rav"

# ── 切词:字符串 / 数字 / 词 / 别的 ──
print (Repl.Segments "x := 12")
print (Repl.Segments "print \"你好\"")
print (Repl.Segments "a # 注释")
print (Repl.Segments "1.5n + _标")

# ── 上色(交回的是**标记**,所以颜色也钉得住)──
print (Repl.Colored "x := 1")
print (Repl.Row 1 "x := 1" ())            # `()` = 光标不在这一行
print (Repl.Row 2 "ab" 1)                 # 光标在第 1 格(词里)
print (Repl.Row 3 "ab" 2)                 # 光标在行尾
print (Repl.Row 12 "x" 0)                 # 行号右对齐三格

# ── 渲染出来的样子(不走颜色,管道里也稳定)──
print (Terminal.Plain (Repl.Row 1 "x := 1" 5))
# 行尾那个位置画的是**一个空格**的光标块 —— 外面套一层方括号,免得尾空格被比对吃掉
print ("[" + (Terminal.Plain (Repl.Row 1 "ab" 2)) + "]")
print (Terminal.Plain (Repl.Colored "a # 注释"))

# ── 写完了吗 ──
print (Repl.Balanced "(1 + 2")
print (Repl.Balanced "1 + 2)")
print (Repl.Balanced "x := 1")
print (Repl.Balanced "\"没闭合")
print (Repl.Balanced "\"a\\\"b\"")          # 转义:那个引号不算收尾
print (Repl.Balanced "# ( 注释里的括号不算")

# ── 屏幕取哪一段 ──
print (Repl.Window 3 1)
print (Repl.Window 100 50)
print (Repl.Window 100 0)
print (Repl.Window 100 99)

# ── 编辑器:插字 / 回车 / 退格 / 删 / 翻页 ──
e := Repl.Editor ()
e.Edit1 "a"
e.Edit1 "b"
e.Clamp ()
print ((e.Text ()).Length ())
print (e.Lines () |> .Count ())
e.Edit1 "enter"
e.Edit1 "c"
e.Clamp ()
print ((e.Text ()).Length ())            # ab + 换行 + c = 4
print (e.Lines () |> .Count ())
e.Edit1 "backspace"
e.Clamp ()
print ((e.Text ()).Length ())
e.Edit1 "tab"
e.Clamp ()
print ((e.Text ()).Length ())
e.Jump "pgdn"                            # 翻到新的一页
e.Clamp ()
print (e.Z)
print ((e.Text ()).Length ())
e.Edit1 "insert"                         # 清这一页
e.Clamp ()
print ((e.Text ()).Length ())

# ── 壳里不用键盘的那几条:方框里的行数、菜单项、快捷栏、页码 ──
# (交回的多半是**标记**,不渲染,所以钉得住;方框那一层要真终端宽度,不在这儿跑)
m := Repl.Editor ()
print ((m.Screen ()).Count ())           # 空页:标题 + `   | <空>`,垫够 8 行,再挂个换行 → 10
print ((m.Tips ()).Count ())
# 菜单项的**顺序**就是 `Pick` 那串 `match` 的序号 —— 钉住它,漏一支 / 错一位都藏不住
foreach (m.Items ()) (name: string) => { print name; }
m.Pages = [["a" "b" "c" "d" "e" "f" "g" "h" "i" "j" "k" "l"]]
m.Z = 0
print ((m.Screen ()).Count ())           # 12 行那页:标题 + 12,不用垫,末尾挂个换行 → 14
# 启动那张大图 —— C# 那版 REPL 原样搬过来的(那一版已删,图留在 `lib/repl.rav` 的 `Banner`)
print ((System.SplitLines (Repl.Banner ())).Count ())
# 「读取」问页码那一步:读得动就是那个数,读不动是 -1
print (Repl.PageOf "13")
print (Repl.PageOf " 7 ")
print (Repl.PageOf "")
print (Repl.PageOf "abc")
# 抓 stdout —— C# 那个「显示结果」开关全靠它(`System.CaptureStart` / `CaptureEnd`)
System.CaptureStart ()
print "藏起来的这句不该出现在上面"
hidden := System.CaptureEnd ()
print ("收到:" + (hidden.Trim ()))

# ── 缓冲区、翻页、光标 ──
m.Pages = [["a" "b"] ["c"]]
m.Z = 0
m.Y = 1
print ((m.Text ()).Length ())
m.Jump "pgdn"
m.Clamp ()
print (m.Z)
print ((m.Text ()).Length ())
m.Jump "pgup"
m.Clamp ()
print (m.Z)
m.Jump "end"
m.Clamp ()
print (m.Y)
print (m.X)
m.Jump "home"
m.Clamp ()
print (m.Y)
m.Jump "没有这个键"                        # 认不出的键:什么都不做,报 false
# `Jump` / `Edit1` 内部是一张 **`match` 表**(键 → 做什么),这几条照着表走一遍
m.Jump "right"
m.Clamp ()
print (m.X)
m.Jump "down"
m.Clamp ()
print (m.Y)
m.Jump "up"
m.Clamp ()
print (m.Y)
m.Edit1 "delete"
m.Clamp ()
print ((m.Text ()).Length ())
print "end"

# ── 壳里**离线也跑得动**的那几条:运行那一页 ──
#
# **这条是补闸的**:`TryEval` 里从前有一句**只有两块**的 `if`(`if { c; } { t; }`),
# 而少给一块在 Ravel 里 = 那个 `if` 变成半成品、**整块静默不跑** —— 用户的 `print`
# 于是被整段吞掉,一声不吭。`--warn` 认得出来,但**得跑到那一句**才报,而这一页
# 从前没有任何用例驱动过。下面这几行就是让它跑到。
e2 := Repl.Editor ()
e2.TryEval "print 1 + 1"                    # 用户代码的打印要出得来
e2.TryEval "print \"第一行\"
2 + 3"          # 打印 + 交回值:两样都要有
e2.ShowResult = false
e2.TryEval "print \"关掉开关\""
e2.ShowResult = true
e2.TryEval "print \"又回来了\""
print "end2"
# --- expected ---
# [{kind: word text: x} {kind: other text:  } {kind: other text: :} {kind: other text: =} {kind: other text:  } {kind: number text: 12}]
# [{kind: word text: print} {kind: other text:  } {kind: string text: "你好"}]
# [{kind: word text: a} {kind: other text:  } {kind: other text: # 注释}]
# [{kind: number text: 1.5n} {kind: other text:  } {kind: other text: +} {kind: other text:  } {kind: word text: _标}]

# 数据结构那一族:栈 / 队列 / 双端队列 / 堆 / 有序字典 / 有序集合。
#
# 它们是**插件**:类和函数在一个独立的项目里(`Ravel.Structures/`,编成
# `plugins/Ravel.Structures.dll`),`using "structures.rav"` 把 dll 装进来、顺手登记
# `IEnumerable` 那几条(于是 `foreach` / `Map` / `Fold` 白拿)。名字都在 `Structures` 模块下。
using "structures.rav"

# ── 栈:后进先出 ──
s := Structures.Stack ()
s.Push 1
s.PushRange [2 3]
print s                       # 打印时**顶在前**
print (s.Peek ())             # 只看不弹
print (s.Pop ())
print (s.Count ())
print (s.IsEmpty ())
print (Structures.Stack [1 2 3])         # 也可以从一串垒起来(底 → 顶)

# ── 队列:先进先出 ──
q := Structures.Queue [1 2 3]
print (q.Dequeue ())
print q
print (q.Peek ())

# ── 双端队列:两头都能进能出(`Push` / `Pop` 是后端的简写) ──
d := Structures.Deque [2 3]
d.PushFront 1
d.Push 4
print d
print (d.PopFront ())
print (d.PopBack ())

# ── 堆:每次弹出来的都是当前最小的那个 ──
h := Structures.Heap [3 1 4 1 5]
print (h.Peek ())
print (h.Pop ())
print (h.ToList ())           # 一个个弹出来的顺序 = 排好序
mx := Structures.Heap true               # 大顶堆(`lib/heap.rav` 的 `MaxHeap ()` 就这么写)
mx.PushRange [1 9 5]
print (mx.ToList ())
print (mx.Max ())

# ── 有序字典:键永远有序 ──
sd := Structures.SortedDict ()
sd.Set "b" 2
sd.Set "a" 1
print (sd.Keys ())
print (sd.Values ())          # 跟着键走
print (sd.Get "b")
print (sd.GetOr "zz" 0)
print (sd.Has "a")
print (sd.Remove "a")
print sd

# ── 有序集合:重复的加不进去,枚举就是升序 ──
ss := Structures.SortedSet ()
ss.Add 3
ss.Add 1
ss.Add 2
ss.Add 1
print (ss.ToList ())
print (ss.Min ())
print (ss.Max ())
print (ss.Count ())

# ── 实现了 `IEnumerable`:整套序列方法白拿 ──
print ((Structures.Stack [1 2 3]).Map ((x: object) => { x * 10; }) |> .ToList ())
print ((Structures.Queue [1 2 3]).Fold 0 ((a: object b: object) => { a + b; }))
print ((Structures.SortedSet [3 1 2]).Sum ())
foreach (Structures.Heap [3 1 2]) (x: object) => { print ("堆: " + (string x)); }

# ── 它们是类型树上的节点 ──
print (typeof (Structures.Stack ()))
print (Structures.Stack <: object)
print ((Structures.SortedDict ()) : object)

# ── 报错的几种:当场说人话 ──
try { (Structures.Stack ()).Pop (); } (e: Exception) => { print ("1: " + string e); }
try { (Structures.Queue ()).Peek (); } (e: Exception) => { print ("2: " + string e); }
try { (Structures.Heap ()).Pop (); } (e: Exception) => { print ("3: " + string e); }
try { (Structures.Deque ()).PopFront (); } (e: Exception) => { print ("4: " + string e); }
try { (Structures.SortedSet ()).Min (); } (e: Exception) => { print ("5: " + string e); }
try { (Structures.SortedDict ()).Get "nope"; } (e: Exception) => { print ("6: " + string e); }
try { (Structures.Heap [1 "a"]).Pop (); } (e: Exception) => { print ("7: " + string e); }      # 比不了
try { (Structures.SortedDict ()).Set [1] 1; } (e: Exception) => { print ("8: " + string e); }  # 键要值类型
# --- expected ---
# Stack [3 2 1]
# 3
# 3
# 2
# false
# Stack [3 2 1]
# 1
# Queue [2 3]
# 2
# Deque [1 2 3 4]
# 1
# 4
# 1
# 1
# [1 3 4 5]
# [9 5 1]
# true
# [a b]
# [1 2]
# 2
# 0
# true
# true
# SortedDict {b: 2}
# [1 2 3]
# 1
# 3
# 3
# [30 20 10]
# 6
# 6
# 堆: 1
# 堆: 2
# 堆: 3
# Stack
# true
# true
# 1: Stack.Pop: 空栈没有可弹的
# 2: Queue.Peek: 空队列没有头可看
# 3: Heap.Pop: 空的，没有可弹的
# 4: Deque.PopFront: 空的双端队列没有可弹的
# 5: SortedSet.Min: 空集合没有最小
# 6: SortedDict.Get: 键不存在: nope
# 7: 比不了 String 与 Integer
# 8: SortedDict.Set 的键得是值类型（数 / 字符串），得到 List

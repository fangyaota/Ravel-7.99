# `Generator f`:体的参数 `y` 是投喂口 —— `y v` 送出一个值**并挂起**,消费者再要才接着跑。
# `Generator f` 本身是个 `IEnumerable`,`foreach` 直接吃;每次遍历从头跑一遍体。

# ① 无限流 + 早期退出(要几个拿几个)
Nats := Generator (y: function) => {
    n := 0
    while { true; } { y n; n += 1 }
}
callcc (stop: function) => {
    i := 0
    foreach Nats (x: int) => {
        if { i >= 5; } { stop (); } { 0; }
        print x
        i += 1
    }
}

# ② 有限序列:斐波那契
Fib := Generator (y: function) => {
    a := 0
    b := 1
    while { true; } { y a; t := a + b; a = b; b = t; }
}
callcc (stop: function) => {
    i := 0
    foreach Fib (x: int) => {
        if { i >= 8; } { stop (); } { 0; }
        print x
        i += 1
    }
}

# ③ 惰性:不要的部分一句都不跑
Lazy := Generator (y: function) => {
    print "开始"
    y 1
    print "继续"
    y 2
    print "收尾"
}
callcc (stop: function) => {
    foreach Lazy (x: int) => { print x; stop (); }
}

# ④ 把已有的遍历包成生成器(能 foreach 的东西都能包)
Odds := (xs: IEnumerable) => {
    Generator (y: function) => {
        foreach xs (x: int) => { if { (x % 2) != 0; } { y x; } { 0; } }
    }
}
foreach (Odds [1 2 3 4 5]) (x: int) => { print x; }

# ⑤ 生成器套生成器:扁平化
Flat := (xss: IEnumerable) => {
    Generator (y: function) => {
        foreach xss (xs: IEnumerable) => { foreach xs (x: object) => { y x; } }
    }
}
foreach (Flat [[1 2] [3] [4 5]]) (x: int) => { print x; }

# ⑥ 同一个 Generator 遍历两次:各自从头(体是配方)
Twice := Generator (y: function) => { y 1; y 2; }
foreach Twice (x: int) => { print x; }
foreach Twice (x: int) => { print x; }

# ⑦ 类型关系:is IEnumerable / is IEnumerator
print (Twice : IEnumerable)
print ((Twice.GetEnumerator ()) : IEnumerator)
print (Twice : IEnumerator)

# ⑧ 交给别的库:按**模式**分派(生成器照旧是 IEnumerable)
Tag := Generator (y: function) => { y 1; y "x"; y true; }
foreach Tag (v: object) => {
    print (v |> ((x: int) => { "整数"; } | (x: string) => { "字符串"; } | _ => { "别的"; }))
}
print "end"
# --- expected ---
# 0
# 1
# 2
# 3
# 4
# 0
# 1
# 1
# 2
# 3
# 5
# 8
# 13
# 开始
# 1
# 1
# 3
# 5
# 1
# 2
# 3
# 4
# 5
# 1
# 2
# 1
# 2
# true
# true
# false
# 整数
# 字符串
# 别的
# end

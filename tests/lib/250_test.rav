# `Test` —— 给自己的库写断言(`using "test.rav"` 才引入;仓库自己的用例仍是 golden 那一套)。
# 一条 = 一个名字 + 一段**会跑出结果的东西**:不报错就算过(`Check`)、两边显示形式一样就算过
# (`Equal`)、必须报错才算过(`Fails`)。`Report ()` 打一行汇总,**有没过就抛出去**
# (CLI 于是以非零码结束,见 Program.cs)。
#
# 这一份里**故意**有几条没过 —— 那些 `not ok` 和缩进的原因就是要钉的样子。

using "test.rav"

# ── 过的(Check 顺便交回"过没过",当值能用)──
print (Test.Check "1 加 1 是 2" { assert ((1 + 1) == 2) "不对"; })
Test.Equal "摊平一层" (Seqs.Flatten [[1 2] [3]]) [1 2 3]
Test.Equal "标量也吃" (2 + 2) 4
Test.Equal "字符串也吃" ("a" + "b") "ab"
Test.Fails "除零确实报错" { 1 / 0; }

# ── 没过的:底下缩进那行就是原因(期望 / 得到,或那句报错)──
Test.Check "故意没过" { assert false "我就是要炸"; }
Test.Equal "这条也没过" [1 2] [1 3]
Test.Fails "本该报错却没事" { 1 + 1; }

# 每条的记录还在(名字 / 过没过 / 那句消息),名字等值的那个计数也在
print (Test.Results.Count ())
print ((Test.Results.At 5).Get "name")
print ((Test.Results.At 5).Get "ok")
print (Test.PassCount)
print (Test.FailCount)

# 汇总:有没过就抛出去(不想让它抛就别调它 —— 逐条的输出早就打完了)
try { Test.Report (); } (e: Exception) => { print ("Report 抛了：" + string e); }

# 再收一次尾:还是那几没过,所以照样抛(计数器不重置)
try { Test.Report (); } (e: Exception) => { 0; }
print "end"
# --- expected ---
# ok 1 - 1 加 1 是 2
# true
# ok 2 - 摊平一层
# ok 3 - 标量也吃
# ok 4 - 字符串也吃
# ok 5 - 除零确实报错
# not ok 6 - 故意没过
#     我就是要炸
# not ok 7 - 这条也没过
#     期望 [1 3]，得到 [1 2]
# not ok 8 - 本该报错却没事
#     本该报错，却正常回来了
# 8
# 故意没过
# false
# 5
# 3
# 5 passed, 3 failed
# Report 抛了：3 条断言没过
# 5 passed, 3 failed
# end

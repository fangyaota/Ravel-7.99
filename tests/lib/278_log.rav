# `Log` —— 分级日志(见 lib/log.rav)。**要显式引用**。
#
# 除了那一条 `Line`,用例里**一律把时间戳关掉**(`"stamp": false`)——
# 打出来的是不是"现在"这件事钉不住,但行的其余部分该钉得住。
using "log.rav"

# ── 四个级别:比当前级别松的不落笔 ──
lg := Log.New {"stamp": false}
lg.Debug "看不见"
lg.Info "启动"
lg.Warn "磁盘快满了"
lg.Error "坏了"
print (lg.Enabled "debug")
print (lg.Enabled "error")

# ── 级别能改 ──
lg.SetLevel "debug"
lg.Debug "这下看得见了"

# ── 标签:多打一段,一眼知道是谁说的 ──
db := Log.New {"level": "debug" "stamp": false "tag": "db"}
db.Debug "连接池开了 4 条"

# ── 时间戳:只钉"有 19 个字符那么长的一段",不钉它是几号几点 ──
ts := Log.New ()                                  # 这一台**开着**时间戳
print ((ts.Line "info" "带时间戳").Skip 19)          # 戳正好 19 格:`2026-10-01 09:30:00`
print ((ts.Line "warn" "还是一行").Skip 20)         # 再算上后面那个空格

# ── 默认那台:`Log.Info "…"` 不必先拎一个 logger ──
# 打出去那几行带时间戳(钉不住),所以这儿只钉**同一条路的另一半**:
# `Log.Default ()` 拿到那台之后自己组行 —— 和 `Log.Info` 走的是同一条 `Line`。
print (((Log.Default ()).Line "info" "默认那台").Skip 20)
Log.SetLevel "warn"
Log.Info "被挡掉了(warn 级以后,这句不落笔)"
Log.SetLevel "info"

# ── 落盘的落点(`RAVEL_LOG` 那个环境变量也认,见 lib/log.rav)──
System.CreateDir ".io-test"
f := Log.New {"file": ".io-test/log.txt" "stamp": false "tag": "job"}
f.Info "写到文件"
f.Warn "也写"
f.Debug "不写(级别不够)"
print (System.ReadText ".io-test/log.txt")
System.DeletePath ".io-test/log.txt"
System.DeletePath ".io-test"
print (System.FileExists ".io-test")

# ── 报错的几种 ──
try { Log.New {"level": "verbose"}; } (e: Exception) => { print ("1: " + string e); }
try { (Log.New ()).SetLevel "nope"; } (e: Exception) => { print ("2: " + string e); }

# --- expected ---
# [INFO] 启动
# [WARN] 磁盘快满了
# [ERROR] 坏了
# false
# true
# [DEBUG] 这下看得见了
# [DEBUG] db: 连接池开了 4 条
#  [INFO] 带时间戳
# [WARN] 还是一行
# [INFO] 默认那台
# [INFO] job: 写到文件
# [WARN] job: 也写

# false
# 1: Log: 不认识的级别 'verbose'（有 debug / info / warn / error）
# 2: Log: 不认识的级别 'nope'（有 debug / info / warn / error）

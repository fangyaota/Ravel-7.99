# `Range` —— **内置值类型**:一个区间。四种写法(那一对括号各带**一半**的意思):
#
#     [1..3]   两端都含          (3..5)   两端都不含
#     [1..5)   左闭右开          (1..5]   左开右闭
#
# 打印出来就是写出来那个样子(`Text ()` 同一个);它同时也是一个 `IEnumerable`
# (impl 在 lib/iterator.rav,枚举走生成器的光标、**惰性**),所以整套方法白拿。
#
# **端点收任何数值**(int / bigint / real / fraction,混着写也行),而**元素是"区间里的
# 整数"**:`[1.5..3.5]` → 2 3、`[0.1..0.9]` → 空。`Start ()` / `End ()` 交回的是**写出来
# 那个数**(1.5 就是 1.5),要元素用 `First ()` / `Last ()`。两端不是数值才当场报错。
using "math.rav"

# ---- 四种开闭 ----

lo := [1..3]
print lo
print (lo.ToList ())
half := [1..5)
print half
print (half.ToList ())
allOpen := (3..5)
print allOpen
print (allOpen.ToList ())
rightOnly := (1..5]
print rightOnly
print (rightOnly.ToList ())

# ---- 端点 / 个数 / 包含 ----
print (lo.Start ())
print (lo.End ())
print (lo.Count ())
print (allOpen.Count ())
print ((3..5).Count ())          # 两端都不含 → 只剩 4
print ((3..3).Count ())          # 空
print ([3..3].Count ())          # 只含 3
print (lo.Contains 1)
print (lo.Contains 3)
print (lo.Contains 4)
print (allOpen.Contains 3)
print ((5..1).IsEmpty ())
print (lo.IsEmpty ())
print (lo.Text ())

# ---- `Contains` 问"是不是元素",`Covers` 问"落不落在这段里" ----
q := [1..10]
print (q.Contains 2)
print (q.Contains 2.5)          # 2.5 不是集合里的元素(元素是那些整数)
print (q.Covers 2.5)            # 但它确实落在 1 和 10 之间
print (q.Covers 0)
print (q.Covers 10)
print ([1..10).Covers 10)       # 不含右端
print ((1..10).Covers 1)        # 不含左端
print ((1..10).Covers 1.2)
print ([1.5..3.5].Covers 1.7)   # 端点带小数也一样按端点比
print ([1.5..3.5].Contains 1.7)
print ([10..1].Covers 5)        # 方向对这个问法没意义:盖住的还是那一段
print ([1..10].Covers (0.0 / 0.0))

# ---- 起点在后 = **倒着数**(方向由两端自己说了算)----
print ([5..1].ToList ())
print ((5..1).ToList ())          # 两头都不含 → 4 3 2
print ([5..1).ToList ())
print ((5..1].ToList ())
print ([5..1].Count ())
print ([5..1].First ())           # 第一站是**起点**那头
print ([5..1].Last ())
print ([5..1].IsEmpty ())         # 倒着数也照样有元素
print ([5..1].Contains 3)
print ([5.5..1.5].ToList ())      # 端点带小数也一样,只是从下往上取整换成从上往下
print ([10.5..10].ToList ())
back := []
[3..1].Foreach (i: int) => { back.Add i; }
print back
print (([5..1]).Sum ())
print (([5..1]).Join "-")

# ---- 空的那几种:区间里**一个整数都没有** ----
print ([3..3].ToList ())
print ((3..3).ToList ())
print ((0.1..0.9).ToList ())
print ([0.1..0.9].IsEmpty ())
print ((5..6).ToList ())

# ---- 值语义:类型、按内容比 ----
print (typeof lo)
print (lo : Range)
print (lo : IValue)
print (lo == [1..3])
print (lo == [1..4])
print (lo != allOpen)

# ---- 它也是一串:IEnumerable 那一整套白拿 ----
seen := []
[1..4].Foreach (i: int) => { seen.Add i; }
print seen
(1..4).Foreach (i: int) => { seen.Add i; }
print seen
print (([1..4]).Sum ())
sq := ([1..4]).Map ((i: int) => { i * i; })
print (sq.ToList ())
print (([1..4]).Any ((i: int) => { i > 3; }))
thirds := ([1..10]).Where ((i: int) => { (i % 3) == 0; })
print (thirds.ToList ())
print (([1..5]).Join "-")
# 惰性那两条:要是先铺成表就回不来了(100 万 / 10 亿个)
print (([1..1000000]).First ())
big := ([1..1000000000]).Take 3
print (big.ToList ())
print (([1..1000000000]).Count ())   # 这条走引擎那份 O(1) 的,不数

# ---- 切一段:`Slice` 收区间(字符串那条 `Slice` 也认,两种写法都行)----
xs := [10 20 30 40 50]
print (xs.Slice [1..3])
print (xs.Slice [1..4))
print (xs.Slice (0..2])
print ((xs.Slice (3..3)).ToList ())
print ((xs.Slice [9..9]).ToList ())          # 越过尾巴不报错,空的
tail := ([1..1000000000]).Slice [5..7]       # 惰性:后端是无限的
print (tail.ToList ())
# 头一个 / 末一个**元素**(不是那两个端点 —— 开区间的端点在区间外),O(1)
print ([1..9].First ())
print ([1..9].Last ())
print ((1..9).First ())
print ((1..9).Last ())

# ---- 普通列表照旧:`..` 才算区间 ----
print [1 2 3]
print [[1..3]]
lst := [1 2 3]
print ((lst.Count ()) + (lo.Count ()))

# ---- 端点收**任何数值**,元素是"区间里的整数" ----
# 端点带小数照样能枚举:夹在中间的那些整数就是元素。`Start ()` / `End ()` 交回的仍是
# **写出来那个数**(所以 1.5 就是 1.5),要元素用 `First ()` / `Last ()`。
print [1..3]
fl := [1.5..3.5]
print fl
print (fl.ToList ())
print (fl.Count ())
print (fl.First ())
print (fl.Last ())
print (fl.Start ())
print (fl.End ())
print (fl.Contains 2)
print (fl.Contains 2.5)          # 2.5 不是集合里的元素
print (fl.Contains 2.0)          # 2.0 就是整数 2
print ((0.1..0.9).ToList ())     # 一个整数都没有
print ((0.1..0.9).Count ())
print ([1..2.5].ToList ())
print ([3..1.5].ToList ())      # 3 2 —— 倒着数,起点那一头往下取整
print ([(0.0 / 0.0)..3].ToList ())   # NaN 也是空
flSel := []
[1.5..2.5].Foreach (i: int) => { flSel.Add i; }
print flSel
print ((fraction 1 2..fraction 5 2).ToList ())
print ([1..fraction 7 2].ToList ())
try { [1..Inf].Count (); } (e: Exception) => { print ("1: " + string e); }

# bigint 端点:元素也是 bigint(值有多大就多大),个数装不下也给 bigint
bigEnd := [1..bigint 3]
print bigEnd
print (bigEnd.ToList ())
print (typeof (bigEnd.First ()))
wide := [1..bigint 5000000000]
print (wide.Count ())
print (typeof (wide.Count ()))
print (wide.First ())
print ((wide.Take 2).ToList ())

# ---- 字符串那条 Slice 也算"元素"那一边 ----
print ("Hello World!".Slice [0.5..4.5])   # 元素 1..4

# ---- Clamp 也收区间(端点收任何数值,保型照旧)----
print (Math.Clamp 5 [0..3])
print (Math.Clamp (0 - 5) [0..3])
print (Math.Clamp 2 [0..3])
print (Math.Clamp 0.5 [0.0..1.0])
print (Math.Clamp 2.5 [0.0..1.0])
print (typeof (Math.Clamp 2.5 [0.0..1.0]))
try { Math.Clamp 5 0; } (e: Exception) => { print ("3: " + string e); }   # 旧的三个数字写法没了

# ---- 两端不是数值:当场报错 ----
try { ["a"..3]; } (e: Exception) => { print ("4: " + string e); }
try { "abc".Slice 1; } (e: Exception) => { print ("5: " + string e); }
print "end"

# `Random` —— **可选择的**随机数生成器(见 lib/random.rav)。三台:
#
#     Random.Shared ()   进程共享(.NET Random.Shared)—— 不可复现
#     Random.Make seed   带种子 —— 同一个运行时里同种子给同一串
#     Random.Crypto ()   加密级 —— 不可复现、也没有种子
#
# 取数那一面是 `IRandom` 的**默认实现**(一条槽 `Next`,其余白拿),换台子只换构造子。
#
# **这个用例不钉具体随机数**(.NET 的算法换版本可能变):钉的是"同种子同序列"和各种范围
# 不变量;要钉死的地方用"注定只有一个答案"的写法(`Int 5 5` / `Below 1`)。

using "random.rav"

# ── 三台都在,都实现 IRandom ──
r := Random.Make 42
print (r : IRandom)
print (r.Kind)
shared := Random.Shared ()
print (shared.Kind)
crypto := Random.Crypto ()
print (crypto.Kind)
print (typeof r)
print (r : IEnumerable)          # 枚举器那一族的待遇它没有 —— 这里只是问一句

# ── 可复现:同种子同序列,换种子就换一串 ──
draw := (rng: IRandom) => {
    out := []
    i := 0
    while { i < 5; } { out.Add (rng.Below 1000000); i += 1; }
    out
}
a1 := draw (Random.Make 7)
a2 := draw (Random.Make 7)
b1 := draw (Random.Make 8)
print ((a1.Join ",") == (a2.Join ","))       # 同种子 → 同一串
print ((a1.Join ",") == (b1.Join ","))       # 换种子 → 另一串
print (a1.Count ())
# 同一台连着抽也是接着往下走(不是每次都从头)
again := (Random.Make 7).Below 1000000
print (again == (a1.At 0))

# ── 注定只有一个答案的那几个:把两端的规矩钉死 ──
print (r.Int [5..5])       # 5 —— 那个区间里就一个数
print (r.Below 1)          # 0 —— `Below n` 是 0..n-1
print (r.Int [0..0])       # 0

# ── 范围不变量(抽 200 次,越界就 false —— 不钉具体值)──
inRange := (f: function lo: object hi: object) => {
    good := true
    i := 0
    while { i < 200; } {
        v := f ()
        (v < lo) || (v > hi) { good = false; } { 0; }
        i += 1
    }
    good
}
print (inRange (() => { r.Int [1..6]; }) 1 6)       # 掷骰子:`[1..6]` 两端都含
print (inRange (() => { r.Below 10; }) 0 9)
print (inRange (() => { r.Real (); }) 0.0 1.0)     # [0, 1)(上界取不到,这里只证不越界)
print (typeof (r.Bool ()))
pr := Random.Shared ()
print (inRange (() => { pr.Int [1..100]; }) 1 100)
ck := crypto.Int [0..999]
print ((ck >= 0) && (ck <= 999))

# ── xoshiro256**:算法**定死**的那台 ──
# 和 `Make` 的区别就在这儿:它是我们自己实现的固定算法,同一个种子在哪个运行时、
# 哪台机器上都给同一串 —— 所以**具体的数能钉进用例**;`Make` 走 .NET 的 `Random(seed)`,
# 那个换版本就可能变,只能钉"两次相同"。
x1 := Random.Xoshiro 42
x2 := Random.Xoshiro 42
print (x1.Kind)
print (x1 : IRandom)
x := []
x.Add (x1.Below 1000000)
x.Add (x1.Below 1000000)
x.Add (x1.Below 1000000)
print x
y := []
y.Add (x2.Below 1000000)
y.Add (x2.Below 1000000)
y.Add (x2.Below 1000000)
print y
print ((x.Join ",") == (y.Join ","))
z := Random.Xoshiro 43
print (z.Below 1000000)
# 和 .NET 那台不是一串(算法不同)
m42 := Random.Make 42
print ((m42.Below 1000000) == (x.At 0))
# 分布的大致样子:2000 次 0/1 各约一半(定死的种子,这个数也是定死的)
coin := Random.Xoshiro 1
heads := 0
i := 0
while { i < 2000; } { heads += coin.Below 2; i += 1; }
print ((heads > 800) && (heads < 1200))
# 整套方法照旧(它也是一个 IRandom)
sq := (Random.Xoshiro 5).Shuffle [1 2 3 4 5]
print ((Sorting.Sort sq).Join ",")
print (typeof (Native.XoshiroRandom 1))

# ── 常用件:三台白拿(默认实现在 IRandom 的体里)──
xs := [1 2 3 4 5]
sh := (Random.Make 3).Shuffle xs
print (sh.Count ())
print xs                                       # 原表**没动**
print ((Sorting.Sort sh).Join ",")             # 还是那一批,只是顺序变了
picked := (Random.Make 11).Choice xs
print (xs.Contains picked)
smp := (Random.Make 5).Sample 2 xs
print (smp.Count ())
uniq := smp.Distinct ()
print (uniq.Count ())                          # 不重复
cs := (Random.Crypto ()).Sample 2 xs
print (cs.Count ())
try { (Random.Make 1).Choice []; } (e: Exception) => { print ("1: " + string e); }
try { (Random.Make 1).Sample 9 [1 2]; } (e: Exception) => { print ("2: " + string e); }
try { (Random.Make 1).Int (5..5); } (e: Exception) => { print ("3: " + string e); }   # 空区间里没得挑
try { (Random.Make 1).Below 0; } (e: Exception) => { print ("4: " + string e); }

# ── 分布与抽样 ──
r7 := Random.Xoshiro 42

# 小数:`Real ()` 还是 [0, 1);收一个区间就是区间里的小数(连续的东西统一按 [lo, hi) 看)
f0 := r7.Real ()
print ((f0 >= 0.0) && (f0 < 1.0))
fr := r7.Real (0.0..10.0)
print ((fr >= 0.0) && (fr < 10.0))
fn := r7.Real [-1.0..1.0]
print ((fn >= -1.0) && (fn <= 1.0))
print (typeof (r7.Real ()))
try { r7.Real (5.0..1.0); } (e: Exception) => { print ("1: " + string e); }

# 正态:σ 给 0 就是那个均值;一堆抽样的均值该落在均值附近
print (r7.Normal 5.0 0.0)
print (typeof (r7.Normal 0.0 1.0))
sum := 0.0
k := 0
while { k < 500; } { sum += r7.Normal 0.0 1.0; k += 1; }
avg := sum / 500.0
print ((avg > -0.5) && (avg < 0.5))
try { r7.Normal 0.0 (0.0 - 1.0); } (e: Exception) => { print ("2: " + string e); }

# 加权挑:权重 0 的永远轮不到;权重全压在谁身上就一直是它
print (r7.Weighted ["a" "b" "c"] [1 0 0])
print (r7.Weighted ["a" "b" "c"] [0.0 0.0 2.5])
only := []
i = 0
while { i < 30; } { only.Add (r7.Weighted ["x" "y"] [1 0]); i += 1; }
got := only.Distinct ()
print (got.ToList ())
try { r7.Weighted ["a"] [1 2]; } (e: Exception) => { print ("3: " + string e); }
try { r7.Weighted ["a" "b"] [1 (0 - 1)]; } (e: Exception) => { print ("4: " + string e); }
try { r7.Weighted ["a" "b"] [0 0]; } (e: Exception) => { print ("5: " + string e); }

# 有放回(Choices)和无放回(Sample)配成一对
c := r7.Choices 5 [1 2 3]
print (c.Count ())
cd := (c.Distinct ()).Count ()
print (cd <= 3)
s3 := r7.Sample 3 [1 2 3]
sd := s3.Distinct ()
print (sd.Count ())
try { r7.Choices 2 []; } (e: Exception) => { print ("6: " + string e); }

# 随机字节
bs := r7.Bytes 8
print (bs.Count ())
print (((bs.At 0) >= 0) && ((bs.At 0) <= 255))
cbs := (Random.Crypto ()).Bytes 4
print (cbs.Count ())

# ── 引擎那三条原语(库只是包了一层)──
print (typeof (Native.SharedRandom ()))
print (typeof (Native.NewRandom 1))
rb := Native.RandomBytes 4
print (rb.Count ())
print (((rb.At 0) >= 0) && ((rb.At 0) <= 255))
print "end"

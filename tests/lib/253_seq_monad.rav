# `IEnumerable` 也是 `IMonad` —— 序列这一族进了 monad 那一族(见 lib/iterator.rav)。
#
# `IEnumerable ::= interface IMonad`,那两条槽:Map 逐个映射、Bind 是"每个元素交回一串、
# 接起来"(flatMap)。于是 `do { … }` 在序列上就是**列表推导**,`IMonad` 的注解也收得下序列。
#
# 和 `Option` 是同一族的两个实例:`Some`/`None` 那半"要么一个值要么没有",序列这半
# "一串值"。桥有两座 —— `Option.ToList ()`(往序列走)与 `xs.TryFirst ()` / `TryFind p`(往 Option 走)。

# ---- 凡是实现了 IEnumerable 的,都在这族里 ----
print ([1 2] : IMonad)
print ({1 2} : IMonad)
print ({"a"-> 1} : IMonad)
print ("ab" : IMonad)
G := Generator (y: function) => { y 1; y 2; }
print (G : IMonad)
print ((Some 5) : IMonad)
print ([1 2] : IEnumerable)

# ---- do 块 = 列表推导 ----
xs := [1 2]
ys := [10 20]
pairs := do {
    x :< xs
    y :< ys
    [x y];
}
print (typeof pairs)                       # 惰性的一串(Bind 交回 Generator)
print (Seqs.Gather pairs)
# 最后一条得交回**一串**(Bind 要的是"每个元素变一串")—— 单层时就是 Map
print (Seqs.Gather (do { x :< [1 2 3]; [x * x]; }))

# 两边都可以是无限的:只要下游 Take 得住
Nats := Generator (y: function) => {
    n := 0
    while { true; } { y n; n += 1 }
}
sums := do {
    a :< Nats
    b :< Nats
    [a + b];
}
print (Seqs.Gather (sums.Take 5))

# ---- monad 三律:序列 ----
# 左单位:`[x].Bind f` ≡ `f x`
f := (n: int) => { [n (n + 1)]; }
left := [5].Bind f
print (Seqs.Gather left)
print (Seqs.Gather (f 5))
# 右单位:`m.Bind ((x) => { [x]; })` ≡ `m`
m := [1 2 3]
print (Seqs.Gather (m.Bind ((x: int) => { [x]; })))
# 结合律:`(m.Bind f).Bind g` ≡ `m.Bind ((x) => { (f x).Bind g; })`
g := (n: int) => { [n (0 - n)]; }
lhs := (m.Bind f).Bind g
print (Seqs.Gather lhs)
rhs := m.Bind ((x: int) => { (f x).Bind g; })
print (Seqs.Gather rhs)

# ---- monad 三律:Option(同一个形状,另一族)----
half := (x: int) => { (x % 2) == 0 { Some (x / 2); } { None; } }
print (((Some 8).Bind half).Value ())
l2 := (Some 8).Bind half
print (Seqs.Gather (l2.ToList ()))
print (Seqs.Gather ((half 8).ToList ()))
rightId := (Some 5).Bind Some
print (rightId.Value ())
print ((((Some 16).Bind half).Bind half).Value ())
r2 := (Some 16).Bind ((x: int) => { (half x).Bind half; })
print (r2.Value ())
print (((None).Bind half).IsNone ())

# ---- Option 本身就是一串:0 个或 1 个 ----
# (`impl (IEnumerable Option …)`,见 lib/iterator.rav)于是整串方法白拿;
# 而 `Map` / `Bind` / `Where` 仍是 **Option 自己那份**(类链先命中)—— 取出来还是 Option,
# 不会跑偏成一串。
print ((Some 5) : IEnumerable)
print (None : IEnumerable)
print ((Some 5).Count ())
print ((None).Count ())
print ((Some 5).ToList ())
print ((None).ToList ())
seen := []
foreach (Some 7) (x: int) => { seen.Add x; }
foreach None (x: int) => { seen.Add 999; }
print seen
print (Seqs.Gather (Some 3))
print (Seqs.Gather (None))
print (Seqs.Flatten [(Some 1) (None) (Some 3)])
kept := (Some 5).Where ((x: int) => { x > 9; })
print (kept.IsNone ())
mapped := (Some 5).Map ((x: int) => { x + 1; })
print (typeof mapped)
print (mapped.Value ())
inner := do {
    n :< Some 5
    Some (n * 2);
}
print (typeof inner)
print (inner.Value ())

# ---- 反过来:序列 → Option ----
# 要"可能没有"就用这两条,别去 try 里接 First / Find 那句错
t1 := [1 2 3].TryFirst ()
print (t1.Value ())
t2 := [].TryFirst ()
print (t2.IsNone ())
t3 := [1 2 3].TryFind ((x: int) => { x > 2; })
print (t3.IsSome ())
t4 := [].TryFind ((x: int) => { x > 2; })
print (t4.IsNone ())
print "end"
# --- expected ---

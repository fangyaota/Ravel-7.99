# 递归类型树。`[...]` 里是这个值的 typeof(即它的创建者),
# 所以类的实例显类型名、类本身显 Class 的创建者 Type。
# 注意 Ravel 下挂着 System / Ex —— 模块也是类型,它们由 RuntimeType.Define 建。
print_tree := (t: object prefix: string) => {
    subs := t.Subtypes ()
    total := 0
    j := 0
    while { j < subs.Count (); } {
        s := subs.At j
        p := s.Parent ()
        if { p.name == t.name && s.name != t.name; } { total += 1; } { 0; }
        j += 1
    }
    k := 0
    j := 0
    while { j < subs.Count (); } {
        s := subs.At j
        p := s.Parent ()
        if { p.name == t.name && s.name != t.name; } {
            k += 1;
            is_last := k == total;
            m := typeof s
            label := s.name + " [" + m.name + "]"
            if { is_last; } {
                print (prefix + "└── " + label);
                print_tree s (prefix + "    ");
            } {
                print (prefix + "├── " + label);
                print_tree s (prefix + "│   ");
            }
        } { 0; }
        j += 1
    }
}
print "Object [Type]"
print_tree object ""
# --- expected ---
# Object [Type]
# ├── ValueType [Type]
# │   ├── Integer [Type]
# │   ├── Float [Type]
# │   ├── String [Type]
# │   ├── BigInt [Type]
# │   ├── Fraction [Type]
# │   └── BigFraction [Type]
# ├── Function [Type]
# │   ├── Bool [Type]
# │   ├── Block [Type]
# │   └── Type [Type]
# │       └── Class [Type]
# ├── List [Type]
# ├── Set [Type]
# ├── Dict [Type]
# ├── Void [Type]
# ├── Ravel [Type]
# ├── Exception [Type]
# ├── Scope [Type]
# └── Property [Type]

# `IComparable` / `Sorting`:谁大谁小,以及"按什么排"由**类型自己**说了算。
#
# 协议是 `CompareTo`:收对方、交回 -1 / 0 / 1(和 C# 的 IComparable 同约定)。引擎在 `Object`
# 上放了一条 —— 内建那把尺子(数值、字符串之间怎么比),所以**每个值都有**,不必谁登记:
# `3.CompareTo 5` 拿起来就能用。
#
# 自己写的类型嫌那把尺子不够(它比不了你的对象),就在**类里写一条** `CompareTo` ——
# 它盖掉 `Object` 那条(和 `ToString` 同一个规矩);再 `impl` 登记一下"我这个类型讲了怎么比"。
# (现装那条 `by CompareTo = property …` 在这儿**用不了**:这个名字 `Object` 上已经有了,
#  类链先说话 —— 槽还没轮到。)
#
# 排序是库里自己写的**稳定**归并(`Sorting.Sort` / `SortBy`):比的是 `CompareTo`,
# 所以实现了接口的类型也排得了 —— 引擎那个 `xs.Sort ()` 只认内建标量,碰见对象只会说「比不了」。

# ① 协议:每个值都有
print (3.CompareTo 5)
print (5.CompareTo 3)
print (5.CompareTo 5)
print ("a".CompareTo "b")
print ("b".CompareTo "b")
print ((2.5).CompareTo 1.5)
print ((bigint 5).CompareTo (bigint 7))

# ② 登记 = "这个类型自己讲了怎么比"这个类型层面的事实(内建那几个也登记过)
print (3 is IComparable)
print ("a" is IComparable)
print ([1 2] is IComparable)
print (IComparable.GetImplementors ())

# ③ 库里那些通用件:对着 `CompareTo` 写,所以内建 / 自写两边都吃
print (Sorting.Compare 3 5)
print (Sorting.Sort [3 1 2])
print (Sorting.Sort [])
print (Sorting.Sort [7])
print (Sorting.Sort [3 1 2 1 3])
print (Sorting.Sort ["bb" "a" "ccc"])
print (Sorting.SortBy ["bb" "a" "ccc"] ((s: string) => { s.Length (); }))
print (Sorting.Max [3 9 2])
print (Sorting.Min [3 9 2])
print (Sorting.MaxBy ["bb" "a" "ccc"] ((s: string) => { s.Length (); }))
print (Sorting.MinBy ["bb" "a" "ccc"] ((s: string) => { s.Length (); }))

# ④ 自己写的类型:类里一条 CompareTo + impl 登记
Rec ::= class {
    K: int = 0
    N: string = ""
    init = (k: int n: string) => { K = k; N = n; this; }
    CompareTo := (o: Rec) => { if { K < o.K; } { -1; } { if { K > o.K; } { 1; } { 0; } } }
}
impl (IComparable Rec {
    ()
})
print (Rec.GetImplements ())
rs := []
rs.Add (Rec 3 "c")
rs.Add (Rec 1 "a")
rs.Add (Rec 2 "b")
print ((Sorting.Sort rs).Map ((r: Rec) => { r.N; }))
print ((Sorting.SortBy rs ((r: Rec) => { r.K; })).Map ((r: Rec) => { r.N; }))
print ((Sorting.Max rs).N)
print ((Sorting.Min rs).N)
print ((Sorting.MaxBy rs ((r: Rec) => { r.N; })).N)

# 稳定:键相等的保持原来的先后
r2 := []
r2.Add (Rec 1 "x")
r2.Add (Rec 1 "y")
r2.Add (Rec 0 "z")
print ((Sorting.Sort r2).Map ((r: Rec) => { r.N; }))

# ⑤ 比不了 / 空表:当场说人话,不静默给个错答案
try { rs.Sort (); } (e: Exception) => { print ("1: " + string e); }
try { Sorting.Sort [1 "x"]; } (e: Exception) => { print ("2: " + string e); }
try { Sorting.Max []; } (e: Exception) => { print ("3: " + string e); }
print "end"
# --- expected ---
# -1
# 1
# 0
# -1
# 0
# 1
# -1
# true
# true
# false
# [String BigFraction Fraction BigInt Float Integer]
# -1
# [1 2 3]
# []
# [7]
# [1 1 2 3 3]
# [a bb ccc]
# [a bb ccc]
# 9
# 2
# ccc
# a
# [IComparable BaseInterface]
# [a b c]
# [a b c]
# c
# a
# c
# [z x y]
# 1: 比不了 Rec 与 Rec
# 2: 比不了 Integer 与 String
# 3: 空表没得挑：Max / Min 至少要一个元素
# end

# 抽象那一层：`IEntry` / `IFile` / `IDir` —— "文件"先是个**形状**，磁盘只是其中一个实现。
#
# 这个用例在测试里**现写一个内存文件系统**（十几行，就用 tests/61 那种"content 字段"的做法），
# 登记两条 `impl` 之后：`is` / 注解认得它，而 `Io.Copy` / `Io.EachDir` 这些**对着接口写的**
# 代码两边都吃 —— 这就是"以后要加各种抽象文件"要的那个缝。
using "io.rav"

MemFile ::= class {
    Label: string = ""
    Text: string = ""

    init := (label: string text: string) => { Label = label; Text = text; this; }

    Name := () => { Label; }
    Exists := () => { true; }
    IsDir := () => { false; }
    Read := () => { Text; }
    Write := (t: string) => { Text = t; (); }
    Append := (t: string) => { Text = Text + t; (); }
    Size := () => { Text.Length (); }
    Delete := () => { Text = ""; (); }
}

MemDir ::= class {
    Label: string = ""
    Kids: dict = {}

    init := (label: string) => { Label = label; this; }

    Name := () => { Label; }
    Exists := () => { true; }
    IsDir := () => { true; }
    Delete := () => { Kids = {}; (); }
    Add := (e: object) => { Kids.Set (e.Name ()) e; this; }

    # 接口没规定顺序，但两个实现都按名字排 —— `Io.EachDir` 的输出才稳定
    List := () => {
        names := Kids.Keys ()
        names.Sort ()
        out := {}
        foreach names (n: string) => { out.Set n (Kids.Get n); }
        out
    }
}

# 登记（用 impl：类型层面的事实）。只登记最具体的两条 —— `IEntry` 由接口继承兜着。
impl (IFile MemFile {
    ()
})
impl (IDir MemDir {
    ()
})

m := MemFile "mem.txt" "内存里的内容"
top := MemDir "memdir"
sub := MemDir "sub"
sub.Add (MemFile "deep.txt" "深")
top.Add m
top.Add sub

# 形状认得出来（实现了 IFile 也就算 IEntry）
print (m is IFile)
print (m is IEntry)
print (top is IDir)
print (top is IEntry)
print (m is IDir)
print (MemFile.GetImplements ())
print (IFile.GetImplementors ())
print (IDir.GetImplementors ())

# 对着接口写的函数：注解 (f: IFile) 收得下内存实现
describe := (f: IFile) => { (f.Name ()) + " = " + (f.Read ()); }
print (describe m)

# 同一段代码两边跑：内存 → 磁盘，磁盘 → 内存
root := Io.Dir ".io-test-abs"
root.Create ()
disk := root.Child "from-mem.txt"
Io.Copy m disk
print (disk.Read ())
back := MemFile "back.txt" ""
Io.Copy disk back
print (back.Read ())
print (Io.Lines back)

# `Io.EachDir` 在内存目录上照样递归（路径那一段用 BaseName 打，免得带平台分隔符）
print (m.Size ())
Io.EachDir top (p: string e: IEntry) => { print ((string (e.IsDir ())) + " " + (e.Name ()) + " @ " + (Io.BaseName p)); }

# 要和 IoMonad 搭台:`Io` 那几条是**直接做**的,下面这几条只是包成"说明书"
act := Io.ReadAction m                                   # 到这儿什么都还没读
print ((act.Map ((t: string) => { t.Length (); })).Perform ())
job := Io.WriteAction disk ("从 Action 写进来\n")
print ((job.Then (Io.ReadAction disk)).Perform ())       # 先写后读,交回后一份的结果
print ((Io.EachLineAction m ((l: string) => { print ("行 " + l); })).Perform ())
print ((Io.AppendAction disk ("又一行\n")).Then (Io.ReadAction disk) @ .Perform ())

disk.Delete ()
root.Delete ()
print (root.Exists ())
# --- expected ---
# true
# true
# true
# true
# false
# [IFile IEntry]
# [MemFile ConsoleIn ConsoleOut File]
# [MemDir Dir]
# mem.txt = 内存里的内容
# 内存里的内容
# 内存里的内容
# [内存里的内容]
# 6
# false mem.txt @ mem.txt
# true sub @ sub
# false deep.txt @ deep.txt
# 6
# 从 Action 写进来

# 行 内存里的内容
# ()
# 从 Action 写进来
# 又一行

# false

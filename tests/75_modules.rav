# 运算符成员/with/类/多init/throw/eval/模块(合并 63/137/148/115/116/120/105/82/84/75/76/77/80/81/83/96/97)
print (2.* 7)
print ("aaa".== "aaa")
print ("aaa".== "bbb")
print (3.+ 4)
print (10.- 3)
b := { print "world"; }
c := b.Prepend { print "hello"; }
c ()
f := () => { print "hi"; }
print ("[" + f.name + "]")
f.name = "hello"
print (f.name)
g := f.Append { print " there"; }
g ()
Point := class {
    init := () => { 0; this; }
    x: int = 0
    y: int = 0
}
p := Point ()
p.x = 1
p.y = 2
q := with p {
    x = 10
}
print (p.x)
print (p.y)
print (q.x)
print (q.y)
r := with p {
    x = 100
    tmp := 999
}
print (r.x)
Point := class {
    init := () => { 0; this; }
    x: int = 0
    y: int = 0
}
p := Point ()
p.x = 1
p.y = 2
q := with p { x = 10; }
print (p.x)
print (q.x)
print (q.y)
r := with p {
    x = 100
    tmp := 999
}
print (r.x)
Animal := class {
    init := () => { 0; this; }
    name: string = ""
}
Dog := class Animal {
    init := () => {
        breed = ""
        this;
    }
    breed: string = ""
}
dog := Dog ()
dog.name = "Rex"
dog.breed = "Husky"
dog2 := with dog { name = "Max"; }
print (dog.name)
print (dog2.name)
print (dog2.breed)
# 一个类只有一个构造器,要按参数分派就在 init 里自己判断
Multi := class {
    init := (v: object) => {
        x = 0
        y = 0
        if { typeof v == int; } {
            x = int v
        } { 0; }
        this;
    }
    x: int = 0
    y: int = 0
}
a := Multi 10
b := Multi ()
print (a.x)
print (a.y)
print (b.x)
print (b.y)
try {
    throw (Exception "boom")
} (e: Exception) => {
    print "caught"
}
print "done"
try {
    throw (Exception "oops")
} (e: Exception) => {
    print "caught"
}
print "done"
result := try {
    42
} (e: Exception) => {
    0
}
print result
x := 10
eval "print x"
eval "y := 20"
eval "print (x + y)"
result := callcc (k: function) => {
    eval "k 42"
}
print result
eval "F := (a: int) => { a * 2; }"
print (F 5)
ravel "Math"
Pi := 3.14159
Square := (x: int) => { x * x; }
ravel ""
print (Math.Pi)
print (Math.Square 5)
using "math.rav"
print (Math.Pi)
print (Math.Square 6)
using "math.rav"
ravel "Math"
Tau := 6.28318
ravel ""
print (Math.Pi)
print (Math.Tau)
References = ["./tests/"]
using "132_mod_simple.rav"
print "first done"
using "132_mod_simple.rav"
print "second done"
References = ["./tests/"]
using "132_mod_simple.rav"
print "done"

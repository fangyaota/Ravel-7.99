# 运算符成员/with/类/多init/throw/eval/模块(合并 63/137/148/115/116/120/105/82/84/75/76/77/80/81/83/96/97)
print (2.operator* 7)
print ("aaa".operator== "aaa")
print ("aaa".operator== "bbb")
print (3.operator+ 4)
print (10.operator- 3)
b := { print "world"; }
c := b.prepend { print "hello"; }
c ()
f := () => { print "hi"; }
print ("[" + f.name + "]")
f.name = "hello"
print (f.name)
g := f.append { print " there"; }
g ()
Point := class {
    init ctor := () => { 0; }
    x: int = 0
    y: int = 0
}
p := Point ()
p.x = 1
p.y = 2
q := with p {
    x = 10
}
print (p.x)
print (p.y)
print (q.x)
print (q.y)
r := with p {
    x = 100
    tmp := 999
}
print (r.x)
Point := class {
    init ctor := () => { 0; }
    x: int = 0
    y: int = 0
}
p := Point ()
p.x = 1
p.y = 2
q := with p { x = 10; }
print (p.x)
print (q.x)
print (q.y)
r := with p {
    x = 100
    tmp := 999
}
print (r.x)
Animal := class {
    init ctor := () => { 0; }
    name: string = ""
}
Dog := class Animal {
    init ctor := () => {
        base = Animal ()
        breed = ""
    }
    breed: string = ""
}
dog := Dog ()
dog.name = "Rex"
dog.breed = "Husky"
dog2 := with dog { name = "Max"; }
print (dog.name)
print (dog2.name)
print (dog2.breed)
Multi := class {
    init with_val := (v: int) => {
        x = v
        y = 0
    }
    init empty := () => {
        x = 0
        y = 0
    }
    x: int = 0
    y: int = 0
}
a := Multi 10
b := Multi ()
print (a.x)
print (a.y)
print (b.x)
print (b.y)
using "try.rav"
Ex.try {
    Ex.throw (Exception "boom")
} (e: Exception) => {
    print "caught"
}
print "done"
using "try.rav"
Ex.try {
    Ex.throw (Exception "oops")
} (e: Exception) => {
    print "caught"
}
print "done"
using "try.rav"
result := Ex.try {
    42
} (e: Exception) => {
    0
}
print result
x := 10
eval "print x"
eval "y := 20"
eval "print (x + y)"
result := callcc (k: function) => {
    eval "k 42"
}
print result
eval "F := (a: int) => { a * 2; }"
print (F 5)
ravel "Math"
pi := 3.14159
square := (x: int) => { x * x; }
ravel ""
print (Math.pi)
print (Math.square 5)
using "math.rav"
print (Math.pi)
print (Math.square 6)
using "math.rav"
ravel "Math"
tau := 6.28318
ravel ""
print (Math.pi)
print (Math.tau)
references = ["./tests/"]
using "132_mod_simple.rav"
print "first done"
using "132_mod_simple.rav"
print "second done"
references = ["./tests/"]
using "132_mod_simple.rav"
print "done"

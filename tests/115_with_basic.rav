# with 关键字测试

# 基础类 with
Point := class {
    init ctor := () => { 0; }
    x: int = 0
    y: int = 0
}

p := Point ()
p.x = 1
p.y = 2

q := with p {
    x = 10
}

print (p.x)
print (p.y)
print (q.x)
print (q.y)

# with 中 := 不影响副本
r := with p {
    x = 100
    tmp := 999
}
print (r.x)
# --- expected ---
# 1
# 2
# 10
# 2
# 100

# scope 方法
T := type object { x: int = 42; }
sc := T.Proto ()
child := sc.Push ()
child.Define "y" int
print (typeof child)

vars := child.Variables ()
ks := vars.Keys ()
print (ks.Count ())

p := sc.Lookup "x"
print (typeof p)
print (p.get ())
p.set 99
print (p.get ())
# --- expected ---
# Scope
# 1
# Property
# 42
# 99

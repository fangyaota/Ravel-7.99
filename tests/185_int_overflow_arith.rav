# int 算术溢出:报错,不要静默回绕
# 从前 C# 的 unchecked 让它悄悄绕过去:`100000 * 100000` 得 1410065408、
# `2147483647 + 1` 得 -2147483648 ——「算出来了但是错的」比崩溃难查得多。
Ex.Try { 2147483647 + 1; } (e: Exception) => { print ("1: " + string e); }
Ex.Try { 100000 * 100000; } (e: Exception) => { print ("2: " + string e); }
Ex.Try { 0 - (0 - 2147483647 - 1); } (e: Exception) => { print ("3: " + string e); }
# 装得下的照常
print (2147483646 + 1)
print (0 - 2147483647)
print (0 - 2147483647 - 1)
print (5 % 3)
# 要更宽就写 bigint —— 一边是 bigint 时按宽度升级,不进 int 那条路
print (2147483647 + bigint 1)
print (bigint 100000 * 100000)
print (typeof (2147483647 + bigint 1))
# --- expected ---
# 1: 2147483647 + 1 超出 int 范围（int 是 32 位，大数用 bigint）
# 2: 100000 * 100000 超出 int 范围（int 是 32 位，大数用 bigint）
# 3: 0 - -2147483648 超出 int 范围（int 是 32 位，大数用 bigint）
# 2147483647
# -2147483647
# -2147483648
# 2
# 2147483648
# 10000000000
# BigInt

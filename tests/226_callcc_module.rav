# `callcc` × 模块：**模块加载栈 `_loading` 也是控制状态**，续延恢复时一起还原。
#
# 从模块体里逃出去 = 这次加载被**中断**。从前它两头都不对：既留在 `_loading` 里（之后
# 正常 `using` 被误报「检测到循环引用」），又已经被记进"已加载"（于是 `using` 变成
# 静默的空操作，定义缺着）。现在恢复时连 `_loading` 一起还原，并把被中断的那个从
# "已加载"里摘掉 —— 下次 `using` 从头上重来（所以下面第二遍会再打一次 "body"）。
#
# 伴侣文件是 tests/226_abort_mod.rav（它单独跑会报错，那是它自己的预期）。
References = ["tests/"]
already := false
hook: object = 0
out := callcc (k: function) => {
    hook = () => { k "escaped"; }
    using "226_abort_mod.rav"
    "loaded";
}
print out
print "again:"
using "226_abort_mod.rav"
print "third:"
using "226_abort_mod.rav"
print "done"
# --- expected ---
# body
# escaped
# again:
# body
# body end
# third:
# done

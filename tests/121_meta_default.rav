# metaclass:拿到建好的类再交出去(这里只是穿过去,真实用途是在这中间做手脚)
HasDefaults ::= class type {
    private parentInit := init;
    init = (parent: type body: function) => {
        c := parentInit parent body
        c
    } | (body: function) => {
        c := parentInit object body
        c
    }
}
Person ::= HasDefaults {
    init = () => { name = "?"; age = 0; this; }
    name: string = ""
    age: int = 0
}
p := Person ()
print (p.name)
print (p.age)
# --- expected ---
# ?
# 0

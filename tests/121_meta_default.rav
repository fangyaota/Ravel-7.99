# todo
# metaclass: 添加默认方法
HasDefaults ::= class class {
    init := (parent: type block: function) => {
        c := base.init parent block
        c
        this;
    }
}
Person ::= HasDefaults {
    init := () => { name = "?"; age = 0; this; }
    name: string = ""
    age: int = 0
}
p := Person ()
print (p.name)
print (p.age)
# --- expected ---
# ?
# 0

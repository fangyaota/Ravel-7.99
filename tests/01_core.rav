# ═══ 17_type_error(并入:原本是 expect-error 的用例,改成 try+eval 钉住文本) ═══
try { eval "X: int = 1\nX = true"; } (e: Exception) => { print ("17_type_error: " + string e); }

# ═══ 25_empty_block(并入:原本是 expect-error 的用例,改成 try+eval 钉住文本) ═══
try { eval "X := {\n}\nprint X"; } (e: Exception) => { print ("25_empty_block: " + string e); }

# ═══ 175_single_line_lambda(并入) ═══
ravel "175_single_line_lambda"
# 单行块要用 `;` 收尾 —— lambda 体也不例外
# `;` 和换行都是 Newline token,它是「这是块」的标记:没换行时 `{ x }` 是集合、
# `{ a: 1 }` 是字典,只有见到 Newline 才当块。这条规则不分位置,
# `=>` 后面的 lambda 体一样适用。
double := (x: int) => { x * 2; }
add ::= (x: int y: int) => { x + y; }
init := () => { 42; }
print (double 5)
print (add 3 4)
print (init ())
C := class {
    init = () => { 0; this; }
    probe := () => { print "hi"; }
}
c := C ()
c.probe ()
# 表达式位置同理
print ({ 1 2 })
ravel ""

# ═══ 190_lambda_body_needs_semicolon(并入:原本是 expect-error 的用例,改成 try+eval 钉住文本) ═══
try { eval "# `=> { x }` 是错的,`=> { x; }` 才对\n# 单行块靠 `;`(= Newline token)和集合/字典区分开,这条规则不看位置。\nx := 1\nf := () => { x }"; } (e: Exception) => { print ("190_lambda_body_needs_semicolon: " + string e); }

# ═══ 192_no_class_type(并入:原本是 expect-error 的用例,改成 try+eval 钉住文本) ═══
try { eval "# System 模块里不再有 Class 这个名字 —— 它作为类型已经删掉了,class 只是 type 的别名\nprint (System.Class)"; } (e: Exception) => { print ("192_no_class_type: " + string e); }

# ═══ 231_nesting_sugar(并入) ═══
ravel "231_nesting_sugar"
# `$` 与 `@` —— **括号的语法糖**，应用和 `.` 都吃。
#
#   @ 把**左边**封口：后面的成员链挂到左边那一串的**结果**上
#       x.f () @ .g ()        ≡  (x.f ()).g ()
#   $ 把**右边**封口：从这儿到表达式结束全算**一个**实参（右结合）
#       f $ a b               ≡  f (a b)
#       f $ g $ x             ≡  f (g (x))
#
# 为什么需要 `@`：`.成员` 比并列的调用绑得紧，所以 `x.f ().g ()` 会被读成
# `x.f ((().g ()))` —— 零参调用后面接链的写法就全废了（教程 6.1 那条 `(Some 5).Map f` 是同一个规矩）。

xs := [3 1 2]

# ① `@`：链式调用
print (xs.Count () @ .ToString ())
print (xs.Count () @ .ToString () @ .Length ())
print ((xs.Count ()).ToString ())          # 自己写括号，一样的

# `()` 是实参，`+ 1` 会被调用吃进去（新规矩：实参吃到运算符为止）—— 想先数再加一就得括起来
print ((xs.Count ()) + 1)

# ② `@`：显式左嵌套（`a b @ c` ≡ `(a b) c`，和 `a b c` 本来就是一回事）
add := (a: int) => { (b: int) => { a + b; }; }
print (add 1 2)
print (add 1 @ 2)

# ③ 调用比运算符**松**：实参吃到运算符为止（这才是"函数调用和运算符的优先级"那条）
inc := (n: int) => { n + 1; }
print (inc 1 * 5)          # inc (1 * 5) —— 调用抓住右边那整条算式
print ((inc 1) * 5)        # 想先算调用，自己加括号
print (inc $ 1 * 5)        # 和第一条一样（`$` 是把这件事写明白）
print (inc $ [10 20].Count ())
print (inc $ xs.Count () @ .ToString () @ .Length ())

# ④ 右结合：f $ g $ x
wrap := (n: int) => { "[" + (string (n)) + "]"; }
print (wrap $ inc $ 1 + 2)     # wrap (inc (1 + 2))

# ⑤ 两个并排用：`$` 把右边整个当一个实参（左边那串照旧并列）
print (add 1 $ inc $ 2 * 3)      # (add 1) (inc (2*3)) = 1 + 7
print (string $ add 1 $ inc $ 3) # string ((add 1) (inc 3)) → "5"

# ⑥ 位置不对就报错
try { eval "@ 1"; } (e: Exception) => { print ("1: " + string e); }
try { eval "$ 1"; } (e: Exception) => { print ("2: " + string e); }
try { eval "1 @"; } (e: Exception) => { print ("3: " + string e); }
# ═══ 括号里换行不算数 ═══
# 没闭合的 `(` / `[` 里,换行**不当语句结束** —— 表和长参数列表因此能写好看。
# 花括号**不在**这条规则里:块就是靠换行分语句的(`{ x }` 是集合、`{ a: 1 }` 是字典、
# 多行才是块),所以下面那个"列表里的多行块"照旧成立。
long := [
    1
    2
    3
]
print long
print (
    1 +
    2
)
blocks := [
    {
        print "块里第一句"
        42
    }
]
print ((blocks.At 0) ())
print "end"
ravel ""

# ═══ 233_precedence(并入) ═══
ravel "233_precedence"
# 调用比运算符**松**：实参吃到运算符为止。**没有例外**。
#
#     f 1 + 2      ≡  f (1 + 2)       —— 调用"抓住"它右边那一整条算式
#     f (1) + 2    ≡  f ((1) + 2)     —— 括号开头也一样（从前"括号组除外"那条特判已经删掉）
#     f a b        ≡  ((f a) b)       —— 并列照旧是多个实参（柯里化不受影响）
#
# 于是想"先算调用、拿结果再运算"就得自己加括号：`(f (1)) + 2`。库里 `x.Count () == 0`
# 那一类写法全改成了 `(x.Count ()) == 0`（教程 3.7 / 常见陷阱）。
print 1 + 2
print (1 + 2)
print "a" + "b"

inc := (n: int) => { n + 1; }
print (inc 1 * 5)              # inc (1 * 5)
print ((inc 1) * 5)            # 先算调用：自己加括号

add := (a: int) => { (b: int) => { a + b; }; }
print (add 1 2 * 3)            # ((add 1) (2 * 3)) —— 还是两个实参
print (add 1 2 + 3)            # ((add 1) 2) + 3

xs := [10 20 30]
print ((xs.Count ()) + 1)      # 数完再加一：把调用自己括起来
print ((xs.At (0)) + 1)        # 取第 0 个再加一
print (xs.At 0 + 1)            # 实参吃到运算符为止 → 取第 (0+1) 个

str := (v: object) => { "[" + (string (v)) + "]"; }
print (str 5)                  # 转换器的实参括起来才安稳
print (str $ 5)                # `$` 把右边整个封成一个实参
print (str 5 + 1)              # 不括：string 把 `+ 1` 也吃进去 → "[(5 + 1)]"

f := (x: int) => { x is int; }
print (f 3)                    # 词形运算符一样被吃：f (3 is int)
print (f 3 + 1)                # f (3 + 1) → 4 is int
print ((f 3) == true)          # 先算调用要加括号
# ═══ 括号里换行不算数 ═══
# 没闭合的 `(` / `[` 里,换行**不当语句结束** —— 表和长参数列表因此能写好看。
# 花括号**不在**这条规则里:块就是靠换行分语句的(`{ x }` 是集合、`{ a: 1 }` 是字典、
# 多行才是块),所以下面那个"列表里的多行块"照旧成立。
long := [
    1
    2
    3
]
print long
print (
    1 +
    2
)
blocks := [
    {
        print "块里第一句"
        42
    }
]
print ((blocks.At 0) ())
print "end"
ravel ""

# `_` 落在 Set/Dict 字面量里也要消糖
# 从前 HasHoles/CollectHoles 都漏了这两种节点,于是 `{_ + 1}` 里的 HoleExpr
# 一路带到求值器,用户看到的是「无法求值的节点类型: HoleExpr」。
_ := 0
f := {_ + 1}
print (f 40)
g := {a: _}
print (g 7)
h := [_ 2]
print (h 1)
add1 := _ + 1
print (add1 41)
both := _ + _
print (both 3 4)
# 闭包边界:`_` 在嵌套 lambda 体内,属于那一层,不被外层收走
outer := (y: int) => { _ + y; }
print (typeof (outer 10))
print ((outer 10) 5)
# --- expected ---
# {41}
# {a: 7}
# [1 2]
# 42
# 7
# Function
# 15

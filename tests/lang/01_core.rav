print L
print (L.Count ())
print (L.At 1)
double := (x: int) => { x * 2; }
add ::= (x: int y: int) => { x + y; }
noop := () => { 42; }
print (double 5)
print (add 3 4)
print (noop ())
inc := _ + 1
print (inc 5)
cut := 10 - _
print (cut 3)
both := _ + _
print (both 1 2)
Box := class {
    init = () => { 0; this; }
    probe := () => { print "hi"; }
}
b := Box ()
b.probe ()
x := 5
print (x: int)
print (x: real)
print (x: object)
print ("a": IValue)
print ([1]: list)
print (!(x: int))
print (x.: int)
f := :.int
print (f 3)
print (f "s")
n: int = 7
print n
g := (a: int) => { a + 1; }
print (g 2)
x: int { print "整数"; } { print "别的"; }
x: string { print "串"; } { print "不是串"; }
print (typeof 5)
print (typeof 99999999999)
print (typeof 5n)
print (typeof 5i)
print (typeof 2.0)
print (typeof 2f)
print (5n + 1)
print (5i * 2)
print (2f / 4)
print 99999999999n
try { eval "y := 1
f := () => { y }"; } (e: Exception) => { print ("needs_semicolon: " + string e); }
try { eval "print (System.Class)"; } (e: Exception) => { print ("no_class_type: " + string e); }
ravel "231_nesting_sugar"
xs := [3 1 2]
print (xs.Count () |> .ToString ())
print (xs.Count () |> .ToString () |> .Length ())
print ((xs.Count ()) + 1)
addf := (a: int) => { (b: int) => { a + b; }; }
print (addf 1 2)
print (2 |> addf 1)
print (1 |> addf 1 |> addf 10)
incr := (n: int) => { n + 1; }
print (incr 1 * 5)
print ((incr 1) * 5)
print (incr <| 1 * 5)
print (incr <| [10 20].Count ())
ravel ""
ravel "136_fn_meta"
# fn.scope / fn.setScope
# (原来还测 fn.setType 和 C.Proto (),但 setType 和 Proto 都已不存在——
#  ADR-0001 里「Proto / Instantiate」本来就被判定为泄漏抽象、建议砍掉)
f := () => { print "hi"; }
print (typeof (f.Scope ()))
# setScope:把函数的闭包 scope 换成实例 scope,于是函数能读到实例字段。
# 拿实例 scope 得在类方法里用 currentScope ()——外面没有 API 能拿到它。
C := class {
    init = () => { 0; this; }
    x: int = 99
    attach := (fn: function) => { fn.SetScope (currentScope ()); }
}
g := () => { x; }
c := C ()
c.attach g
print (g ())
ravel "177_param_type_mismatch"
# lambda 参数类型不对:消息要说清哪个参数、要什么、得到什么
# 从前固定是四个字「这一格要的是」,调用失败时完全看不出错在哪
f := (n: int) => { n; }
# 注意 `{ f "abc"; }` 的分号:这是**表达式位置**的块,少了它会被当成 Set
try { f "abc"; } (e: Exception) => { print ("1: " + string e); }
# | 交替靠 TypeMismatchException 分流,消息变长不影响它
g := f | (s: string) => { 0 - 1; }
print (g "abc")
print (g 7)
ravel "189_alternate_chain"
# `|` 三个以上分支也要能试到
# `x | y | z` 解析成 `(x | y) | z`。从前 `|` 只是把两侧塞进 ControlFunction,
# 于是外层那个 try 帧里那句 CallInto 只**推**了内层的帧就返回了,内层两分支都失败时
# 抛的 TypeMismatchException 已经在外层 try 之外 —— 第三个分支永远试不到。
# 现在 `|` 会把链条摊平成一个分支列表,一个帧顺序试完。
f := (a: int) => { "int"; } | (a: string) => { "str"; } | (a: bool) => { "bool"; }
print (f 1)
print (f "x")
print (f true)
try { f 1.5; } (e: Exception) => { print ("none: " + string e); }
# 两个分支照旧
g := (a: int) => { "int"; } | (a: string) => { "str"; }
print (g 1)
print (g "x")
try { g true; } (e: Exception) => { print ("none: " + string e); }
# 四个分支
h := (a: int) => { 0; } | (a: string) => { 1; } | (a: bool) => { 2; } | (a: real) => { 3; }
print (h 1)
print (h 1.5)
print (h false)


N += 3
M := 10
M %= 3
print N
print M
print (5 & 3)
print (5 | 3)
print (5 ^ 3)
print (true & false)
print (true | false)
print (true ^ true)
print (1 < 2 && 3 < 4)
print ((1 < 3) || (2 > 0 && false))
print (!false)
print 42
print ("hello".Length ())
print ({ 1 2 })

#
# **括号能省** —— 单参 lambda 那一格直接写模式,不套括号:
#
#     1 => …          true => …        "yes" => …
#     [x y] => …      {1 -> v} => …    {p q} => …
#     -1 => …         (()) => …        x => …            ← 光杆名字本来就能省
#
# 就是一格模式,和 `(模式) => …` **等价** —— 于是**按值分派**不必套一层:
#
#     pick := [1 a] => … | ["x" a] => … | (_) => …
#
# **`() => …` 不在这一条里**:那是**空参数表**(老写法,一个字没动)。
# 想写"参数必须是单位那个值"就套一层:`(()) => …`。
#
# `true` / `false` 特意收进来:在这一格它们是**字面量**(和 `(true) => …` 一个意思),
# 不是"叫 `true` 的参数"。
#
# **括号里是一格模式,不是一串** —— 所以 `( 模式 )` 只是**分组**,能套(`(((x:(int))))`);
# 要一串还是写 `[a b]`。`(a b)` 那样的两格仍旧不认。

# ── 六种 + 负号 + 光杆名字 ──
one := 1 => { "数"; }
print (one 1)
tr := true => { "真"; }
print (tr true)
st := "yes" => { "串"; }
print (st "yes")
pair := [x y] => { "一对 ${x + y}"; }
print (pair [1 2])
dic := {1 -> v} => { "字典 ${v}"; }
print (dic {1 -> 9})
P ::= class { p: int = 1; q: int = 2 }
mem := {p q} => { "成员 ${p + q}"; }
print (mem (P ()))
neg := -1 => { "负"; }
print (neg (-1))
nm := x => { "名字 ${x}"; }
print (nm 5)

# ── 裸模式当分派各支 ──
pick := [1 a] => { "首格一 ${a}"; } | ["x" a] => { "首格串 ${a}"; } | (_) => { "别的"; }
print (pick [1 5])
print (pick ["x" 5])
print (pick [9 5])

# ── 括号嵌套:只是分组 ──
pk := (((x:(int)))) => { x; }
print (pk 7)
pk2 := [((x):int):int 4 5 6] => { "x=${x}"; }
print (pk2 [3 4 5 6])
pk3 := ((1)) => { "一"; }
print (pk3 1)
pk4 := ((({"a" -> v}))) => { v; }
print (pk4 {"a" -> 8})

# ── `() => …` 还是零参 ──
z := () => { "零参"; }
print (z ())
unit := (()) => { "单位"; }
print (unit ())

# ── 括号里是**一格**模式,不是一串(一串仍旧写 `[a b]`)──
#    (`(a b) => …` 那种是**参数表**里两个参数,和这里说的不是一回事)
print ((try { eval "f := [(a b)] => 0"; } (e: Exception) => { "两格塞一个括号: " + e.Message; }))
# --- expected ---
数
真
串
一对 3
字典 9
成员 3
负
名字 5
首格一 5
首格串 5
别的
7
x=3
一
8
零参
单位
两格塞一个括号: 模式括号没闭上

#
# **拒收(`reject`)送到哪儿** —— 它不走词法、走**帧链**:沿 `Parent` 往上找**最近的**
# 交替帧(`|` 的那一枚)。所以它和 `return` / `break` 不一样:
#
#   * `return` / `break` 是 `callcc` 的 **lambda 参数**,**词法**绑定 ——
#     写在回调里出的是**那个回调**,不是外面那层函数;
#   * `reject` 是谁在链上谁接 —— 写在回调里,外面那一支照样会被它顶掉。
#
# **但 `try` 是一道边界**:`Try` 把体套在 `System.RejectStop` 里,拒收到那儿就停、
# 不再往外找。于是"`try` 的体里写的错归这个 `try`"对拒收也成立 ——
# **任务**就是靠这条:任务体本来就套着 `try`(`lib/tasks.rav` 的 `Start`,那句
# "体的错在这儿收住"),所以任务里写的 `reject` 从前会把**派发它的那一支**顶掉,现在不会。
#
# 生成的那些拒收(参数守卫、参数模式、解构的形状检查)本来就写在**支体的开头**,
# 近旁没有任何 `try` —— 边界对它们一个字都不影响。

using "tasks.rav"

# ── ① `try` 是一道边界:体里拒收,本层的 handler 接住(不往外找 `|`)──
f := (v) => { try { reject (TypeError "体里拒收"); } (e: Exception) => { "内层接了: " + e.Message; }; } | (_) => { "外面那支"; }
print (f 1)

# ── ② 任务体里拒收:记在任务自己身上,不追到派发它的那一支 ──
g := (v) => {
    print "  支1 开始"
    Tasks.Cycle [(Tasks.Task (k: Tasks.TaskGroup) => { reject (TypeError "任务里拒收"); })]
    print "  支1 尾巴"
    "支1 的结果"
} | (_) => { print "  支2 被叫起来"; "支2"; }
# (只钉消息的**头一行** —— 后面那串位置/调用栈由报错那套渲染,深度会变,不宜钉死)
print ((try { g 1; } (e: Exception) => { "兜住: " + ((System.SplitLines e.Message).At 0); }))

# ── ③ 回调里(近旁没有 `try`):还是动态的 —— 外面那一支会被顶掉 ──
h := (v) => { [1 2].Each (x: object) => { reject (TypeError "回调里拒收"); }; "支1…"; } | (_) => { "支2"; }
print (h 1)

# ── ④ 本行该干的活没被带歪:守卫 / 参数模式 / 解构照旧 ──
k := (v == 1) => { "守卫生效"; } | (_) => { "换支"; }
print (k 1)
print (k 2)
m := ([x y]) => { x + y; } | (_) => { "不是一对"; }
print (m [3 4])
print (m 5)
print ((try { [q w] := 5; } (e: Exception) => { "解构: " + e.Message; }))
# --- expected ---
# 内层接了: 体里拒收
#   支1 开始
# 兜住: 有 1 个任务失败了,而没人接它的错 —— 谁起的任务谁负责等它(`group.Await` / `.Value`)
# 支2
# 守卫生效
# 换支
# 7
# 不是一对
# 解构: 要的是能按顺序取的东西（list / set / dict / 字符串 / Generator…），得到 Integer

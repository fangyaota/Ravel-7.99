# `Prepend` / `Append` 收的块能拿到**这次调用**的作用域。
#
# 传 `(sc) => { … }` 时,`sc` 就是被接的那个函数这次调用要用的那一层:
# `Prepend` 的块在函数体之前跑,往 `sc` 里 `Define` 的东西,函数体(以及
# 体里嵌套的闭包)当场就能读到 —— `reject` 这种要交给"函数体深处"的
# 名字就是这么进去的。`Append` 的块在体之后跑,读到的是体留下的现场。
#
# 传裸块 `{ … }` 还是老规矩:块在自己被写下的那层跑,收一枚 `()`。

f := () => { k; }
g := f.Prepend ((sc) => { sc.Define "k" "injected"; })
print (g ())

# 每次调用是新的一层:注入不会留到下一次、也不会漏给别的函数
print (g ())
h := () => { k; }
try {
    h ();
} (e: Exception) => {
    print ("接住: " + string e)
}

# 函数体里再套闭包也看得见(闭包捕获的就是这一层)
nested := () => {
    inner := () => { k; }
    inner ();
}
print ((nested.Prepend ((sc) => { sc.Define "k" "deep"; })) ())

# 参数照旧绑在同一层,注入的名字与参数并存
add := (x: int) => { x + base; }
print ((add.Prepend ((sc) => { sc.Define "base" 100; })) 5)

# 裸块的老写法不变
p := () => { 7; }
print ((p.Prepend { 1; }) ())

# Append:块跑在体之后
order := []
body := () => { order.Add "body"; 3; }
print ((body.Append ((sc) => { order.Add "after"; })) ())
print order
# --- expected ---
# injected
# injected
# 接住: 未定义的变量 'k'
# deep
# 105
# 7
# 3
# [body after]

ravel "m43"
Method ::= interface {
    whom := () => { "serving " + (instance.ToString ()); }
}
Servant ::= class {
    init = () => { this; }
    ToString := () => { "servant"; }
}
m := Method Servant {
    ()
}
use m
sv := Servant ()
print (sv.whom ())

Proto ::= interface {
    by a : function = _
    b : function = _
}
P ::= class { init = () => { this; } }
pa := Proto P {
    ()
}
use pa
p := P ()
print (p.a)
print (p.b)

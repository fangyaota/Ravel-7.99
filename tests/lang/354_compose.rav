#
# `<<` `>>` 是**同一枚符号的两种意思**,按左操作数的类型分派:
#
#   * 整数 / 大整数 → 移位(`5 << 1`、`(0 - 8) >> 1` 那套,符号留着);
#   * 函数 → **组合**:`f >> g` 先 f 后 g(`g (f x)`),`f << g` 先 g 后 f(`f (g x)`)。
#
# 读的时候看左边是谁就够了。两条都左结合,可以一串写下去。

f := (x: int) => { x + 1; }
g := (x: int) => { x * 2; }
h := (x: int) => { x - 10; }

# ── 函数那边 ──
print ((f >> g) 3)          # g (f 3) = (3+1)*2 = 8
print ((f << g) 3)          # f (g 3) = 3*2+1   = 7

# 反向组合就是"把两枚函数倒过来":(f << g) 与 (g >> f) 一样
print (((f << g) 3) == ((g >> f) 3))

# 左结合、可以串
print ((f >> g >> h) 3)     # ((3+1)*2)-10 = -2
print ((f << g << h) 3)     # f(g(h(3)))  = (-7)*2+1 = -13

# 类型照旧收:组合出来仍是一枚函数
print (typeof (f << g))

# ── 整数那边:还是移位 ──
print (5 << 1)
print (5 >> 1)
print ((0 - 8) >> 1)

# --- expected ---
8
7
true
-2
-13
Function
10
2
-4

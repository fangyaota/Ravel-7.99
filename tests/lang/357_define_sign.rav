#
# 定义一律写 `:=`。唯一的缩写:带类型注解时 `:=` 可以写成 `=`
#   n : int := 5   ≡   n : int = 5
# 解构同理:`[a b] := e`,带类型时 `[a b] : list = e` 也行;
# 不带类型的 `[a b] = e` 是**解构赋值**(见 358),里面的名字走 `=`、必须已经存在。
#
# 语句级的约束式定义也一样:`a == 1 := e`,写 `=` 报错。

n : int := 5
print n

m : int = 6
print m

[x y] := [1 2]
print [x y]

[u v] : list = [3 4]
print [u v]

w == 1 := 1
print w

print ((try { eval "[p q] = [1 2]"; } (e: Exception) => { "1: " + e.Message; }))
print ((try { eval "r == 1 = 2"; } (e: Exception) => { "2: " + e.Message; }))

# --- expected ---
# 5
# 6
# [1 2]
# [3 4]
# 1
# 1: 无法给未定义变量 'p' 赋值
# 2: '=' 的左边得是变量或成员

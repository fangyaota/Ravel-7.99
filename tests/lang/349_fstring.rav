# f-string:`f"…{表达式}…"` —— `{` 起插值,`{{` / `}}` 才是字面量花括号。
#
# 它不是新语义:lowering 把它拼成 `"" + "…" + string(表达式) + …`,
# 和手写的 `+` 链走同一条路(求值器见到的只是 `+`)。
# 老的 `"…${表达式}…"` 一个字都没动,两种糖纸并存。

n := 42
name := "甲"
print (f"共 {n} 件")
print (f"{name}: {n * 2}")
print (f"plain")
print (f"{{花括号}} 和 {n}")
print (f"$5 不是插值,{1 + 1}")
print (f"${n} 在 f-string 里是字面量")
print (f"转义:\t制表 {3}")
print (f"{true} {1.5} {'a'} {[1 2]}")

# 拼出来的和手写的 `+` 链是同一个值
print ((f"{n}") == ("" + (string n)))
print ((f"{n + 1}{name}") == ((string (n + 1)) + name))

# 老的写法照旧
print ("老的 ${n} 仍然插值")
# --- expected ---
# 共 42 件
# 甲: 84
# plain
# {花括号} 和 42
# $5 不是插值,2
# $42 在 f-string 里是字面量
# 转义:	制表 3
# true 1.5 a [1 2]
# true
# true
# 老的 42 仍然插值

try { int 9999999999999; } (e: Exception) => { print ("1: " + string e); }
try { int (bigint 2147483648); } (e: Exception) => { print ("2: " + string e); }
try { int (real 100000000000000000000.0); } (e: Exception) => { print ("3: " + string e); }
try { int (bigfraction 2147483648 1); } (e: Exception) => { print ("4: " + string e); }

try { bigint NaN; } (e: Exception) => { print ("5: " + string e); }
try { bigint Inf; } (e: Exception) => { print ("6: " + string e); }

print (int 2147483647)
print (int (bigint 0 - 2147483648))
print (int (fraction 7 2))
print (int true)

print (real (bigint 5))
z: real = real (bigint 5)
print z
x: int = int 3.9
print x
y: int = int (bigint 7)
print y

try { eval "# 分数的分母不能为零。以前 `fraction 1 0` 会造出一个 `1/0` 的无效分数,\n# 之后 `int (fraction 1 0)` 就抛 C# 的 DivideByZeroException。\n# 字符串形式 `fraction \"1/0\"` 一直有检查,构造器这条漏了。\nprint (fraction 1 0)"; } (e: Exception) => { print ("160_fraction_zero_den: " + string e); }

ravel "185_int_overflow_arith"

try { 2147483647 + 1; } (e: Exception) => { print ("1: " + string e); }
try { 100000 * 100000; } (e: Exception) => { print ("2: " + string e); }
try { 0 - (0 - 2147483647 - 1); } (e: Exception) => { print ("3: " + string e); }

print (2147483646 + 1)
print (0 - 2147483647)
print (0 - 2147483647 - 1)
print (5 % 3)

print (2147483647 + bigint 1)
print ((bigint (100000)) * 100000)
print (typeof (2147483647 + bigint 1))
ravel ""

print ((0 - 7) % 3)
print (7 % (0 - 3))
print (typeof (5 % 3))
print (5 % 3.5)

print ((fraction 7 2) % 2)
print ((fraction 7 2) % (fraction 1 2))
print ((bigfraction 7 2) % 2)
print ((fraction (0 - 7) 2) % 2)

n := 10
n %= 3
print n

try { (fraction 1 2) % (fraction 0 3); } (e: Exception) => { print ("mod0: " + string e); }
ravel "m8"
print (1 << 4)
print (1 << 31)
print (1 << 32)
print (1 << bigint 40)

print (16 >> 2)
print ((0 - 8) >> 1)
print ((0 - 1) >> 40)

print (1 <<< 1)
print (1 <<< 33)
print (256 >>> 4)
print (5 >>> 1)
print ((0 - 1) <<< 1)
print (1 <<< 0)

print ((bigint 1) << 40)
print ((bigint (0 - 8)) >> 1)
print (typeof ((bigint 1) << 40))

print (1 + 2 << 3)
print (2 << 1 == 4)

try { print (1 << (0 - 1)); } (e: Exception) => { print ("1: " + string e); }
try { print (1 << "2"); } (e: Exception) => { print ("2: " + string e); }
try { print ((bigint 1) <<< 2); } (e: Exception) => { print ("3: " + string e); }

print ([1 2 3].Map (<<.1))
ravel ""
ravel "m9"
n : int = _
print n
s : string = _
print ("[" + s + "]")
f : function = _
print (f ())
print (typeof f)
l : list = _
print l
c : char = _
print (c == default char)
b : bigint = _
print (b + 1)
bf : bigfraction = _
print bf

print (n == default int)
print ((string ()) == "()")
try { eval "o : object = _"; } (e: Exception) => { print ("1: " + string e); }
try { eval "x : int = \"s\""; } (e: Exception) => { print ("2: " + string e); }

print (default bool)
print (default set)
print (default Continuation)
print (typeof (default list))
try { eval "default 5"; } (e: Exception) => { print ("3: " + string e); }

T ::= interface {
    by a : int = _
}
C ::= class {
    q : int = 7
}
impl (T C {
    by a = property (() => { 9; }) ((v: int) => {;})
})
u := C ()
print u.a
u.a = 5
print u.a
ravel ""


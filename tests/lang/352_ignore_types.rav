# `#ignoreTypes true` / `#ignoreTypes false` —— 夹在中间的代码,所有类型注解
# 都只当摆设:变量定义、参数定义、模式匹配,三道检查一道都不发。
#
# 注解还在树上(所以 `x: int = _` 照样拿得到 `default int`),但不再为它生成
# `x : T` 那样的判断 —— 想临时跑一段"不带类型"的代码,不用一路删注解。

#ignoreTypes true
x: int = "s"
print x

f := (a: int) => { a; }
print (f "s")

pat := (1) => { "one"; } | (2) => { "two"; }
print (pat 1)

n: int = _
print n

g := ([a b]: list) => { a + b; }
print (g [1 2])

#ignoreTypes false
try { z: int = "s"; } (e: Exception) => { print "back: " + (string e); }
h := (a: int) => { a; }
try { h "s"; } (e: Exception) => { print "param: " + (string e); }
print "done"
# --- expected ---
# s
# s
# one
# 0
# 3
# back: 这一格要的是 Integer，得到 String
# param: 参数 'a' 需要 Integer，得到 String
# done

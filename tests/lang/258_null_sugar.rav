# 空值那三条语法糖:`?.` / `??` / `??=`。
#
# **「空」只有 `None` 一样** —— `()` 不是空:它是 Void 类型那个**值**,和 `0` / `""` / `[]`
# 平起平坐;`Some ()` 更不是(有个值,值是 `()`)。要"没设过"就明写 `None`:
#
#     Cache: Option = None
#     Cache ??= 算一次 ()
#
# 语义在库里(`lib/predefined.rav` 的 IsNothing / NilChain / NilOr),
# 引擎只管把这三条脱糖成对它们的调用(词法/语法见 Lexer、Parser.Expressions)。
#
#     a ?? b    不空**原样交回**,空了才给 b(**惰性**:要用才求值);左边不是 monad 就报错
#     a?.b c    空**原样**短路;`Some x` 拿着 `x` 走完整条链(含调用)再包回去
#     x ??= v   空才写;不空一个字符都不碰(连 setter 都不调)

# ── `??`:空才给后备 ──
print ((None ?? 0))
print ((Some 7) ?? 0)          # 不空,原样交回(还是 Option)
后备值 := "有值"
# 不是 monad 的左边直接报错(不会悄悄当成"取成员")
try { eval "print (5 ?? 1)"; } (e: Exception) => { print ("4: " + string e); }
print ("串" ?? 后备值)
nothing := ()
try { eval "print (nothing ?? 1)"; } (e: Exception) => { print ("5: " + string e); }

# `Some ()` 也不是空(值是 `()` 而已)
print (((Some ()) ?? "后备"))

# ── `?.`:只有 None 短路 ──
print ((None?.Count ()) ?? "空")
print ((Some "abc")?.Length ())           # Some 里的值走完链,**再包回去**
print (((Some "abc")?.Length ()) ?? -1)   # 不空,原样交回(还是 Option)
print ((None?.Length ()) ?? -1)

# 不是 monad 的左边直接报错(不会悄悄当成"取成员")
try { eval "print ((5)?.ToString ())"; } (e: Exception) => { print ("0: " + string e); }

# 是 monad(IMonad)就按 Map 走 —— list / dict / string 都算
print ((["ab" "c"]?.Length ()) ?? -1)

# `()` 上取成员**照旧报错** —— 不被悄悄吞掉
try { nothing?.Text (); } (e: Exception) => { print ("1: " + string e); }

# 短路:后面的调用**不该跑**
boom := () => { print "不该跑"; 0; }
print ((None?.Value ()) ?? "没跑")

# ── `??=`:空才写 ──
Holder ::= class {
    Name: object = None
    Hits: int = 0
}
h := Holder ()
print (h.Name ??= "第一次")
print (h.Name ??= "第二次（不该盖）")
print h.Name
# 不是 monad 的槽位不能 `??=`(`0` 是值,不是"空")
try { eval "print (h.Hits ??= 7)"; } (e: Exception) => { print ("6: " + string e); }

# 不空就**一个字符都不碰**:setter 里记账,看得见
Counted ::= class {
    Writes: int = 0
    Storage: object = None
    by Value := property (() => { Storage; }) ((v: object) => { Writes += 1; Storage = v; })
}
c := Counted ()
print (c.Value ??= "写上")     # 空 → 写一次
print c.Writes
print (c.Value ??= "再来")     # 不空 → 一次都不写
print c.Writes

# 成员那条:接收者只求一次
Times := 0
mk := () => { Times += 1; c; }
print (mk () |> .Value ??= "不该写")
print Times

# ── 和 `_` 占位符处得来:糖生成的那几枚闭包**不是**闭包边界 ──
# (它们只是把表达式挪个地方,里面的 `_` 还是外层语句的洞 —— 见 Parser.Holes 的 Children)
pick := (_ ?? "兜底")
print (pick (None))
print (pick (Some "有"))
has := (_?.Count ())
print ((has [["a"] ["bc"]]) ?? -1)   # list 也是 monad:`?.` 就是逐元素 Map
print (has (None))            # None 还是 None

# ── 和 `|>` 搭:一路 `?.` 喂下去 ──
# `?.` 是「拆开—走一趟—包回去」,所以每过一段形状**还是 Option**,不会叠成 `Some (Some x)`;
# `None` 从头短路到尾(中间那些 `.成员` 一次都不跑),末尾用一个 `??` 收口。
print (Some "  hi  " |> ?.Trim ())
print (None |> ?.Trim ())
print (Some "  hi  " |> ?.Trim () |> ?.Length ())
print (None |> ?.Trim () |> ?.Length ())
print ((Some [1 2 3] |> ?.Count ()) ?? 0)
print ((None |> ?.Count ()) ?? 0)

# ── 报错:左值不是变量/成员、单独的 `?` ──
try { eval "(1 + 2) ??= 3"; } (e: Exception) => { print ("2: " + string e); }
try { eval "1 ? 2"; } (e: Exception) => { print ("3: " + string e); }

# --- expected ---
# 0
# Option { Has = true, Inner = 7 }
# 4: '??' 的左边得是个 monad（`IMonad`：Option / list / dict / set / string …）—— 得到 Integer
# 串
# 5: '??' 的左边得是个 monad（`IMonad`：Option / list / dict / set / string …）—— 得到 Void
# Option { Has = true, Inner = () }
# 空
# Option { Has = true, Inner = 3 }
# Option { Has = true, Inner = 3 }
# -1
# 0: '?.' 的左边得是个 monad（`IMonad`：Option / list / dict / set / string …）—— 得到 Integer
# [2 1]
# 1: '?.' 的左边得是个 monad（`IMonad`：Option / list / dict / set / string …）—— 得到 Void
# 没跑
# 第一次
# 第一次
# 第一次
# 6: '??' 的左边得是个 monad（`IMonad`：Option / list / dict / set / string …）—— 得到 Integer
# 写上
# 1
# 写上
# 2
# 写上
# 1
# 兜底
# Option { Has = true, Inner = 有 }
# [1 1]
# Option { Has = false, Inner = () }
# Option { Has = true, Inner = hi }
# Option { Has = false, Inner = () }
# Option { Has = true, Inner = 2 }
# Option { Has = false, Inner = () }
# Option { Has = true, Inner = 3 }
# 0
# 2: '??=' 的左边得是变量或成员（就像 '=' 那样）
# 3: '?' 只用在 '?.' / '??' / '??=' 里（没有三目运算符）

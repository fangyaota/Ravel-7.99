# `_` 在定义处就是"问类型要它的零值"：`x : T = _` 脱糖成 `x : T = default T`。
#
# `default` 是一枚普通函数(见 `lib/predefined.rav`),本体是一张表
# (`BuiltinClasses.DefaultValue`):只有"有零值"的类型配得上。`()` 不是空值 ——
# `int ()` / `list ()` 都不再是"给我默认值"那条路(函数和续延例外,见各自那两格)。

n : int = _
print n
s : string = _
print ("[" + s + "]")
f : function = _
print (f ())
print (typeof f)
l : list = _
print l
c : char = _
print (c == default char)
b : bigint = _
print (b + 1)
bf : bigfraction = _
print bf

# 脱糖的那一格和 `default T` 是同一个值
print (n == default int)
print ((string ()) == "()")   # `()` 的文本就是 `()`,不是空串
try { eval "o : object = _"; } (e: Exception) => { print ("1: " + string e); }
try { eval "x : int = \"s\""; } (e: Exception) => { print ("2: " + string e); }

# `default` 也能直接拿来用(不带注解)
print (default bool)
print (default set)            # SetVal 的文本就是 {}
print (default Continuation)
print (typeof (default list))
try { eval "default 5"; } (e: Exception) => { print ("3: " + string e); }

# `by` 那格脱糖成 `property ()`：一对什么都不做的 getter/setter。
T ::= interface {
    by a : int = _
}
C ::= class {
    q : int = 7
}
impl (T C {
    by a = property (() => { 9; }) ((v: int) => {;})
})
u := C ()
print u.a
u.a = 5
print u.a
# --- expected ---
# 0
# []
# ()
# Function
# []
# true
# 1
# 0/1
# true
# true
# 1: 类型 Object 没有默认值
# 2: 这一格要的是 Integer，得到 String
# false
# {}
# <续延 default>
# List
# 3: default 要一个类型，得到 Integer
# 9
# 9

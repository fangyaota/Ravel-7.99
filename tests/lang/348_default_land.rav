# `_` 在定义处就是"这个类型造一个空值"：`x : T = _` 脱糖成 `x : T = T ()`。
#
# 没有底类型那道坎了 —— 造出来的本来就是 T 的值，之后 `n + 1` 直接能算。
# 不同类型的空值（`Int ()` 给 0、`String ()` 给 ""、`List ()` 给空表…）由各类型的
# `init` 那一格决定。

n : int = _
print n
s : string = _
print ("[" + s + "]")
f : function = _
print (f ())
print (typeof f)
l : list = _
print l
c : char = _
print (c == '\0')
b : bigint = _
print (b + 1)
bf : bigfraction = _
print bf

# `by` 那格脱糖成 `property ()`：一对什么都不做的 getter/setter。
T ::= interface {
    by a : int = _
}
C ::= class {
    q : int = 7
}
impl (T C {
    by a = property (() => { 9; }) ((v: int) => {;})
})
u := C ()
print u.a
u.a = 5
print u.a
# --- expected ---
# 0
# []
# ()
# Function
# []
# true
# 1
# 0/1
# 9
# 9

#
# **解构定义** —— 按形状把右边那个值拆成一串名字。两种模式:
#
#     [x _ z ..rest] : T = e     # 列表模式:按位置取。`_` 跳过,`..名字` 拿剩下的
#                                # (`rest` 只是惯用名 —— 后面跟什么就叫什么)
#     {x y z} : U = e            # 对象模式:从对象上取**同名成员**
#
# 它们能和 `x : T = e` 一个待遇:注解可省(省了写 `:=`)、前面能挂修饰符、类体里能用。
# 两种能嵌套(`[x _ {y z}]`)。
#
# **落点是"定义"**,所以绑出来的是**新名字**:`[x y] = e`(光一个 `=`)不认 ——
# 那读起来像"赋值给已经有的 x、y",和 `x = v` 撞。要定义就 `:=`,要带类型就 `: T =`。
#
# 解析器只把形状读出来,拆法是 `Syntax/Lowering.Destructure` 的事(和 `do` / `??` 一个规矩):
# 列表模式走**枚举器**(`GetEnumerator` → `MoveNext` → `Current`,和 `foreach` 同一条路),
# 对象模式就是连着取几个成员 —— 所以右边那个值**只求一次**(中间量落地)。

# ── 列表模式:按位置 ──
[x y] := [10 20]
print (x + y)

# ── `_` 跳过(游标**照走**,不是"不取")、`..rest` 拿剩下的 ──
[ka _ kc ..krest] := [1 2 3 4 5]
print ka
print kc
print (krest.ToList ())

# ── 对象模式:取同名成员 ──
Point ::= class {
    px: int = 0
    py: int = 0
}
p := Point ()
p.px = 3
p.py = 4
{px py} := p
print (px + py)

# ── 嵌套 ──
[[m n] [q]] := [[1 2] [3]]
print (m + n + q)

# ── 注解管的是**右边那个值**(和 `x : T = v` 一个意思)──
[p0 q0] : list = [4 5]
print (p0 + q0)
print ((try { eval "[u v] : list = 5"; } (e: Exception) => { "1: " + e.Message; }))
# 没 `=` 就还是**类型判断**,别把这条吞了
print ([1 2] : list)
print ([1 2] : int)

# ── 右边那个值只求一次 ──
calls := 0
mk := () => { calls += 1; [7 8]; }
[mm nn] := mk ()
print (mm + nn)
print calls

# 对象模式那边更要紧(一个值要取好几个成员)
P2 ::= class { a: int = 0; b: int = 0 }
cc := 0
mk2 := () => { cc += 1; P2 (); }
{a b} := mk2 ()
print cc
print (a + b)

# ── 凡是能枚举的都行:字符串 ──
[s0 s1 ..tail] := "abcdef"
print s0
print s1
print ((tail.ToList ()).Join "")

# ── `..` 后面那个名字自己起(`rest` 只是惯用名)──
[r0 ..其他] := [1 2 3]
print (其他.ToList ())
[r1 ..r] := [4 5]
print (r.ToList ())
[..全部] := [6 7]
print (全部.ToList ())

# ── 类体里也一样,修饰符跟着每个拆出来的名字走 ──
Box ::= class { sx: int = 5; sy: int = 6 }
Sq ::= class {
    [q1 r1] := [3 4]
    private {sx sy} := (Box ())
    Sum := () => { sx + sy; }
}
s := Sq ()
print (s.q1)
print (s.r1)
print (s.Sum ())

# ── 边界 ──
# `..rest` 写在中间:后面的格子永远取不到,当场报
print ((try { eval "[a ..r b] := [1 2 3]"; } (e: Exception) => { "2: " + e.Message; }))
# 空模式
print ((try { eval "[] := [1]"; } (e: Exception) => { "3: " + e.Message; }))
print ((try { eval "{} := 1"; } (e: Exception) => { "4: " + e.Message; }))
# 对象模式里没有 `_` 这一格(不要的成员别写出来就行)
print ((try { eval "{_ x} := 1"; } (e: Exception) => { "5: " + e.Message; }))
# `by` 是换槽的,和解构凑不到一起
print ((try { eval "by [x y] := [1 2]"; } (e: Exception) => { "6: " + e.Message; }))
# 序列比模式短:报的是底层那条越界(位置指得到)
print ((try { [z1 z2 z3] := [1 2]; } (e: Exception) => { "7: " + e.Message; }))
# `.._` 不行:`_` 是丢弃/占位的记号,不是名字
print ((try { eval "[p .._] := [1 2]"; } (e: Exception) => { "8: " + e.Message; }))
# --- expected ---
# 30
# 1
# 3
# [4 5]
# 7
# 6
# 9
# 1: 类型不匹配: 无法将 Integer 赋值给 List — 无法将 Integer 转换为 List
# true
# false
# 15
# 1
# 1
# 0
# a
# b
# cdef
# [2 3]
# [5]
# [6 7]
# 3
# 4
# 11
# 2: '..名字' 只能写在模式的最后一项 —— 它把后面都吃了
# 3: 列表模式里得有一格（`[]` 没东西可解）
# 4: 对象模式里得写成员名（`{x y}`）
# 5: 对象模式里没有 '_' 这一格 —— 不想要的成员别写出来就行
# 6: 解构定义不能用 'by' —— 它拆出来的是一串新名字，不是槽
# 7: list.At 的索引 2 越界 (列表长度 2)
# 8: '..' 后面要一个真名字 —— `_` 是丢弃/占位的记号，当不了名字

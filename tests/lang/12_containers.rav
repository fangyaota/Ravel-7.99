ravel ""
ravel "m28"
n := 0
mk := () => { property (() => { n; }) ((v: int) => { n = v; }) }

[by x] := [(mk ())]
print x
x = 42
print "${x} / ${n}"

by [u v] := [(mk ()) (mk ())]
u = 7
print "${u} / ${n}"

f := (by y: int) => { y = y + 1; y; }
print (f (mk ()))
print n

g := ([by z]) => { z = 100; z; }
print (g [(mk ())])
print n

print (try { [by bad] := [5]; bad; } (e: Exception) => { e.Message; })

print f

n : int := 5
print n

m : int = 6
print m

[x y] := [1 2]
print [x y]

[u v] : list = [3 4]
print [u v]

w == 1 := 1
print w

print ((try { eval "[p q] = [1 2]"; } (e: Exception) => { "1: " + e.Message; }))

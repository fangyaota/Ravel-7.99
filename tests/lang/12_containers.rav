ravel "m26"
print [1..]
print ([1..] == [1..Inf])
print ([..1] == [-Inf..1])

print (([1..].Take 3).ToList ())
print (([1..Inf].Take 3).ToList ())
print (([..1].Take 3).ToList ())
print (([1..-Inf].Take 3).ToList ())
print ((([1..].Where (x: object) => { (x % 2) == 0; }).Take 3).ToList ())

print ([1..].First ())
print ([..1].First ())
print ([Inf..1].First ())
print ([1..].Step ())
print ([..1].Step ())
print ([1..].IsEmpty ())
print ([1..].IsBounded ())
print ([..1].IsBounded ())
print ([1..3].IsBounded ())

print ([1..].Contains 99999)
print ([1..].Covers 2.5)
print ([..1].Contains 99999)
print ([..1].Contains (-99999))

print [..]
print ([-Inf..Inf] == [..])
print ([..].IsWhole ())
print ([..].IsBounded ())
print ([..].IsEmpty ())
print ([..].Contains 12345)
print ([..].Contains (-12345))
print ([..].Covers 2.5)
print ([1..].IsWhole ())
print ([1..3].IsWhole ())

try { [..].First (); } (e: Exception) => { print ("1: " + string e); }
try { [1..].Count (); } (e: Exception) => { print ("2: " + string e); }
try { [1..].Last (); } (e: Exception) => { print ("3: " + string e); }
try { [1..].ToList (); } (e: Exception) => { print ("4: " + string e); }
try { [..].Count (); } (e: Exception) => { print ("5: " + string e); }

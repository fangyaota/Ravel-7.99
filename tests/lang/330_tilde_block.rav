#
# **`~x` 就是 `{x;}`** —— 只吃**一个原子**,吃完整成一个**块**。
#
#     ~x          ≡  {x;}
#     ~5 + 3      ≡  {5;} + 3        （`+` 落在**块**上,不是块里 —— 只吃原子）
#     x => ~x     ≡  x => {x;}       （体就是那个块,所以**封口**）
#
# 吃的是**一个操作数**:原子 + 它那串 `.成员` / `?.`(那是一**条链**)——
# 所以 `~x.y?.z` 就是 `{x.y?.z;}`。**并列的实参不吃**(调用是"应用",不是后缀):
# `~f 1` 是 `{f;} 1`。要更大的范围自己加括号:`~(f 1)`。
#
# **块是块**,不是它的值:`{5;}` 当一个值用是个**可调用的块**(所以 `+ 3` 会报
# 「Block 不支持运算符 '+'」),要块的值就调它:`(~5) ()` 是 5。
# 这一点上 `~` 和 `{…}` 一字不差 —— 下面是逐项对着验的。
#
# lambda 体那边差别最要紧:`x => ~x` 走**块**那条(封口,`x => ~x + 1` 里 `+1` 落在
# lambda 上),`x => ({x;})` 走**表达式**那条(吃尽,`+1` 进体)。两种都在这儿钉着。

# ── 和 `{x;}` 逐项对照 ──
print (~5)
print ({5;})
print ((~5) ())
print (({5;}) ())

# ── 当语句用 ──
x := 7
~x
print "过了"

# ── 吃的是"一个操作数":原子 + 成员链 ──
Q ::= class {
    z: int = 9
}
P ::= class {
    y: object = Q ()
}
p := P ()
print ((~p.y?.z) ())
print (({p.y?.z;}) ())
print ((~p.y) ())
print (~p)
print ((try { print (~p.y.z.y); } (e: Exception) => { "链到哪儿: " + e.Message; }))

# ── 并列的实参不吃(调用是应用,不是后缀) ──
add1 := (n: int) => { n + 1; }
print ((try { print ((~add1 1) ()); } (e: Exception) => { "1 落在块外面: " + e.Message; }))

# ── 和一元号不同层 ──
print (-~5 ())
print (~(-1) ())

# ── lambda 体:封口 vs 吃尽 ──
print (x => ~x)
print ((try { f := x => ~x + 1; } (e: Exception) => { "封口: " + e.Message; }))
print ((try { f := x => ({x;}) + 1; print (f 5); } (e: Exception) => { "吃尽: " + e.Message; }))

# ── 块能当实参传 ──
run := (b: function) => { b (); }
print (run ~9)
# --- expected ---
# <block>
# <block>
# 5
# 5
# 过了
# 9
# 9
# Q { z = 9 }
# <block>
# <block>
# ()
# 1 落在块外面: 参数 'n' 需要 Integer，得到 Void
# -5
# -1
# <function (x: object) => { x; }>
# 封口: 类型 Function 不支持运算符 '+'
# 吃尽: 类型 Block 不支持运算符 '+'
# 9

result := callcc (k: function) => {
    k 42
}
print result
result = callcc (k: function) => {
    k (1 + 2)
}
print result
F := (x: int) => {
    callcc (return: function) => {
        x < 0 {
            return 0
        } {
            return x
        }
    }
}
print (F 10)
print (F (-5))
F = (x: int) => {
    callcc (exit: function) => {
        i := 1
        while {
            true
        } {
            i > x {
                exit i
            } {
                0
            }
            i += 1
        }
        0
    }
}
print (F 5)
X := [1 2 3 4 5]
result = callcc (found: function) => {
    i := 0
    while {
        i < X.Count ()
    } {
        val := X.At i
        val > 3 {
            found val
        } {
            0
        }
        i += 1
    }
    0
}
print result
product := (list: list) => {
    callcc (return: function) => {
        result := 1
        i := 0
        while {
            i < list.Count ()
        } {
            val := list.At i
            val == 0 {
                return 0
            } {
                0
            }
            result = result * val
            i += 1
        }
        result
    }
}
print (product [2 3 4])
print (product [2 0 4])

saved := (x: int) => { x; }
trace := []
n := 0
n = 1 + callcc (k: function) => {
    saved = k
    0
}
trace.Add n
n < 10 { saved 10; } { 0; }
print trace

seen := []
m := 0
m = callcc (k: function) => {
    saved = k
    0
}
seen.Add m
m < 3 { saved (m + 1); } { 0; }
print seen

i := 0
total := 0
again := (x: int) => { x; }
callcc (k: function) => { again = k; }
i += 1
total += i
i < 5 { again 0; } { 0; }
print total

result = 0
try {
    throw (Exception "boom")
    result = 1
} (e: Exception) => {
    result = 99
}
print result
result = callcc (k: function) => {
    k (k 3)
}
print result

ravel "224_callcc_loops"

i := 0
out := callcc (esc: function) => {
    while { i < 10; } {
        i += 1
        i == 3 { esc i; } { 0; }
    }
    999
}
print out
print i

seen: list = []
r1 := callcc (k: function) => {
    [1 2 3 4].Foreach (x: int) => {
        seen.Add x
        x == 3 { k x; } { 0; }
    }
    999
}
print r1
print seen

done: list = []
r2 := callcc (k: function) => {
    [1 2 3 4].Foreach (x: int) => { done.Add x; x == 2 { k x; } { 0; } }
    999
}
print r2
print done

stuck := 0
try {
    [1 2 3].Foreach (x: int) => {
        stuck += 1
        x == 2 { throw (Exception "boom"); } { 0; }
    }
} (e: Exception) => { print ("caught " + string e); }
print stuck
print (Ex.HandlerStack.Count ())

escN: object = 0
n := 0
r := callcc (k: function) => { escN = k; "first"; }
print r
n += 1
n < 3 { escN ("again " + string n); } { 0; }
print r

escM: object = 0
haveM := false
doneM := false
mm := [1 2 3].Map (x: int) => {
    x == 2 {
        !haveM { haveM = true; escM = callcc (k: function) => { k; }; } { 0; }
    } { 0; }
    x * 10;
}
print mm
try { !doneM { doneM = true; escM 99; } { 0; }; } (e: Exception) => { print ("M: " + string e); }
print mm
print "end"
ravel ""

ravel "226_callcc_module"

ReferencesPath = ["tests/lang/"]
already := false
hook: object = 0
out := callcc (k: function) => {
    hook = () => { k "escaped"; }
    using "226_abort_mod.rav"
    "loaded";
}
print out
print "again:"
using "226_abort_mod.rav"
print "third:"
using "226_abort_mod.rav"
print "done"
ravel ""
ravel "m17"
print (2 - 3 - 4)
print (16 / 4 / 2)
print (100 % 7 * 2)
print (2 * 3 + 4 * 5)
print (10 - 2 * 3)

print (2 ** 3 ** 2)
print (-2 ** 2)
print (2 ** -1)
print (-2 * 3)

print (1 << 2 + 1)
print (1 << 2 << 1)
print (2 >> 1 >> 1)
print (5 >>> 1)

print (2 << 1 == 4)
print (1 < 2 == true)
print (int <: object)
print (object :> int)

print (1 : int && true)
print (!(1 : string))
print (1 : int == true)

print (3 ^ 1 & 1)
print (4 | 1 & 3)

print (true && false || true)
print (false || true && false)
print (1 == 1 && 2 == 2)
print (true && false && true)

a := (x: int) => { x + 1; }
b := (x: int) => { x * 2; }
print ((a | b) 5)

f := (x: int) => { x * 10; }
g := (x: int) => { (y: int) => { x - y; }; }
print (f 1 + 2)
print (f 2 + 3)
print (g 10 3 + 4)
print (f (1) + 2)

n := None
print (n ?? 7)
print (n ?? None ?? 9)
print (None ?? 2 + 3)

print (1 + 2 |> f)
print (5 |> f |> a)

print (!false && false)
ravel ""


# `local`:内层看不见它。
#
# 别的修饰符(`private` / `protected` / `readonly` / `internal` …)管的都是
# "谁能读写这个成员",只有 `local` 管词法链:`Scope.Find` 往上走的时候,
# 遇见带 `local` 的那一格**跳过**、接着往上找 —— 对子 scope 来说它等于不存在。
#
# 所以:本层照旧看得见;闭包看不到它;外面真有同名的话,内层看到的是外面那个。

x := 1
f := () => {
    local y := 2
    y + x;
}
print (f ())

# 闭包里看不见,就当没有这个名字 → 和拼错一样报「未定义的变量」
h := () => {
    local secret := 5
    k := () => { secret; }
    k ();
}
try {
    h ();
} (e: Exception) => {
    print ("接住: " + string e)
}

# 也写不进去(同样的理由:对子 scope 不存在)
w := () => {
    local slot := 5
    k := () => { slot = 9; }
    k ();
}
try {
    w ();
} (e: Exception) => {
    print ("接住: " + string e)
}

# 外面有同名 → 内层继续往上找,看到的是外面那个
n := 100
g := () => {
    local n := 7
    print n
    inner := () => { n; }
    inner ();
}
print (g ())

# 同一层里两个 `local` 互不影响
p := () => {
    local a := 1
    local b := 2
    a + b;
}
print (p ())

# 顶层写 `local` 也合法:它只挡住"往下看",不挡本层
local top := 42
print top

# 不带 `local` 的照旧穿透(对照组)
outer := 10
q := () => { outer + 1; }
print (q ())
# --- expected ---
# 3
# 接住: 未定义的变量 'secret'
# 接住: 无法给未定义变量 'slot' 赋值
# 7
# 100
# 3
# 42
# 11

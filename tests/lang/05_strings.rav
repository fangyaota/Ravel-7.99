c := 'a'
print c
print (typeof c)
print (c : IValue)
print ('\n' == '\n')
print ('\t' == '\t')
print ('\\')
print ('\'')
print ((default char) == '\0')

# ── 比较、拼接、重复 ──
print ('a' == 'a')
print ('a' < 'b')
print ('a' + 'b')            # 两个字符拼成字符串
print ('a' + "bc")
print ("bc" + 'a')
print ('-' * 5)              # 字符重复
print ("ab" * 3)             # 字符串也能重复
try { print ('a' + 1); } (e: Exception) => { print ("1: " + string e); }
try { print ("abc" * "x"); } (e: Exception) => { print ("2: " + string e); }

# ── 转换 ──
print (char 97)
print (char "x")
print (int 'A')              # 码位
print ('A'.Code ())
try { print (char "ab"); } (e: Exception) => { print ("3: " + string e); }
try { print (char 99999); } (e: Exception) => { print ("4: " + string e); }

# ── 字符自己的方法 ──
print ('7'.IsDigit ())
print ('a'.IsLetter ())
print ('A'.IsUpper ())
print ('A'.IsLower ())
print (' '.IsSpace ())
print ('a'.ToString ())

# ── 字符串:取、找、切、变 ──
s := "Hello, World"
print (s.Length ())
print (s.IsEmpty ())
print (s.At 0)
print (s.At 4)
print ((s.Chars ()).Count ())
print (s.Contains "World")
print (s.Contains 'H')
print (s.StartsWith "He")
print (s.EndsWith 'd')
print (s.IndexOf "World")
print (s.Find "zz")                 # 明知可能没有:给 -1
print (s.LastIndexOf "l")
print (s.Slice [0..5])         # 两端都含 → 0..5 共 6 个字符
print (s.Slice (0..5))         # 两端都不含 → 1..4
print (s.Slice [6..11])
print (s.Take 5)
print (s.Skip 7)
print ("  pad  ".Trim ())
print (s.ToUpper ())
print (s.ToLower ())
print (s.Replace "l" "L")
print (s.Replace 'o' '0')
print ("ab".Repeat 3)
print (s.Reverse ())
print ("a,b,,c".Split ",")
try { print (s.At 99); } (e: Exception) => { print ("5: " + string e); }
try { print (s.IndexOf "zz"); } (e: Exception) => { print ("6: " + string e); }
try { print (s.Slice [0..99]); } (e: Exception) => { print ("7: " + string e); }
try { print ("a".Split ""); } (e: Exception) => { print ("8: " + string e); }

# ── 和库搭台:字符当键、当排序元素、进 `.Foreach` ──
print ('c' : IComparable)
print ('c' : IKey)
print ("ab" : IEnumerable)          # 字符串**可枚举**:元素是字符(lib/iterator.rav 里登记的一条 impl)
("abc".Chars ()).Foreach (ch: char) => { print ch; }
d := {->}
d.Set 'a' 1
d.Set 'b' 2
print (d.Get 'a')
print (d.Keys ())
print (Sorting.Sort ['c' 'a' 'b'])
print (Sorting.Max ['c' 'a' 'b'])
print (Keys.Of 'x')
print "end"

# ═══ 170_string_escape(并入) ═══
ravel "170_string_escape"
# 字符串转义。以前 lexer 只找下一个引号,所以字符串里根本放不进 `"`,
# `"say \"hi\""` 会被当成两个串,再报「未预期的字符」。
# 不认识的转义原样保留(含反斜杠),免得把 Windows 路径这类文本吃掉。
print ("say \"hi\"")
print ("tab:\tend")
print ("line1\nline2")
print ("back\\slash")
print ("stays:\dz")
ravel ""

# ═══ 239_interpolation(并入) ═══
ravel "m10"
s := """
    第一行
    第二行
       缩进二
    """
print s
print (s.Length ())
print (s.Contains "第二行")
ravel ""
ravel "m11"
print (try { eval "bad := \"\"\"\n    第一行\n  第二行\n    \"\"\""; } (e: Exception) => { string e; })
print (try { eval "x := \"\"\"\n没收尾"; } (e: Exception) => { string e; })
ravel ""
ravel "m12"
#ignore-types true
x: int = "s"
print x

f := (a: int) => { a; }
print (f "s")

pat := (1) => { "one"; } | (2) => { "two"; }
print (pat 1)

n: int = _
print n

g := ([a b]: list) => { a + b; }
print (g [1 2])

#ignore-types false
try { z: int = "s"; } (e: Exception) => { print "back: " + (string e); }
h := (a: int) => { a; }
try { h "s"; } (e: Exception) => { print "param: " + (string e); }
print "done"
ravel ""


ravel "m29"
[x y] := [10 20]
print (x + y)

[ka _ kc ..krest] := [1 2 3 4 5]
print ka
print kc
print (krest.ToList ())

[n9: int s9: string] := [1 "看"]
print "${n9} ${s9}"

k2 := ([x: int y: int]) => { x + y; } | (_) => { "不是两个 int"; }
print (k2 [1 2])
print (k2 [1 "a"])

[] := []
print "空 list 过"
print ((try { [] := [1]; } (e: Exception) => { "1: " + e.Message; }))

Point ::= class {
    px: int = 0
    py: int = 0
}
p := Point ()
p.px = 3
p.py = 4
{px py} := p
print (px + py)

Point2 ::= class { rx: int = 8; ry: int = 9 }
{rx: int ry: int} := Point2 ()
print (rx + ry)

[[m n]: list [q]] := [[1 2] [3]]
print (m + n + q)

[p0 q0] : list = [4 5]
print (p0 + q0)
print ((try { eval "[u v] : list = 5"; } (e: Exception) => { "1: " + e.Message; }))

print ([1 2] : list)
print ([1 2] : int)

calls := 0
mk := () => { calls += 1; [7 8]; }
[mm nn] := mk ()
print (mm + nn)
print calls

P2 ::= class { a: int = 0; b: int = 0 }
cc := 0
mk2 := () => { cc += 1; P2 (); }
{a b} := mk2 ()
print cc
print (a + b)

[s0 s1 ..tail] := "abcdef"
print s0
print s1
print ((tail.ToList ()).Join "")

[r0 ..其他] := [1 2 3]
print (其他.ToList ())
[r1 ..r] := [4 5]
print (r.ToList ())
[..全部] := [6 7]
print (全部.ToList ())

Box ::= class { sx: int = 5; sy: int = 6 }
Sq ::= class {
    [q1 r1] := [3 4]
    private {sx sy} := (Box ())
    Sum := () => { sx + sy; }
}
s := Sq ()
print (s.q1)
print (s.r1)
print (s.Sum ())

print ((try { eval "[a ..r b] := [1 2 3]"; } (e: Exception) => { "2: " + e.Message; }))

print ((try { eval "[] := [1]"; } (e: Exception) => { "3: " + e.Message; }))
print ((try { eval "{} := 1"; } (e: Exception) => { "4: " + e.Message; }))

print ((try { eval "{_ x} := 1"; } (e: Exception) => { "5: " + e.Message; }))

print ((try { eval "by [bx by2] := [1 2]\nprint bx"; } (e: Exception) => { "6: " + e.Message; }))

print ((try { [z1 z2 z3] := [1 2]; } (e: Exception) => { "7: " + e.Message; }))

print ((try { eval "[p .._] := [1 2]"; } (e: Exception) => { "8: " + e.Message; }))

eval "[e1 f1] := [1 2]
print (e1 + f1)"
eval "[g1 h1] := [3 4]
print (g1 + h1)"
ravel ""
ravel "m30"
a := 1
b := 2
[a b] = [10 20]
print [a b]

x := 0
y := 0
[x y] = [3 4]
print [x y]

head := 0
rest := ()
[head ..rest] = [5 6 7]
print head
print (rest.ToList ())

try { [p q] = [1 2]; } (e: Exception) => { print ("1: " + e.Message); }
try { eval "[private m] = [1 2]"; } (e: Exception) => { print ("2: " + e.Message); }
try { eval "private [m n] = [1 2]"; } (e: Exception) => { print ("3: " + e.Message); }

[s1 s2] : list = [8 9]
print [s1 s2]

P ::= class {
    cx: int = 11
    cy: int = 22
}

cx := 0
cy := 0
{cx cy} = P ()
print [cx cy]

renamed := 0
{renamed := cx} = P ()
print renamed

whole := 0
w1 := 0
w2 := 0
(whole := [w1 w2]) = [7 8]
print [whole w1 w2]

d := {"a" -> 1 "b" -> "s"}
dv := 0
ds := ""
{"a" -> dv "b" -> ds} = d
print [dv ds]

t1 := 0
print ((try { eval "t2 := 0; [t2: int] = [\"s\"]"; } (e: Exception) => { "4: " + e.Message; }))
ravel ""
ravel "m31"
l := [0 0 0]
[l[2] l[1] l[0]] = [1 2 3]
print l
P ::= class {
    x: int = 0
    y: int = 0
}
p := P ()
q := P ()
[p.x q.y] = [7 8]
print (p.x + q.y)
m := {"a" -> 0 "b" -> 0}
[m["a"] m["b"]] = [10 20]
print ((m["a"]) + (m["b"]))
[l[0] p.x] = [5 6]
print (l[0] + p.x)
nested := [0 [0 0]]
[nested[1][1] nested[0]] = [41 40]
print nested
try { eval "[l[0]] := [9]"; } (e: Exception) => { print ("定义位置: " + (e.Message)); }
try { eval "[l[0] l[1]] = [1]"; } (e: Exception) => { print ("数量不对: " + (e.Message)); }
ravel ""


# `char` 类型 + 字符串那一套操作。
#
# `char` 是**值类型**(`Char <: IValue`):能比大小、能当字典的键、能进集合去重、
# `IComparable` / `IKey` 都认它 —— 和数、字符串一个待遇。
# 口径是 **UTF-16 码元**(和 `string.Length` / `s.At i` 一致):`"😀".Length` 是 2,
# 一个 `'…'` 装不下它。

# ── 字面量与转义 ──
c := 'a'
print c
print (typeof c)
print (c : IValue)
print ('\n' == '\n')
print ('\t' == '\t')
print ('\\')
print ('\'')
print ((char default) == '\0')

# ── 比较、拼接、重复 ──
print ('a' == 'a')
print ('a' < 'b')
print ('a' + 'b')            # 两个字符拼成字符串
print ('a' + "bc")
print ("bc" + 'a')
print ('-' * 5)              # 字符重复
print ("ab" * 3)             # 字符串也能重复
try { print ('a' + 1); } (e: Exception) => { print ("1: " + string e); }
try { print ("abc" * "x"); } (e: Exception) => { print ("2: " + string e); }

# ── 转换 ──
print (char 97)
print (char "x")
print (int 'A')              # 码位
print ('A'.Code ())
try { print (char "ab"); } (e: Exception) => { print ("3: " + string e); }
try { print (char 99999); } (e: Exception) => { print ("4: " + string e); }

# ── 字符自己的方法 ──
print ('7'.IsDigit ())
print ('a'.IsLetter ())
print ('A'.IsUpper ())
print ('A'.IsLower ())
print (' '.IsSpace ())
print ('a'.ToString ())

# ── 字符串:取、找、切、变 ──
s := "Hello, World"
print (s.Length ())
print (s.IsEmpty ())
print (s.At 0)
print (s.At 4)
print ((s.Chars ()).Count ())
print (s.Contains "World")
print (s.Contains 'H')
print (s.StartsWith "He")
print (s.EndsWith 'd')
print (s.IndexOf "World")
print (s.Find "zz")                 # 明知可能没有:给 -1
print (s.LastIndexOf "l")
print (s.Slice [0..5])         # 两端都含 → 0..5 共 6 个字符
print (s.Slice (0..5))         # 两端都不含 → 1..4
print (s.Slice [6..11])
print (s.Take 5)
print (s.Skip 7)
print ("  pad  ".Trim ())
print (s.ToUpper ())
print (s.ToLower ())
print (s.Replace "l" "L")
print (s.Replace 'o' '0')
print ("ab".Repeat 3)
print (s.Reverse ())
print ("a,b,,c".Split ",")
try { print (s.At 99); } (e: Exception) => { print ("5: " + string e); }
try { print (s.IndexOf "zz"); } (e: Exception) => { print ("6: " + string e); }
try { print (s.Slice [0..99]); } (e: Exception) => { print ("7: " + string e); }
try { print ("a".Split ""); } (e: Exception) => { print ("8: " + string e); }

# ── 和库搭台:字符当键、当排序元素、进 `.Foreach` ──
print ('c' : IComparable)
print ('c' : IKey)
print ("ab" : IEnumerable)          # 字符串**可枚举**:元素是字符(lib/iterator.rav 里登记的一条 impl)
("abc".Chars ()).Foreach (ch: char) => { print ch; }
d := {}
d.Set 'a' 1
d.Set 'b' 2
print (d.Get 'a')
print (d.Keys ())
print (Sorting.Sort ['c' 'a' 'b'])
print (Sorting.Max ['c' 'a' 'b'])
print (Keys.Of 'x')
print "end"

# ═══ 170_string_escape(并入) ═══
ravel "170_string_escape"
# 字符串转义。以前 lexer 只找下一个引号,所以字符串里根本放不进 `"`,
# `"say \"hi\""` 会被当成两个串,再报「未预期的字符」。
# 不认识的转义原样保留(含反斜杠),免得把 Windows 路径这类文本吃掉。
print ("say \"hi\"")
print ("tab:\tend")
print ("line1\nline2")
print ("back\\slash")
print ("stays:\dz")
ravel ""

# ═══ 239_interpolation(并入) ═══
ravel "239_interpolation"
# 字符串插值:`"${表达式}"` —— 只有这一种写法(没有 `$名字` 那种短的)。
#
# 它**不是新语义**:解析器把 `"你好 ${n}"` 拼成 `"" + "你好 " + string (n)`,和手写
# `"你好 " + (string n)` 一模一样 —— 于是求值、报错、显示全走现成那条路。
# `$` 后面不是 `{` 就是**字面量**(`"$5"` / `"$name"` 不用转义);要写 `${` 本身,`\${`。

name := "小明"
n := 3

# ① 基本
print "你好 ${name}!"
print "共 ${n} 个,${n * 2} 个才对"
print "空${name}空"
print "${n}"

# ② 段里可以是任何表达式(位置也指得对:见最后的报错)
print "括号:${(1 + 2) * 3}"
print "括号加调用:${[3 1 2].Count ()}"
pi := 3.14159
print "浮点 ${pi}"
c := 'x'
print "字符 ${c}"
print "表的显示 ${[1 2]}"

# ③ 段里能再放字符串(扫描会跳过引号里的内容)
print "嵌套:${"abc".ToUpper ()}"

# ④ 字面量不算插值
print "美元符号 $5 和 $name 都不是插值"
print "要写记号本身:\${name}"

# ⑤ 错误指得对地方
try {
    eval ("print \"值 " + "$" + "{noSuchVar} 啊\"");
} (e: Exception) => { print ("1: " + string e); }
try {
    eval ("print \"缺收尾 " + "$" + "{1 + 2\"");
} (e: Exception) => { print ("2: " + string e); }
print "end"
ravel ""

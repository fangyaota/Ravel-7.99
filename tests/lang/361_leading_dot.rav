# 行首的 `.` 等价于上一行的末尾写了 `|>`
xs := [1 2 3]
print (xs.Map (x) => { x * 2; }
    .Sum ())
f := () => { [1 2]; }
print (f ()
    .Count ())
print ((5
    .ToString ()) + "!")
# 注释行夹在中间不妨碍
print ([4 5]
    # 这一行是注释
    .Sum ())
# 下一行不是点 → 照旧断句
y := 1
print y
# `.` 连着 `..` 不算
r := [1..3]
print (r.Count ())
# 空行夹着也算
print ([7 8]

    .Sum ())
# 连着两行都行首开点
print ([1 2 3]
    .Map (x) => { x * 10; }
    .Sum ())
# 行首的 `?.` 也一样(左边得是 monad)
print ((Some "abc"
    ?.Length ()) ?? -1)
print ((None
    ?.Length ()) ?? -1)

# --- expected ---
# 12
# 2
# 5!
# 9
# 1
# 3
# 15
# 60
# 3
# -1

print ([i * i for i in [1 2 3 4] if (i > 1)])
print ([i * 10 + j for i in [1 2] for j in [3 4]])
print ([i for i in [1 2] if (i > 1) for j in [3]])
print ({i for i in [1 1 2]})
print ({i -> i * 10 for i in [1 2]})
print ({i % 2 -> i for i in [1 2 3 4]})
print ((i * 2 for i in [1 2 3]).ToList ())
print (([i * 2 for i in (1..5)]).Count ())
print ([c for c in "abc"])
print ([[j * 2 for j in i] for i in [[1 2] [3]]])
print ([i for i in [-1 2].Where ((x) => { x > 0; })])
print (([i for i in [1 2]]).Count ())
print ([i for i in (j * 2 for j in [1 2])])
print ([[k v] for [k v] in [[1 2] [3 4]]])
print ({k -> v for [k v] in [["a" 1]]})
print ([x for (x: int) in [1 2]])

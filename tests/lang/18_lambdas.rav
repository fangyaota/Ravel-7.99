+ 2
* 3)

Even := (n) => { (n % 2) == 0; }
Small := (n) => { n < 10; }
both := Even
and Small
print (both 4)
print (both 12)

print ((try { eval "y := 1; + 2"; } (e: Exception) => { "分号不接: " + e.Message; }))


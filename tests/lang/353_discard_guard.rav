#
# 守卫那一格里 `_` 是**参数自己的名字**（"随便来一个,我盯着它看"）,不是占位符。
#
# 从前 `(_ > 100) => …` 会把 `_` 当占位符脱糖成一层 lambda,于是守卫成了
# "拿函数跟 100 比",一路坏到求值器:「无法求值的节点类型: HoleExpr」。
# 现在那一段只认名字 —— 和 `(x > 100)` 一个字不差,只是不占用一个名字。
#
# 边界没变:`_` 只在**参数表里**是名字。体里、普通表达式里它还是占位符
# （`[1 2 3].Map (_ + 1)` 那族照旧）。

# ── 丢弃式守卫:不占名字,直接盯住这一格 ──
f := (_ > 100) => { "大"; } | (_) => { "小"; }
print (f 200)
print (f 5)

g := (_ == 100) => { "正好"; } | (x) => { "不是 " + (string x); }
print (g 100)
print (g 7)

# 守卫里调谓词那条路（`|>`）同样能丢名字
IsPrime := (n: int) => {
    r := n > 1
    i := 2
    while { (i * i) <= n; } {
        (n % i) == 0 { r = false; } { 0; }
        i += 1
    }
    r
}
h := (_ |> IsPrime) => { "素数"; } | (x) => { "不是 " + (string x); }
print (h 7)
print (h 8)

# 守卫里冒出 TypeError 仍然只是"这一支不收"（拿字符串跟数比）
print (f "字符串")

# 想盯类型就把整个参数括起来:`((x: int) |> Big)` —— 名字仍然只写一遍
Big := (n: int) => { n > 10; }
k := ((x: int) |> Big) => { "大"; } | (x: int) => { "小"; }
print (k 20)
print (k 3)

# 一支都不收时,拒收没地方去 —— 当场报出来（丢弃式守卫也一样）
only := (_ > 10) => { 1; }
print ((try { only 3; } (e: Exception) => { "1: " + e.Message; }))

# ── `_` 在别处仍是占位符 ──
print ([1 2 3].Map (_ + 1))
print ((_ > 2) 5)

# --- expected ---
大
小
正好
不是 7
素数
不是 8
小
大
小
1: 实参不满足 '_' 的守卫
[2 3 4]
true

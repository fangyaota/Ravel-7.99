# 控制流(合并 11/12/15/43/139/104)
X: object = {
    A := 10
    B := 20
    A + B
}
print X
X = 0
while {
    X < 5
} {
    print X
    X += 1
}
X = 10
X > 5 {
    print X
} {
    print 0
}
i: object = 0
while {
    i < 3
} {
    j := 0
    while {
        j < 2
    } {
        print (i * 10 + j)
        j += 1
    }
    i += 1
}
xs := [1 2 3]
sum := 0
xs.Foreach (x: int) => { sum = sum + x; }
print sum
s := {42}
print (typeof s)
print (s.Contains 42)
x := 0
while { x < 3; } {
    x += 1
}
print x
# 控制内建柯里化(部分应用):`true` / `false` 收两个块,可以**逐层给**
# (从前这儿写的是 `f := if cond` —— `if` 2026-10-07 删了,直接拿 bool 就好)
f := true
g := f { print "yes"; }
g { print "no"; }
h := false
print (h { 1; } { 2; })
# while 两参部分应用
i = 0
w := while { i < 3; }
w { print i; i += 1; }
# `.Foreach` 部分应用(方法先取出来再喂体)
fe := [10 20].Foreach
fe (x: int) => { print x; }

# ═══ 169_control_flow_args(并入) ═══
ravel "169_control_flow_args"
# `while` 是 Ravel 库函数,参数不对时要自己给出清楚的消息。
# `5.Foreach (x) => { 0; }` 报的是「类型 'Integer' 没有方法 'Foreach'」——
# 2026-10-07 之前 `foreach 5 …` 是库函数,报的是说全了的那句「foreach 需要 IEnumerable
# （能按顺序交出一串的东西：…），得到 Integer」;改成方法之后没有兜底那一层了。
# (lambda 那条含糊的消息已经改成「参数 'x' 需要 list，得到 Integer」了,见 177。)
# 这里用 try 逐个测:运行时错误现在也能被接住,所以一个文件就能覆盖三条。
#
# **第一条 2026-10-07 变了**:它原先是 `if { 1; } { 2; } { 3; }` —— 而旧 `if` 里那句
# `cond : bool = c ()` 的**注解**会报「无法将 Integer 赋值给 Bool」,那是"条件得是个 bool"
# 最准的一条消息。`if` 删了之后 `cond { A } { B }` 里条件就是接收者本身,
# 非 bool 的接收者一头撞在"不是函数"上(下面钉的就是这个)。所以:
# **"条件不是 bool" 现在只有 `while` / `.Foreach` 那条(下面第 2 条)还报得准**。
try { 1 { 2; } { 3; } } (e: Exception) => { print ("1: " + string e); }
try { while { 1; } { 0; } } (e: Exception) => { print ("2: " + string e); }
try { 5.Foreach (x: object) => { 0; } } (e: Exception) => { print ("3: " + string e); }
print "after"
ravel ""

# ═══ 182_control_arg_types(并入) ═══
ravel "182_control_arg_types"
# 控制内建的参数类型不对:报 Ravel 错误,不要抛 C# 的 InvalidCastException
# 从前控制帧一律 `(BlockVal)cf.Args.At(1)` 硬转,`with 5 6` 直接
# InvalidCastException —— 它不是 RuntimeException,Ravel 的 try 接不住,程序被打掉。
try { with 5 6; } (e: Exception) => { print ("1: " + string e); }
try { with 5 {}; } (e: Exception) => { print ("2: " + string e); }
try { using 5; } (e: Exception) => { print ("3: " + string e); }
try { eval 5; } (e: Exception) => { print ("4: " + string e); }
# 正常调用照常
C := class {
    init = () => { 0; this; }
    x: int = 7
}
# 注意 (C ()) 的括号:with 收两个参数,写成 `with C () {...}` 会变成三参
w := with (C ()) { x = 99; }
print w.x
ravel ""

# 控制流(合并 11/12/15/43/139/104)
X: object = {
    A := 10
    B := 20
    A + B
}
print X
X = 0
while {
    X < 5
} {
    print X
    X += 1
}
X = 10
if {
    X > 5
} {
    print X
} {
    print 0
}
i: object = 0
while {
    i < 3
} {
    j := 0
    while {
        j < 2
    } {
        print (i * 10 + j)
        j += 1
    }
    i += 1
}
xs := [1 2 3]
sum := 0
foreach xs (x: int) => { sum = sum + x; }
print sum
s := {42}
print (typeof s)
print (s.Contains 42)
x := 0
while { x < 3; } {
    x += 1
}
print x
# 控制内建柯里化(部分应用):if 三参逐层给
cond := { 5 > 3; }
f := if cond
g := f { print "yes"; }
g { print "no"; }
h := if { false; }
print (h { 1; } { 2; })
# while 两参部分应用
i = 0
w := while { i < 3; }
w { print i; i += 1; }
# foreach 两参部分应用
fe := foreach [10 20]
fe (x: int) => { print x; }

# ═══ 169_control_flow_args(并入) ═══
ravel "169_control_flow_args"
# if/while/foreach 是 Ravel 库函数,参数不对时要自己给出清楚的消息。
# 以前 if { 1; } 报的是「值 1 不是函数，不能调用」——因为条件是直接当函数调的,
# foreach 5 报的是含糊的「类型不匹配」。
# (lambda 那条含糊的消息已经改成「参数 'x' 需要 list，得到 Integer」了,见 177;
#  这里仍然在前置 assert 里拦,因为库函数想报的是「foreach 需要 IEnumerable」这个语境。)
# 这里用 try 逐个测:运行时错误现在也能被接住,所以一个文件就能覆盖三条。
try { if { 1; } { 2; } { 3; } } (e: Exception) => { print ("1: " + string e); }
try { while { 1; } { 0; } } (e: Exception) => { print ("2: " + string e); }
try { foreach 5 (x: object) => { 0; } } (e: Exception) => { print ("3: " + string e); }
print "after"
ravel ""

# ═══ 182_control_arg_types(并入) ═══
ravel "182_control_arg_types"
# 控制内建的参数类型不对:报 Ravel 错误,不要抛 C# 的 InvalidCastException
# 从前控制帧一律 `(BlockVal)cf.Args.At(1)` 硬转,`with 5 6` 直接
# InvalidCastException —— 它不是 RuntimeException,Ravel 的 try 接不住,程序被打掉。
try { with 5 6; } (e: Exception) => { print ("1: " + string e); }
try { with 5 {}; } (e: Exception) => { print ("2: " + string e); }
try { using 5; } (e: Exception) => { print ("3: " + string e); }
try { eval 5; } (e: Exception) => { print ("4: " + string e); }
# 正常调用照常
C := class {
    init = () => { 0; this; }
    x: int = 7
}
# 注意 (C ()) 的括号:with 收两个参数,写成 `with C () {...}` 会变成三参
w := with (C ()) { x = 99; }
print w.x
ravel ""
# --- expected ---
# <block>
# 0
# 1
# 2
# 3
# 4
# 10
# 0
# 1
# 10
# 11
# 20
# 21
# 6
# Set
# true
# 3
# yes
# 2
# 0
# 1
# 2
# 10
# 20
# 1: 类型不匹配: 无法将 Integer 赋值给 Bool（不是父子）—— 要转就明写 `Bool …`
# 2: 类型不匹配: 无法将 Integer 赋值给 Bool（不是父子）—— 要转就明写 `Bool …`
# 3: foreach 需要 IEnumerable（能按顺序交出一串的东西：list / set / dict / string / Generator / 枚举器 / Option…），得到 Integer
# after
# 1: with 的第 2 个参数需要代码块，得到 Integer
# 2: with 的第 2 个参数需要代码块，得到 Dict
# 3: using 的第 1 个参数需要 string，得到 Integer
# 4: eval 的第 1 个参数需要 string，得到 Integer
# 99

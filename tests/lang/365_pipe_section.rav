add := (a b) => { a + b; }
print (1 + <| add 2 3)
print (1 + <| add 2 3 + 4)
print (5 |> + 1)
print (5 |> + 1 * 2)
print (5 |> * 2)
print (5 |> > 3)
print (2 |> ** 10)
print ([1 2 3].Map (_ |> + 10))
print ([1 2 3 4].Where (_ |> > 2))
f := (x |> > 3) => { "big"; } | (x) => { "small"; }
print (f 5)
print (f 1)
g := (x) => { x * 3; }
print (7 |> g |> + 1)

# --- expected ---
# 6
# 10
# 6
# 7
# 10
# true
# 1024
# [11 12 13]
# [3 4]
# big
# small
# 22

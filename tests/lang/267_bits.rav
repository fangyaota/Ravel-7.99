# `Bits` —— 位那一套(见 lib/bits.rav)。**要显式引用**。
#
# 运算符那边已经有 `&` `|` `^` `<<` `>>` `<<<` `>>>`,这里补的是它们给不了的。
using "bits.rav"

# ── 查一位 ──
print (Bits.Test 5 0)
print (Bits.Test 5 1)
print (Bits.Count 255)
print (Bits.Count (0 - 1))     # 负数按 32 位位型数
print (Bits.Width 255)
print (Bits.Width 0)
print (Bits.Width (0 - 1))     # 符号位也算一格
print (Bits.High 5)            # 0 基
print (Bits.Low 40)
print (Bits.High 0)            # 一个都没有 → -1
print (Bits.ZerosHigh 1)
print (Bits.ZerosLow 40)

# ── 改一位(原值不动,交回新的) ──
print (Bits.Set 5 1)
print (Bits.Clear 7 1)
print (Bits.Toggle 5 0)
print (Bits.Not 0)

# ── 一段位 ──
print (Bits.Mask 4)
print (Bits.Mask 0)
print (Bits.Mask 32)
print (Bits.Mask 31)                   # 这一格得单写(`1 << 31` 是负的,减一会溢出)
print (Bits.Field 2147483647 28 4)     # 最高的那 4 位
print (Bits.PutField 0 4 4 15)

# ── 逻辑右移:补零(`>>` 是算术的,符号留住) ──
print (Bits.Shr 5 1)
print (Bits.Shr (0 - 1) 1)
print ((0 - 1) >> 1)

# ── 和字节表来回(大端 / 小端) ──
print (Bits.Bytes 16909060)
print (Bits.FromBytes [1 2 3 4])
print (Bits.BytesLE 16909060)
print (Bits.FromBytesLE [4 3 2 1])

# ── 位型 ↔ 非负数 ──
print (Bits.Unsigned (0 - 1))
print (Bits.Signed 4294967295)
print (typeof (Bits.Unsigned (0 - 1)))

# ── 位下标越界当场报错,不静默什么都不做 ──
try { Bits.Test 5 32; } (e: Exception) => { print ("1: " + string e); }
try { Bits.Set 5 (0 - 1); } (e: Exception) => { print ("2: " + string e); }
try { Bits.Signed 4294967296; } (e: Exception) => { print ("3: " + string e); }
# --- expected ---
# true
# false
# 8
# 32
# 8
# 0
# 32
# 2
# 3
# -1
# 31
# 3
# 7
# 5
# 4
# -1
# 15
# 0
# -1
# 2147483647
# 7
# 240
# 2
# 2147483647
# -1
# [1 2 3 4]
# 16909060
# [4 3 2 1]
# 16909060
# 4294967295
# -1
# BigInt
# 1: Bits.Test: 位下标要在 0..31 里，得到 32
# 2: Bits.Set: 位下标要在 0..31 里，得到 -1
# 3: Bits.Signed: 要在 0..4294967295 里，得到 4294967296

#
# 运算符优先级与结合性 —— 数都是**刻意挑的**,尽量挑成"换个读法结果就不一样"的,
# 所以这条用例是那张优先级表(`Parser.Expressions.BinOpBp`)的镜子:
# 谁把哪一行的数改了、或者爬升那两个 `if` 写反了,这里当场变红。
#
# 只挑"两种读法答案不同"的:比如 `1 + 2 * 3` 和 `(1+2)*3` 是 7 和 9 —— 有意义;
# 而 `2 | 1 & 3` 两种读法都是 3 —— 放进来了也证明不了什么。

# ── 加减乘除取模:左结合,乘除紧 ──
print (2 - 3 - 4)          # 左结合 → -5(右结合会是 3)
print (16 / 4 / 2)         # 左结合 → 2(右结合会是 8)
print (100 % 7 * 2)        # (100%7)*2 = 4(反过来 100%(14) = 2)
print (2 * 3 + 4 * 5)      # 26
print (10 - 2 * 3)         # 4(不是 24)

# ── 乘方:右结合,而且**比一元还紧** ──
print (2 ** 3 ** 2)        # 右结合 → 512(左结合会是 64)
print (-2 ** 2)            # -(2**2) → -4(要是 (-2)**2 就是 4)
print (2 ** -1)            # 指数里的负号照样是一元的 → 0.5
print (-2 * 3)             # 一元只管自己那一边 → -6

# ── 移位:比加减松、比比较紧 ──
print (1 << 2 + 1)         # 1 << 3 = 8(不是 (1<<2)+1 = 5)
print (1 << 2 << 1)        # 左结合 → 8(右结合会是 1<<4 = 16)
print (2 >> 1 >> 1)        # 左结合 → 0(右结合会是 2>>0 = 2)
print (5 >>> 1)            # 循环右移,不是无符号右移 → -2147483646

# ── 比较:比移位紧;同级比较是左结合 ──
print (2 << 1 == 4)        # (2<<1) == 4 → true
print (1 < 2 == true)      # (1<2) == true → true
print (int <: object)      # true(两边都是类型)
print (object :> int)      # true

# ── 类型判断 `:`:和比较同级 ──
print (1 : int && true)    # true
print (!(1 : string))      # true
print (1 : int == true)    # (1 : int) == true → true

# ── 位运算:& ^ 同级;| 比它们松 ──
print (3 ^ 1 & 1)          # 3 ^ (1&1) = 2(不是 (3^1)&1 = 0)
print (4 | 1 & 3)          # 4 | 1 = 5(不是 (4|1)&3 = 1)

# ── 逻辑:&& 比 || 紧,两者都左结合 ──
print (true && false || true)   # (&&)先,再 || → true
print (false || true && false)  # false||(true&&false) → false
print (1 == 1 && 2 == 2)   # true
print (true && false && true)   # 左结合 → false

# ── 函数交替 `|`:夹在 || 和 && 中间 ──
a := (x: int) => { x + 1; }
b := (x: int) => { x * 2; }
print ((a | b) 5)          # `|` 是交替:先 a → 6(和 `&` 同层,比 `||` 紧)

# ── 实参"吃到运算符为止":并列调用的实参里能放整条算式 ──
f := (x: int) => { x * 10; }
g := (x: int) => { (y: int) => { x - y; }; }   # 柯里化:一个 lambda 收一个实参
print (f 1 + 2)            # f (1+2) → 30(不是 (f 1)+2 = 12)
print (f 2 + 3)            # f (2+3) → 50(不是 (f 2)+3 = 23)
print (g 10 3 + 4)         # g 10 (7) → 3
print (f (1) + 2)          # 还是 f (1+2) → 30

# ── 空值合并 `??`:比 || 松、右结合、且惰性 ──
n := None
print (n ?? 7)             # 7
print (n ?? None ?? 9)     # 右结合 → 9
print (1 ?? 2 + 3)         # 1 ?? (2+3) → 1

# ── 管道 `|>`:`|>` 那一段比整条链都松 ──
print (1 + 2 |> f)         # f (1+2) → 30(不是 (f 1)+2 = 12)
print (5 |> f |> a)        # 左喂右 → a (f 5) = 51

# ── 一元 `!` 比 `&&` 紧 ──
print (!false && false)    # (!false) && false → false
# --- expected ---
# -5
# 2
# 4
# 26
# 4
# 512
# -4
# 0.5
# -6
# 8
# 8
# 0
# -2147483646
# true
# true
# true
# true
# true
# true
# true
# 0
# 5
# true
# false
# true
# false
# 6
# 30
# 50
# 3
# 30
# 7
# 9
# 1
# 21
# 51
# false

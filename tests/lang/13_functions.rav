# 函数/闭包/递归/多参数(合并 13/16/18/19/20/21/44/45/46/47/48/49/90/91/92/93)
F := (x: int) => {
    x * 2
}
print (F 21)
F = (x: int) => {
    result := 1
    while {
        x > 0
    } {
        result = result * x
        x -= 1
    }
    result
}
print (F 5)
factorial := (x: int) => {
    x <= 1 {
        1
    } {
        x * (self (x - 1))
    }
}
print (factorial 5)
fib := (n: int) => {
    n <= 1 {
        n
    } {
        (self (n - 1)) + (self (n - 2))
    }
}
print (fib 10)
makeAdder := (x: int) => {
    (y: int) => {
        x + y
    }
}
add5 := makeAdder 5
print (add5 10)
makeCounter := (init: int) => {
    count := init
    () => {
        count = count + 1
        count
    }
}
counter := makeCounter 0
print (counter ())
print (counter ())
print (counter ())
F = (n: int) => {
    a := 0
    b := 1
    i := 0
    while {
        i < n
    } {
        tmp := a + b
        a = b
        b = tmp
        i += 1
    }
    a
}
print (F 10)
isPrime := (n: int) => {
    n < 2 {
        false
    } {
        d := 2
        result := true
        while {
            d * d <= n
        } {
            n % d == 0 {
                result = false
            } {
                0
            }
            d += 1
        }
        result
    }
}
print (isPrime 2)
print (isPrime 7)
print (isPrime 10)
print (isPrime 97)
rangeSum := (a: int) => {
    (b: int) => {
        sum := 0
        i := a
        while {
            i <= b
        } {
            sum += i
            i += 1
        }
        sum
    }
}
print (rangeSum 1 10)
makeAccum := (init: int) => {
    total := init
    (x: int) => {
        total = total + x
        total
    }
}
acc := makeAccum 0
print (acc 5)
print (acc 3)
print (acc 2)
forEach := (list: list) => {
    (f: function) => {
        i := 0
        while {
            i < list.Count ()
        } {
            f (list.At i)
            i += 1
        }
    }
}
myList := [10 20 30]
forEach myList print
compose := (f: function) => {
    (g: function) => {
        (x: int) => {
            f (g x)
        }
    }
}
double := (x: int) => { x * 2; }
addOne := (x: int) => { x + 1; }
h := compose double addOne
print (h 5)
add := (a: int b: int) => {
    a + b
}
print (add 3 4)
print (add 10 20)
sum3 := (a: int b: int c: int) => {
    a + b + c
}
print (sum3 1 2 3)
add5 = sum3 5
print (add5 10 20)
greet := (name: string times: int) => {
    result := ""
    while { times > 0; } {
        result = result + name
        times -= 1
    }
    result
}
print (greet "hi" 3)
x := 10
f := (a: int b: int) => {
    a + b + x
}
print (f 1 2)
x = 100
print (f 1 2)

# ═══ 136_fn_meta(并入) ═══
ravel "136_fn_meta"
# fn.scope / fn.setScope
# (原来还测 fn.setType 和 C.Proto (),但 setType 和 Proto 都已不存在——
#  ADR-0001 里「Proto / Instantiate」本来就被判定为泄漏抽象、建议砍掉)
f := () => { print "hi"; }
print (typeof (f.Scope ()))

# setScope:把函数的闭包 scope 换成实例 scope,于是函数能读到实例字段。
# 拿实例 scope 得在类方法里用 currentScope ()——外面没有 API 能拿到它。
C := class {
    init = () => { 0; this; }
    x: int = 99
    attach := (fn: function) => { fn.SetScope (currentScope ()); }
}
g := () => { x; }
c := C ()
c.attach g
print (g ())
ravel ""

# ═══ 177_param_type_mismatch(并入) ═══
ravel "177_param_type_mismatch"
# lambda 参数类型不对:消息要说清哪个参数、要什么、得到什么
# 从前固定是四个字「类型不匹配」,调用失败时完全看不出错在哪
f := (n: int) => { n; }
# 注意 `{ f "abc"; }` 的分号:这是**表达式位置**的块,少了它会被当成 Set
try { f "abc"; } (e: Exception) => { print ("1: " + string e); }
# | 交替靠 TypeMismatchException 分流,消息变长不影响它
g := f | (s: string) => { 0 - 1; }
print (g "abc")
print (g 7)
ravel ""

# ═══ 189_alternate_chain(并入) ═══
ravel "189_alternate_chain"
# `|` 三个以上分支也要能试到
# `x | y | z` 解析成 `(x | y) | z`。从前 `|` 只是把两侧塞进 ControlFunction,
# 于是外层那个 try 帧里那句 CallInto 只**推**了内层的帧就返回了,内层两分支都失败时
# 抛的 TypeMismatchException 已经在外层 try 之外 —— 第三个分支永远试不到。
# 现在 `|` 会把链条摊平成一个分支列表,一个帧顺序试完。
f := (a: int) => { "int"; } | (a: string) => { "str"; } | (a: bool) => { "bool"; }
print (f 1)
print (f "x")
print (f true)
try { f 1.5; } (e: Exception) => { print ("none: " + string e); }
# 两个分支照旧
g := (a: int) => { "int"; } | (a: string) => { "str"; }
print (g 1)
print (g "x")
try { g true; } (e: Exception) => { print ("none: " + string e); }
# 四个分支
h := (a: int) => { 0; } | (a: string) => { 1; } | (a: bool) => { 2; } | (a: real) => { 3; }
print (h 1)
print (h 1.5)
print (h false)
ravel ""

# ═══ 206_cached(并入) ═══
ravel "206_cached"
# Cached count f:按实参缓存 f 的返回结果(记忆化)。`count` 是 **f 的参数个数**。
# 缓存有没有生效,靠函数体里的副作用跑了几次来证明 —— 否则"命中"和"重算"看不出区别。

Calls := 0
slow := (x: int) => { Calls += 1; x * 10; }
c1 := Cached 1 slow
print (c1 1)
print (c1 1)
print (c1 2)
print (c1 1)
print ("单参算了 " + (string (Calls)) + " 次")

# 两个参数的函数:喂够 2 个才算一次完整调用
AddCalls := 0
add := (a: int b: int) => { AddCalls += 1; a + b; }
c2 := Cached 2 add
print (c2 1 2)
print (c2 1 2)
print (c2 2 1)
print (c2 1 3)
print (c2 1 2)
print ("加了两参的 " + (string (AddCalls)) + " 次")

# 柯里化的半成品继续收参数,缓存认的是**整组**实参 —— 所以 half 拿到的那个半成品
# 再喂 2,和刚才 `c2 1 2` 是同一个键(命中),而喂 9 是个新键
half := c2 1
print (half 2)
print (half 9)
print (half 2)
print ("加了两参的 " + (string (AddCalls)) + " 次")

# 原子值按值认,而 `1` 与 "1" 是两个键(拿字符串当键的缓存会把这两条撞成一条)
EchoCalls := 0
echo := (x: object) => { EchoCalls += 1; "算 " + string x; }
ce := Cached 1 echo
print (ce 1)
print (ce "1")
print (ce 1)
print ("回声算了 " + (string (EchoCalls)) + " 次")

# 对象按身份认:同一个对象命中,内容一样但另建一个的不命中
C := class { init = () => { 0; this; }; }
c := C ()
ObjCalls := 0
take := (o: object) => { ObjCalls += 1; "第一次看它"; }
ct := Cached 1 take
print (ct c)
print (ct c)
print (ct (C ()))
print ("看对象看了 " + (string (ObjCalls)) + " 次")

# 参数个数写错 -> 当场报错,不是悄悄收不满参数、永远不给结果
try { Cached 0 add; } (e: Exception) => { print ("E: " + string e); }

# `Cached count f` 是个**函数** —— 直接交出那个包装函数,拿到手就能直接调。
print (typeof (Cached 1 slow))
print (Cached.name)           # `::=` 给它起了名
print (Cached : type)        # false:它是函数,不是类型
# 每个 Cached 是**独立的一份缓存**:包同一个函数互不干扰
TwoCalls := 0
two := (x: int) => { TwoCalls += 1; x; }
a1 := Cached 1 two
a2 := Cached 1 two
print (a1 5)
print (a2 5)
print (a1 5)
print ("算了几次: " + string TwoCalls)

# 无参函数:参数个数写 1,调用时喂 `()`。它的实参是 Void 值 ——
# 这也正是 `Type` 那层 `==` 从前会崩的那条路(见 tests/207)。
NoArgCalls := 0
thunk := Cached 1 (() => { NoArgCalls += 1; "expensive"; })
print (thunk ())
print (thunk ())
print ("算了几次: " + string NoArgCalls)

# 正经用途:递归函数自己走缓存。函数体里读的是**外层那个名字**(调用时才解析),
# 所以只要把缓存版的名字给它,递归的每一层都会经过缓存。
FibCalls := 0
fib: object = 0
fib = Cached 1 ((n: int) => { FibCalls += 1; n < 2 { n; } { (fib (n - 1)) + (fib (n - 2)); } })
print (fib 25)
print ("斐波那契算了几次: " + string FibCalls)
ravel ""
# ═══ 省略注解:按 `object` 收 ═══
# `(x)` 和 `(x: object)` 是一回事 —— 只知道"有东西来了"的地方不必硬写注解。
# 要更细就在体里自己过一手(`n: int = x`),或者给参数写上注解。
show := (x) => { print ("收到 " + string x); x; }
print (show 5)
print (show "abc")

# 多参数、柯里化那套照旧(注解可以混着写)
plus := (a b) => { a + b; }
print (plus 1 2)
pair := (a b: int) => { [a b]; }
print (pair "s" 2)

# 注解写了的照旧挑类型:省略的那种**不会**在调用时挑
doubled := (n: int) => { n * 2; }
print (doubled 4)
try { doubled "x"; } (e: Exception) => { print ("1: " + string e); }

# `.Map ((p) => …)` 这种回调写法现在短了
print ([[1 2] [3 4]].Map ((p) => { (p.At 0) + (p.At 1); }))

# 参数表里也能跨行(括号里换行不算数,见 tests/01)
twoArgs := (a: int
        b) => { (string a) + string b; }
print (twoArgs 1 "x")
print "end"


#
# `[x y] := e` 是**定义**(名字全是新的);`[x y] = e` 是**赋值** ——
# 同样的拆法,但每个名字都走 `=`:必须已经存在,也不许带修饰符。
# 带注解的 `[x y] : T = e` 仍是定义(`:=` 的缩写)。
#
a := 1
b := 2
[a b] = [10 20]
print [a b]

x := 0
y := 0
[x y] = [3 4]
print [x y]

head := 0
rest := ()
[head ..rest] = [5 6 7]
print head
print (rest.ToList ())

try { [p q] = [1 2]; } (e: Exception) => { print ("1: " + e.Message); }
try { eval "[private m] = [1 2]"; } (e: Exception) => { print ("2: " + e.Message); }
try { eval "private [m n] = [1 2]"; } (e: Exception) => { print ("3: " + e.Message); }

[s1 s2] : list = [8 9]
print [s1 s2]

# 别的形状一样能赋值:对象模式(按同名成员)、改名、整块、字典
P ::= class {
    cx: int = 11
    cy: int = 22
}

cx := 0
cy := 0
{cx cy} = P ()
print [cx cy]

renamed := 0
{renamed := cx} = P ()
print renamed

whole := 0
w1 := 0
w2 := 0
(whole := [w1 w2]) = [7 8]
print [whole w1 w2]

d := {"a" -> 1 "b" -> "s"}
dv := 0
ds := ""
{"a" -> dv "b" -> ds} = d
print [dv ds]

t1 := 0
print ((try { eval "t2 := 0; [t2: int] = [\"s\"]"; } (e: Exception) => { "4: " + e.Message; }))

# --- expected ---
# [10 20]
# [3 4]
# 5
# [6 7]
# 1: 无法给未定义变量 'p' 赋值
# 2: 解构赋值里不能加修饰符 'private' —— 修饰符只属于定义（要定义就写 ':='）
# 3: 解构赋值里不能加修饰符 'private' —— 修饰符只属于定义（要定义就写 ':='）
# [8 9]
# [11 22]
# 11
# [[7 8] 7 8]
# [1 s]
# 4: 这一格要的是 Integer，得到 String

#
# **每一格的条件** —— 模式的一格除了 `: 类型`,还能写一条**条件**:
#
#     [u == 1 v] := e          # 第一格绑给 u,还要求 u == 1;第二格绑给 v
#     {n == 3 s} := obj        # 对象模式也一样
#     a == 1 = 1               # 语句级:**带约束的定义**
#
# 名字取条件里**最左边那个标识符**(和参数表的守卫一个规矩)——
# `c |> (_ > 3) = 9` 认的是 `c`,不是 `_`。
#
# 不成 → **拒收**(和形状检查一条路,不是硬错),所以 `|` 的交替接得住、`try` 也接得住。
#
# **语句级那条为什么用 `=` 不用 `:=`**:约束本身就说明了这是个定义。
# 它走的是**同一条路** —— 一个只有一格的模式、那一格带条件,所以检查只写在一处。

# ── 语句级:带约束的定义 ──
a == 1 = 1
print a
# 名字从条件里最左边那个标识符取(`|>` 会把 `_ > 3` 折成调用,按树取"最左"会取错)
c |> (_ > 3) = 9
print c

# ── 每一格的条件 ──
f := ([u == 1 v]) => { "u=${u} v=${v}"; } | (_) => { "不是 [1 _]"; }
print (f [1 2])
print (f [9 2])

# 连着两格都有
h := ([u == 1 v == 2]) => { "${u} ${v}"; } | (_) => { "不是 [1 2]"; }
print (h [1 2])
print (h [1 9])

# 和类型混着用(类型那格先验形状,条件那格后验值)
g := ([u: int v == 2]) => { "${u} ${v}"; } | (_) => { "不匹配"; }
print (g [7 2])
print (g [7 3])
print (g ["x" 2])

# 对象模式里
P ::= class { n: int = 3; s: string = "看" }
{n == 3 s} := P ()
print "${n} ${s}"

# ── 拒收的两种接法:交替 / try ──
print ((try { eval "b == 2 = 5"; } (e: Exception) => { "1: " + e.Message; }))

# --- expected ---
# 1
# 9
# u=1 v=2
# 不是 [1 _]
# 1 2
# 不是 [1 2]
# 7 2
# 不匹配
# 不匹配
# 3 看
# 1: 'b' 这一格的条件没过 —— 这一支不收这个值

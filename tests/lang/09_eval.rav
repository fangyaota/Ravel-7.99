ravel "m19"
print ((None ?? 0))
print ((Some 7) ?? 0)
后备值 := "有值"

try { eval "print (5 ?? 1)"; } (e: Exception) => { print ("4: " + string e); }
print ("串" ?? 后备值)
nothing := ()
print (nothing ?? 1)

print (((Some ()) ?? "后备"))

print ((None?.Count ()) ?? "空")
print ((Some "abc")?.Length ())
print (((Some "abc")?.Length ()) ?? -1)
print ((None?.Length ()) ?? -1)

try { eval "print ((5)?.ToString ())"; } (e: Exception) => { print ("0: " + string e); }

print ((["ab" "c"]?.Length ()) ?? -1)

print (nothing?.Text ())

boom := () => { print "不该跑"; 0; }
print ((None?.Value ()) ?? "没跑")

Holder ::= class {
    Name: object = None
    Hits: int = 0
}
h := Holder ()
print (h.Name ??= "第一次")
print (h.Name ??= "第二次（不该盖）")
print h.Name

try { eval "print (h.Hits ??= 7)"; } (e: Exception) => { print ("6: " + string e); }

Counted ::= class {
    Writes: int = 0
    Storage: object = None
    by Value := property (() => { Storage; }) ((v: object) => { Writes += 1; Storage = v; })
}
c := Counted ()
print (c.Value ??= "写上")
print c.Writes
print (c.Value ??= "再来")
print c.Writes

Times := 0
mk := () => { Times += 1; c; }
print (mk () |> .Value ??= "不该写")
print Times

pick := (_ ?? "兜底")
print (pick (None))
print (pick (Some "有"))
has := (_?.Count ())
print ((has [["a"] ["bc"]]) ?? -1)
print (has (None))

print (Some "  hi  " |> ?.Trim ())
print (None |> ?.Trim ())
print (Some "  hi  " |> ?.Trim () |> ?.Length ())
print (None |> ?.Trim () |> ?.Length ())
print ((Some [1 2 3] |> ?.Count ()) ?? 0)
print ((None |> ?.Count ()) ?? 0)

try { eval "(1 + 2) ??= 3"; } (e: Exception) => { print ("2: " + string e); }
try { eval "1 ? 2"; } (e: Exception) => { print ("3: " + string e); }
ravel ""


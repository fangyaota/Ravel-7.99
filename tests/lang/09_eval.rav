eval "xs := [1 2 3]"
eval "xs.Add 4"
eval "print xs"
eval "
    C := class {
        init = () => { this.n = 7; this; }
        n: int = 0
        get := () => { n; }
    }
"
c := C ()
print (c.get ())

try { eval "eval \"print (1 + true)\""; } (e: Exception) => { print ("79_eval_error: " + string e); }

ravel "184_eval_syntax_error"

try { eval "1 +"; } (e: Exception) => { print ("A[" + (string (e)) + "]"); }
try { eval "print )"; } (e: Exception) => { print ("B[" + (string (e)) + "]"); }
print "after"

ravel ""
ravel "m18"
i := 0
while { i < 5; } { i++; }
print i

j := 10
while { j > 7; } { j--; }
print j

k := 1
k++
k--
k--
k++
print k

C := class { init = () => { 0; this; }; n: int = 0; }
c := C ()
c.n++
c.n++
print c.n

hits := 0
[1 2 3 4].Foreach (x: int) => { hits++; }
print hits

R := class { init = () => { 0; this; }; readonly w: int = 1; }
print ((try { eval "r := R ()\nr.w++"; } (e: Exception) => { "1: " + (string e); }))

a := 10
b := 3
print (a - -b)

print ((try { eval "x := 5\ny := x++"; } (e: Exception) => { "2: " + (string e); }))
print ((try { eval "x := 1\n++x"; } (e: Exception) => { "3: " + (string e); }))
print ((try { eval "a := 1\n(a + 1)++"; } (e: Exception) => { "4: " + (string e); }))
print ((try { eval "f := (p: int) => { p; }\nx := 1\nf x++"; } (e: Exception) => { "5: " + (string e); }))
print ((try { eval "a := 10\nb := 3\na--b"; } (e: Exception) => { "6: " + (string e); }))

ravel "m13"
f := () => { k; }
g := f.Prepend ((sc) => { sc.Define "k" "injected"; })
print (g ())

print (g ())
h := () => { k; }
try {
    h ();
} (e: Exception) => {
    print ("接住: " + string e)
}

nested := () => {
    inner := () => { k; }
    inner ();
}
print ((nested.Prepend ((sc) => { sc.Define "k" "deep"; })) ())

add := (x: int) => { x + base; }
print ((add.Prepend ((sc) => { sc.Define "base" 100; })) 5)

p := () => { 7; }
print ((p.Prepend { 1; }) ())

order := []
body := () => { order.Add "body"; 3; }
print ((body.Append ((sc) => { order.Add "after"; })) ())
print order

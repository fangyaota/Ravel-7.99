ravel "118_metaclass_print"
# metaclass:在 init 里挂钩建类过程
# `parentInit parent body` 就是"走默认那套建类逻辑",它返回建出来的那个类。
LoggingMeta ::= class type {
    private parentInit := init;
    init = (parent: type body: function) => {
        print "meta: creating..."
        r := parentInit parent body
        print "meta: done"
        r
    } | (body: function) => {
        print "meta: creating..."
        r := parentInit object body
        print "meta: done"
        r
    }
}
M2 := LoggingMeta object {
    init = () => { 0; this; }
    name: string = "hello"
}
m := M2 ()
print (m.name)
ravel ""

# ═══ 121_meta_default(并入) ═══

ravel "m4"
using "keys.rav"

probe := () => {
    a := 1
    b := 2
    s := currentScope ()

    print (s : IDict)
    print (s : IEnumerable)
    print ((typeof s))

    print (s.ContainsKey "a")
    print (s.ContainsKey "没这个")
    print (s.Get "a")
    print (s.GetOr "没这个" 99)

    n0 := s.Count ()
    s.Set "c" 7
    print (s.Get "c")
    print ((s.Count ()) - n0)
    s.Set "a" 10
    print (s.Get "a")
    print (s.Count ())

    s.Remove "a"
    print (s.ContainsKey "a")
    print ((s.Count ()) - n0)

    print ((s.Keys ()).Count ())
    print ((s.Values ()).Count ())
    print "end"
}
probe ()


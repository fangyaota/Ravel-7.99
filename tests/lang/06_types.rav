ravel "117_metaclass"

MyMeta ::= class type {
    private parentInit := init;
    init = (parent: type body: function) => {
        parentInit parent body
    } | (body: function) => {
        parentInit object body
    }
}
print (typeof MyMeta)

MyClass := MyMeta {
    init = () => { 0; this; }
    x: int = 42
}
c := MyClass ()
print (c.x)
print (typeof MyClass)
ravel ""


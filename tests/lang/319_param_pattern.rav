#
# **参数位置也能解构** —— 参数表里写 `[…]` / `{…}`,整个参数按形状拆:
#
#     f := ([x y]) => { x + y; }
#     f [3 4]          # 7
#
# 参数本身没有名字(名字在模式里),所以它拿一个**合成名**;真正给用户用的名字由模式
# 在**体的开头**绑出来。这一条是 `Lowering` 那趟做的(和 `do` / `??` 一个规矩)。
#
# **形状不对时拒收走的是 `reject`**,不是 `throw` —— `reject` 先给最近的 `|` 交替接,
# 没人接才落到 `try`。所以这就能当**分派的头一格**用:
#
#     f := ([x y]) => { … } | ({a b}) => { … } | (_) => { … }
#
# 这一点比**守卫**强:守卫写在参数表**最后**,而多参子句的守卫要等整个调用链走完才判 ——
# 那会儿 `|` 的交替帧早返回了,接不住。参数模式在**第一格**就判,拒收当场有人接。
# (见 `tests/lang/317` 那条"多参子句上的守卫接不住"的旁注。)
#
# 模式参数**不能带注解** —— 形状本身就是它对实参的要求。

# ── 基本:一个模式参数 ──
f := ([x y]) => { x + y; }
print (f [3 4])

# 对象模式
Point ::= class { px: int = 0; py: int = 0 }
p := Point ()
p.px = 10
p.py = 20
g := ({px py}) => { px + py; }
print (g p)

# ── 当分派的头一格:不成 → 下一支 ──
k := ([x y]) => { "一对：${x + y}"; } | ({a b}) => { "一条：${a + b}"; } | (_) => { "别的"; }
print (k [3 4])
XY ::= class { a: int = 1; b: int = 2 }
print (k (XY ()))
print (k 5)
print (k "ab")

# ── 嵌套 ──
h := ([[m n] [q]]) => { m + n + q; }
print (h [[1 2] [3]])

# ── 参数表里混着写:模式前后能跟普通参数(柯里化的每一层各管各的)──
m2 := (t [x y]) => { "${t} ${x + y}"; }
print (m2 "前" [1 2])
n2 := ([x y] z) => { "${x + y} ${z}"; }
print (n2 [1 2] "后")
o2 := (t [x y] z) => { "${t} ${x + y} ${z}"; }
print (o2 "前" [1 2] "后")
# 两个模式参数挨着
q2 := ([x y] [p3 q3]) => { "${x + y} ${p3 + q3}"; }
print (q2 [1 2] [3 4])

# ── `..rest` 也在 ──
r2 := ([head ..tail]) => { "${head} / ${tail.ToList ()}"; }
print (r2 [9 8 7])
# `_` 跳过
s2 := ([_ b2]) => { b2; }
print (s2 [1 2])

# ── 单支、形状不对:拒收没人接,兜到 `try` 去 ──
print ((try { f 5; } (e: Exception) => { "1: " + e.Message; }))
print ((try { f [1]; } (e: Exception) => { "2: " + e.Message; }))
print ((try { g 5; } (e: Exception) => { "3: " + e.Message; }))

# ── 参数上也能带类型:它挂在**模式那一格**上,和 `[x: int]` 一条路 ──
z := ([x y] : list) => { x + y; } | (_) => { "不是一对 list"; }
print (z [1 2])
print (z 5)
print (z "ab")          # 字符串也能解成两格,但 `: list` 挡住 → 下一支

# ── 每一格各自的类型(`: int` 那些也是一样,不成 → 拒收 → 下一支)──
w := ([x: int y: int]) => { x + y; } | (_) => { "不是两个 int"; }
print (w [1 2])
print (w [1 "a"])
# --- expected ---
# 7
# 30
# 一对：7
# 一条：3
# 别的
# 一对：ab
# 6
# 前 3
# 3 后
# 前 3 后
# 3 7
# 9 / [8 7]
# 2
# 1: 要的是能按顺序取的东西（list / set / dict / 字符串 / Generator…），得到 Integer
# 2: 要第 2 格，可这一串已经到底了
# 3: 要求成员 'px'，可这一份上没有
# 3
# 不是一对 list
# 不是一对 list
# 3
# 不是两个 int

ravel "m16"
f := (x: int) => { x + 1; }
g := (x: int) => { x * 2; }
h := (x: int) => { x - 10; }

print ((f >> g) 3)
print ((f << g) 3)

print (((f << g) 3) == ((g >> f) 3))

print ((f >> g >> h) 3)
print ((f << g << h) 3)

print (typeof (f << g))

print (5 << 1)
print (5 >> 1)
print ((0 - 8) >> 1)
ravel ""


x := 1
f := () => {
    local y := 2
    y + x;
}
print (f ())

h := () => {
    local secret := 5
    k := () => { secret; }
    k ();
}
try {
    h ();
} (e: Exception) => {
    print ("接住: " + string e)
}

w := () => {
    local slot := 5
    k := () => { slot = 9; }
    k ();
}
try {
    w ();
} (e: Exception) => {
    print ("接住: " + string e)
}

n := 100
g := () => {
    local n := 7
    print n
    inner := () => { n; }
    inner ();
}
print (g ())

p := () => {
    local a := 1
    local b := 2
    a + b;
}
print (p ())

local top := 42
print top

outer := 10
q := () => { outer + 1; }
print (q ())

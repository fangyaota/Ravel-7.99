internal hidden: int = 0
plain: int = 0
Set := () => { hidden = 7; hidden; }
ravel ""
print MyMod.plain
print (MyMod.Set ())
print MyMod.hidden
print (try { MyMod.hidden = 1; } (e: Exception) => { "模块: " + e.Message; })
print MyMod.hidden

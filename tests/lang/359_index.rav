# 下标:`xs[i]` 与四种区间切片
l := [10 20 30 40 50]
print l[0]
print l[4]
print (l[1..3])
print (l[1..4))
print (l(0..2])
print (l(0..3))
print (l[2])
s := "abcdef"
print s[1]
print (s[1..4))
print (s(0..3))
print (s.Length ())
m := {"a" -> 1 "b" -> 2}
print m["a"]
m["c"] = 3
print m["c"]
print (m.Keys ())
l[1] = 99
print (l.At 1)
l[1] += 1
print (l.At 1)
print (l[0] = 7)
print (l.At 0)
nested := [[1 2] [3 4]]
print (nested[1][0])
print (nested[0])
print ((nested[0]).Count ())
print (l[1])
print ([1 2 3][1..])
print ([1 2 3][..1])
print (s[2..])
q := [1 2 3]
print (q[0..])
print (q[..1])
try { eval "q[9]"; } (e: Exception) => { print ("越界: " + (e.Message)); }

# --- expected ---
# 10
# 50
# [20 30 40]
# [20 30 40]
# [20 30]
# [20 30]
# 30
# b
# bcd
# bc
# 6
# 1
# 3
# [a b c]
# 99
# 100
# 7
# 7
# 3
# [1 2]
# 2
# 100
# [2 3]
# [1 2]
# cdef
# [1 2 3]
# [1 2]
# 越界: list.At 的索引 9 越界 (列表长度 3)

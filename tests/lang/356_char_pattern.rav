#
# 字符字面量能当模式：`'+' => …` 和 `1 => …` / `"看" => …` 一样，
# 只在这一格等于那个字符时接住。
#
# 从前它连解析都过不去：`BarePatternLambdaAhead` 只认数字/字符串，
# `'+' =>` 会被当成 "一个字符字面量，后面跟着 =>"，报「需要表达式」；
# 即便认出来，`ParseLiteralPattern` 也只给数字/字符串/`()`/布尔派域，
# 会掉到「模式里要写一个名字…」那句里。

pick := '+' => { "加"; }
      | '-' => { "减"; }
      | '=' => { "等"; }
      | (c) => { "别的 " + (string c); }

print (pick '+')
print (pick '-')
print (pick '=')
print (pick 'x')

# 字符模式也能写在 `|>` 那条链里、和守卫混着用
kind := ('0') => { "零"; }
      | ('1') => { "一"; }
      | _ => { "多"; }

print (kind '0')
print (kind '1')
print (kind '9')

# 值位置上的字符字面量不受影响
print 'q'
print ('+' == '+')

# --- expected ---
加
减
等
别的 x
零
一
多
q
true

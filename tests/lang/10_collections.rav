ravel "188_hole_in_containers"

_ := 0
f := {_ + 1}
print (f 40)
g := {"a"-> _}
print (g 7)
h := [_ 2]
print (h 1)
add1 := _ + 1
print (add1 41)
both := _ + _
print (both 3 4)

outer := (y: int) => { _ + y; }
print (typeof (outer 10))
print ((outer 10) 5)
ravel ""

ravel "216_sequence_methods"

xs := [3 1 2 2]

print (xs.Count ())
print (xs.IsEmpty ())
print (xs.Any ())
print (xs.Contains 2)
print (xs.First ())
print (xs.Last ())
print (xs.Distinct ())
print (xs.Reverse ())
print (xs.Take 2)
print (xs.Skip 2)
print (xs.Concat [9 9])
print (xs.Sum ())
print (xs.Min ())
print (xs.Max ())
print (xs.Join "-")
print (xs.Sort ())
print (xs.IndexOf 2)
print (xs.RemoveAt 0)
print xs
xs.AddRange [7 8]
print xs
print ([].IsEmpty ())
print ([].Sum ())
print ([10 20].Join ",")
xs.Clear ()
print (xs.Count ())

ys := [1 2 3 4]
ys.Foreach (x: int) => { print ("each " + string x); }
print (ys.Map (x: int) => { x * 10; })
print (ys.Where (x: int) => { x % 2 == 0; })
print (ys.Fold 0 (acc: int x: int) => { acc + x; })
print (ys.All (x: int) => { x > 0; })
print (ys.All (x: int) => { x > 2; })
print (ys.Any (x: int) => { x > 3; })
print (ys.Any (x: int) => { x > 9; })
print (ys.Find (x: int) => { x > 2; })
print ([5 2 9 1].SortBy (x: int) => { 0 - x; })

s := {1 2 3}
print (s.Union {3 4})
print (s.Intersect {2 3 9})
print (s.Except {1})
print (s.IsSubsetOf {1 2 3 4})
print (s.Contains 3)
print (s.Max ())
print (s.Where (x: int) => { x >= 2; })

d := {"a"-> 3 "b"-> 1 "c"-> 2}
print (d.Count ())
print (d.Min ())
print (d.Max ())
print (d.Join ",")
print (d.Contains 2)
print (d.HasValue 1)
print (d.GetOr "a" 0)
print (d.GetOr "zz" 0)
print (d.Remove "a")
print (d.Count ())
print (d.Map (v: int) => { v * 100; })
print (d.Keys ())

try { print (ys.Where (x: int) => { 1; }); } (e: Exception) => { print ("1: " + string e); }
try { print (ys.Find (x: int) => { false; }); } (e: Exception) => { print ("2: " + string e); }
try { print (ys.Any 5); } (e: Exception) => { print ("3: " + string e); }
try { print ([].First ()); } (e: Exception) => { print ("4: " + string e); }
try { print ([].Min ()); } (e: Exception) => { print ("5: " + string e); }
try { print ([1 "a"].Sort ()); } (e: Exception) => { print ("6: " + string e); }
try { print ([1 "a"].Max ()); } (e: Exception) => { print ("7: " + string e); }
try { print ([1 2].Concat 5); } (e: Exception) => { print ("8: " + string e); }
print ([].Map (x: int) => { x; })
print ([].Fold 7 (acc: int x: int) => { acc + x; })
print ([].Any ())
print ([].All (x: int) => { false; })
ravel ""
ravel "m20"
n := 42
name := "甲"
print (f"共 {n} 件")
print (f"{name}: {n * 2}")
print (f"plain")
print (f"{{花括号}} 和 {n}")
print (f"$5 不是插值,{1 + 1}")
print (f"${n} 在 f-string 里是字面量")
print (f"转义:\t制表 {3}")
print (f"{true} {1.5} {'a'} {[1 2]}")

print ((f"{n}") == ("" + (string n)))
print ((f"{n + 1}{name}") == ((string (n + 1)) + name))

print ("老的 ${n} 仍然插值")
ravel ""


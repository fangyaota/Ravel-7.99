# `HasNext ()`:还有下一个吗 —— 不挪 `Current`,探一下就走
e := ([10 20].GetEnumerator ())
print (e.HasNext ())
print (e.HasNext ())
print (e.MoveNext ())
print (e.Current)
print (e.HasNext ())
print (e.MoveNext ())
print (e.Current)
print (e.HasNext ())
print (e.MoveNext ())

r := (([1..3]).GetEnumerator ())
print ((r.HasNext ()) & (r.MoveNext ()))
print (r.Current)

b := (y: function) => { y 1; y 2; }
c := (Generator b).GetEnumerator ()
print (c.HasNext ())
print (c.MoveNext ())
print (c.Current)
print (c.HasNext ())
print (c.MoveNext ())
print (c.Current)
print (c.HasNext ())
print (c.MoveNext ())

# --- expected ---
# true
# true
# true
# 10
# true
# true
# 20
# false
# false
# true
# 1
# true
# true
# 1
# true
# true
# 2
# false
# false

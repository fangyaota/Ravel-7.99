# myClass：用 Ravel 实现的 class（type metaclass + C# 默认 Initializer）
myClass := type type {
    init new := (parent: type block: function) => {
        newType := type parent block
        newType
    }
}

Animal := myClass object {
    init ctor := (n: string) => { name = n; this }
    name: string = "?"
    speak := () => { print name; }
}
a := Animal "Rex"
a.speak ()
print (a.name)

# 多参数 + 继承
Dog := myClass Animal {
    init ctor := (n: string age: int) => { name = n; this }
    age: int = 0
}
d := Dog "Rex" 5
d.speak ()
print (d.age)
# --- expected ---
# Rex
# Rex
# Rex
# 0

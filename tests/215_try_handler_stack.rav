# Ex.Try 的 handler 必须在结束时回到栈外。
#
# 从前只在"出错"那条路上摘(求值器调 handler 前先弹),**正常收尾不摘** —— 于是那个 handler
# 一直挂在 HandlerStack 上:后面**没人接**的错误会被它接住,而它的续延停在上面那次 callcc,
# 结果程序从「Try 之后」重跑一遍,报错位置也指到那儿去,原来的错反而看不见了。
using "try.rav"

print (Ex.HandlerStack.Count ())
Ex.Try { print "in try"; } (e: Exception) => { print ("1: " + string e); }
print (Ex.HandlerStack.Count ())

# 出错那条路照旧:接住了,栈也干净
Ex.Try { print (missingVar); } (e: Exception) => { print ("2: " + string e); }
print (Ex.HandlerStack.Count ())

# 嵌套:内层出错只摘内层那一个,外层照常还在
Ex.Try {
    Ex.Try { print (alsoMissing); } (e: Exception) => { print ("3: " + string e); }
    print (Ex.HandlerStack.Count ())
} (e: Exception) => { print ("4: " + string e); }
print (Ex.HandlerStack.Count ())
# --- expected ---
# 0
# in try
# 0
# 2: 未定义的变量 'missingVar'
# 0
# 3: 未定义的变量 'alsoMissing'
# 1
# 0

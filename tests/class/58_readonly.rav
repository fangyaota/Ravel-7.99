# readonly/访问控制
using "math.rav"

ravel "58_main0"
C := class {
    init = () => { 0; this; }
    readonly x: int = 10
}
c := C ()
print (c.x)

try { eval "C59 := class {\n    init = () => { x = 99; this; }\n    readonly x: int = 10\n}\nc59 := C59 ()\nprint (c59.x)"; } (e: Exception) => { print ("59_readonly_error: " + string e); }
ravel ""

ravel "199_lib_readonly"
using "math.rav"
Ex.Try { print = 1; } (e: Exception) => { print ("赋值: " + string e); }
Ex.Try { true = false; } (e: Exception) => { print ("常量: " + string e); }
Ex.Try { Math.Square := 1; } (e: Exception) => { print ("重新定义: " + string e); }
Ex.Try { Ex.Throw := 1; } (e: Exception) => { print ("模块 API: " + string e); }

Ex.HandlerStack = [1]
print (Ex.HandlerStack)
print (ReferencesPath)

f := () => { print := 9; print; }
print (f ())
print (print : function)
print "done"
ravel ""

try { eval "true := 1"; } (e: Exception) => { print ("200_readonly_redefine: " + string e); }

ravel "68_main3"
C := class {
    init = () => { 0; this; }
    private secret: int = 42
    show := () => { print secret; }
    set := (v: int) => { secret = v; }
}
c := C ()
c.show ()
c.set 99
c.show ()

try { eval "C69 := class {\n    init = () => { 0; this; }\n    private secret: int = 42\n}\nc69 := C69 ()\nprint (c69.secret)"; } (e: Exception) => { print ("69_access_private_err: " + string e); }
ravel ""

ravel "70_access_protected"
Base := class {
    init = () => { 0; ; this; }
    protected val: int = 10
    show := () => { print val; }
}
Child := class Base {
    init = () => { 0; this; }
    show2 := () => { print val; }
}
c := Child ()
c.show ()
c.show2 ()
ravel ""

ravel "68_main5"
try { eval "Base := class {\n    init = () => { 0; this; }\n    protected val: int = 10\n}\nb := Base ()\nprint (b.val)"; } (e: Exception) => { print ("71_access_protected_err: " + string e); }

try { eval "C72 := class {\n    init = () => { 0; this; }\n    unreadable x: int = 99\n}\nc72 := C72 ()\nprint (c72.x)"; } (e: Exception) => { print ("72_access_unreadable: " + string e); }
ravel ""

ravel "73_access_outdated"
C := class {
    init = () => { 0; this; }
    outdated old: int = 77
}
c := C ()
print (c.old)
ravel ""

ravel "74_access_mixed"
C := class {
    init = () => { 0; this; }
    public    a: int = 1
    private   b: int = 2
    protected c: int = 3
    outdated  d: int = 4
    show := () => {
        print a
        print b
        print c
        print d
    }
}
c := C ()
print (c.a)
c.show ()
ravel ""

ravel "172_core_bare_ident"
C := class {
    init = () => { 0; this; }
    core secret: int = 42
    show := () => { unsafe (); print secret; }
}
c := C ()
c.show ()
ravel ""

ravel "68_main9"
try { eval "# core 字段:类体里用裸标识符读,没进 unsafe 就该拦住(和 c.secret 一个待遇)\nC173 := class {\n    init = () => { 0; this; }\n    core secret: int = 42\n    peek := () => { print secret; }\n}\nc173 := C173 ()\nc173.peek ()"; } (e: Exception) => { print ("173_core_bare_ident_err: " + string e); }
ravel ""

ravel "180_unsafe_scope"
C := class {
    init = () => { 0; this; }
    core secret: int = 42
    peek := () => { unsafe (); print secret; }
}
c := C ()
c.peek ()
(unused: object) => { unsafe (); 0; } (0)
try { print c.secret; } (e: Exception) => { print ("blocked: " + string e); }
try { c.secret = 1; } (e: Exception) => { print ("blocked: " + string e); }
ravel ""
# --- expected ---
# 10
# 59_readonly_error: 无法给只读变量 'x' 赋值
# 赋值: 无法给只读变量 'print' 赋值
# 常量: 无法给只读变量 'true' 赋值
# 重新定义: 无法重新定义只读变量 'Square'
# 模块 API: 无法重新定义只读变量 'Throw'
# [1]
# []
# 9
# true
# done
# 200_readonly_redefine: 'true' 在这个作用域里已经定义过 —— `:=` 是定义不是覆盖（要改值/覆盖继承来的成员，用 `=`）
# 42
# 99
# 69_access_private_err: 变量 'secret' 是私有的
# 10
# 10
# 71_access_protected_err: 变量 'val' 是受保护的
# 72_access_unreadable: 变量 'x' 不可读取
# 77
# 1
# 1
# 2
# 3
# 4
# 42
# 173_core_bare_ident_err: 字段 'secret' 是核心字段，需要 unsafe
# 42
# blocked: 字段 'secret' 是核心字段，需要 unsafe
# blocked: 字段 'secret' 是核心字段，需要 unsafe

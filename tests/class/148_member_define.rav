# 成员定义/复合赋值
ravel "148_main0"
C := class {
    init = () => { 0; this; }
    v: int = 1
}
a := C ()

a.new := 42
a.other := "hello"
print (a.new)
print (a.other)

a.v := 99
print (a.v)

a.new = 7
print (a.new)

a.count := 10
print (a.count + 1)

b := C ()
b.new := 1000
print (b.new)
print (a.new)

x := 1
print (x = 5)
print x
print (a.v = 88)
print (a.v)
print (a.def := 6)
print (a.def)

try { print (x := 6); } (e: Exception) => { print ("1: " + string e); }
try { print (5 = 5); } (e: Exception) => { print ("2: " + string e); }
try { print ([1 2] = 3); } (e: Exception) => { print ("3: " + string e); }

try { eval "# 用 = 给不存在的字段赋值要报错(想新建字段得用 :=)\nC149 := class {\n    init = () => { 0; this; }\n    v: int = 1\n}\na149 := C149 ()\na149.missing = 1"; } (e: Exception) => { print ("149_member_assign_missing: " + string e); }
ravel ""

ravel "150_member_compound_assign"
C := class {
    init = () => { 0; this; }
    n: int = 10
    s: string = "a"
}
a := C ()
a.n += 5
print (a.n)
a.n -= 3
print (a.n)
a.n *= 2
print (a.n)
a.s += "bc"
print (a.s)

a.fresh := 100
a.fresh /= 4
print (a.fresh)

count := 0
shared := C ()
get := () => { count += 1; shared; }
(get ()).n += 1
print count
print (shared.n)

V := class {
    init = () => { 0; this; }
    v: int = 7
    + := (x: int) => { v + x; }
}
Holder := class { init = () => { 0; this; }; slot: object = 0; }
h := Holder ()
h.slot = V ()
h.slot += 10
print (h.slot)

P := class {
    init = () => { 0; this; }
    _n: int = 10
    by n := property (() => { _n; }) ((v: int) => { _n = v; })
}
p := P ()
p.n += 5
print (p.n)
p.n *= 2
print (p.n)
print (p.n += 9)
V = class {
    init = () => { 0; this; }
    v: int = 0
    + := (o: V) => {
        r := V ()
        r.v = v + o.v
        r
    }
}
x := V ()
x.v = 7
y := V ()
y.v = 10
x += y
print (x.v)
ravel ""

ravel "236_no_redefine"
x := 1
print x
x = 2
print x
try { eval "x := 3"; } (e: Exception) => { print ("1: " + string e); }

f := () => {
    y := 1
    y = y + 1
    try { eval "y := 9"; } (e: Exception) => { print ("2: " + string e); }
    y
}
print (f ())

z := "outer"
g := () => { z := "inner"; z; }
print (g ())
print z

P := class {
    a: int = 1
}
print ((P ()).a)
try {
    eval "P2 := class P {\n    a: int = 2\n}\nP2 ()";
} (e: Exception) => { print ("3: " + string e); }

Q := class {
    init = () => { print "Q.init"; this; }
}
print (Q ())
R := class Q {
    init = () => { print "R.init"; this; }
}
print (R ())
try { print ((Q ()).init ()); } (e: Exception) => { print ("5: " + string e); }
try { (Q ()).init = () => { this; }; } (e: Exception) => { print ("6: " + string e); }
try {
    eval "S := class Q {\n    init := () => { this; }\n}\nS ()";
} (e: Exception) => { print ("4: " + string e); }

i := 0
total := 0
while { i < 3; } {
    n := i * 2
    total = total + n
    i = i + 1
}
print total
print "end"
ravel ""
# --- expected ---
# 42
# hello
# 99
# 7
# 11
# 1000
# 7
# 5
# 5
# 88
# 88
# 6
# 6
# 1: 定义语句不允许作为表达式使用
# 2: 赋值左侧要求变量或字段，得到 Integer
# 3: 赋值左侧要求变量或字段，得到 List
# 149_member_assign_missing: 对象未包含字段 'missing'
# 15
# 12
# 24
# abc
# 25
# 1
# 11
# 17
# 15
# 30
# 39
# 17
# 1
# 2
# 1: 'x' 已被定义
# 2: 'y' 已被定义
# 2
# inner
# outer
# 1
# 3: 'a' 已被定义
# Q.init
# class {}
# R.init
# class {}
# Q.init
# 5: 变量 'init' 是受保护的
# Q.init
# 6: 字段 'init' 的可见性为 受保护的
# 4: 'init' 已被定义
# 6
# end

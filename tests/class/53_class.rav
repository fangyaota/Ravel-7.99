# 类/继承/构造/with-copy
ravel "53_main0"
C := class {
    init = () => { this.n = 10; this; }
    n: int = 0
    + := (x: int) => { n + x; }
    setN := (v: int) => { n = v; }
    getN := () => { n; }
}
c := C ()
print (c.getN ())
print (c + 5)
c.setN 99
print (c.getN ())
print (c + 1)
ravel ""

ravel "54_inherit_basic"
Animal := class {
    init = () => { this.name = "?"; this; }
    name: string = ""
    speak := () => { print name; }
}
Dog := class Animal {
    init = () => {
        name = "dog"
        this;
    }
}
d := Dog ()
d.speak ()
ravel ""

ravel "55_inherit_multilevel"
A := class {
    init = () => { 0; this; }
    a: int = 1
}
B := class A {
    init = () => { 0; this; }
    b: int = 2
}
C := class B {
    init = () => { c = 3; this; }
    c: int = 0
}
obj := C ()
print (obj.a)
print (obj.b)
print (obj.c)
ravel ""

ravel "56_inherit_empty"
Base := class {
    init = () => { x = 5; this; }
    x: int = 0
}
Child := class Base { 0; }
c := Child ()
print (c.x)
ravel ""

ravel "57_inherit_isolation"
Animal := class {
    init = () => { 0; this; }
    name: string = ""
}
Dog := class Animal {
    init = () => { name = "hacked"; this; }
}
Dog2 := class Animal {
    init = () => { 0; this; }
}
d := Dog ()
d2 := Dog2 ()
print (d.name)
print (d2.name)
ravel ""

ravel "60_this_x_identity"
C := class {
    init = () => { this.v = 0; this; }
    v: int = 0
    setDirect := () => { v = 42; }
    setThis := () => { this.v = 99; }
    get := () => { v; }
}
c := C ()
c.setDirect ()
print (c.get ())
c.setThis ()
print (c.get ())

Parent := class {
    init = () => { pv = 10; this; }
    pv: int = 0
}
Child := class Parent {
    init = () => {
        pv = 99
        print pv
        print (this.pv)
        this;
    }
}
ch := Child ()
print (ch.pv)
ravel ""

ravel "147_ctor_curry"
Point := class {
    init = (x0: int y0: int) => {
        x = x0
        y = y0
        this;
    }
    x: int = 0
    y: int = 0
}

p := Point 3 4
print (p.x)
print (p.y)

half := Point 10
q := half 20
print (q.x)
print (q.y)

Vec := class {
    init = (a: int b: int c: int) => { s = a + b + c; this; }
    s: int = 0
}
v := Vec 1 2 3
print (v.s)

Box := class {
    init = (n: int) => { x = n; this; }
    x: int = 0
}
bx := Box 5
print (bx.x)
Zero := class {
    init = () => { z = 9; this; }
    z: int = 0
}
zz := Zero ()
print (zz.z)

M := { X := 1; }
baseM ::= class M
try { badM ::= class baseM M; } (e: Exception) => { print ("1: " + string e); }
ravel ""

ravel "165_main7"
C := class {
    init = () => { 0; this; }
    v: int = 1
    set := (n: int) => { v = n; }
    get := () => { v; }
}
c := C ()
c2 := with c { v = 10; }
print (c2.get ())
c2.set 99
print (c.get ())
print (c2.get ())

c3 := with c { tmp := 123; print (string tmp); }

c4 := c.Copy ()
c4.set 7
print (c.get ())
print (c4.get ())
ravel ""

ravel "166_copy_this"
C := class {
    init = () => { 0; this; }
    v: int = 1
    setThis := (n: int) => { this.v = n; }
    setBare := (n: int) => { v = n; }
    get := () => { v; }
}
c := C ()
c2 := c.Copy ()
c2.setThis 99
print (c.get ())
print (c2.get ())
c3 := c.Copy ()
c3.setBare 42
print (c.get ())
print (c3.get ())
ravel ""

ravel "167_copy_attrs"
C := class {
    init = () => { 0; this; }
    _v: int = 1
    by v := property (() => { _v; }) ((n: int) => { _v = n; })
    readonly w: int = 5
}
c := C ()
print (c.v)
c2 := c.Copy ()
c2.v = 10
print (c.v)
print (c2.v)
print (c2.w)
ravel ""
try { eval "R := class { init = () => { 0; this; }; readonly w: int = 5; }
r := R ()
r2 := with r { 0; }
r2.w = 9"; } (e: Exception) => { print ("168_copy_readonly: " + string e); }


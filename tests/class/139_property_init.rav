# 默认 init/默认属性
ravel "138_main0"

Old2 := 0
New2 := 0
Q ::= class {
    init = () => { _q = 1; this; }
    _q: int = 1
    by q: int = property (() => { _q; }) ((v: int) => { Old2 += 1; _q = v; })
}
qq := Q ()
R ::= class {
    init = () => { 0; this; }
    swapOn := (o: object) => {
        by o.q = property (() => { 1000; }) ((v: int) => { New2 += 1; })
    }
}
r := R ()
print (qq.q)
r.swapOn qq
print (qq.q)
qq.q = 5
print ("旧 " + (string (Old2)) + " 新 " + (string New2))
try { by qq._q = property (() => { 1; }) ((v: int) => { 0; }); } (e2: Exception) => { print ("12: " + string e2); }
try { by qq.nope = property (() => { 1; }) ((v: int) => { 0; }); } (e2: Exception) => { print ("13: " + string e2); }

T ::= class { init = () => { 0; this; }; }
t := T ()
by t.added := property (() => { 42; }) ((v: int) => { 0; })
print (t.added)
print (by t.added)
by t.added = property (() => { 43; }) ((v: int) => { 0; })
print (t.added)

Ro ::= class {
    init = () => { _r = 1; this; }
    _r: int = 1
    readonly by r := property (() => { _r; }) ((v: int) => { _r = v; })
    readonly by d: int = _
}
ro := Ro ()
print (ro.r)
try { ro.r = 9; } (e2: Exception) => { print ("14: " + string e2); }
try { ro.r += 1; } (e2: Exception) => { print ("15: " + string e2); }
try { by ro.r = property (() => { 1; }) ((v: int) => { 0; }); } (e2: Exception) => { print ("16: " + string e2); }
try { ro.d = 2; } (e2: Exception) => { print ("17: " + string e2); }
print (ro.r)
try { eval "readonly by z = 1"; } (e2: Exception) => { print ("18: " + string e2); }
ravel ""

ravel "211_default_init"
C ::= class { x: int = 1; }
print (C ())
print ((C ()).x)
print (C ())
print (typeof (C ()))

B ::= class C { y: int = 2; }
print (B ())
print ((B ()).x)
print ((B ()).y)

D ::= class {
    init = () => { print "D.init"; this; }
    z: int = 3
}
d := D ()
print (d.z)

MyJson ::= class Json { 0; }
print (MyJson { "a" -> 1 })

try { MyInt ::= class int { 0; }; } (e: Exception) => { print ("1: " + string e); }
try { MyList ::= class list { 0; }; } (e: Exception) => { print ("2: " + string e); }

print (System.Object ())

try { System.Void (); } (e: Exception) => { print ("3: " + string e); }
try { System.Every (); } (e: Exception) => { print ("4: " + string e); }
ravel ""

ravel "212_default_property"
Trait ::= class {
    init = () => { 0; this; }
    by a: int = _
    by b: function = _
}
t := Trait ()

print (t.a)
print (t.a = 1)
print (t.a)
print (t.b)
t.b = (x: int) => { x; }
print (t.b)

Install := (o: object) => {
    by o.a = property (() => { 100; }) ((v: int) => { print ("装了 setter: " + string v); })
    by o.b = property (() => { (x: int) => { x * 2; }; }) ((v: function) => { 0; })
}
Install t
print (t.a)
t.a = 5
print (t.b 21)

Empty ::= class { init = () => { 0; this; }; }
e := Empty ()
by e.nick := _
print (e.nick)
by e.nick = property (() => { "someone"; }) ((v: string) => { 0; })
print (e.nick)

print ((with t { 0; }).a)
print (t.a)

Named ::= class {
    by Any := property (() => { "本层的 Any"; }) ((v: string) => { (); })
}
n2 := Named ()
print n2.Any
by n2.Any = property (() => { "后面换的"; }) ((v: string) => { (); })
print n2.Any
ravel ""
# --- expected ---
# 1
# 1000
# 旧 0 新 1
# 12: '_q' 并非 by 属性
# 13: 对象未包含字段 'nope'
# 42
# <property>
# 43
# 1
# 14: 无法给只读变量 'r' 赋值
# 15: 无法给只读变量 'r' 赋值
# 16: 无法给只读变量 'r' 赋值
# 17: 无法给只读变量 'd' 赋值
# 1
# 18: 访问控制符仅允许出现在定义处
# C { x = 1 }
# 1
# C { x = 1 }
# C
# B { x = 1, y = 2 }
# 1
# 2
# D.init
# 3
# {"a":1}
# 1: `Integer` 被 seal 了 —— 不能再被继承
# 2: `List` 被 seal 了 —— 不能再被继承
# Object {}
# 3: Void 无法作为构造器使用
# 4: 模块 'System' 未包含方法 'Every'
# ()
# 1
# ()
# ()
# ()
# 100
# 装了 setter: 5
# 42
# ()
# someone
# 100
# 100
# 本层的 Any
# 后面换的

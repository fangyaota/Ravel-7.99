# 成员查找/自定义调用
ravel "195_main0"
print ([1 2 3].Count ())
print ("abcd".Length ())
print (true.ToString ())
print (1 == 1)
print ({1 2 1}.Count ())
print ((5).+ 2)
try { (5).parent; } (e: Exception) => { print ("(5).parent: " + string e); }
try { (5).block; } (e: Exception) => { print ("(5).block: " + string e); }
print ((5).init "12")
C ::= class { init = () => { this; }; x: int = 7; m := () => { 9; }; }
c := C ()
print c.x
print (c.m ())
print ((typeof (c)) == C)
print ((typeof (c)) == (typeof (C ())))
print ((typeof (c)) == int)
ravel ""

ravel "194_custom_call"
C ::= class { init = () => { this; }; }
a := C ()
try { a (); } (e: Exception) => { print ("实例不能调: " + string e); }
try { System.Void (); } (e: Exception) => { print ("无类体的类: " + string e); }
try { a.call; } (e: Exception) => { print ("实例读 call: " + string e); }
try { (5).call; } (e: Exception) => { print ("int 读 call: " + string e); }
Adder ::= class {
    init = () => { this; }
    call := (n: int) => { n + 1; }
}
ad := Adder ()
f := ad.call
print (f 41)
try { ad 41; } (e: Exception) => { print ("自定义 call 也不行: " + string e); }
print (C.Name ())
print (C.Scope ())
C.name = "Renamed"
print (C.Name ())
print (C.name)
ravel ""

ravel "197_is_operator"
print (1 : int)
print (1 : real)
print ("a" : IValue)
print (1 : object)
print ([1] : list)

bound := 1.:
print (bound int)
print (!(2.: int))
print ((1.:) int)

isInt := :.int
print (isInt 1)
print (:.IValue "a")

print (int : type)
print ((typeof 1) : type)
print ((typeof 1) : int)
print ((typeof 1) <: int)

print (int <: object)
print (object :> int)
print (int <: int)
print (object <: int)
print (bool <: string)
try { 1 <: int; } (e: Exception) => { print ("1: " + string e); }
try { int <: 1; } (e: Exception) => { print ("2: " + string e); }
C ::= class {
    n : int = 0
}
print (C <: object)
print (C <: int)

superOf := object.:>
print (superOf int)
print (int.<: object)

try { 1 : 5; } (e: Exception) => { print ("右边不是类型: " + string e); }
print "done"
ravel ""

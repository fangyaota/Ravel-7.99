# 无类体的类: 类型 Void 不能作为构造器调用
# 实例读 call: 类型 'C' 没有方法 'call'
# int 读 call: 类型 'Integer' 没有方法 'call'
# 42
# 自定义 call 也不行: 值 Adder {} 不是函数，不能调用
# C
# <scope>
# Renamed
# Renamed
# true
# false
# true
# true
# true
# true
# false
# true
# true
# true
# true
# true
# false
# true
# true
# true
# true

# 两张成员表/属性槽
using "plugins/Ravel.Generated.dll"

ravel "242_main0"
C ::= class {
    n: int = 7
    g := () => { this.n; }
}
c := C ()

print c.n
print (c.g ())

C.func := (x: int) => { x + 1; }
C.num := 5
print (C.func 5)
print C.num
try { print (c.func 5); } (e: Exception) => { print ("1: " + string e); }
try { print c.num; } (e: Exception) => { print ("2: " + string e); }
print ((C.Fields ()).Contains "func")
print ((c.Fields ()).Contains "func")

l := [1 2 3]
print (l.Count ())
try { print (list.Count ()); } (e: Exception) => { print ("3: " + string e); }
try { print (list.Add 2); } (e: Exception) => { print ("4: " + string e); }
print ((list.Fields ()).Contains "Add")

print (Json.FromString "{\"a\":1}")
try { print (Json.Kind); } (e: Exception) => { print ("5: " + string e); }

print (1 + 2)
print (1 == 2)
print (5.: int)

j := Json {"a"-> 1}
j.tag := 1
print j.tag
try { print (Json 2).tag; } (e: Exception) => { print ("6: " + string e); }

print (C.parent)
try { C.parent = int; } (e: Exception) => { print ("7: " + string e); }
try { C.block = (); } (e: Exception) => { print ("8: " + string e); }
C.name = "改过的"
print C

print "end"
ravel ""

ravel "146_class_flat_inherit"
Base := class {
    init = () => { 0; this; }
    x: int = 1
    y: int = 5
}
Child := class Base {
    init = () => { 0; this; }
    x2: int = 100
}
c := Child ()
print (c.x)
print (c.x2)
print (c.y)

Bad := class Base {
    x: int = 100
}
try { Bad (); } (e: Exception) => { print ("1: " + string e); }
Deferred := class {
    init = () => { v = 10; this; }
    v: int = 0
}
Child2 := class Deferred { init = () => { 0; this; } }
c2 := Child2 ()
print (c2.v)

A := class {
    init = () => { a = 1; this; }
    a: int = 0
}
B := class A {
    init = () => { b = 2; this; }
    b: int = 0
}
obj := B ()
print (obj.a)
print (obj.b)
ravel ""

ravel "243_body_scope"
make := () => {
    Helper := 7
    class {
        x: int = Helper
    }
}
P := make ()
print (P ())

TopHelper := 3
Q ::= class (P) {
    y: int = TopHelper
}
print (Q ())

R ::= class (P) {
    z: int = x + 1
}
print (R ())

H ::= class {
    Helper: int = 9
    got := () => { Helper; }
}
print ((H ()).got ())

M ::= class {
    n: int = 5
    f := () => { n + (make2 ()); }
}
make2 := () => { 10; }
print ((M ()).f ())
print "end"
ravel ""

ravel "350_main3"
using "plugins/Ravel.Generated.dll"

sb := NSb.StringBuilder ()
sb.Append_3 "hello"

print (sb.Length)

sb.Length = 2
print (sb.Length)
print (sb.ToString ())

sb.Length += 3
print (sb.Length)

print ((sb.Fields ()).Contains "Length")

print (sb.MaxCapacity > 0)
try { sb.MaxCapacity = 1; print "没拦住"; } (e: object) => { print "只读拦住了"; }

sp := NSpan.TimeSpan 10000000
print (sp.TotalSeconds)
print (sp.Seconds)
print (sp.Ticks)
print ((sp.TotalSeconds) + 1)

print (((NSpan.TimeSpan 600000000).Duration ()).TotalMinutes)
ravel ""

ravel "351_main4"
using "plugins/Ravel.Generated.dll"

print (NMath.PI)
print (NMath.E)
print (NMath.Tau)

print ((NMath.PI) > 3)
print (NMath.PI == 3.141592653589793)

print ("[" + NStr.Empty + "]")

try { NMath.PI = 3; print "只读没拦住"; } (e: object) => { print "只读拦住了"; }

print ((NMath.Fields ()).Contains "PI")
ravel ""

ravel "352_main5"
using "plugins/Ravel.Generated.dll"

a := NSb.StringBuilder ()
a.Append_3 "hello"
b := NSb.StringBuilder ()
b.Append_3 "world"

print (a.Length)

by a.Length = property (() => { 42; }) ((v: int) => { (); })
print (a.Length)
print (a.Length = 7)
print (a.Length)

print (b.Length)

d := NDate.DateTime 0
try {
    by d.Year = property (() => { 1; }) ((v: int) => { (); });
    print "值类型换槽没拦住";
} (e: object) => {
    print "值类型那一格换不掉";
}

by 年 := property (() => { d.Year; }) ((n: int) => { d = d.AddYears (n - d.Year); })
print (d.Year)
年 = 2000
print (d.Year)
print ((NDate.DateTime 0).Year)

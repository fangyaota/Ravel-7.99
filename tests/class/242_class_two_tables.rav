# 一个**类对象有两张表**,分工是结构性的(不靠标记、不靠过滤):
#
#   ① 类自己那张（`ClassVal.Scope`，也就是基类 `ObjectVal.Scope`）—— 类对象是元类 `type`
#      的实例,建类时平铺进来的 `name`/`parent`/`block`/`init`/`==`/`!=`,用户事后挂上去的
#      `C.func := …`,以及**类那一侧**的 API(`Json.FromString`)。
#   ② 给它那些**实例**的表（`ClassVal.InstanceTable`）—— 内置方法(`Add`/`Map`/`Kind`…)、
#      类运算符、序列方法、`GetImplements ()` 这类查询。
#
# 于是两件事都是结构决定的了(从前要靠 `forInstance` + `private` 两个标记去挡):
#   * 类上挂的东西实例看不到(`C.func := …` 落在①,实例读②);
#   * 内置方法从**类那一侧**读不到(`Add` 在②里,类对象自己的查找不经过它)——
#     从前从类上读到的那份没绑 `self`,调用时 `((ListVal)ClassVal)` 当场炸成
#     「!! 解释器内部错误 InvalidCastException」。

C ::= class {
    n: int = 7
    g := () => { this.n; }
}
c := C ()

# ① 类体里写的成员:实例化时落进**每个实例自己的表**,和这两张表无关
print c.n
print (c.g ())

# ② 事后挂在**类**上的:只有类对象自己看得到
C.func := (x: int) => { x + 1; }
C.num := 5
print (C.func 5)
print C.num
try { print (c.func 5); } (e: Exception) => { print ("1: " + string e); }
try { print c.num; } (e: Exception) => { print ("2: " + string e); }
print ((C.Fields ()).Contains "func")       # 类那一侧列得出
print ((c.Fields ()).Contains "func")       # 实例那一侧列不出

# ③ 内置实例方法在②里:实例读得到,类对象那一侧读不到
l := [1 2 3]
print (l.Count ())
try { print (list.Count ()); } (e: Exception) => { print ("3: " + string e); }
try { print (list.Add 2); } (e: Exception) => { print ("4: " + string e); }
print ([1 2 3].Fields ())                   # 实例:整串
print ((list.Fields ()).Contains "Add")     # 类对象:没有它

# ④ 类那一侧的 API 不进②:`Json.FromString` 就是**在类上读**的
print (Json.FromString "{\"a\":1}")
try { print (Json.Kind); } (e: Exception) => { print ("5: " + string e); }

# ⑤ 运算符也在②里(以左值为身份的那张表)—— 连值类型的:
#    元类链那一半保证挂在 `object` 上的 `:`/`<:`/`:>` 任何值都摸得到,
#    自指的 `Every`(`parent` 是自己)也算
print (1 + 2)
print (1 == 2)
print (5.: int)
print (default : int)

# ⑥ 值**自己**那层照旧留给用户挂的东西:只影响那一个值
j := Json {"a"-> 1}
j.tag := 1
print j.tag
try { print (Json 2).tag; } (e: Exception) => { print ("6: " + string e); }

# ⑦ 机制成员 `parent` / `block` 是**只读**的:它们是"这个类是什么"的定义,
#    改它等于把类换一个(`C.parent = int` 之后 `C ()` 就去跑 Integer 的构造器了)
print (C.parent)
try { C.parent = int; } (e: Exception) => { print ("7: " + string e); }
try { C.block = (); } (e: Exception) => { print ("8: " + string e); }
C.name = "改过的"                 # `name` 照旧可写:那是它本来的用法(`F.name = "x"`)
print C

print "end"

# ═══ 146_class_flat_inherit(并入) ═══
ravel "146_class_flat_inherit"
# 平铺继承:各层类体的字段落在同一个作用域,不做链式查找。
# **同名就是错**(`:=` 是定义不是覆盖)—— 子类再声明父类已声明过的字段,实例化时当场报错。
# 1) 子类没声明的字段 → 从父类那层可见;子类自己声明的另起一个名字
Base := class {
    init = () => { 0; this; }
    x: int = 1
    y: int = 5
}
Child := class Base {
    init = () => { 0; this; }
    x2: int = 100
}
c := Child ()
print (c.x)
print (c.x2)
print (c.y)

# 同名字段 → 报错(建类时不报,实例化那一刻各层类体跑进同一个作用域才撞上)
Bad := class Base {
    x: int = 100
}
try { Bad (); } (e: Exception) => { print ("1: " + string e); }
# 2) 父类 init 不自动调用:父类 init 里的赋值不生效,初始值看字段声明
Deferred := class {
    init = () => { v = 10; this; }
    v: int = 0
}
Child2 := class Deferred { init = () => { 0; this; } }
c2 := Child2 ()
print (c2.v)

# 3) 只有最具体层的 init 被调用;祖先的 init 不跑
A := class {
    init = () => { a = 1; this; }
    a: int = 0
}
B := class A {
    init = () => { b = 2; this; }
    b: int = 0
}
obj := B ()
print (obj.a)
print (obj.b)
ravel ""

# ═══ 243_body_scope(并入) ═══
ravel "243_body_scope"
# 每层类体的**自由名字**按"那一层写在哪"解析 —— 定义照旧平铺进**同一个**实例表。
#
# 从前只有一个词法父:最具体那个类的写法处。于是父类写在**别的作用域**时,它的类体看不见
# 自己那儿的名字(P 的 `Helper` 在 `make` 里,而 Q 写在顶层 → 解析不到)。现在每层跑在自己的
# `BodyScope` 上:词法父 = 该层的 `CaptureScope`,定义转发回实例表(见 `Runtime/BodyScope.cs`)。

make := () => {
    Helper := 7
    class {
        x: int = Helper          # 这一层写在 make 里面
    }
}
P := make ()
print (P ())

TopHelper := 3
Q ::= class (P) {
    y: int = TopHelper           # 这一层写在顶层
}
print (Q ())

# 平铺照旧:父层的字段就在**同一张表**上,子类的类体里读得到
# (重声明同名是另一条规矩,当场报错 —— 见 tests/236)
R ::= class (P) {
    z: int = x + 1               # `x` 是父层那个字段
}
print (R ())

# 自由名字与字段重名时**字段优先**(和从前一致):本层那个 `Helper` 就是字段
H ::= class {
    Helper: int = 9
    got := () => { Helper; }     # 类体里的裸名字 → 先看实例表本层
}
print ((H ()).got ())

# 闭包捕获的也是这一层(方法体里既读得到字段、也看得见定义处)
M ::= class {
    n: int = 5
    f := () => { n + (make2 ()); }
}
make2 := () => { 10; }
print ((M ()).f ())
print "end"
ravel ""

# `IEnumerable` / `IEnumerator` —— 用 `interface` 写出来的库级接口(predefined.rav),形状照 C#:
#
#     IEnumerable ::= interface { internal GetEnumerator : function = default }
#     IEnumerator ::= interface { internal MoveNext : function = default
#                                 by Current    : object   = default }
#
# `GetEnumerator ()` 交回一个**枚举器**;枚举器 `MoveNext ()` 往前走一步(返回还有没有),
# `Current` 是当前那个(C# 里它是属性,这边也做成属性)。库里的 `Enumerator` 就是拿一串值
# 做的通用枚举器。
#
# 接口对象**继承自 object**(和 C# 一样:接口不是"继承了一个叫 Interface 的基类"),
# 但它的**类型是 interface** —— `typeof IEnumerable` 是 `Interface`。
# 三种容器各 `impl` 一条,于是 `is` / 注解 / `foreach` 都认它们。

# ---- 它是什么 ----
print (IEnumerable.parent)            # 序列这一族也是 monad,父接口是 IMonad(见 lib/monad.rav)
print ((IEnumerable.parent).parent)   # IMonad 的父是 BaseInterface(所有接口的根)
print ((IEnumerable.parent) : type)
print (typeof IEnumerable)
print (IEnumerable : interface)
print ([1 2 3] : IEnumerable)
print ("abc" : IEnumerable)     # 字符串也认(标量一样能挂接口槽;元素是字符)

# ---- 枚举器本身,和 C# 一个用法 ----
e := [4 5].GetEnumerator ()
print (e : IEnumerator)
while { e.MoveNext (); } { print (e.Current); }
print (e.MoveNext ())          # 走完了再问就是 false
print (([9].GetEnumerator ()) : IEnumerator)   # 每次都新开一个,互不打扰

# ---- foreach 就是照这个形状写的 ----
foreach [1 2 3] (x: int) => { print ("list " + string x); }
foreach {"a"-> 7 "b"-> 8} (v: int) => { print ("dict " + string v); }
foreach [1 2] (x: int) => { foreach [10 20] (y: int) => { print ((string (x)) + "-" + (string y)); } }

# ---- 注解、参数也认接口,通用函数写得出来 ----
# 接口承诺的就是"给我一个枚举器",所以通用函数按枚举器的用法写 —— 任何实现者都吃得住。
total := (xs: IEnumerable) => {
    acc := 0
    it := xs.GetEnumerator ()
    while { it.MoveNext (); } { acc += it.Current; }
    acc
}
print (total [1 2 3])
print (total {4 5})
print (total {"a"-> 1 "b"-> 2})

# ---- 自己的类实现它 ----
Seq ::= class {
    n : int = 0
    init = (k: int) => { n = k; this; }
}
# 交回一个枚举器就行 —— 库里的 `Enumerator` 拿来就能用。
# (`property g s` 要写在**同一行**:换行就是两条语句,槽里会只剩半截 `property`)
seqImpl := use (IEnumerable Seq {
    GetEnumerator = () => { Enumerator [instance.n (instance.n + 1) (instance.n + 2)]; }
})
s := Seq 7
print (s : IEnumerable)
print (total s)
foreach s (x: int) => { print ("mine " + string x); }

# ---- T.GetImplements ():这个类型**现在**实现了哪些接口 ----
# 实现是登记在作用域里的,所以这是一份"当下"的快照:换了作用域、`Dispose` 之后就没了。
Sub ::= class Seq {
    tag : int = 0
}
# ---- I.GetImplementors ():反过来问 —— 现在哪些**类型**实现了这个接口 ----

MyIface ::= interface {
    by Go : function = default
}
MyThing ::= class {
    x : int = 0
}
myImpl := use (MyIface MyThing {
    by Go = property (() => { () => { instance.x; }; }) ((v: function) => { (); })
})
myImpl.Dispose ()

seqImpl.Dispose ()

# ---- 不是可枚举的:报错说清楚要什么 ----
try { foreach 5 (x: int) => { 0; } } (e2: Exception) => { print ("1: " + string e2); }
try { foreach "abc" (c: string) => { 0; } } (e2: Exception) => { print ("2: " + string e2); }

# ═══ 220_inumber(并入) ═══
ravel "220_inumber"
# `INumber` —— predefined.rav 里那个**空槽接口**:五种数值类型都实现了它。
#
# 用处是给"要一个数"的参数当注解(见 lib/math.rav 的 `Square` / `Cube` / `Deg` / `Rad`)。
# 从前那种地方标的是 `ValueType`,那个连 String 都收(`String <: ValueType`),
# 字符串乘不起来;标 `real` 又只收 real —— 参数注解不做隐式转换。
using "math.rav"

# ---- 谁算数 ----
print (5 : INumber)
print (2.5 : INumber)
print ((bigint 5) : INumber)
print ((fraction 1 3) : INumber)
print ((bigfraction 1 3) : INumber)
print ("a" : INumber)
print (true : INumber)
print ([1] : INumber)
print ((typeof 5) <: INumber)          # 类型那一侧也认(和 `is` 同一个判据)

# ---- 两个查询都看得见它 ----

# ---- math.rav 那四个现在收 INumber ----
print (Math.Square 5)
print (Math.Square 2.5)
print (Math.Cube 3)
print (Math.Deg Math.Pi)
print (Math.Rad 180)

# ---- 不是数的当场说清楚(而不是让它烂在 `x * x` 里) ----
try { print (Math.Square "a"); } (e: Exception) => { print ("1: " + string e); }
try { print (Math.Square true); } (e: Exception) => { print ("2: " + string e); }
ravel ""

# ═══ 234_icomparable(并入) ═══
ravel "234_icomparable"
# `IComparable` / `Sorting`:谁大谁小,以及"按什么排"由**类型自己**说了算。
#
# 协议是 `CompareTo`:收对方、交回 -1 / 0 / 1(和 C# 的 IComparable 同约定)。引擎在 `Object`
# 上放了一条 —— 内建那把尺子(数值、字符串之间怎么比),所以**每个值都有**,不必谁登记:
# `3.CompareTo 5` 拿起来就能用。
#
# 自己写的类型嫌那把尺子不够(它比不了你的对象),就在**类里写一条** `CompareTo` ——
# 它盖掉 `Object` 那条(和 `ToString` 同一个规矩);再 `impl` 登记一下"我这个类型讲了怎么比"。
# (现装那条 `by CompareTo = property …` 在这儿**用不了**:这个名字 `Object` 上已经有了,
#  类链先说话 —— 槽还没轮到。)
#
# 排序是库里自己写的**稳定**归并(`Sorting.Sort` / `SortBy`):比的是 `CompareTo`,
# 所以实现了接口的类型也排得了 —— 引擎那个 `xs.Sort ()` 只认内建标量,碰见对象只会说「比不了」。

# ① 协议:每个值都有
print (3.CompareTo 5)
print (5.CompareTo 3)
print (5.CompareTo 5)
print ("a".CompareTo "b")
print ("b".CompareTo "b")
print ((2.5).CompareTo 1.5)
print ((bigint 5).CompareTo (bigint 7))

# ② 登记 = "这个类型自己讲了怎么比"这个类型层面的事实(内建那几个也登记过)
print (3 : IComparable)
print ("a" : IComparable)
print ([1 2] : IComparable)

# ③ 库里那些通用件:对着 `CompareTo` 写,所以内建 / 自写两边都吃
print (Sorting.Compare 3 5)
print (Sorting.Sort [3 1 2])
print (Sorting.Sort [])
print (Sorting.Sort [7])
print (Sorting.Sort [3 1 2 1 3])
print (Sorting.Sort ["bb" "a" "ccc"])
print (Sorting.SortBy ["bb" "a" "ccc"] ((s: string) => { s.Length (); }))
print (Sorting.Max [3 9 2])
print (Sorting.Min [3 9 2])
print (Sorting.MaxBy ["bb" "a" "ccc"] ((s: string) => { s.Length (); }))
print (Sorting.MinBy ["bb" "a" "ccc"] ((s: string) => { s.Length (); }))

# ④ 自己写的类型:类里一条 CompareTo + impl 登记
Rec ::= class {
    K: int = 0
    N: string = ""
    init = (k: int n: string) => { K = k; N = n; this; }
    CompareTo := (o: Rec) => { if { K < o.K; } { -1; } { if { K > o.K; } { 1; } { 0; } } }
}
impl (IComparable Rec {
    ()
})
rs := []
rs.Add (Rec 3 "c")
rs.Add (Rec 1 "a")
rs.Add (Rec 2 "b")
print ((Sorting.Sort rs).Map ((r: Rec) => { r.N; }))
print ((Sorting.SortBy rs ((r: Rec) => { r.K; })).Map ((r: Rec) => { r.N; }))
print ((Sorting.Max rs).N)
print ((Sorting.Min rs).N)
print ((Sorting.MaxBy rs ((r: Rec) => { r.N; })).N)

# 稳定:键相等的保持原来的先后
r2 := []
r2.Add (Rec 1 "x")
r2.Add (Rec 1 "y")
r2.Add (Rec 0 "z")
print ((Sorting.Sort r2).Map ((r: Rec) => { r.N; }))

# ⑤ 比不了 / 空表:当场说人话,不静默给个错答案
try { rs.Sort (); } (e: Exception) => { print ("1: " + string e); }
try { Sorting.Sort [1 "x"]; } (e: Exception) => { print ("2: " + string e); }
try { Sorting.Max []; } (e: Exception) => { print ("3: " + string e); }
print "end"
ravel ""

# ═══ 235_ikey(并入) ═══
ravel "235_ikey"
# `IKey` / `IDict`:字典的键操作**分两层**。
#
#   * 引擎那套叫 `SysGet` / `SysSet` / `SysHas` / `SysRemove` / `SysGetOr` —— 同步的 C#,
#     只吃**值类型**键(它够不着你写的 `Key`:调 Ravel 函数要推帧,而查表那一步还在
#     .NET 字典的内部,那儿更插不进帧);
#   * 日常敲的 `d.Get` / `d.Set` / `d.Has` / `d.Remove` / `d.GetOr` 是**库注入**的
#     (`lib/keys.rav` 的 `IDict` 接口槽):先把键规范成值类型、再转到 `Sys*` 上,
#     于是"内容一样的两个对象"是同一条。
#
# 名字腾出来是前提:类链上还占着 `Get` 的话,接口槽**够不着而且静默**(`TraitSlot` 的规矩)。

# ① 协议:每个值都有(`Key ()` = "我当键时等于什么";默认那把尺子只对值类型有话说)
print (5.Key ())
print ("a".Key ())
print ((Keys.Of 5) == 5)
print ((Keys.Of "a") == "a")
try { print ((Some 5).Key ()); } (e: Exception) => { print ("1: " + string e); }

# ② dict:键是值类型,相等就是值自己的
d := {}
d.Set 1 "int"
d.Set "1" "str"
d.Set 1.0 "real"
print (d.Count ())
print (d.Get 1)
print (d.Get "1")
print (d.Get 1.0)
print (d.Has 2)
print (d.Keys ())
print ({1-> "a"}.Get 1)
print (d : IDict)
try { d.Set ([1 2]) "x"; } (e: Exception) => { print ("2: " + string e); }
try { print (d.Get 999); } (e: Exception) => { print ("3: " + string e); }

# ③ 字面量的键是**表达式**:`{"a": 1}` 而不是 `{a: 1}`(那个 `a` 是变量)
print {"a"-> 1}
print {1-> 2}
print {1 2}
k := "kk"
print {k-> 1}
n := 7
print {n-> 1}
print {"a" + "b"-> 1}
try { print {zz-> 1}; } (e: Exception) => { print ("4: " + string e); }

# ④ 登记 = "这个类型自己讲了怎么当键"这个类型层面的事实(内建那几个值类型也登记过)
print (5 : IKey)
print ("a" : IKey)
print ([1 2] : IKey)

# ⑤ 值语义:类里写一条 `Key`(它盖掉 `Object` 那条),再 impl 登记
Rec ::= class {
    X: int = 0
    N: string = ""
    init = (x: int n: string) => { X = x; N = n; this; }
    Key := () => { X; }
}
impl (IKey Rec {
    ()
})
print ((Rec 1 "a") : IKey)
print (Keys.Of (Rec 7 "x"))

d2 := {}
d2.Set (Rec 1 "甲") "one"
d2.Set (Rec 2 "乙") "two"
print (d2.Get (Rec 1 "别的"))
print (d2.Has (Rec 2 "别的"))
print (d2.Count ())
print (d2.Keys ())
print (d2.GetOr (Rec 9 "z") "缺")
print (d2.Remove (Rec 1 "别"))
print (d2.Has (Rec 1 "别"))

# 引擎那套(raw)不认对象 —— 它只吃值类型
try { print (d2.SysGet (Rec 1 "别")); } (e: Exception) => { print ("5: " + string e); }

# 没写 `Key` 的类型:引擎那句(指向"在类里写一条 Key")
B ::= class {
    X: int = 0
    init = (x: int) => { X = x; this; }
}
try { d2.Get (B 1); } (e: Exception) => { print ("6: " + string e); }

# `Key` 交回的不是值类型:库这层当场说清楚
C ::= class {
    X: int = 0
    init = (x: int) => { X = x; this; }
    Key := () => { [X]; }
}
try { Keys.Of (C 1); } (e: Exception) => { print ("7: " + string e); }

# ⑥ `Keyed`:以任意值为键、还能把**原对象**拿回来(普通 dict 里只剩规范键)
t := Keyed ()
t.Set (Rec 1 "甲") "one"
t.Set (Rec 2 "乙") "two"
print (t : IDict)
print (t.Get (Rec 1 "丙"))
print (t.Has (Rec 2 "丁"))
print (t.Count ())
print ((t.Keys ()).Map ((r: Rec) => { r.N; }))
print (t.Values ())
print (t.GetOr (Rec 5 "x") "缺")
print (t.Remove (Rec 1 "戊"))
print (t.Count ())
print ((t.Keys ()).Map ((r: Rec) => { r.N; }))
t.Clear ()
print (t.Count ())

# ═══ 枚举器**也是**一串(`IEnumerator <: IEnumerable`)═══
# 它自己就是自己的枚举器,所以整套方法白拿、也能直接 foreach。
# 两条语义(单遍的东西本来就这样):遍历的是**还没走完的那一段**;走一遍就**消耗掉**。
e := Enumerator [1 2 3]
print (e : IEnumerator)
print (e : IEnumerable)
print (e : IMonad)
print (e.Count ())              # 3
print (e.Count ())              # 0 —— 上一句把它走完了
f := Enumerator [1 2 3 4 5]
print (f.First ())              # 1
print (f.Current)
print (Seqs.Gather (f.Take 2))  # 接着往后两个
print (Seqs.Gather (f.Map ((x: int) => { x + 1; })))
print (f.ToList ())             # 也被上面那两句走完了
print (f.IsEmpty ())
g := Enumerator [7 8 9]
foreach g (x: int) => { print x; }
print (g.Count ())              # 0 —— foreach 把它走完了
# `Generator` 的光标也一样:能拿它当一串用(比如"先看几个,剩下的照旧")
G := Generator (y: function) => { y 1; y 2; y 3; }
c := G.GetEnumerator ()
print (c : IEnumerable)
print (Seqs.Gather (c.Take 2))   # [1 2] —— Take 只取 n 个,**不多走一步**
print (c.ToList ())              # [3] —— 剩下的照旧
print "end"
ravel ""

# interface 基础/生命周期
ravel "213_main0"
myTrait ::= interface {
    by a : int = _
    by b : function = _
}

myClass ::= class {
    x : int = 0
}

myImplement := myTrait myClass {
    by a = property (() => { instance.x; }) ((v: int) => { instance.x = v; })
    by b = property (() => { () => { print "myTrait.b override"; } }) ((v: function) => { (); })
}

u := myClass ()
try { print u.a; } (e: Exception) => { print ("1: " + string e); }
try { early : myTrait = u; print early; } (e: Exception) => { print ("2: " + string e); }

use myImplement

print u.a
print (u.a = 7)
print u.x
print u.a
u.b ()

print (u : myTrait)
print (u : myClass)
print (myImplement : myTrait)

typed : myTrait = u
print (typed : myTrait)
print typed.a
take := (v: myTrait) => { v.a; }
print (take u)
print (take (myClass ()))
try { take 5; } (e: Exception) => { print ("3: " + string e); }
otherClass ::= class {
    y : int = 0
}
try { take (otherClass ()); } (e: Exception) => { print ("4: " + string e); }

v := myClass ()
v.a = 99
print (v.a)
print (u.a)

try { u.a = "str"; } (e: Exception) => { print ("5: " + string e); }

myImplement.Dispose ()
try { print u.a; } (e: Exception) => { print ("6: " + string e); }
print (u : myTrait)
try { late : myTrait = u; print late; } (e: Exception) => { print ("7: " + string e); }

impl myImplement
print u.a
myImplement.Dispose ()
ravel ""

ravel "221_instance_lifetime"
T ::= interface {
    by f : function = _
    by a : int = _
}
C ::= class {
    x : int = 0
}

impl (T C {
    by f = property (() => { () => { instance.x; }; }) ((v: function) => { (); })
    by a = property (() => { instance.x; }) ((v: int) => { instance.x = v; })
})

u := C ()
w := C ()
u.x = 1
w.x = 2

g := u.f
print (g ())
h := w.f
print (h ())
print (g ())

N ::= interface {
    by peek : int = _
    by c : int = _
}
D ::= class {
    y : int = 0
}
p := D ()
q := D ()
p.y = 10
q.y = 20
impl (N D {
    by peek = property (() => { instance.y; }) ((v2: int) => { (); })
    by c = property (() => { print q.peek; instance.y; }) ((v2: int) => { (); })
})
print (p.c)

A ::= interface {
    by n : int = _
}
E ::= class {
    z : int = 0
}
impl (A E {
    by n = property (() => { instance.z; }) ((x: int) => { instance.z = x; })
})
l := E ()
r := E ()
l.z = 1
r.z = 2
l.n += r.n
print (l.z)
print (r.z)

H ::= interface {
    by c : int = _
}
F ::= class {
    w : int = 0
}
impl (H F {
    helper := () => { instance.w; }
    by c = property (() => { (helper ()) + 1; }) ((v3: int) => { (); })
})
s := F ()
s.w = 41
print (s.c)

slot := by s.c
try { print (slot.Get ()); } (e: Exception) => { print ("1: " + string e); }
try { print s.instance; } (e: Exception) => { print ("2: " + string e); }

R ::= interface {
    by c : int = _
}
G ::= class {
    v4 : int = 0
}
impl (R G {
    by c = property (() => { (); }) ((v5: int) => { instance = 5; })
})
t := G ()
try { t.c = 1; } (e: Exception) => { print ("3: " + string e); }

print (s.c)
by s.c = property (() => { 99; }) ((v6: int) => { (); })
print (s.c)

Bad ::= interface {
    by instance : int = _
}
K ::= class {
    x : int = 0
}
try {
    impl (Bad K {
        ()
    })
} (e: Exception) => { print ("4: " + string e); }

im := impl (H F {
    show := () => { instance.w; }
    by c = property (() => { show (); }) ((v7: int) => { (); })
})
z := F ()
z.w = 8
print (z.c)
try { im.show (); } (e: Exception) => { print ("5: " + string e); }

dup := im.Copy ()
use dup
z2 := F ()
z2.w = 7
print (z2.c)
dup.Dispose ()
print (z2.c)
ravel ""
# --- expected ---
# 1: 类型 'myClass' 没有方法 'a'
# 2: 这一格要的是 myTrait，得到 myClass
# 0
# 7
# 7
# 7
# myTrait.b override
# true
# true
# true
# true
# 7
# 7
# 0
# 3: 参数 'v' 需要 myTrait，得到 Integer
# 4: 参数 'v' 需要 myTrait，得到 otherClass
# 99
# 7
# 5: 参数 'v' 需要 Integer，得到 String
# 6: 类型 'myClass' 没有方法 'a'
# false
# 7: 这一格要的是 myTrait，得到 myClass
# 7
# 1
# 2
# 1
# 20
# 10
# 3
# 2
# 42
# 1: `instance` 只在实现体的槽里有效：此刻没有正在被服务的实例（它指的是「这一次调用在服务谁」，离开那次调用就没有了）
# 2: 类型 'F' 没有方法 'instance'
# 3: 无法给只读变量 'instance' 赋值
# 42
# 99
# 4: 接口 Bad 里声明了名为 'instance' 的槽 —— 那是引擎自己的名字（它指的是「这一次在服务谁」），换一个
# 8
# 5: `instance` 只在实现体的槽里有效：此刻没有正在被服务的实例（它指的是「这一次调用在服务谁」，离开那次调用就没有了）
# 7
# 7

# 运算符/模块类型
using "math.rav"

ravel "64_main0"
Vec := class {
    init = () => { this.v = 10; this; }
    v: int = 0
    + := (x: int) => { v + x; }
    * := (x: int) => { v * x; }
    - := (x: int) => { v - x; }
}
a := Vec ()
print (a + 5)
print (a * 3)
print (a - 2)
addFn := a.+
print (addFn 100)
ravel ""

ravel "65_operator_inherit"
Node := class { init = () => { 0; this; }; }
Child := class Node {
    init = () => { 0; this; }
    v: int = 42
    + := (x: int) => { v + x; }
}
c := Child ()
print (c + 8)

Base := class {
    init = () => { 0; this; }
    n: int = 1
    + := (x: int) => { n + x; }
}
Derived := class Base {
    init = () => { 0; this; }
    + = (x: int) => { n * 100 + x; }
}
d := Derived ()
b := Base ()
print (d + 5)
print (b + 5)
ravel ""

ravel "66_operator_isolation"
A := class {
    init = () => { this.n = 1; this; }
    n: int = 0
    + := (x: int) => { n + x; }
}
a1 := A ()
a2 := A ()
a1.n = 100
print (a1 + 0)
print (a2 + 0)
ravel ""

ravel "67_operator_this"
B := class {
    init = () => { this.val = 10; this; }
    val: int = 0
    + := (x: int) => { val + x; }
    * := (x: int) => { this.val * x; }
}
b := B ()
print (b + 5)
print (b * 3)
b.val = 50
print (b + 5)
print (b * 3)
ravel ""

ravel "151_operator_section"
add2 := +.2
print (add2 5)

print ((+.(2 * 3)) 10)

print ((+.1) 41)
print ((_ + 1) 41)

C := class { init = () => { 0; this; }; v: int = 100; }
c := C ()
print ((+.c.v) 1)

print ((*.3) 5)
print ((==.5) 5)
print ((<.5) 3)

d := 2.+
print (d 3)
ravel ""

ravel "281_main5"
using "math.rav"

print (typeof (Math))
print ((typeof (Math)) == (typeof (System)))
print (Math)
print (System)
print (Math : object)
print (Math : System.Function)

print (Math : Ravel)
print (System : Ravel)
print (5 : Ravel)
print ("x" : Ravel)
print (Math.Square 6)
print ((Math.Fields ()).Count ())

try { System.Class; } (e: Exception) => { print ("1: " + string e); }
try { Math.Nope; } (e: Exception) => { print ("2: " + string e); }

try { Math <: object; } (e: Exception) => { print ("3: " + string e); }
try { 5 <: int; } (e: Exception) => { print ("4: " + string e); }
ravel ""

ravel "Mine"
print (typeof (Mine))
print (Mine)
ravel ""

ravel "64_identity"
same := [1 2]
other := [1 2]
print (1 === 1)
print (1 === 1.0)
print (1 !== 1.0)
print (1 == 1.0)
print ("a" === "a")
print (same === same)
print (same === other)
print (same !== other)
print (same == other)
print ({->} === {->})
Point := class { init = () => { 0; this; }; }
p := Point ()
q := Point ()
print (p === p)
print (p === q)
print (1 === 1 === 1)
sameEq := same.===
print (sameEq other)
Iffy := class { init = () => { 0; this; }; === := (o) => { "mine"; } }
i := Iffy ()
print (i === i)
print (i !== i)
ravel ""
ravel "64_container_ops"
print ([1 2] + [3])
print ([1 2 2] - [2])
xs := [1 2]
print (xs + [3])
print xs
print ({1 2} + {2 3})
print ({1 2} - {2})
print ({1 2} + [3])
print ({1 2} + {7 -> "a"})
d1 := {1 -> "a" 2 -> "b"}
print (d1 + {2 -> "B" 3 -> "c"})
print (d1 - {2})
print d1
print ("ab" + "cd")
print (1 + 2)
try { print ({1 2} + 5); } (e: Exception) => { print ("1: " + string e); }
try { print ({1 -> "a"} + [1]); } (e: Exception) => { print ("2: " + string e); }
ravel ""

# `flags` —— **按位的枚举**(`enum` 的**子类**,见 lib/enum.rav)。**要显式引用**。
#
# 声明、成员、`Values ()` / `Text ()` 那一套全照 `enum`;多出来的是**位运算**和
# "组合值"。这一条把三样都钉住:怎么拼、怎么问、组合值不是成员这件事。
using "enum.rav"

perms ::= flags {
    Read := 1
    Write := 2
    Exec := 4
}

# ── 值:单枚 ──
print (perms.Read.Value)
print (perms.Read.Name)
print (perms.Read.Text ())
print (perms.Values () |> .Map ((v: object) => { v.Text (); }) |> .ToList ())

# ── 拼(`|`) ──
p := (perms.Read | perms.Exec)
print (p.Value)
print (p.Text ())
# 拼出来正好等于某枚成员时,交回的**就是那一枚**(不是个等值的新壳子)
print ((perms.Read | perms.Read).Text ())
print ((perms.Read | perms.Write | perms.Exec).Text ())

# ── 问 ──
print (p.Names ())
print (p.Has (perms.Read))
print (p.Has (perms.Exec))
print (p.Has (perms.Write))
print (p.Has (perms.Read | perms.Exec))     # 这几位**全都要有**才算

# ── 交 / 差 / 对称差 ──
print ((p & perms.Exec).Text ())
print ((p & perms.Write).Text ())           # 一位都不剩 → "0"
print ((p - perms.Read).Text ())
print ((p ^ perms.Exec).Text ())

# ── 另一边直接给整数(解配置里那个掩码) ──
print ((perms.Read | 4).Text ())
print ((perms.Of 5).Text ())                # 不是成员 → 现拼一枚
print ((perms.Of 2).Text ())                # 是成员 → 交回**那一枚**
print ((perms.Of 5) == p)                   # `==` 比的是**值**,不是身份

# ── 继承:父类也得是 enum 一族(flags 或 enum 都行) ──
ext ::= flags perms {
    Link := 8
}
print ((ext.Read | ext.Link).Text ())
print ((ext.Values ()).Count ())            # 父类那几枚迁过来了
print (ext.Read is ext)                     # 迁过来的是**这个**的
print (ext.Read == perms.Read)              # 同名不同枚 —— `enum` 那条规矩照旧

# ── 报错:另一边不是同一个 flags、也不是整数 ──
print ((try { perms.Read | "x"; } (e: Exception) => { "1: " + (string e); }))

# ── 普通 enum 没被带累:这几样它没有 ──
e ::= enum {
    A := 1
    B := 2
}
print ((try { e.A | e.B; } (ex: Exception) => { "2: " + (string ex); }))
print ((try { e.A.Has e.B; } (ex: Exception) => { "3: " + (string ex); }))
# --- expected ---
# 1
# Read
# Read
# [Read Write Exec]
# 5
# Read|Exec
# Read
# Read|Write|Exec
# [Read Exec]
# true
# true
# false
# true
# Exec
# 0
# Exec
# Read
# Read|Exec
# Read|Exec
# Write
# true
# Read|Link
# 4
# true
# false
# 1: flags: 位运算两边得是同一个 flags 的值或整数（那边是 String）
# 2: 类型 e 不支持运算符 '|'
# 3: 类型 'e' 没有方法 'Has'

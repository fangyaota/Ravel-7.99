# property 属性基础
ravel "138_main0"
C := class {
    init = () => { this._val = 0; this; }
    _val: int = 0
    by val := property (() => { _val; }) ((v: int) => { _val = v; })
    get := () => { val; }
}
c := C ()
c.val = 99
print (c.get ())

print (c.val = 7)
print (c.get ())
print (c._val)

D ::= class {
    init = () => { 0; this; }
    by bad := 5
    read := () => { bad; }
    write := (q: int) => { bad = q; }
}
d := D ()
try { d.bad; } (e: Exception) => { print ("1: " + string e); }
try { d.bad = 1; } (e: Exception) => { print ("2: " + string e); }
try { d.bad += 1; } (e: Exception) => { print ("3: " + string e); }
try { d.read (); } (e: Exception) => { print ("4: " + string e); }
try { d.write 1; } (e: Exception) => { print ("5: " + string e); }

DL ::= class {
    init = () => { 0; this; }
    by dl: int = _
}
dl := DL ()
print (dl.dl)
print (dl.dl = 1)
print (dl.dl)

E ::= class {
    init = () => { 0; this; }
    _n: int = 1
    _f: real = 1.0
    _s: object = ""
    by n: int = property (() => { _n; }) ((q: int) => { _n = q; })
    by loose := property (() => { _s; }) ((q: object) => { _s = q; })
    by lying: string = property (() => { 42; }) ((q: object) => { 0; })
    by m: int = property (() => { _f; }) ((q: object) => { _f = q; })
}
e := E ()
print (e.n)
e.n = 7
print (e.n)
print (e.n = 9)
try { e.n = "str"; } (e2: Exception) => { print ("6: " + string e2); }
try { e.m += 1; } (e2: Exception) => { print ("7: " + string e2); }
e.loose = "anything"
print (e.loose)
print (e.lying)

OldSet := 0
NewSet := 0
S ::= class {
    init = () => { _n = 1; this; }
    _n: int = 1
    by n: int = property (() => { _n; }) ((q: int) => { OldSet += 1; _n = q; })
    swap := () => {
        by n = property (() => { _n * 100; }) ((q: int) => { NewSet += 1; _n = q; })
    }
}
s := S ()
s.n = 5
print (s.n)
print ("换之前 旧 " + (string (OldSet)) + " 新 " + (string NewSet))
s.swap ()
print (s.n)
s.n = 7
print (s.n)
print ("换之后 旧 " + (string (OldSet)) + " 新 " + (string NewSet))
plain := 1
try { by plain = 2; } (e2: Exception) => { print ("8: " + string e2); }
try { by nope = 2; } (e2: Exception) => { print ("9: " + string e2); }

GetCalls := 0
P ::= class {
    init = () => { _v = 1; this; }
    _v: int = 1
    by v := property (() => { GetCalls += 1; _v; }) ((q: int) => { _v = q; })
}
pp := P ()
p1 := by pp.v
print p1
print ("取完 getter 被调了 " + (string (GetCalls)) + " 次")
p1.Set 9
print (pp.v)
print (by pp.v == p1)
Bag := []
Bag.Add (by pp.v)
print ((Bag.At 0).Get ())
print ("至此 getter 被调了 " + (string (GetCalls)) + " 次")
try { print (by pp._v); } (e2: Exception) => { print ("10: " + string e2); }
try { print (by plain); } (e2: Exception) => { print ("11: " + string e2); }
ravel ""

ravel "142_property_attrs"
C := class {
    init = () => { 0; this; }
    readonly x: int = 42
    probe := () => {
        p := (currentScope ()).Lookup "x"
        print ((p.Attrs ()).Count ())
    }
}
c := C ()
c.probe ()
ravel ""
# --- expected ---
# 99
# 7
# 7
# 7
# 1: 'bad' 标了 by，但它的值不是 property（Integer 上没有 getter）
# 2: 'bad' 标了 by，但它的值不是 property（Integer 上没有 setter）
# 3: 'bad' 标了 by，但它的值不是 property（Integer 上没有 getter）
# 4: 'bad' 标了 by，但它的值不是 property（Integer 上没有 getter）
# 5: 'bad' 标了 by，但它的值不是 property（Integer 上没有 setter）
# ()
# 1
# ()
# 1
# 7
# 9
# 6: 参数 'q' 需要 Integer，得到 String
# anything
# 42
# 5
# 换之前 旧 1 新 0
# 500
# 700
# 换之后 旧 1 新 1
# 8: 'plain' 并非 by 属性
# 9: 未定义的变量 'nope'
# <property>
# 取完 getter 被调了 0 次
# 9
# true
# 9
# 至此 getter 被调了 2 次
# 10: '_v' 并非 by 属性
# 11: 'plain' 并非 by 属性
# 1

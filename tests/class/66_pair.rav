# pair:值类型的一对
ravel "66_pair"
p := pair 1 "a"
print p
print (p.Key ())
print (p.Value ())
print (p.At 0)
print (p.At 1)
print (p.Count ())
print (p.ToList ())
print (p : pair)
print (p : IValue)
print ((pair 1 "a") == (pair 1 "a"))
print ((pair 1 "a") === (pair 1 "a"))
print ((pair 1 "a") == (pair 1.0 "a"))
print ((pair 1 "a") != (pair 2 "a"))
d := {->}
d[pair "k" 1] = 7
print (d[pair "k" 1])
print (d.ContainsKey (pair "k" 1))
print ({{(pair 1 2) (pair 1 2)}}.Count ())
print (p : IList)
print ([(pair "a" 1) (pair "b" 2)] |> .ToDict ())
p.Foreach ((x) => { print x; })
[k v] := p
print k
print v
try { p.At 2; } (e: Exception) => { print ("1: " + string e); }
# --- expected ---
# 1 -> a
# 1
# a
# 1
# a
# 2
# [1 a]
# true
# true
# true
# true
# false
# true
# 7
# true
# 1
# true
# {a: 1 b: 2}
# 1
# a
# 1
# a
# 1: pair.At 的索引 2 越界 (一对只有 0 / 1 两格)

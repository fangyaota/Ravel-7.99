# pair:值类型的一对
ravel "66_pair"
p := pair 1 "a"
print p
print (p.Key ())
print (p.Value ())
print (p.At 0)
print (p.At 1)
print (p.Count ())
print (p.ToList ())
print (p : pair)
print (p : IValue)
print ((pair 1 "a") == (pair 1 "a"))
print ((pair 1 "a") === (pair 1 "a"))
print ((pair 1 "a") == (pair 1.0 "a"))
print ((pair 1 "a") != (pair 2 "a"))
d := {->}
d[pair "k" 1] = 7
print (d[pair "k" 1])
print (d.ContainsKey (pair "k" 1))
print ({{(pair 1 2) (pair 1 2)}}.Count ())
print (p : IList)
print ([(pair "a" 1) (pair "b" 2)] |> .ToDict ())
dm := {"a" -> 1 "b" -> 2}
print (dm.Contains (pair "a" 1))
print (dm.Contains (pair "a" 2))
print (1 -> 2)
print ((1 -> 2).Key ())
print ((1 -> 2 -> 3))
print (((1 -> 2) -> 3))
print ([1 -> 1])
print ({(1 -> 1)})
print (({1 -> 1;}) ())
print ((1 -> "a") == (1 -> "a"))
print (1 -> 2 : pair)
print (1 -> 2 == (pair 1 2))
x := 5
print (x : int -> 1)
print (1 + 2 -> 3)
Arrowish ::= class { -> := (o) => { "mine"; }; }
print (try { Arrowish (); } (e: Exception) => { string e; })
p.Foreach ((x) => { print x; })
[k v] := p
print k
print v
try { p.At 2; } (e: Exception) => { print ("1: " + string e); }

# --- expected ---
# 1 -> a
# 1
# a
# 1
# a
# 2
# [1 a]
# true
# true
# true
# true
# false
# true
# 7
# true
# 1
# true
# {a: 1 b: 2}
# true
# false
# 1 -> 2
# 1
# 1 -> 2 -> 3
# (1 -> 2) -> 3
# [1 -> 1]
# {1 -> 1}
# 1 -> 1
# true
# true
# true
# true -> 1
# 3 -> 3
# '->' 是继承来的成员 —— `:=` 遮不掉它（它不给覆盖，`=` 也不收）
# 1
# a
# 1
# a
# 1: pair.At 的索引 2 越界 (一对只有 0 / 1 两格)

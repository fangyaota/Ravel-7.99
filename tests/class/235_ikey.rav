# IKey 接口
using "math.rav"

ravel "235_ikey"
print (5.Key ())
print ("a".Key ())
print ((Keys.Of 5) == 5)
print ((Keys.Of "a") == "a")
try { print ((Some 5).Key ()); } (e: Exception) => { print ("1: " + string e); }

d := {->}
d.Set 1 "int"
d.Set "1" "str"
d.Set 1.0 "real"
print (d.Count ())
print (d.Get 1)
print (d.Get "1")
print (d.Get 1.0)
print (d.Has 2)
print (d.Keys ())
print ({1-> "a"}.Get 1)
print (d : IDict)
l := [1 2]
d.Set l "list"
print (d.Get l)
print (d.Has [1 2])
try { print (d.Get 999); } (e: Exception) => { print ("3: " + string e); }

print {"a"-> 1}
print {1-> 2}
print {1 2}
k := "kk"
print {k-> 1}
n := 7
print {n-> 1}
print {"a" + "b"-> 1}
try { print {zz-> 1}; } (e: Exception) => { print ("4: " + string e); }

print (5 : IKey)
print ("a" : IKey)
print ([1 2] : IKey)

Rec ::= class {
    X: int = 0
    N: string = ""
    init = (x: int n: string) => { X = x; N = n; this; }
    Key := () => { X; }
}
impl (IKey Rec {;})
print ((Rec 1 "a") : IKey)
print (Keys.Of (Rec 7 "x"))

d2 := {->}
r1 := Rec 1 "甲"
r2 := Rec 2 "乙"
d2.Set r1 "one"
d2.Set r2 "two"
print (d2.Get r1)
print (d2.Has r2)
print (d2.Count ())
print (d2.GetOr (Rec 9 "z") "缺")
print (d2.Remove r1)
print (d2.Has r1)
print (d2.Count ())
print ((d2.Keys ()).Map ((r: Rec) => { r.N; }))

C ::= class {
    X: int = 0
    init = (x: int) => { X = x; this; }
    Key := () => { [X]; }
}
try { Keys.Of (C 1); } (e: Exception) => { print ("7: " + string e); }

t := Keyed ()
t.Set (Rec 1 "甲") "one"
t.Set (Rec 2 "乙") "two"
print (t : IDict)
print (t.Get (Rec 1 "丙"))
print (t.Has (Rec 2 "丁"))
print (t.Count ())
print ((t.Keys ()).Map ((r: Rec) => { r.N; }))
print (t.Values ())
print (t.GetOr (Rec 5 "x") "缺")
print (t.Remove (Rec 1 "戊"))
print (t.Count ())
print ((t.Keys ()).Map ((r: Rec) => { r.N; }))
t.Clear ()
print (t.Count ())

e := Enumerator [1 2 3]
print (e : IEnumerator)
print (e : IEnumerable)
print (e : IMonad)
print (e.Count ())
print (e.Count ())
f := Enumerator [1 2 3 4 5]
print (f.First ())
print (f.Current)
print (Seqs.Gather (f.Take 2))
print (Seqs.Gather (f.Map ((x: int) => { x + 1; })))
print (f.ToList ())
print (f.IsEmpty ())
g := Enumerator [7 8 9]
g.Foreach (x: int) => { print x; }
print (g.Count ())
G := Generator (y: function) => { y 1; y 2; y 3; }
c := G.GetEnumerator ()
print (c : IEnumerable)
print (Seqs.Gather (c.Take 2))
print (c.ToList ())
print "end"
ravel ""
ravel "dict_no_sys"
d := {1 -> "a"}
print (d.Has 1)
print ((d.Set 2) "b")
print d
print (d.Remove 2)
print ((d.GetOr 9) "none")
try { print (d.SysSet 1); } (e: Exception) => { print ("1: " + string e); }
ravel ""


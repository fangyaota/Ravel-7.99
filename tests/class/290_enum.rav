# enum/flags/singleton
using "enum.rav"
using "singleton.rav"

ravel "290_main0"
using "enum.rav"

myEnum ::= enum {
    A := 1
    B := 2
    C := 3
}

print (myEnum.A.Value)
print (myEnum.A.Name)
print (myEnum.A.Text ())
print ((myEnum.B.Value) + 10)

print (myEnum.A == myEnum.A)
print (myEnum.A == myEnum.B)

(myEnum.Values ()).Foreach (e: object) => { print (e.Name); }

print ((myEnum.Of 3).Name)
try { myEnum.Of 99; } (e: Exception) => { print ("1: " + string e); }

color ::= enum {
    Red := "红"
    Green := "绿"
}
print (color.Red.Value)
print (color.Green.Text ())

base ::= enum {
    A := 1
    B := 2
}
sub ::= enum base {
    X := 7
}
print (sub.A.Value)
print (sub.X.Value)
print (sub.A : sub)
print (sub.A == base.A)
print ((sub ()) : base)
(sub.Values ()).Foreach (e: object) => { print (e.Name); }
print ((sub.Of 2).Name)

try { plain ::= class { x: int = 0; }; bad ::= enum plain { X := 1; }; } (e: Exception) => { print ("2: " + string e); }
print "end"
ravel ""

ravel "291_main1"
using "enum.rav"

perms ::= flags {
    Read := 1
    Write := 2
    Exec := 4
}

print (perms.Read.Value)
print (perms.Read.Name)
print (perms.Read.Text ())
print (perms.Values () |> .Map ((v: object) => { v.Text (); }) |> .ToList ())

p := (perms.Read | perms.Exec)
print (p.Value)
print (p.Text ())
print ((perms.Read | perms.Read).Text ())
print ((perms.Read | perms.Write | perms.Exec).Text ())

print (p.Names ())
print (p.Has (perms.Read))
print (p.Has (perms.Exec))
print (p.Has (perms.Write))
print (p.Has (perms.Read | perms.Exec))

print ((p & perms.Exec).Text ())
print ((p & perms.Write).Text ())
print ((p - perms.Read).Text ())
print ((p ^ perms.Exec).Text ())

print ((perms.Read | 4).Text ())
print ((perms.Of 5).Text ())
print ((perms.Of 2).Text ())
print ((perms.Of 5) == p)

ext ::= flags perms {
    Link := 8
}
print ((ext.Read | ext.Link).Text ())
print ((ext.Values ()).Count ())
print (ext.Read : ext)
print (ext.Read == perms.Read)

print ((try { perms.Read | "x"; } (e: Exception) => { "1: " + (string e); }))

e ::= enum {
    A := 1
    B := 2
}
print ((try { e.A | e.B; } (ex: Exception) => { "2: " + (string ex); }))
print ((try { e.A.Has e.B; } (ex: Exception) => { "3: " + (string ex); }))
ravel ""

using "singleton.rav"

Config ::= singleton {
    init = () => { name = "默认"; this; }
    name: string = ""
}

a := Config ()
b := Config ()
print (a == b)
print (a : Config)
print ((Config ()) == a)

a.name = "改了"
print (b.name)

NoInit ::= singleton {
    n: int = 1
}
print ((NoInit ()) == (NoInit ()))
print ((NoInit ()).n)

Runs := []
Counted ::= singleton {
    init = () => { 0; this; }
    mark := (Runs.Add "跑了一次")
}
Counted ()
Counted ()
Counted ()
print (Runs.Count ())

Base ::= class {
    init = () => { 0; this; }
    tag: string = "基类"
}
Sub ::= singleton Base {
    init = () => { tag = "子类单例"; this; }
}
s1 := Sub ()
s2 := Sub ()
print (s1 == s2)
print s1.tag
print (s1 : Base)

print ((try { eval "Arg ::= singleton {\n    init = (x: int) => { v = x; this; }\n    v: int = 0\n}\nArg ()"; } (e: Exception) => { "1: " + (string e); }))

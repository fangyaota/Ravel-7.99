isPrime := (n: int) => {
    if {
        n < 2
    } {
        false
    } {
        d := 2
        result := true
        while {
            d * d <= n
        } {
            if {
                n % d == 0
            } {
                result = false
            } {
                0
            }
            d += 1
        }
        result
    }
}
print (isPrime 2)
print (isPrime 7)
print (isPrime 10)
print (isPrime 97)
# --- expected ---
# true
# true
# false
# true

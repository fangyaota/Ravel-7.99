# 成员定义 a.field := v —— `:=` 是定义(不存在就新建、存在就整条替换),`=` 是赋值(必须已存在)
C := class {
    init := () => { 0; }
    v: int = 1
}
a := C ()

# 1) 给对象新增字段
a.new := 42
a.other := "hello"
print (a.new)
print (a.other)

# 2) 覆盖已有字段
a.v := 99
print (a.v)

# 3) 新字段的类型约束来自值的类型,之后用 `=` 改值也守约
a.new = 7
print (a.new)

# 4) 新字段和普通字段一样能参与运算
a.count := 10
print (a.count + 1)

# 5) 定义也能用在别的对象上,互不影响
b := C ()
b.new := 1000
print (b.new)
print (a.new)
# --- expected ---
# 42
# hello
# 99
# 7
# 11
# 1000
# 7

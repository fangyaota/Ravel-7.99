# `Tasks` —— 协作式任务:一个 OS 线程,任务只在 `group.Await` 上换人。
#
# 顺序是**钉死的**(协作式的好处:谁来跑由代码决定,不是碰运气),所以这儿只钉顺序,
# 不钉墙钟。`Tasks.After 0` 是"让一轮"—— 句柄当场就算完成,不掺进真实计时。
using "tasks.rav"

# ① 交替:两个任务各挂两次
Tasks.Cycle [
    (Tasks.Task (g: Tasks.TaskGroup) => {
        print "A1"
        g.Await (Tasks.After 0)
        print "A2"
        g.Await (Tasks.After 0)
        print "A3"
    })
    (Tasks.Task (g: Tasks.TaskGroup) => {
        print "B1"
        g.Await (Tasks.After 0)
        print "B2"
        g.Await (Tasks.After 0)
        print "B3"
    })
]

# ② 结果在任务自己身上:IsDone 探一下,Value 是**检查过的读**(没完就报错,不等)
t := Tasks.After 0
print t.IsDone
try { t.Value; print "不该到这儿"; } (e: Exception) => { print ("没完就读:" + e.Message); }
Tasks.Cycle [
    (Tasks.Task (g: Tasks.TaskGroup) => { g.Await t; print t.IsDone; print ("读完:" + (string t.Value)); })
]

# ③ 跑着再加一个(group.Add)
Tasks.Cycle [
    (Tasks.Task (g: Tasks.TaskGroup) => {
        print "主:开帮手"
        h := g.Add (Tasks.Task (gg: Tasks.TaskGroup) => {
            gg.Await (Tasks.After 0)
            print "帮手:完"
        })
        g.Await h
        print "主:帮手回来了"
    })
]

# ④ 自创任务之间互等(它在组里,所以等得到)
b := Tasks.Task (g: Tasks.TaskGroup) => { g.Await (Tasks.After 0); print "b 完"; }
Tasks.Cycle [
    (Tasks.Task (g: Tasks.TaskGroup) => { print "a 等 b"; g.Await b; print "a 到了"; })
    b
]

# ⑤ 库 `while` 的循环体里挂起 —— 这一条是老引擎那个形状,在这儿是过的
Tasks.Cycle [
    (Tasks.Task (g: Tasks.TaskGroup) => {
        i := 0
        while { i < 2; } { i += 1; print ("L" + (string i)); g.Await (Tasks.After 0); }
    })
    (Tasks.Task (g: Tasks.TaskGroup) => {
        i := 0
        while { i < 2; } { i += 1; print ("M" + (string i)); g.Await (Tasks.After 0); }
    })
]

# ⑥ 任务里抛的错:在**等它那一头**现形,不把组带走
bad := Tasks.Task (g: Tasks.TaskGroup) => { throw (Exception "任务里炸了"); }
Tasks.Cycle [
    (Tasks.Task (g: Tasks.TaskGroup) => {
        try { g.Await bad; print "不该到这儿"; } (e: Exception) => { print ("接住:" + e.Message); }
    })
    bad
]

# ⑦ 死锁:两个任务**互相等** —— 当场报,不干等
# (注意 ③ 那个 `group.Add` 交回的任务、以及 `Http.GetTask` 那种,**不用先 Add** ——
#  `Await` 会顺手把它挂进组里跑。真卡住的只有这种"谁也等不来谁"的。)
cycl := []
cycl.Add (Tasks.Task (g: Tasks.TaskGroup) => { g.Await (cycl.At 1); })
cycl.Add (Tasks.Task (g: Tasks.TaskGroup) => { g.Await (cycl.At 0); })
try { Tasks.Cycle cycl; } (e: Exception) => { print e.Message; }

# ⑧ 任务失败了**而没人接** —— 和"没人接的错误"一个口径,也当场报
try { Tasks.Cycle [(Tasks.Task (g: Tasks.TaskGroup) => { throw (Exception "没人理我"); })]; } (e: Exception) => { print e.Message; }

# ⑨ 组能套着跑:每组的就绪队列 / 等待集合 / `Back` 都是**它自己的字段**,互不打扰
Tasks.Cycle [
    (Tasks.Task (g: Tasks.TaskGroup) => {
        print "外:起"
        Tasks.Cycle [
            (Tasks.Task (g2: Tasks.TaskGroup) => { g2.Await (Tasks.After 0); print "  内:完"; })
        ]
        g.Await (Tasks.After 0)
        print "外:完"
    })
]

# ⑩ 一个任务只能跑一遍 —— 它的续延是多发的,再跑一遍会跳回上一次留下的那条帧链
# (实测:**死循环**,第二遍把第一遍整段重放)。加两遍也一样乱,所以两个方向都在 `Add` 上拦住。
once := Tasks.Task (g: Tasks.TaskGroup) => { g.Await (Tasks.After 0); print "只跑一遍"; }
Tasks.Cycle [ once ]
try { Tasks.Cycle [ once ]; } (e: Exception) => { print ("再跑一次:" + e.Message); }
twice := Tasks.Task (g: Tasks.TaskGroup) => { g.Await (Tasks.After 0); }
try { Tasks.Cycle [ twice twice ]; } (e: Exception) => { print ("一间组里加两遍:" + e.Message); }

# ⑪ 任务里出**运行时错误**、没人接 —— 报错要带上**出错位置**
#
# 位置和调用栈是引擎的内部状态,只在 handler 体里活着(`System.FormatError` 那条注释),
# 所以 `TaskGroup.Start` 是**趁那一刻**把整份报告渲染下来挂在任务上的 —— 见 lib/tasks.rav。
# 这里只钉"有没有位置":整份报告里带着库的**绝对路径**(bin/Debug/… 那种),钉不住。
try { Tasks.Cycle [(Tasks.Task (g: Tasks.TaskGroup) => { x := 1 / 0; print x; })]; } (e: Exception) => {
    print ((e.Message).Contains "297_tasks.rav:");
    print ((e.Message).Contains "除数为零");
}

# ⑫ **用户自己 `throw` 的错,不能被上一份报告串了**
#
# `Handed`(引擎刚交出去的那个错)没有可靠的地方可以清:handler 可能用续延跳走(库里的
# `try` 就是),收不到"调用返回"那一刻。于是用户 `throw` 进来时,它上面挂的可能是**上一次**
# 引擎错误的报告 —— 照渲染就会报出别人的位置和栈,自己那句话反而不见(实测过)。
# `System.FormatError` 现在核对"消息逐字相同",对不上就退回那句消息。
# 这两条**必须挨着**:前一节刚留下一个引擎错误,这一节正好验它没被串上。
try { Tasks.Cycle [(Tasks.Task (g: Tasks.TaskGroup) => { throw (Exception "我自己扔的"); })]; } (e: Exception) => {
    print ((e.Message).Contains "我自己扔的");
    print ((e.Message).Contains "除数为零");
}

# ⑬ `Tasks.Signal` —— 一只闸:有人等、有人开、**开过之后还能再等**
#
# 它管的是第三种"会完":`Tasks.Task` 等"那段代码跑完",`Tasks.After` 等"那个计时器走完",
# 这只闸等"别人跟我说一声"。
sig := Tasks.Signal ()
Tasks.Cycle [
    (Tasks.Task (g: Tasks.TaskGroup) => { print ("  甲:等到了 " + (string (g.Await sig))); })
    (Tasks.Task (g: Tasks.TaskGroup) => { g.Await (Tasks.After 0); sig.Open "甲的东西"; })
]
# 开过之后再来的:直接拿到 —— "事件发生在等待之前"不用另想办法
Tasks.Cycle [
    (Tasks.Task (g: Tasks.TaskGroup) => { print ("  丙(开过才来):" + (string (g.Await sig))); })
]
# 三个人等一只没开的闸:开一次,一次全醒
sig2 := Tasks.Signal ()
got := []
Tasks.Cycle [
    (Tasks.Task (g: Tasks.TaskGroup) => { g.Await sig2; got.Add "A"; })
    (Tasks.Task (g: Tasks.TaskGroup) => { g.Await sig2; got.Add "B"; })
    (Tasks.Task (g: Tasks.TaskGroup) => { g.Await sig2; got.Add "C"; })
    (Tasks.Task (g: Tasks.TaskGroup) => { g.Await (Tasks.After 0); sig2.Open 0; })
]
print ("  三个人一次全醒:" + (string got))

# ⑭ `Tasks.All` / `Tasks.Any` / `Tasks.Chan` —— 三件常见活儿
#
# `All`:一起跑,**按交进去的顺序**交回结果表。
Tasks.Cycle [
    (Tasks.Task (g: Tasks.TaskGroup) => {
        a := Tasks.Task (gg: Tasks.TaskGroup) => { gg.Await (Tasks.After 0); "甲"; }
        b := Tasks.Task (gg: Tasks.TaskGroup) => { gg.Await (Tasks.After 0); "乙"; }
        print ("  All:" + (string (g.Await (Tasks.All [a b]))));
    })
]
# `Any`:等最先完成的那个,**交回它本身**(所以 `.Value` 拿结果、也看得出是谁)。
# (这里三个都是 `After 0` —— 立刻完成,谁先到由"谁排在前面"定,钉得住。
#  真要"谁快谁赢"得用几十上百毫秒的间隔,那是计时器的事,见例子。)
Tasks.Cycle [
    (Tasks.Task (g: Tasks.TaskGroup) => {
        a := Tasks.Task (gg: Tasks.TaskGroup) => { gg.Await (Tasks.After 0); "甲"; }
        b := Tasks.Task (gg: Tasks.TaskGroup) => { gg.Await (Tasks.After 0); "乙"; }
        w := g.Await (Tasks.Any [a b])
        print ("  Any 赢家:" + (string w.Value));
    })
]
# `Chan`:能等的队列 —— 空了就睡,来货了叫醒,`Close` 把等着的人全放走。
ch := Tasks.Chan ()
Tasks.Cycle [
    (Tasks.Task (g: Tasks.TaskGroup) => {
        i := 0
        while { i < 3; } { i += 1; g.Await (Tasks.After 0); ch.Put ("货" + (string i)); }
        ch.Close ();
    })
    (Tasks.Task (g: Tasks.TaskGroup) => {
        while { !(ch.IsShut ()); } { print ("  取 " + (string (ch.Take g))); }
        # 关了再取是个错 —— 不是"取到空的"
        try { ch.Take g; } (e: Exception) => { print ("  " + e.Message); }
    })
]

# ⑮ 任务也在 `IMonad` 那一族里 —— 于是能进 `do { … }`
#
# `do { x :< m; … }` 是**解析期**就地长成 `.Bind` 链的(没有运行时支持)。任务这一家
# 原来缺两样:那两条槽(`Map` / `Bind`),和**交回一个裸值的构造子** `Tasks.Return`
# —— 因为 `do` 的**最后一句**必须自己交回一个"包着的值"(别的 monad 就是 `Some (…)`
# / `Ok (…)`,只是你写惯了、不觉得它是个构造子)。
Tasks.Cycle [
    (Tasks.Task (g: Tasks.TaskGroup) => {
        t1 := Tasks.Task (gg: Tasks.TaskGroup) => { gg.Await (Tasks.After 0); 20; }
        t2 := Tasks.Task (gg: Tasks.TaskGroup) => { gg.Await (Tasks.After 0); 22; }
        print ("  do 块:" + (string (g.Await (do { a :< t1; b :< t2; Tasks.Return (a + b); }))));
    })
]
# 三个子类跟着认(那条 `impl` 挂在 `TaskBase` 上),序列那一族本来就认
print ("  任务 is IMonad:" + (string ((Tasks.After 0) is IMonad)))
print ("  闸 is IMonad:  " + (string ((Tasks.Signal ()) is IMonad)))
print ("  序列 is IMonad:" + (string ([1 2] is IMonad)))

# --- expected ---
# A1
# B1
# A2
# B2
# A3
# B3
# false
# 没完就读:这个任务还没完 —— 要等它就用 `group.Await t`,只想探一下就 `t.IsDone`
# true
# 读完:()
# 主:开帮手
# 帮手:完
# 主:帮手回来了
# a 等 b
# b 完
# a 到了
# L1
# M1
# L2
# M2
# 接住:任务里炸了
# 死锁:还有 2 个任务没完,但已经没有谁能推进它们了 —— 多半是在互相等,或者在等一件没人会去做的事
# 有 1 个任务失败了,而没人接它的错 —— 谁起的任务谁负责等它(`group.Await` / `.Value`)

# 没人理我
# 外:起
#   内:完
# 外:完
# 只跑一遍
# 再跑一次:这个任务已经跑完了 —— 一个任务只能跑一遍(要再来一次就再造一个)
# 一间组里加两遍:这个任务已经在组里了 —— 别加第二遍
# true
# true
# true
# false
#   甲:等到了 甲的东西
#   丙(开过才来):甲的东西
#   三个人一次全醒:[A B C]
#   All:[甲 乙]
#   Any 赢家:甲
#   取 货1
#   取 货2
#   取 货3
#   队列已经关了,没货可取
#   do 块:42
#   任务 is IMonad:true
#   闸 is IMonad:  true
#   序列 is IMonad:true

# int 转换的越界与 NaN:报错,不要静默饱和/崩掉
# 从前 `int 9999999999999` 抛 C# 的 OverflowException 一路漏到顶层(程序直接崩),
# `int (float 1e30)` 静默饱和成 2147483647 —— 两个都不说一个字。
using "try.rav"
Ex.try { int 9999999999999; } (e: Exception) => { print ("1: " + string e); }
Ex.try { int (bigint 2147483648); } (e: Exception) => { print ("2: " + string e); }
Ex.try { int (float 100000000000000000000.0); } (e: Exception) => { print ("3: " + string e); }
Ex.try { int (bigfraction 2147483648 1); } (e: Exception) => { print ("4: " + string e); }
# 装得下的照常
print (int 2147483647)
print (int (bigint 0 - 2147483648))
print (int (fraction 7 2))
print (int true)
# bigint → float 是拓宽,显式隐式都该通
print (float (bigint 5))
z: float = bigint 5
print z
x: int = 3.9
print x
y: int = bigint 7
print y
# --- expected ---
# 1: 数值 9999999999999 超出 int 范围（int 是 32 位，大数用 bigint）
# 2: 数值 2147483648 超出 int 范围（int 是 32 位，大数用 bigint）
# 3: 数值 1E+20 超出 int 范围（int 是 32 位，大数用 bigint）
# 4: 数值 2147483648 超出 int 范围（int 是 32 位，大数用 bigint）
# 2147483647
# -2147483648
# 3
# 1
# 5
# 5
# 3
# 7

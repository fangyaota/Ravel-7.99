# `Httpd` 的两条硬性质:**keep-alive 真的复用连接**、**handler 挂起时别的连接能进来**。
#
# 头一条看 `srv.Conns` 和 `srv.Requests`:三个请求走一条连接,就是 1 和 3。
# 后一条看**服务端自己数的并发峰值** —— 和 `tests/298` 一个规矩:**钉整数,不钉墙钟**。
# 墙上那点毫秒在慢机器上会飘,"此刻同时挂着几个"不会。
using "httpd.rav"
using "tasks.rav"
using "http.rav"

live := 0
peak := 0

srv := Httpd.Server 0
srv.Route "GET" "/hi" (req g) => { Httpd.Text "hi"; }

# 一个"慢" handler:它挂起 200 毫秒,把这一刻的并发数记下来。
# **`g.Await` 就是那个挂起点** —— 挂着的时候调度器去伺候别的连接。
srv.Route "GET" "/hold" (req g) => {
    live += 1
    if { live > peak; } { peak = live; } { 0; }
    g.Await (Tasks.After 200)
    live -= 1
    Httpd.Text "ok";
}

base := "http://127.0.0.1:" + (string (srv.Port))

Tasks.Cycle [
    (Tasks.Task (g: Tasks.TaskGroup) => { srv.RunIn g; })
    (Tasks.Task (g: Tasks.TaskGroup) => {
        # ── 一、keep-alive:三个请求一个一个发,客户端那条连接会被复用 ──
        foreach [1 2 3] (i: int) => { g.Await (Http.GetTask (base + "/hi")); }
        print (string (srv.Conns))
        print (string (srv.Requests))

        # ── 二、并发:三个 /hold 同时挂着 ──
        # 每个 handler 都先 `Conns` 一下再挂起 200 毫秒,所以三个会在服务端叠起来。
        # 要是它们排着队跑,peak 会是 1。
        rs := []
        foreach [1 2 3] (i: int) => { rs.Add (Http.GetTask (base + "/hold")); }
        g.Await (Tasks.All rs)
        print (string peak)

        srv.Stop ()
    })
]
# --- expected ---
# 1
# 3
# 3

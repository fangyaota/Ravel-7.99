# 控制台也是文件:`stdout` / `stderr` / `stdin` 三个单例值都实现 `IFile`。
#
# 这一层的好处就在这儿 —— 对着接口写的代码直接能用:`Io.Copy f Io.Stdout` 把文件倒进终端,
# `Io.Copy Io.Stdin f` 把输入倒进文件。只写的那两个读不了、只读的那个写不了(报错说人话)。
#
# 两点说明:① 测试运行器只接管 **stdout**,所以 `Io.Stderr.Write` 那行会出现在终端上
# (比对不到,只证明它不炸);② `Io.Stdin.Read ()` 是读到 EOF —— 测试里不去碰它(会挂住),
# 只查它认不认这个形状。
using "io.rav"

print (Io.Stdout is IFile)
print (Io.Stdout is IEntry)
print (Io.Stderr is IFile)
print (Io.Stdin is IFile)
print (Io.Stdout.Name ())
print (Io.Stderr.Name ())
print (Io.Stdin.Name ())
print (Io.Stdout.IsDir ())
print (Io.Stdout.Exists ())

Io.Stdout.Write "直接写到 stdout\n"
Io.Stdout.Append "追一行(没有换行)"
Io.Stdout.Write "\n"
Io.Stderr.Write "这行去 stderr（比对不到，只在终端上看得见）\n"

# 只写的读不了 / 只读的写不了 / 没有大小 / 删不掉
try { Io.Stdout.Read (); } (e: Exception) => { print ("1: " + string e); }
try { Io.Stderr.Read (); } (e: Exception) => { print ("2: " + string e); }
try { Io.Stdin.Write "x"; } (e: Exception) => { print ("3: " + string e); }
try { Io.Stdout.Size (); } (e: Exception) => { print ("4: " + string e); }
try { Io.Stdout.Delete (); } (e: Exception) => { print ("5: " + string e); }

# 实现者名单里有它们(磁盘那个 File 也在 —— 同一族的三个实现)
print (IFile.GetImplementors ())

# 对着接口写的代码:文件 → 终端
d := Io.Dir ".io-test-con"
d.Create ()
f := d.Child "a.txt"
f.Write "从文件来的一行\n"
Io.Copy f Io.Stdout
f.Append "又一行\n"
Io.Copy f Io.Stdout
print (Io.Lines f)

f.Delete ()
d.Delete ()
print (d.Exists ())
print "end"
# --- expected ---
# true
# true
# true
# true
# stdout
# stderr
# stdin
# false
# true
# 直接写到 stdout
# 追一行(没有换行)
# 1: 这是只写的（stdout），读不了
# 2: 这是只写的（stderr），读不了
# 3: 这是只读的（stdin），写不了
# 4: 控制台没有大小：stdout
# 5: 控制台删不掉：stdout
# [ConsoleIn ConsoleOut File]
# 从文件来的一行
# 从文件来的一行
# 又一行
# [从文件来的一行 又一行]
# false
# end

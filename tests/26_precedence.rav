# 运算符优先级(合并 26-34)
print (1 + 2 * 3)
print (1 * 2 + 3)
print (1 + 2 < 5)
print (1 < 3 && 2 > 0)
print (1 < 3 || 2 > 0 && false)
print (!false && false)
print (-1 + 3)
X := 3
X = X + 1
print X
f := (x: int) => { x; }
print (f 1 + 2)
# --- expected ---
# 7
# 5
# true
# true
# true
# false
# 2
# 4
# 3

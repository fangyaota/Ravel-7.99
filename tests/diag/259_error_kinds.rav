# 引擎报的错**按类分**:`Exception` 底下挂着一族错误类,报错那一刻由引擎挑
# (见 Runtime/BuiltinClasses.Errors.cs 那张表)。于是 `try` 的 handler 能**按类型接** ——
# 挑不上就试下一个(和 `|` 造自定义函数是同一套机制)。
#
#   Exception
#   ├── TypeError / NameError / AttributeError / IndexError / KeyError
#   ├── ZeroDivisionError / AssertionError / ArgumentError
#   └── ValueError / IoError / RegexError
using "regex.rav"

# 先看"引擎这一趟报的是哪一类":跑一下、把 typeof 打出来
probe := (f: function) => {
    try { f (); "没报错"; } (e: Exception) => { (typeof e).name + " / " + e.Message; }
}

print (probe () => { 1 + "a"; })                    # 运算符不吃这个操作数
print (probe () => { nope; })                       # 未定义的变量
print (probe () => { (5).没有这个方法 (); })          # 类型上没有这个方法
print (probe () => { [1 2].At 9; })                 # 下标越界
print (probe () => { {"a": 1}.Get "b"; })           # 键不存在
print (probe () => { 1 / 0; })                       # 除零
print (probe () => { assert false "断言没通过"; })    # assert
print (probe () => { ((x: int) => { x; }).Prepend 5; })   # 参数形状不对
print (probe () => { int "abc"; })                   # 值本身不对
print (probe () => { System.ReadText "没有这个/文件.txt"; })   # 文件那批
print (probe () => { (Regex.C "(").IsMatch "x"; })    # 正则写错

# ── 这一趟补上的那些(读写被挡、值/参数、分数除零、字符串下标、Json 的键)──
print (probe () => { readonly r := 1; r = 2; })       # 只读
print (probe () => { char "ab"; })                    # 值不对
print (probe () => { "a,b".Split ""; })               # 分隔符不能是空串
print (probe () => { (object ()).Key (); })           # 对象不是值类型,没有默认的键
print (probe () => { fraction 1 0; })                 # 分母为零
print (probe () => { "abc".At 9; })                   # 字符串下标越界
print (probe () => { (Json.FromString "{}").Get "k"; })   # Json 里没有这个键

# ── 按类型接:挑不上就试下一个 ──
handle := ((e: TypeError) => { "类型错: " + e.Message; }) | ((e: Exception) => { "别的: " + e.Message; })
print (try { 1 + "a"; } handle)
print (try { nope; } handle)

# ── 库那一半也照着这一族对齐(不然同一个"取不到"两处两个类)──
print (probe () => { [].First (); })
print (probe () => { (None.Value ()); })

# ── 那一族都还是 Exception:老的写法一个都没坏 ──
print (probe () => { 1 + "a"; })                    # 上面已经证明接了
print ((try { 1 / 0; } (e: Exception) => { e is Exception; }))
print ((try { 1 / 0; } (e: ZeroDivisionError) => { e is Exception; }))
# ── 它们就是普通类:能继承、自己能 throw ──
MyErr ::= class TypeError { 0; }        # `{ }` 是空字典,类体得写点什么
print (try { throw (MyErr "自己造的"); } (e: TypeError) => { "接住了: " + e.Message; })
print (probe () => { throw (TypeError "手工抛的"); })     # 手工抛的也是那一族
# --- expected ---
# TypeError / 运算符 '+' 不支持 String 操作数
# NameError / 未定义的变量 'nope'
# AttributeError / 类型 'Integer' 没有方法 '没有这个方法'
# IndexError / list.At 的索引 9 越界 (列表长度 2)
# KeyError / 键不存在: b
# ZeroDivisionError / 运算符 '/' 的除数为零
# AssertionError / 断言没通过
# ArgumentError / prepend 需要代码块参数
# ValueError / 无法将字符串 'abc' 转换为 int（超出 int 范围或不是数字）
# IoError / 读文件: 找不到文件 —— 没有这个/文件.txt
# RegexError / 正则式写错了 —— Invalid pattern '(' at offset 1. Not enough )'s.
# AccessError / 无法给只读变量 'r' 赋值
# ValueError / char: 字符串得正好一个字符，得到 2 个
# ValueError / s.Split: 分隔符不能是空串（想逐个字符就用 s.Chars ()）
# TypeError / Key: Object 没有默认的键（只有值类型有：数、字符串）。要拿它当键，就在类里写一条 Key，交回一个值类型的键
# ZeroDivisionError / 分数的分母不能为零
# IndexError / s.At: 索引 9 超出范围（长度 3）
# KeyError / Json.Get: 没有这个键 'k'（对象里有 0 个键）
# 类型错: 运算符 '+' 不支持 String 操作数
# 别的: 未定义的变量 'nope'
# IndexError / First: 元素不够（一共 0 个）
# ValueError / Option.Value: 这个 Option 里没有值（用 IsSome 先问，或改用 ValueOr）
# TypeError / 运算符 '+' 不支持 String 操作数
# true
# true
# 接住了: 自己造的
# TypeError / 手工抛的

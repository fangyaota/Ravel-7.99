# 成员复合赋值 a.b += v —— 和变量一样支持 += -= *= /= %=
C := class {
    init := () => { 0; }
    n: int = 10
    s: string = "a"
}
a := C ()
a.n += 5
print (a.n)
a.n -= 3
print (a.n)
a.n *= 2
print (a.n)
a.s += "bc"
print (a.s)

# 用 := 新建的字段也能复合赋值
a.fresh := 100
a.fresh /= 4
print (a.fresh)

# 左操作数只求一次(即使它带副作用)
count := 0
shared := C ()
get := () => { count += 1; shared; }
(get ()).n += 1
print count
print (shared.n)

# 类运算符也走这条路:算那步要走 ClassOp 帧,回来再写回
V := class {
    init := () => { 0; }
    v: int = 7
    + := (x: int) => { v + x; }
}
Holder := class { init := () => { 0; }; slot: object = 0; }
h := Holder ()
h.slot = V ()
h.slot += 10
print (h.slot)

# by 属性:左值过 getter、结果过 setter(两个子求值各占一个阶段)
P := class {
    init := () => { 0; }
    _n: int = 10
    by n := property (() => { _n; }) ((v: int) => { _n = v; })
}
p := P ()
p.n += 5
print (p.n)
p.n *= 2
print (p.n)
print (p.n += 9)
# 变量形式的复合赋值走 CallAssign 帧(和对象字段那条路不同):算完写回变量。
# 之前这条路径零覆盖。
V := class {
    init := () => { 0; }
    v: int = 0
    + := (o: V) => {
        r := V ()
        r.v = v + o.v
        r
    }
}
x := V ()
x.v = 7
y := V ()
y.v = 10
x += y
print (x.v)
# --- expected ---
# 15
# 12
# 24
# abc
# 25
# 1
# 11
# 17
# 15
# 30
# 39
# 17

# 类型注解是个**表达式**,在定义处(变量)/ 创建处(参数)求值一次 —— 算出来是个类就行。
#
# 写法:
#   `x: int = v`            一个名字(可带 `.` 成员访问)
#   `x: (任意表达式) = v`    括号里什么都能写(if/调用/lambda…)
# 括号是**必需的**,不是可选:不带括号的 `f ()` 会和"下一个参数"撞上 ——
# `(x: int y: int)` 里的 `int y` 会被当成一次调用。
using "try.rav"

# 算出来的类型:同一个字段,注解不同就装不同的类型
pick := (flag: bool) => { if { flag; } { int; } { float; } }
a: (pick true) = 5
b: (pick false) = 5
print (typeof a)
print (typeof b)

# 注解里调用函数、用成员访问
mk := () => { string; }
s: (mk ()) = "hi"
print (typeof s)
print s

# 参数注解同理(在 lambda 创建时求值一次)
f := (x: (pick true)) => { x; }
print (typeof (f 3))
print (typeof ((x: (pick false)) => { x; } 3.0))

# 最干净的写法照旧
n: int = 7
print (typeof n)

# 注解不是类型 → 报错(锚在被定义的字段上)
Ex.Try { z: (1 + 1) = 0; } (e: Exception) => { print ("1: " + string e); }
# 注解里的名字不存在 → 在**求值**那一步就报
Ex.Try { w: (nope ()) = 0; } (e: Exception) => { print ("2: " + string e); }
# 括号不能省:`a: pick true = 5` 会把它当成字段名,报语法错
Ex.Try { eval "q: pick true = 5"; } (e: Exception) => { print ("3: " + string e); }
print "done"
# --- expected ---
# Integer
# Float
# String
# hi
# Integer
# Float
# Integer
# 1: 'z' 的类型注解要是个类型，得到 Integer
# 2: 未定义的变量 'nope'
# 3: 类型注解后需要 '='
# done

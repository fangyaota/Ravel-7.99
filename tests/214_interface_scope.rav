# 接口实现是**作用域里的东西**:`use` 登记在当前作用域,`Dispose` 摘掉,出了作用域自然就没了。
# 同一个作用域里可以叠几个实现:`x.b` 由内到外、后 use 的先试,第一个身上有这个名的胜出。
# 接口里 `= default` 的槽,实现没填就是"什么都不做"的那个默认属性(读给 `()`),
# 别人提供的那个才不是 `()`。
using "try.rav"

T ::= interface {
    by a : int = default
    by z : int = default
}

C ::= class {
    n : int = 0
}

one := T C { by a = property (() => { 1; }) ((v: int) => { (); }) }
two := T C {
    by a = property (() => { 2; }) ((v: int) => { (); })
    by z = property (() => { 20; }) ((v: int) => { (); })
}

use one
use two
c := C ()
print c.a
print c.z
print (c is T)

# 摘掉后一个:回到前一个;z 那条落回 one 摆的默认槽(什么都不做)
two.Dispose ()
print c.a
print c.z
two.Dispose ()
print c.a
one.Dispose ()
Ex.Try { print c.a; } (e: Exception) => { print ("1: " + string e); }
use one
print c.a
one.Dispose ()

# use 写在函数体里:只在那一次调用里生效(它登记在那个调用自己的作用域上)
scoped := () => {
    use two
    inner := C ()
    print inner.a
    print inner.z
}
scoped ()
Ex.Try { q := C (); print q.a; } (e: Exception) => { print ("2: " + string e); }

# 目标是类的**子类**时也认(和 `is` 一个口径:实例的类收得下目标)
Sub ::= class C {
    tag : int = 0
}

use one
s := Sub ()
print s.a
print (s is T)

# 实现的副本:`Dispose` 读出来时才绑接收者,所以绑的是**副本自己**,不误伤原件
copy := one.Copy ()
use copy
print c.a
copy.Dispose ()
print c.a

# 不是实现的东西
Ex.Try { use 5; } (e: Exception) => { print ("3: " + string e); }
# `interface 某个类型 { … }` 是"接口继承"的意思 —— 还没这东西,当场报出来
Ex.Try { eval "interface int {\n    by q : int = default\n}"; } (e: Exception) => { print ("4: " + string e); }
# --- expected ---
# 2
# 20
# true
# 1
# ()
# 1
# 1: 类型 'C' 没有方法 'a'
# 1
# 2
# 20
# 2: 类型 'C' 没有方法 'a'
# 1
# true
# 1
# 1
# 3: use 要的是「接口 类 实现」造出来的实现，得到 Integer
# 4: `interface` 后面要跟一个代码块（`interface { … }` 才是造接口）；实现写成 `myTrait myClass { … }`，第一个得是接口（用 `interface { … }` 造出来的那个）

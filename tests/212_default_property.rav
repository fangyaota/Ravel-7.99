# `by a: int = default` —— `default` 是**属性的默认值**:一对什么都不做的函数
#
#     Get = () => { (); }
#     Set = (_ : object) => { (); }
#
# 和 `int default` 给 0、`function default` 给空函数是同一个道理。
# 于是"先声明、之后再装实现"这套写法通了(trait 要的正是这个形状):默认那份能读能写,
# 只是都不做事 —— 读出来是 (), 写进去丢掉。之后用 `by a = property g s` 换掉它。

Trait ::= class {
    init = () => { 0; this; }
    by a: int = default
    by b: function = default
}
t := Trait ()

# 装实现之前:读 ()、写丢掉、不报错
print (t.a)
print (t.a = 1)
print (t.a)
print (t.b)
t.b = (x: int) => { x; }
print (t.b)
print (t.Fields ())

# 装实现:换掉槽里的那份 property
Install := (o: object) => {
    by o.a = property (() => { 100; }) ((v: int) => { print ("装了 setter: " + string v); })
    by o.b = property (() => { (x: int) => { x * 2; }; }) ((v: function) => { 0; })
}
Install t
print (t.a)
t.a = 5
print (t.b 21)

# 在**别的对象**身上建一个默认属性(`:=` 定义那条)
Empty ::= class { init = () => { 0; this; }; }
e := Empty ()
by e.nick := default
print (e.nick)
by e.nick = property (() => { "someone"; }) ((v: string) => { 0; })
print (e.nick)

# 默认属性没有状态 —— 复制出来的副本和原件共享同一个,谁都不会被写坏
print ((with t { 0; }).a)
print (t.a)
# --- expected ---
# ()
# 1
# ()
# ()
# ()
# [init a b is isnot <: :> ToString Copy Fields CompareTo Key]
# 100
# 装了 setter: 5
# 42
# ()
# someone
# 100
# 100

# 文件系统：磁盘实现（lib/io.rav）。真写磁盘 —— 写在仓库里的 .io-test/ 下，结尾删干净。

# 两条自律：**路径手写 `/`**（平台无关；`Io.Join` / `Child` 拼出来的在 Windows 上是 `\`，
# 所以只对它们做行为断言、不打印）；**只打稳定量**（名字、内容、大小、Exists、报错消息），
# 不打时间戳（那是会变的）。
using "io.rav"
using "terminal.rav"    # 控制台那三个单例住这儿

root := Io.Dir ".io-test"
root.Create ()
print (root.Exists ())

f := root.Child "a.txt"
f.Write "hi\nho\n"
print (f.Read ())
print (f.Lines ())
print (f.Size ())
print (f.Name ())
f.Append "tail"
print (f.Read ())
print (f.Lines ())

# 子目录里放一个文件 —— 待会儿"删非空目录"那条要靠它
sub := root.Mkdir "sub"
(sub.Child "deep.txt").Write "x"

print ((root.List ()).Keys ())
print ((root.Files ()).Keys ())
print ((root.Dirs ()).Keys ())

# 接口：实现了 IFile 也就算 IEntry（接口继承兜着，登记时只写了 IFile 那一条）
print (f is IFile)
print (f is IEntry)
print (sub is IDir)
print (sub is IEntry)
print (f is IDir)

# 复制 / 移动 / 改名
g := f.CopyTo ".io-test/copy.txt"
print (g.Read ())
h := g.MoveTo ".io-test/moved.txt"
print (h.Read ())
h.Rename "final.txt"
print ((root.Files ()).Keys ())
print ((root.Dirs ()).Keys ())

# 路径函数
print (Io.BaseName "a/b/c.txt")
print (Io.Ext "a/b/c.txt")
print (Io.BaseName (Io.DirName "a/b/c.txt"))
print (Io.BaseName (Io.Join "a" "b.txt"))     # Join 出来的分隔符随平台,所以只打最后一段

# 报错：消息里带的是用户写的那串路径
try { (Io.File ".io-test/nope.txt").Read (); } (e: Exception) => { print ("1: " + string e); }
try { (Io.File ".io-test/sub").Read (); } (e: Exception) => { print ("2: " + string e); }
try { (Io.File ".io-test/nodir/x.txt").Write "hi"; } (e: Exception) => { print ("3: " + string e); }
try { (Io.File ".io-test/gone.txt").Delete (); } (e: Exception) => { print ("4: " + string e); }
try { (Io.Dir ".io-test/sub").Delete (); } (e: Exception) => { print ("5: " + string e); }
try { Io.ChDir ".io-test/nodir"; } (e: Exception) => { print ("6: " + string e); }

# 换目录：存 → 换到上一层 → 断言 → 换回来（它改的是**进程**状态，必须还原）
save := Io.Current ()
ok := false
try { Io.ChDir (Io.DirName save); ok = (Io.Current ()) != save; } (e: Exception) => { print ("7: " + string e); }
Io.ChDir save
print (ok)
print ((Io.Current ()) == save)

# 收摊：先删文件、再删子目录、最后删根
foreach ((root.Files ()).Keys ()) (n: string) => { (root.Child n).Delete (); }
(sub.Child "deep.txt").Delete ()
sub.Delete ()
root.Delete ()
print (root.Exists ())

# ═══ 61_filesystem(并入) ═══
ravel "61_filesystem"
# ===== 文件系统 =====

Node := class {
    init = () => {
        this.name = ""
        this.size = 0
        this;
    }
    name: string = ""
    size: int = 0
    getName := () => { name; }
    getSize := () => { size; }
    find := (target: string) => { File (); }
}

File := class Node {
    init = () => {
        content = ""
        this;
    }
    content: string = ""
    read := () => { content; }
    write := (text: string) => {
        content = text
        size = text.Length ()
    }
    append := (text: string) => {
        content = content + text
        size = content.Length ()
    }
}

Folder := class Node {
    init = () => {
        children = []
        this;
    }
    children: list = []

    add := (child: object) => { children.Add child; }

    find = (target: string) => {
        callcc (found: function) => {
            i := 0
            while { i < children.Count (); } {
                ch := children.At i
                if { (ch.getName ()) == target; } { found ch; } { 0; }
                i += 1
            }
            i = 0
            while { i < children.Count (); } {
                ch := children.At i
                result := ch.find target
                if { (result.getName ()) != ""; } { found result; } { 0; }
                i += 1
            }
            found (File ())
        }
    }

    list := () => {
        i := 0
        while { i < children.Count (); } {
            ch := children.At i
            print (ch.getName ())
            i += 1
        }
    }
}

root := Folder ()
root.name = "/"
home := Folder ()
home.name = "home"
root.add home
readme := File ()
readme.name = "readme.txt"
readme.write "hello world"
home.add readme
etc := Folder ()
etc.name = "etc"
root.add etc
config := File ()
config.name = "config.txt"
config.write "dark mode"
etc.add config

print "=== find ==="
r := home.find "readme.txt"
print (r.getName ())
print (r.read ())

print "=== list root ==="
root.list ()

print "=== write ==="
c := etc.find "config.txt"
c.write "updated"
print (c.read ())

print "=== not found ==="
nf := root.find "nope"
print (nf.getName ())
ravel ""

# ═══ 230_io_abstract(并入) ═══
ravel "230_io_abstract"
# 抽象那一层：`IEntry` / `IFile` / `IDir` —— "文件"先是个**形状**，磁盘只是其中一个实现。
#
# 这个用例在测试里**现写一个内存文件系统**（十几行，就用 tests/61 那种"content 字段"的做法），
# 登记两条 `impl` 之后：`is` / 注解认得它，而 `Io.Copy` / `Io.EachDir` 这些**对着接口写的**
# 代码两边都吃 —— 这就是"以后要加各种抽象文件"要的那个缝。
using "io.rav"

MemFile ::= class {
    Label: string = ""
    Text: string = ""

    init = (label: string text: string) => { Label = label; Text = text; this; }

    Name := () => { Label; }
    Exists := () => { true; }
    IsDir := () => { false; }
    Read := () => { Text; }
    Write := (t: string) => { Text = t; (); }
    Append := (t: string) => { Text = Text + t; (); }
    Size := () => { Text.Length (); }
    Delete := () => { Text = ""; (); }
}

MemDir ::= class {
    Label: string = ""
    Kids: dict = {}

    init = (label: string) => { Label = label; this; }

    Name := () => { Label; }
    Exists := () => { true; }
    IsDir := () => { true; }
    Delete := () => { Kids = {}; (); }
    Add := (e: object) => { Kids.Set (e.Name ()) e; this; }

    # 接口没规定顺序，但两个实现都按名字排 —— `Io.EachDir` 的输出才稳定
    # (`Sort ()` 交回一份**新的**,不是排自己 —— 写成光秃秃一句 `names.Sort ()` 就是空操作)
    List := () => {
        names := (Kids.Keys ()).Sort ()
        out := {}
        foreach names (n: string) => { out.Set n (Kids.Get n); }
        out
    }
}

# 登记（用 impl：类型层面的事实）。只登记最具体的两条 —— `IEntry` 由接口继承兜着。
impl (IFile MemFile {
    ()
})
impl (IDir MemDir {
    ()
})

m := MemFile "mem.txt" "内存里的内容"
top := MemDir "memdir"
sub := MemDir "sub"
sub.Add (MemFile "deep.txt" "深")
top.Add m
top.Add sub

# 形状认得出来（实现了 IFile 也就算 IEntry）
print (m is IFile)
print (m is IEntry)
print (top is IDir)
print (top is IEntry)
print (m is IDir)

# 对着接口写的函数：注解 (f: IFile) 收得下内存实现
describe := (f: IFile) => { (f.Name ()) + " = " + (f.Read ()); }
print (describe m)

# 同一段代码两边跑：内存 → 磁盘，磁盘 → 内存
root := Io.Dir ".io-test-abs"
root.Create ()
disk := root.Child "from-mem.txt"
Io.Copy m disk
print (disk.Read ())
back := MemFile "back.txt" ""
Io.Copy disk back
print (back.Read ())
foreach (Io.Lines back) (l: string) => { print l; }

# `Io.EachDir` 在内存目录上照样递归（路径那一段用 BaseName 打，免得带平台分隔符）
print (m.Size ())
Io.EachDir top (p: string e: IEntry) => { print ((string (e.IsDir ())) + " " + (e.Name ()) + " @ " + (Io.BaseName p)); }

# 要和 IoMonad 搭台:`Io` 那几条是**直接做**的,下面这几条只是包成"说明书"
act := Io.ReadAction m                                   # 到这儿什么都还没读
print ((act.Map ((t: string) => { t.Length (); })).Perform ())
job := Io.WriteAction disk ("从 Action 写进来\n")
print ((job.Then (Io.ReadAction disk)).Perform ())       # 先写后读,交回后一份的结果
print ((Io.EachLineAction m ((l: string) => { print ("行 " + l); })).Perform ())
print ((Io.AppendAction disk ("又一行\n")).Then (Io.ReadAction disk) |> .Perform ())

disk.Delete ()
root.Delete ()
print (root.Exists ())
ravel ""

# ═══ 232_io_console(并入) ═══
ravel "232_io_console"
# 控制台也是文件:`stdout` / `stderr` / `stdin` 三个单例值都实现 `IFile`。
#
# 这一层的好处就在这儿 —— 对着接口写的代码直接能用:`Io.Copy f Terminal.Stdout` 把文件倒进终端,
# `Io.Copy Terminal.Stdin f` 把输入倒进文件。只写的那两个读不了、只读的那个写不了(报错说人话)。
#
# 两点说明:① 测试运行器只接管 **stdout**,所以 `Terminal.Stderr.Write` 那行会出现在终端上
# (比对不到,只证明它不炸);② `Terminal.Stdin.Read ()` 是读到 EOF —— 测试里不去碰它(会挂住),
# 只查它认不认这个形状。
using "io.rav"

print (Terminal.Stdout is IFile)
print (Terminal.Stdout is IEntry)
print (Terminal.Stderr is IFile)
print (Terminal.Stdin is IFile)
print (Terminal.Stdout.Name ())
print (Terminal.Stderr.Name ())
print (Terminal.Stdin.Name ())
print (Terminal.Stdout.IsDir ())
print (Terminal.Stdout.Exists ())

Terminal.Stdout.Write "直接写到 stdout\n"
Terminal.Stdout.Append "追一行(没有换行)"
Terminal.Stdout.Write "\n"
Terminal.Stderr.Write "这行去 stderr（比对不到，只在终端上看得见）\n"

# 只写的读不了 / 只读的写不了 / 没有大小 / 删不掉
try { Terminal.Stdout.Read (); } (e: Exception) => { print ("1: " + string e); }
try { Terminal.Stderr.Read (); } (e: Exception) => { print ("2: " + string e); }
try { Terminal.Stdin.Write "x"; } (e: Exception) => { print ("3: " + string e); }
try { Terminal.Stdout.Size (); } (e: Exception) => { print ("4: " + string e); }
try { Terminal.Stdout.Delete (); } (e: Exception) => { print ("5: " + string e); }

# 实现者名单里有它们(磁盘那个 File 也在 —— 同一族的三个实现)

# 对着接口写的代码:文件 → 终端
d := Io.Dir ".io-test-con"
d.Create ()
f := d.Child "a.txt"
f.Write "从文件来的一行\n"
Io.Copy f Terminal.Stdout
f.Append "又一行\n"
Io.Copy f Terminal.Stdout
# `Io.Lines` 是**生成器**:边要边给 —— 配 `match` 挑行、配 `Expected` 兜"读不到"
IsBlank := (s: string) => { (s.Trim ()).IsEmpty (); }
foreach (Io.Lines f) (l: string) => {
    print (match l [[IsBlank {"空行";}]] {"有字";});
}

# 读不到的文件:`Expect` 把那次调用兜住,不往外抛
missing := (Expect 1 (() => { (Io.File ".io-test/没有这个.txt").Read (); })) ()
print (missing.IsErr ())
print ((missing.Message ()).Contains "没有这个")

f.Delete ()
d.Delete ()
print (d.Exists ())
print "end"
ravel ""

# ═══ 240_cmd(并入) ═══
ravel "240_cmd"
# `cmd` —— 跑一条外部命令,**走系统 shell**(Windows 上是 `cmd.exe /c`,别处 `/bin/sh -c`),
# 管道 / 重定向 / 通配符都归它管。交回一张 dict:`out`(标准输出)/ `err`(标准错误)/ `code`(退出码)。
#
# **非零退出码不是错误** —— 程序失败是常事,原样放在 `code` 里,自己判断;真正起不来进程才报错。
# (输出按"先试 UTF-8、不合法退回控制台编码"解 —— git/python 吐 UTF-8,`dir` 那类走控制台那套。)

r := cmd "echo 你好"
print (r.Get "code")
print ((r.Get "out").Trim ())               # 尾部换行自己 Trim 掉

print ((cmd "exit 3").Get "code")           # 非零照旧交回来,不抛
print (((cmd "echo oops 1>&2").Get "err").Trim ())

# 命令本身是算出来的:拼接、插值都行
n := 2
print (((cmd ("echo " + string (n * 2))).Get "out").Trim ())
print (((cmd "echo ${n * 3}").Get "out").Trim ())

# 交回来就是普通 dict
print ((cmd "echo x").Keys ())
print (typeof (cmd "echo x"))
print "end"
ravel ""

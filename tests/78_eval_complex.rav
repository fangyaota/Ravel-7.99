eval "xs := [1 2 3]"
eval "xs.Add 4"
eval "print xs"
eval "
    C := class {
        init = () => { this.n = 7; this; }
        n: int = 0
        get := () => { n; }
    }
"
c := C ()
print (c.get ())

# ═══ 79_eval_error(并入:原本是 expect-error 的用例,改成 try+eval 钉住文本) ═══
try { eval "eval \"print (1 + true)\""; } (e: Exception) => { print ("79_eval_error: " + string e); }

# ═══ 184_eval_syntax_error(并入) ═══
ravel "184_eval_syntax_error"
# eval 里的语法错误要能被 try 接住
# 从前来的是 SyntaxException,而 Ravel 的 handler 只认 RuntimeException ——
# eval 一段用户输入就能把程序打死。现在 StepOnce 把它转成 RuntimeException 再分发。
try { eval "1 +"; } (e: Exception) => { print ("A[" + (string (e)) + "]"); }
try { eval "print )"; } (e: Exception) => { print ("B[" + (string (e)) + "]"); }
print "after"
# 报错里不该出现 Token.ToString() 那种调试格式(EndOfFile() at 1:4)
ravel ""
# --- expected ---
# [1 2 3 4]
# 7
# 79_eval_error: 运算符 '+' 不支持 Bool 操作数
# A[需要表达式，但得到表达式结束]
# B[需要表达式，但得到')']
# after


using "native.rav"
ravel "Sqlite"

readonly Db ::= class {
    Handle: int = 0
    Source: string = ""

    init = (handle: int source: string) => { Handle = handle; Source = source; this; }

    Where := () => { Source; }

    Exec := (sql: string args: dict) => { Native.SqliteExec Handle sql args; }

    All := (sql: string args: dict) => { Rows (Native.SqliteQuery Handle sql args); }

    One := (sql: string args: dict) => {
        rows := All sql args
        (rows.IsEmpty ()) { (); } { rows.At 0; }
    }

    Value := (sql: string args: dict) => {
        rows := All sql args
        (rows.IsEmpty ()) { (); } { ((rows.At 0).Values ()).At 0; }
    }

    Each := (sql: string args: dict f: function) => {
        (All sql args).Foreach (row: dict) => { f row; }
        ();
    }

    LastId := () => { Native.SqliteLastId Handle; }

    Tx := (body: function) => {
        Exec "begin" {->}
        try {
            body ()
            Exec "commit" {->}
            ();
        } (e: Exception) => {
            Exec "rollback" {->}
            throw e;
        }
    }

    Close := () => { Native.SqliteClose Handle; (); }
}

readonly private Rows := (raw: dict) => {
    cols := raw.Get "columns"
    out := []
    (raw.Get "rows").Foreach (r: list) => {
        d := {->}
        i := 0
        while { i < (cols.Count ()); } {
            d.Set (cols.At i) (r.At i)
            i += 1
        }
        out.Add d
    }
    out
}

readonly Open := (path: object) => {
    p := PathOf path
    Db (Native.SqliteOpen p) p;
}

readonly Memory := () => { Open ":memory:"; }

readonly PathOf := (p: object) => { ((typeof p) == string) { p; } { p.Path; } }

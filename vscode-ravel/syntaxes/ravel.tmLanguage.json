{
    "name": "Ravel",
    "scopeName": "source.ravel",
    "patterns": [
        { "include": "#strings" },
        { "include": "#comments" },
        { "include": "#numbers" },
        { "include": "#modifiers" },
        { "include": "#constants" },
        { "include": "#operators" },
        { "include": "#support" }
    ],
    "repository": {
        "strings": {
            "patterns": [
                {
                    "begin": "\"",
                    "end": "\"",
                    "name": "string.quoted.double.ravel",
                    "patterns": [
                        { "match": "\\\\.", "name": "constant.character.escape.ravel" },
                        {
                            "comment": "`${表达式}` 里是**代码**(Ravel 只有这一种插值写法)—— 递归回整套语法,里面能再写字符串、再写插值。",
                            "begin": "\\$\\{",
                            "end": "\\}",
                            "name": "meta.embedded.expression.ravel",
                            "patterns": [ { "include": "$self" } ]
                        }
                    ]
                }
            ]
        },
        "comments": {
            "patterns": [
                { "match": "#.*$", "name": "comment.line.number-sign.ravel" }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "comment": "数字 + 可选的类型后缀(`2n` 大整数 / `3i` 普通整数 / `2.5f` 浮点)。后缀后面不能再跟标识符字符 —— 和词法器那条规矩一致(`0if` 不是后缀)",
                    "match": "\\b\\d+(\\.\\d+)?([nif](?![A-Za-z0-9_]))?\\b",
                    "captures": {
                        "2": { "name": "storage.type.ravel" }
                    }
                }
            ]
        },
        "modifiers": {
            "patterns": [
                {
                    "match": "\\b(readonly|public|private|protected|outdated|unreadable|by|core|thistype|block)\\b",
                    "name": "storage.modifier.ravel"
                }
            ]
        },
        "constants": {
            "patterns": [
                { "match": "\\b(true|false|default|NaN|Inf)\\b", "name": "constant.language.ravel" }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "comment": "多字符优先(`??=` 在 `??` 前、`..` 在 `.` 前 —— 和词法器里那张表的顺序一致)",
                    "match": "::=|::|:=|=>|:<|:>|<:|<<<|>>>|<<|>>|<\\||==|!=|<=|>=|&&|\\|\\||\\+=|-=|\\*=|/=|%=|\\?\\?=|\\?\\?|\\?\\.|\\.\\.",
                    "name": "keyword.operator.ravel"
                },
                { "match": "[-+*/%&|^!<>=@\\$]", "name": "keyword.operator.ravel" },
                { "match": "[:.,]", "name": "punctuation.separator.ravel" }
            ]
        },
        "support": {
            "patterns": [
                {
                    "comment": "类型:小写别名(`predefined.rav` 那一批)+ `System.` 侧的权威名 + 引擎报错那一族",
                    "match": "\\b(any|bool|bigfraction|bigint|char|class|dict|float|fraction|function|int|interface|list|object|set|string|type|void|Any|BaseInterface|BigFraction|BigInteger|Bool|Char|Continuation|Dict|Every|Exception|Float|Fraction|Function|Integer|Interface|Json|List|Object|Range|Set|String|Type|ValueType|Void|TypeError|NameError|AttributeError|IndexError|KeyError|ZeroDivisionError|AssertionError|AccessError|ArgumentError|ValueError|IoError|RegexError)\\b",
                    "name": "support.type.ravel"
                },
                {
                    "comment": "语言级函数/别名(都是 `predefined.rav` 里那些全局名)",
                    "match": "\\b(print|while|if|foreach|do|Cached|Some|None|callcc|typeof|assert|eval|with|ravel|using|use|impl|try|throw|exit|input|unsafe|currentScope|property|dataclass)\\b",
                    "name": "support.function.ravel"
                },
                {
                    "comment": "标准库模块(`using \"xxx.rav\"` 之后是个全局名)",
                    "match": "\\b(Math|Random|Regex|Time|Seqs|Keys|Sorting|Test|Types|Io|IoMonad|Ex|Expected|Match|Generator|DataClass)\\b",
                    "name": "support.class.ravel"
                },
                {
                    "match": "\\b(this|instance|self)\\b",
                    "name": "variable.language.ravel"
                },
                {
                    "comment": "点号后面的大驼峰 = 方法调用(`xs.Map f` / `d.Keys ()` / `Math.Sqrt x`)。字段与局部变量按约定是小写(`me.x` / `_n`),所以这条不误伤它们。",
                    "match": "(?<=\\.)[A-Z][A-Za-z0-9_]*",
                    "name": "support.function.ravel"
                }
            ]
        }
    }
}

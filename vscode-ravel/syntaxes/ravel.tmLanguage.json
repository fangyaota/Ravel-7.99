{
    "name": "Ravel",
    "scopeName": "source.ravel",
    "patterns": [
        { "include": "#strings" },
        { "include": "#comments" },
        { "include": "#numbers" },
        { "include": "#modifiers" },
        { "include": "#constants" },
        { "include": "#operators" },
        { "include": "#support" }
    ],
    "repository": {
        "strings": {
            "patterns": [
                {
                    "begin": "\"",
                    "end": "\"",
                    "name": "string.quoted.double.ravel",
                    "patterns": [
                        { "match": "\\\\.", "name": "constant.character.escape.ravel" }
                    ]
                }
            ]
        },
        "comments": {
            "patterns": [
                { "match": "#.*$", "name": "comment.line.number-sign.ravel" }
            ]
        },
        "numbers": {
            "patterns": [
                { "match": "\\b\\d+(\\.\\d+)?\\b", "name": "constant.numeric.ravel" }
            ]
        },
        "modifiers": {
            "patterns": [
                {
                    "match": "\\b(readonly|public|private|protected|outdated|unreadable|by|core|thistype|block)\\b",
                    "name": "storage.modifier.ravel"
                }
            ]
        },
        "constants": {
            "patterns": [
                { "match": "\\b(true|false|default|NaN|Inf)\\b", "name": "constant.language.ravel" }
            ]
        },
        "operators": {
            "patterns": [
                { "match": "::=|::|:=|=>|:<|:>|<:|<\\||==|!=|<=|>=|&&|\\|\\||\\+=|-=|\\*=|/=|%=", "name": "keyword.operator.ravel" },
                { "match": "[-+*/%&|^!<>=@\\$]", "name": "keyword.operator.ravel" },
                { "match": "[:.,]", "name": "punctuation.separator.ravel" }
            ]
        },
        "support": {
            "patterns": [
                {
                    "match": "\\b(int|string|char|bool|float|bigint|fraction|bigfraction|list|set|dict|object|class|interface|function|type|void|Any|Every|Exception|ValueType|Cacher|Option|Keyed|Json|Action|IEnumerable|IEnumerator|Enumerator|IComparable|IKey|IDict|INumber|IMonad|IEntry|IFile|IDir)\\b",
                    "name": "support.type.ravel"
                },
                {
                    "match": "\\b(print|while|if|foreach|do|cacher|Some|None|callcc|typeof|assert|eval|randint|with|ravel|using|use|impl|try|throw|exit|input|unsafe|currentScope|property)\\b",
                    "name": "support.function.ravel"
                },
                {
                    "match": "\\b(this|instance)\\b",
                    "name": "variable.language.ravel"
                },
                {
                    "comment": "点号后面的大驼峰 = 方法调用(`xs.Map f` / `d.Keys ()` / `Math.Sqrt x`)。字段与局部变量按约定是小写(`me.x` / `_n`),所以这条不误伤它们。",
                    "match": "(?<=\\.)[A-Z][A-Za-z0-9_]*",
                    "name": "support.function.ravel"
                }
            ]
        }
    }
}

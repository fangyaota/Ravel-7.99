{
    "version": "2.0.0",
    "tasks": [
        {
            // Ctrl+Shift+B 的默认任务:先编译,再拿当前 .rav 文件跑一遍
            "label": "ravel: 运行当前文件",
            "type": "process",
            "command": "dotnet",
            "args": [
                "${workspaceFolder}/bin/Debug/net10.0/ravel.dll",
                "${file}"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "dependsOn": "build",
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
            "group": { "kind": "build", "isDefault": true }
        },
        {
            // 用例需要 256MB 堆上限:40_callcc 的长循环靠它来卡住退化成 O(N) 帧链的实现
            // **必须挑词**:全量那一趟已经取消,不挑 `ravel test` 直接报错
            "label": "ravel: 挑词跑测试",
            "type": "process",
            "command": "dotnet",
            "args": [
                "${workspaceFolder}/bin/Debug/net10.0/ravel.dll",
                "test",
                "${input:pick}"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": { "DOTNET_GCHeapHardLimit": "0x10000000" }
            },
            "dependsOn": "build",
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
        },
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/Ravel.sln",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "publish",
            "command": "dotnet",
            "type": "process",
            // 用 Ravel.csproj 而不是 .sln:带 -o 发布 sln 会报 NETSDK1194
            "args": [
                "publish",
                "${workspaceFolder}/Ravel.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "watch",
            "command": "dotnet",
            "type": "process",
            "args": [
                "watch",
                "run",
                "--project",
                "${workspaceFolder}/Ravel.sln"
            ],
            "problemMatcher": "$msCompile"
        }
    ],
    "inputs": [
        {
            // 挑词在跑之前问一次,免得手改 tasks.json
            "id": "pick",
            "type": "promptString",
            "description": "挑个沾相对路径的词(例如 lang、net、367)",
            "default": "lang"
        }
    ]
}
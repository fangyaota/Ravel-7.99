<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>7.99</Version>
    <AssemblyName>ravel</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- 插件那一族**不在主项目里编译**:它们是 `Ravel.Structures/` 和 `Ravel.Extensions/`
         那两个项目编出来的 dll,运行时由 `using "plugins/xxx.dll"` 装进来
         (见 Runtime/Builtins/PluginApi.cs)。
         不排掉的话 SDK 默认的 `**/*.cs` 会把它们也编进来 —— 同一批类定义两遍。 -->
    <Compile Remove="Ravel.Structures/**" />
    <Compile Remove="Ravel.Extensions/**" />
    <Compile Remove="plugins/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
    <!-- 命令行的骨架(见 `Cli/Program.cs`)。和上面那件**同版本** —— 它们本来就是一套,
         版本错开会拖来两份 Spectre.Console。 -->
    <PackageReference Include="Spectre.Console.Cli" Version="0.57.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- GBK / Big5 那批老编码:`Encoding.GetEncoding("gbk")` 要 `CodePagesEncodingProvider`
         注册过才认(注册那一下在 `SysNet` 的静态构造里)。中文网页常见,不注册的话
         `charset=gbk` 会静默退回 UTF-8、整页乱码。
         **不再挂 `PackageReference`** —— net10 起它进了共享框架,显式引用反而多一条
         NU1510「自动可用,无需引用」;用例 269 那条 `charset=gbk` 是它的守门人。 -->
  </ItemGroup>


  <!-- 插件 dll:先编那两个插件项目(它们反过来引用本项目的输出),再把产物拷到
       **`$(OutDir)plugins/`** —— `using "plugins/Ravel.Extensions.dll"` 就找得到
       (搜索路径里有"跑起来的那个程序集的目录",所以从哪个工作目录跑都行,
       见 Runtime/ModuleSearchPath.cs)。
       用 MSBuild 任务而不是 ProjectReference:那样会成环(插件依赖主项目,
       主项目再依赖插件就没法还原了)。 -->
  <!-- `IsPluginBuild` 那面旗子**不能省**:插件项目反过来引用主项目,所以编插件会连带把主项目
       再编一遍 —— 那一趟里这个目标又会去编插件,MSBuild 当场报「循环依赖」(MSB4006)。
       旗子一插,嵌进去的那一趟就跳过。 -->
  <Target Name="BuildPlugins" Condition="'$(IsPluginBuild)' != 'true'">
    <MSBuild Projects="Ravel.Structures\Ravel.Structures.csproj" Targets="Restore;Build"
             Properties="Configuration=$(Configuration);IsPluginBuild=true" />
    <MSBuild Projects="Ravel.Extensions\Ravel.Extensions.csproj" Targets="Restore;Build"
             Properties="Configuration=$(Configuration);IsPluginBuild=true" />
  </Target>

  <!-- 拷到哪儿**分两趟**,因为平时 `build` 和 `publish -o out` 的落点不是同一个:
       `$(OutDir)` 那份是 `bin/Debug/net10.0/`,而带 `-o` 发布时 `$(PublishDir)` 才是 out/。
       插件必须在**跑起来的那个程序集旁边**,所以两边都得有。 -->
  <Target Name="CopyPlugins" AfterTargets="Build" DependsOnTargets="BuildPlugins"
          Condition="'$(IsPluginBuild)' != 'true'">
    <ItemGroup>
      <PluginDll Include="Ravel.Structures/bin/$(Configuration)/net10.0/Ravel.Structures.dll" />
      <!-- 扩展自己那一份 + **它拖来的那几件**:`Microsoft.Data.Sqlite` 和 `SQLitePCLRaw.*`
           得跟着走 —— 那几件是它从包引用里拖来的,主项目已经不带它们了。
           **不能整个 `*.dll` 扫**:插件项目的输出里还躺着 ProjectReference 带过来的
           Spectre / Newtonsoft(那批主程序自己就有),多拷一份就多一份可能过期的副本。 -->
      <PluginDll Include="Ravel.Extensions/bin/$(Configuration)/net10.0/Ravel.Extensions.dll" />
      <!-- deps.json 也得跟着:插件自己带的依赖靠它说明(见 PluginLoader.HookDependencies) -->
      <PluginDll Include="Ravel.Extensions/bin/$(Configuration)/net10.0/Ravel.Extensions.deps.json" />
      <PluginDll Include="Ravel.Extensions/bin/$(Configuration)/net10.0/Microsoft.Data.Sqlite.dll" />
      <PluginDll Include="Ravel.Extensions/bin/$(Configuration)/net10.0/SQLitePCLRaw.*.dll" />
      <!-- SQLite 的本机那一件:`runtimes/<rid>/native/e_sqlite3.dll`。它得落在**插件旁边**
           (`plugins/runtimes/...`)—— 解析它的是插件那份 `.deps.json`
           (见 PluginLoader.HookDependencies),而那份说明书是**相对插件自己**写的。
           塞进主程序的 `out/runtimes/` 没用:主程序的 deps.json 里根本没有这个包,
           按那个找就是一句光秃秃的 DllNotFoundException。 -->
      <PluginNative Include="Ravel.Extensions/bin/$(Configuration)/net10.0/runtimes/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(PluginDll)" DestinationFolder="$(OutDir)plugins" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(PluginNative)"
          DestinationFiles="@(PluginNative->'$(OutDir)plugins/runtimes/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyPluginsToPublish" AfterTargets="Publish" DependsOnTargets="BuildPlugins"
          Condition="'$(IsPluginBuild)' != 'true'">
    <ItemGroup>
      <PluginDllP Include="Ravel.Structures/bin/$(Configuration)/net10.0/Ravel.Structures.dll" />
      <PluginDllP Include="Ravel.Extensions/bin/$(Configuration)/net10.0/Ravel.Extensions.dll" />
      <PluginDllP Include="Ravel.Extensions/bin/$(Configuration)/net10.0/Ravel.Extensions.deps.json" />
      <PluginDllP Include="Ravel.Extensions/bin/$(Configuration)/net10.0/Microsoft.Data.Sqlite.dll" />
      <PluginDllP Include="Ravel.Extensions/bin/$(Configuration)/net10.0/SQLitePCLRaw.*.dll" />
      <PluginNativeP Include="Ravel.Extensions/bin/$(Configuration)/net10.0/runtimes/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(PluginDllP)" DestinationFolder="$(PublishDir)plugins" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(PluginNativeP)"
          DestinationFiles="@(PluginNativeP->'$(PublishDir)plugins/runtimes/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- 标准库(`lib/*.rav`)**不是编译产物** —— 解释器是**读源码**跑的,`predefined.rav` 就在里头。
       所以它也得跟着 dll 走,和插件那两趟一个落点、一个道理(见上):
       `$(OutDir)` 那份给平时 build / VS Code 的 F5,`$(PublishDir)` 那份给 `-o out`。
       搜索路径里有"程序集目录下的 lib/"(见 Runtime/ModuleSearchPath.cs),
       拷过去之后**从哪个工作目录跑都行** —— 不然 `out/` 只在工作目录里正好有 `lib/` 时才转得起来。 -->
  <Target Name="CopyLib" AfterTargets="Build" Condition="'$(IsPluginBuild)' != 'true'">
    <ItemGroup>
      <LibFile Include="lib/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(LibFile)"
          DestinationFiles="@(LibFile->'$(OutDir)lib/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyLibToPublish" AfterTargets="Publish" Condition="'$(IsPluginBuild)' != 'true'">
    <ItemGroup>
      <LibFileP Include="lib/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(LibFileP)"
          DestinationFiles="@(LibFileP->'$(PublishDir)lib/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- **发布出去的 `lib/` 不带注释**:那些注释是写给改这门语言的人看的,不是写给跑它的人看的。
       (仓库里那份当然留着 —— 它是唯一能读的那份;`build` 拷进 `$(OutDir)` 的那份也留着,调试时要读。)
       用的是刚发布出来的那个 dll:`strip` 那条路**不进解释器**(只做源码加工),
       而"哪儿是注释"由引擎的词法器说了算 —— 所以这一步不能交给脚本或正则。
       剥之前每个文件都自验过(token 与原文逐个相等),对不上就不写(见 `Syntax/CommentStripper.cs`)。
       `DependsOnTargets` 不能省:两个目标都挂在 `AfterTargets="Publish"` 上,得先拷完再剥。 -->
  <Target Name="StripLibComments" AfterTargets="Publish" DependsOnTargets="CopyLibToPublish"
          Condition="'$(IsPluginBuild)' != 'true'">
    <Exec Command="dotnet &quot;$(PublishDir)ravel.dll&quot; strip &quot;$(PublishDir)lib&quot;" />
  </Target>

  <!-- 例子(`examples/*.rav`)**也跟着走**,和标准库一个道理:它们同样不是编译产物,
       而"拿到 out/ 那一步就能照着跑一段"正是这个目录存在的意义(教程里到处在指它们)。
       落点也照 `lib/` 分两份:平时的 `$(OutDir)`、发布的 `$(PublishDir)`。
       **例子不进搜索路径** —— 它们是拿来跑的文件(`dotnet ravel.dll examples/http.rav`),
       不是拿来 `using` 的:那几个例子自己引的是 `lib/` 里的模块,按模块名找得到。 -->
  <Target Name="CopyExamples" AfterTargets="Build" Condition="'$(IsPluginBuild)' != 'true'">
    <ItemGroup>
      <ExampleFile Include="examples/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(ExampleFile)"
          DestinationFiles="@(ExampleFile->'$(OutDir)examples/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyExamplesToPublish" AfterTargets="Publish" Condition="'$(IsPluginBuild)' != 'true'">
    <ItemGroup>
      <ExampleFileP Include="examples/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(ExampleFileP)"
          DestinationFiles="@(ExampleFileP->'$(PublishDir)examples/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- `docs/`(教程的 markdown 源)也**跟着走** —— 它是 `examples/site.rav` / `serve.rav`
       拿来生成那个静态站的料。不带上的话,从 `out/` 跑起来 `Glob.Find "docs/tutorial/*.md"`
       一个都找不到,于是**静默生成一个空站**(只有 index.html 和 css,一章都没有,
       而且它还印"好了")。例子指 `lib/`、又指 `docs/`,三样得一起走。
       落点照旧分两份:平时的 `$(OutDir)`、发布的 `$(PublishDir)`。 -->
  <Target Name="CopyDocs" AfterTargets="Build" Condition="'$(IsPluginBuild)' != 'true'">
    <ItemGroup>
      <DocFile Include="docs/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(DocFile)"
          DestinationFiles="@(DocFile->'$(OutDir)docs/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyDocsToPublish" AfterTargets="Publish" Condition="'$(IsPluginBuild)' != 'true'">
    <ItemGroup>
      <DocFileP Include="docs/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(DocFileP)"
          DestinationFiles="@(DocFileP->'$(PublishDir)docs/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>

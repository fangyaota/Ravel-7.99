<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>7.99</Version>
    <AssemblyName>ravel</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- SQLite:纯托管那套(不用本机编译),`System.Data` 这边的官方实现 -->
    <!-- SQLite:官方那套(纯托管的 SQLitePCLRaw,不必本机编译) -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- GBK / Big5 那批老编码:`Encoding.GetEncoding("gbk")` 在 .NET Core 上要它才认。
         中文网页常见,不注册的话 `charset=gbk` 会静默退回 UTF-8、整页乱码 -->
    <PackageReference Include="System.Text.Encoding.CodePages" Version="10.0.12" />
  </ItemGroup>

</Project>


ravel "Table"

readonly private WideRange := [
    4352 4447
    11904 12350
    12353 13311
    13312 19903
    19968 40959
    40960 42191
    44032 55203
    63744 64255
    65072 65103
    65280 65376
    65504 65510
    127744 129791
]

readonly private IsWide := (n: int) => {
    w := false
    i := 0
    while { i < (WideRange.Count ()); } {
        (n >= (WideRange.At i)) && (n <= (WideRange.At (i + 1))) { w = true; } { 0; }
        i += 2
    }
    w
}

readonly Width := (s: string) => {
    w := 0
    (s.Chars ()).Foreach (c: object) => {
        IsWide (c.Code ()) { w += 2; } { w += 1; }
    }
    w
}

readonly private Spaces := (n: int) => { (" ").Repeat n; }

readonly private Fit := (s: string n: int align: string) => {
    gap := n - (Width s)
    gap <= 0 { s; } {
        align == "right" { (Spaces gap) + s; } {
            align == "center" {
                left := Spaces (gap / 2)
                left + s + (Spaces (gap - (Width left)))
            } { s + (Spaces gap); }
        }
    }
}

readonly Cell := (v: object) => { (typeof v) == string { v; } { string v; }; }

readonly private AllNum := (rows: list c: object) => {
    seen := 0
    ok := true
    rows.Foreach (r: object) => {
        v := At r c
        (typeof v) != string {
            seen += 1
            v : INumber { 0; } { ok = false; }
        } { 0; }
    }
    ok && (seen > 0)
}

readonly At := (row: object c: object) => {
    (typeof row) == dict {
        row.Has c { row.Get c; } { ""; }
    } {
        c < (row.Count ()) { row.At c; } { ""; }
    }
}

readonly Render := (rows: list) => { RenderWith rows (); }

readonly RenderWith := (rows: list opts: object) => {
    given := (typeof opts) == dict
    (rows.Count ()) == 0 { ""; } { Build rows given opts; }
}

readonly Build := (rows: list given: bool opts: object) => {
    head := rows.At 0
    asDict := (typeof head) == dict

    cols := []
    given && (opts.Has "cols") { (opts.Get "cols").Foreach (c: object) => { cols.Add c; }; } {
        asDict {
            seen := {->}
            rows.Foreach (r: object) => {
                (r.Keys ()).Foreach (k: object) => {
                    seen.Has k { 0; } { seen.Set k true; cols.Add k; }
                }
            }
        } {
            n := 0
            head.Foreach (v: object) => { cols.Add n; n += 1; }
        }
    }

    header := asDict
    given && (opts.Has "header") { header = opts.Get "header"; } { 0; }

    widths := []
    cols.Foreach (c: object) => {
        w := header { Width (string c); } { 0; }
        rows.Foreach (r: object) => {
            t := Width (Cell (At r c))
            t > w { w = t; } { 0; }
        }
        widths.Add w
    }

    aligns := []
    cols.Foreach (c: object) => {
        a := AllNum rows c { "right"; } { "left"; }
        given && (opts.Has "align") {
            al := opts.Get "align"
            al.Has c { a = al.Get c; } { 0; }
        } { 0; }
        aligns.Add a
    }

    style := given && (opts.Has "style") { opts.Get "style"; } { "box"; }
    box := style == "box"

    ruler := (l: string m: string r: string) => {
        out := ""
        i := 0
        while { i < (cols.Count ()); } {
            i > 0 { out += m; } { 0; }
            out += ("─".Repeat (widths.At i))
            i += 1
        }
        l + out + r
    }

    line := (cells: list) => {
        out := box { "│"; } { ""; }
        i := 0
        while { i < (cols.Count ()); } {
            i > 0 { out += (box { " │ "; } { "  "; }); } { out += (box { " "; } { ""; }); }
            out += (Fit (cells.At i) (widths.At i) (aligns.At i))
            i += 1
        }
        out + (box { " │"; } { ""; })
    }

    cellsOf := (r: object) => {
        cs := []
        cols.Foreach (c: object) => { cs.Add (Cell (At r c)); }
        cs
    }

    out := []
    box { out.Add (ruler "┌" "┬" "┐"); } { 0; }
    header {
        hs := []
        cols.Foreach (c: object) => { hs.Add (string c); }
        out.Add (line hs)
        out.Add (box { ruler "├" "┼" "┤"; } { ruler "" "  " ""; })
    } { 0; }
    rows.Foreach (r: object) => { out.Add (line (cellsOf r)); }
    box { out.Add (ruler "└" "┴" "┘"); } { 0; }

    out.Join "
"
}

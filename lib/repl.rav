using "native.rav"
using "terminal.rav"
using "io.rav"
using "docsite.rav"

ravel "Repl"

readonly private ColorOf := (kind: string) => {
    kind == "string" { "yellow"; } {
        kind == "number" { "lime"; } { kind == "word" { "cyan"; } { "bold"; } }
    }
}

readonly private WordChar := (c: char) => {
    code := c.Code ()
    code >= 128 { true; } {
        ((code >= 65) && (code <= 90)) || (((code >= 97) && (code <= 122)) || (code == 95));
    }
}

readonly private NumChar := (c: char) => {
    c.IsDigit () { true; } { c == '.' { true; } { "nif".Contains (string c); } }
}

readonly Segments := (text: string) => {
    out := []
    i := 0
    n := text.Length ()
    while { i < n; } {
        c := text.At i
        j := i + 1
        kind := "other"
        c == '#' {
            j = n
        } {
            c == '"' {
                closed := false
                while { (j < n) && (!(closed)); } {
                    ch := text.At j
                    ch == '\\' { j += 2; } {
                        ch == '"' { closed = true; } { 0; }
                        j += 1
                    }
                }
                j > n { j = n; } { 0; }
                kind = "string"
            } {
                c.IsDigit () {
                    while { (j < n) && (NumChar (text.At j)); } { j += 1; }
                    kind = "number"
                } {
                    WordChar c {
                        while { (j < n) && (WordChar (text.At j)); } { j += 1; }
                        kind = "word"
                    } { 0; }
                }
            }
        }
        piece := text.Slice [i..j)
        out.Add {"kind"-> kind "text"-> piece}
        i = j
    }
    out
}

readonly private Tint := (kind: string text: string at: object) => {
    head := "[" + (ColorOf kind) + "]"
    (typeof at) != int { head + (Terminal.Escape text) + "[/]"; } {
        k := at

        before := head + (Terminal.Escape (text.Take k)) + "[/]"
        cursorBlock := "[underline red]" + (Terminal.Escape (text.Slice [k..(k + 1)))) + "[/]"
        after := head + (Terminal.Escape (text.Skip (k + 1))) + "[/]"
        before + cursorBlock + after;
    }
}

readonly Colored := (text: string) => {
    out := ""
    (Segments text).Foreach (s: object) => { out += (Tint (s.Get "kind") (s.Get "text") ()); }
    out
}

readonly Row := (n: int text: string cursorX: object) => {
    out := "[blue]" + (Pad (string n) 3) + "|[/] "
    pos := 0
    (Segments text).Foreach (s: object) => {
        t := s.Get "text"

        box := []
        (typeof cursorX) == int {
            (cursorX >= pos) && (cursorX < (pos + (t.Length ()))) { box.Add (cursorX - pos); } { 0; }
        } { 0; }
        out += (Tint (s.Get "kind") t ((box.Count ()) == 0 { (); } { box.At 0; }))
        pos += (t.Length ())
    }
    (typeof cursorX) == int {
        cursorX >= pos { out += "[underline red] [/]"; } { 0; }
    } { 0; }
    out
}

readonly Pad := (s: string n: int) => {
    need := n - (s.Length ())
    need <= 0 { s; } { ((" ").Repeat need) + s; }
}

readonly private InsertAt := (s: string i: int t: string) => { (s.Take i) + t + (s.Skip i); }
readonly private CutAt := (s: string i: int) => { (s.Take i) + (s.Skip (i + 1)); }

readonly private ClampTo := (v: int lo: int hi: int) => {
    v < lo { lo; } { v > hi { hi; } { v; } }
}

readonly private IsTriple := (src: string i: int) => {
    n := src.Length ()
    hit := false
    i + 2 < n {
        a := src.At i
        b := src.At (i + 1)
        d := src.At (i + 2)
        hit = ((a == '"') && (b == '"')) && (d == '"')
    } { 0; }
    hit
}

readonly Balanced := (src: string) => {
    depth := 0
    inStr := false
    inRaw := false
    i := 0
    n := src.Length ()
    while { i < n; } {
        c := src.At i
        inStr {
            inRaw {
                IsTriple src i { inStr = false; inRaw = false; i += 3; } { i += 1; }
            } {
                c == '\\' { i += 2; } {
                    c == '"' { inStr = false; } { 0; }
                    i += 1
                }
            }
        } {
            c == '#' { i = n; } {
                IsTriple src i { inStr = true; inRaw = true; i += 3; } {
                    c == '"' { inStr = true; i += 1; } {
                        "([{".Contains (string c) { depth += 1; } {
                            ")]}".Contains (string c) { depth -= 1; } { 0; }
                        }
                        i += 1
                    }
                }
            }
        }
    }
    (depth <= 0) && (!(inStr));
}

readonly Window := (total: int y: int) => {
    left := ClampTo (y - 8) 0 total
    right := ClampTo (left + 16) 0 total
    left = ClampTo (right - 16) 0 total
    [left right]
}

readonly PageOf := (s: string) => {
    t := s.Trim ()
    n := 0
    ok := (t.Length ()) > 0
    (t.Chars ()).Foreach (c: object) => {
        c.IsDigit () { n = (n * 10) + ((c.Code ()) - 48); } { ok = false; }
    }
    ok { n; } { -1; }
}

readonly private PageMark := string (char 12)

readonly Banner := () => {
    """
     ____                                   ___
    /\  _`\                                /\_ \
    \ \ \L\ \      __      __  __     __   \//\ \
     \ \ ,  /    /'__`\   /\ \/\ \  /'__`\   \ \ \
      \ \ \\ \  /\ \L\.\_ \ \ \_/ |/\  __/    \_\ \_
       \ \_\ \_\\ \__/.\_\ \ \___/ \ \____\   /\____\
        \/_/\/ / \/__/\/_/  \/__/   \/____/   \/____/
                _____           ___           ___
               /\  ___\        /'__`\        /'__`\
               \ \ \__/       /\ \/\ \      /\ \/\ \
                \ \___``\     \ \ \ \ \     \ \ \ \ \
                 \/\ \L\ \ __  \ \ \_\ \ __  \ \ \_\ \
                  \ \____//\_\  \ \____//\_\  \ \____/
                   \/___/ \/_/   \/___/ \/_/   \/___/
    Ravel 7.99
    """
}

readonly private Paint := (drawn: int lines: list) => {
    blank := (" ").Repeat ((Terminal.Width ()) - 1)
    System.CursorTo 0 0
    i := 0
    while { i < drawn; } { System.WriteLine blank; i += 1; }
    System.CursorTo 0 0
    n := 0
    lines.Foreach (l: string) => { System.WriteLine l; n += 1; }
    n
}

readonly Editor ::= class {
    Pages: list = [[]]
    Z: int = 0
    Y: int = 0
    X: int = 0
    AutoTab: bool = true
    ShowResult: bool = true
    Drawn: int = 0

    init = () => { Pages = [[]]; Z = 0; Y = 0; X = 0; this; }

    Lines := () => { Pages.At Z; }
    Current := () => { ((Lines ()).Count ()) == 0 { ""; } { (Lines ()).At Y; } }
    Text := () => { (Lines ()).Join "\n"; }

    Ensure := () => { ((Lines ()).Count ()) == 0 { (Lines ()).Add ""; } { 0; }; }

    Clamp := () => {
        Z = ClampTo Z 0 ((Pages.Count ()) - 1)
        ((Lines ()).Count ()) == 0 { Y = 0; X = 0; } {
            Y = ClampTo Y 0 (((Lines ()).Count ()) - 1)
            X = ClampTo X 0 ((Current ()).Length ())
        }
        ();
    }

    Screen := () => {
        out := ["[purple]------第" + (string Z) + "页------[/]"]
        rows := 0
        lines := Lines ()
        (lines.Count ()) == 0 { out.Add "   | <空>"; } {
            w := Window (lines.Count ()) Y
            i := w.At 0
            while { i < (w.At 1); } {
                out.Add (Row i (lines.At i) (i == Y { X; } { (); }))
                i += 1
            }
            rows = (w.At 1) - (w.At 0)
        }
        while { (out.Count ()) < 9; } { out.Add "   |"; }

        (rows == 0) || (rows >= 8) { out.Add ""; } { 0; }
        out
    }

    Tips := () => {
        [
            "------快捷栏------"
            ""
            "  [yellow]Ins [/] : 清除该页"
            "  [yellow]PgUp[/] : 上一条记录"
            "  [yellow]PgDn[/] : 下一条记录"
            "  [yellow]Home[/] : 跳至开头"
            "  [yellow]End [/] : 跳至结尾"
            "  [yellow]Del [/] : 向后删除"
            "  [yellow]Esc [/] : 退出编辑"
        ]
    }

    Framed := (lines: list) => { System.SplitLines (Terminal.Panel lines); }

    DrawMenu := () => { Drawn = Paint Drawn (Framed (Screen ())); }

    DrawEdit := () => {
        rows := Framed (Screen ())
        (Tips ()).Foreach (t: string) => { rows.Add (Terminal.Render t); }
        Drawn = Paint Drawn rows;
    }

    Edit := () => {
        System.CursorShow false
        running := true
        while { running; } {
            DrawEdit ()
            k := System.ReadKey ()
            (typeof k) != string { running = false; } {
                k == "esc" { running = false; } {
                    Jump k { Clamp (); } {
                        Edit1 k { Clamp (); } { 0; }
                    }
                }
            }
        }
        System.CursorShow true
        ();
    }

    Jump := (k: string) => {
        Ensure ()
        k |> "up"    => { Y -= 1; true; }
          |  "down"  => { Y += 1; true; }
          |  "left"  => { X -= 1; true; }
          |  "right" => { X += 1; true; }
          |  "home"  => { X = 0; Y = 0; true; }
          |  "end"   => { GoEnd (); true; }
          |  "pgup"  => { Z -= 1; X = 0; Y = 0; true; }
          |  "pgdn"  => { NextPage (); true; }
          |  _       => { false; }
    }

    GoEnd := () => { Y = (((Lines ()).Count ()) - 1); X = (Current ()).Length (); (); }

    NextPage := () => {
        (Z == ((Pages.Count ()) - 1)) && (((Lines ()).Count ()) != 0) { Pages.Add []; } { 0; }
        Z += 1
        X = 0
        Y = 0
        ();
    }

    Edit1 := (k: string) => {
        Ensure ()
        cur := Current ()
        k |> "backspace" => { Backspace cur; true; }
          |  "delete"    => { DeleteAt cur; true; }
          |  "enter"     => { SplitLine cur; true; }
          |  "tab"       => { (Lines ()).Set Y (InsertAt cur X "    "); X += 4; true; }
          |  "insert"    => { ClearPage (); true; }
          |  _           => { TypeChar k; }
    }

    Backspace := (cur: string) => {
        X == 0 {
            Y >= 1 {
                prev := (Lines ()).At (Y - 1)
                X = prev.Length ()
                (Lines ()).Set (Y - 1) (prev + cur)
                (Lines ()).RemoveAt Y
                Y -= 1
            } { 0; }
        } { (Lines ()).Set Y (CutAt cur (X - 1)); X -= 1; }
        ();
    }

    DeleteAt := (cur: string) => {
        X == (cur.Length ()) {
            Y < (((Lines ()).Count ()) - 1) {
                (Lines ()).Set Y (cur + ((Lines ()).At (Y + 1)))
                (Lines ()).RemoveAt (Y + 1)
            } { 0; }
        } { (Lines ()).Set Y (CutAt cur X); }
        ();
    }

    SplitLine := (cur: string) => {
        indent := AutoTab { Lead cur; } { 0; }
        (Lines ()).Set Y (cur.Take X)
        (Lines ()).Insert (Y + 1) (((" ").Repeat indent) + (cur.Skip X))
        Y += 1
        X = indent
        ();
    }

    TypeChar := (k: string) => {
        (k.Length ()) != 1 { false; } {
            (Lines ()).Set Y (InsertAt (Current ()) X k)
            X += 1
            true
        }
    }

    Lead := (s: string) => {
        i := 0
        while { (i < (s.Length ())) && ((s.At i) == ' '); } { i += 1; }
        i
    }

    ClearPage := () => {
        (((Lines ()).Count ()) == 0) && ((Pages.Count ()) >= 2) {
            Pages.RemoveAt Z
            Z -= 1
        } { (Lines ()).Clear (); }
        Clamp ()
    }

    Items := () => {
        ["编辑" "运行" "普通 Repl" "读取" "保存" "退出" "作者" "开关自动对齐" "开关结果显示" "教程"]
    }

    Menu := () => {
        running := true
        while { running; } {
            DrawMenu ()
            sel := Terminal.Menu "------主菜单------" (Items ())
            running = Guard sel;
        }
        ();
    }

    Guard := (sel: int) => {
        ok := true
        try { ok = Pick sel; } (e: Exception) => {
            Terminal.Line ("[red]出错了：" + (Terminal.Escape e.Message) + "[/]")
            Hold ()
        }
        System.ScreenClear ()
        Drawn = 0
        ok
    }

    Pick := (sel: int) => {
        sel |> 0 => { Edit (); }
            |  1 => { RunPage (); }
            |  2 => { PlainLoop (); }
            |  3 => { LoadPage (); }
            |  4 => { SavePage (); }
            |  5 => { 0; }
            |  6 => { About (); }
            |  7 => { SwitchAutoTab (); }
            |  8 => { SwitchResult (); }
            |  9 => { Tutorial (); }
            |  _ => { 0; }
        sel != 5;
    }

    Hold := () => {
        Terminal.Line ""
        Terminal.Line "[green]按任意键继续[/]"
        System.ReadKey ()
        ();
    }

    Tutorial := () => {
        here := System.CurrentDir ()
        Terminal.Line "[green]正在生成教程……[/]"
        DocSite.Build "site"

        System.Open (here + "/site/index.html")
        Terminal.Line ("[green]已经用浏览器打开了:[/]" + here + "/site/index.html")
        Hold ()
        ();
    }

    SwitchAutoTab := () => {
        AutoTab = Terminal.ConfirmDefault "开关自动对齐文本吗？" (!(AutoTab))
        Terminal.Line (AutoTab { "已开启自动对齐文本"; } { "已关闭自动对齐文本"; })
        ();
    }

    SwitchResult := () => {
        ShowResult = Terminal.ConfirmDefault "开关显示执行结果吗？" (!(ShowResult))
        Terminal.Line (ShowResult { "已开启显示"; } { "已关闭显示"; })
        Hold ()
        ();
    }

    RunPage := () => {
        System.CursorShow true
        TryEval (Text ())
        Hold ()
        ();
    }

    TryEval := (source: string) => {
        System.CaptureStart ()
        try {
            v := eval source
            out := System.CaptureEnd ()
            ShowResult {
                captured := out.Trim ()

                !(captured.IsEmpty ()) { Terminal.Line (Terminal.Escape captured); } { 0; }
                (typeof v) != void {
                    Terminal.Line ("[yellow]==>[/]" + (Terminal.Escape (string v)))
                } { 0; }
            } { 0; }
        } (e: Exception) => {
            o := System.CaptureEnd ()
            ShowError e
        }
        ();
    }

    ShowError := (e: Exception) => {
        (System.SplitLines (System.FormatError e)).Foreach (l: string) => {
            Terminal.Line ("[red]" + (Terminal.Escape l) + "[/]")
        }
        ();
    }

    About := () => {
        System.CursorShow true
        System.ScreenClear ()
        Drawn = 0
        Terminal.Line (Banner ())
        Hold ()
        System.ScreenClear ()
        Drawn = 0
        ();
    }

    PlainLoop := () => {
        System.CursorShow true
        System.WriteLine "普通 Repl（:exit 返回菜单）"
        buffer := ""
        running := true
        while { running; } {
            System.Write (buffer.IsEmpty () { ">>> "; } { "... "; })
            line := input ()
            cmd := line.Trim ()
            (buffer.IsEmpty ()) && ((cmd == ":exit") || ((cmd == ":q") || (cmd == ":quit"))) {
                running = false
            } {
                buffer += line + "\n"
                Balanced buffer {
                    try {
                        v := eval buffer

                        (typeof v) == void { 0; } { System.WriteLine ("==> " + (string v)); }
                    } (e: Exception) => { ShowError e; }
                    buffer = ""
                } { 0; }
            }
        }
        ();
    }

    LoadPage := () => {
        System.CursorShow true
        path := Terminal.AskDefault "选择代码文件" "temp.ravel"
        f := Io.File path
        !(f.Exists ()) {
            Terminal.Line ("[red]错误：文件<" + (Terminal.Escape path) + ">不存在[/]")
        } {
            idx := AskPage ()
            Pages.Insert idx (System.SplitLines (f.Read ()))
            Terminal.Line ("已加载至[purple]第" + (string idx) + "页[/]")
        }
        Hold ()
        ();
    }

    AskPage := () => {
        idx := PageOf (Terminal.AskDefault "输入插入页码" (string Z))
        while { (idx < 0) || (idx >= (Pages.Count ())); } {
            Terminal.Line "[red]错误：页码不合规[/]"
            idx = PageOf (Terminal.AskDefault "输入插入页码" (string Z))
        }
        idx
    }

    SavePage := () => {
        System.CursorShow true
        path := Terminal.AskDefault "选择代码文件" "temp.ravel"
        f := Io.File path
        f.Exists () {
            name := System.PathBase path
            Terminal.Line ("[yellow]警告：文件<" + (Terminal.Escape name) + ">已存在,正在覆盖...[/]")
        } { 0; }
        f.Write (Text ())
        Terminal.Line ("已保存[purple]第" + (string Z) + "页[/]")
        Hold ()
        ();
    }

    Keep := () => {
        parts := []
        Pages.Foreach (p: list) => { parts.Add ((p).Join "\n"); }
        try { System.WriteText (SessionFile ()) (parts.Join PageMark); } (e: Exception) => { 0; }
        ();
    }

    Restore := () => {
        f := Io.File (SessionFile ())
        f.Exists () {
            raw := f.Read ()
            raw.IsEmpty () { 0; } {
                Pages = []
                (raw.Split PageMark).Foreach (p: string) => { Pages.Add (System.SplitLines p); }
                Z = 0
                Y = 0
                X = 0
            }
        } { 0; }
        Clamp ()
        ();
    }
}

readonly private SessionFile := () => { ".ravel-session"; }

readonly Run := () => {
    Terminal.Tty () {
        e := Editor ()
        e.Restore ()
        e.About ()
        e.Menu ()
        e.Keep ()
        System.CursorShow true
        System.ScreenClear ()
    } {
        RunSource (System.ReadAllInput ())
    }
    ();
}

readonly private RunSource := (src: string) => {
    body := src.Trim ()
    body.IsEmpty () { (); } {
        try {
            v := eval src
            (typeof v) == void { 0; } { System.WriteLine (string v); }
        } (e: Exception) => { System.WriteErr (System.FormatError e); }
    }
    ();
}

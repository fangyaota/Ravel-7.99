readonly Generator ::= class {
    Body: function = _
    init = (body: function) => { Body = body; this; }

    internal GetEnumerator := () => { GeneratorCursor Body; }
}

readonly GeneratorCursor ::= class {
    Body: function = _
    Value: object = ()
    Started: bool = false
    Peeked: bool = false
    PeekedOnce: bool = false

    NextFromProducer: Continuation = _
    FromConsumer: Continuation = _

    init = (body: function) => { Body = body; this; }

    Yield := (v: object) => {
        Value = v
        callcc (kp: Continuation) => {
            NextFromProducer = kp
            FromConsumer true
        }
    }

    Advance := () => {
        comes := callcc (kc: Continuation) => {
            FromConsumer = kc

            Started { NextFromProducer (); } { Started = true; Body Yield; }
            FromConsumer false
        }
        comes
    }

    # 探一格:真推进一步(生产者的副作用会发生)并把它存着,`MoveNext` 再取走
    # (类体里 `cond { … } { … }` 得写在一行 —— 跨行的话第二个块会被当成新的一段)
    HasNext := () => {
        PeekedOnce { Peeked; } { n := Advance (); Peeked = n; PeekedOnce = true; n; }
    }

    MoveNext := () => {
        PeekedOnce { PeekedOnce = false; Peeked; } { Advance (); }
    }

    by Current := property (() => { Value; }) ((v: object) => { (); })
}

impl (IMonad Generator {;})
impl (IEnumerable Generator {;})

impl (IMonad GeneratorCursor {;})
impl (IEnumerable GeneratorCursor {
    GetEnumerator = () => { instance; }
})
impl (IEnumerator GeneratorCursor {;})

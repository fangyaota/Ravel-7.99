readonly while := (c: function body: function) => {
    again := (x: int) => { x; }
    callcc (k: function) => { again = k; }

    cond : bool = c ()
    cond { body (); again 0; } { 0; }
}


using "numbers.rav"

using "monad.rav"
using "iterator.rav"
using "cached.rav"
using "generator.rav"
using "sorting.rav"
using "time.rav"
using "keys.rav"
using "seqs.rav"
using "exceptions.rav"
using "expected.rav"

readonly callcc := (f: function) => {
    System.CallCC (k: function) => {
        hs := Ex.HandlerStack

        f (Continuation ((x: object) => {
            Ex.HandlerStack = hs
            k x
        }))
    }
}

readonly try := Ex.Try
readonly throw := Ex.Throw

readonly reject := (e) => {
    throw (e);
}

readonly IsNothing := (v: object) => {
    (v : IMonad) {
        empty := true
        v.Foreach ((x: object) => { empty = false; })
        empty
    } { false; }
}

readonly NilChain := (get: function step: function) => {
    v := get ()
    (v : IMonad) { v.Map step; } {
        throw (TypeError ("'?.' 的左边得是个 monad（`IMonad`：Option / list / dict / set / string …）—— 得到 " + (string (typeof v))))
    }
}

# `a ?? b`:左边**不空就原样交回**(不拆、不挑元素),空了才跑 b。
readonly NilOr := (get: function fallback: function) => {
    v := get ()
    (v : IMonad) { v.SelfOr fallback; } {
        throw (TypeError ("'??' 的左边得是个 monad（`IMonad`：Option / list / dict / set / string …）—— 得到 " + (string (typeof v))))
    }
}

IFunctionAlt ::= interface {
    by | := default function
}

impl (IFunctionAlt function {
    by | = property (
        () => {
            (g: function) => (x) => {
                callcc (h) => {
                    instance.Prepend ((sc) => {
                        sc.Define "reject" ((v) => {
                            sc.Remove "reject"

                            h ((g.Prepend ((sc2) => { sc2.Define "reject" reject; })) x)
                        })
                    }) x
                }
            }
        }
    ) ((v: function) => { (); })
})

# 启动时第一个加载的文件(见 Interpreter.LoadPredefined):别名 + 控制流 + 把标准库几个子模块拉进来。
#
# 别名必须排在最前面 —— 后面的东西(包括子模块)都用它们。
# 子模块用 `using` 拉进来,名字都落在**全局作用域**上(和从前写在同一个文件里一样),
# 所以用户看得见的名字一个没变;`ravel "Ex"` 那种模块也照旧。

# ── 别名 ──
# 都标 readonly:这些是**语言级名字**(`int` / `print` / `true` / …),被顺手覆盖掉
# 整门语言就变了样。`=` 赋值会报「无法给只读变量赋值」;
# 真要换掉得用 `:=` 重新定义(那条路和普通变量一致,见教程的 readonly 一节)。
readonly int := System.Integer
readonly string := System.String
readonly bool := System.Bool
readonly float := System.Float
readonly bigint := System.BigInteger
readonly fraction := System.Fraction
readonly bigfraction := System.BigFraction
readonly Range := System.Range   # 区间值([1..3] / (3..5) …);语法不靠这个名字,库和用户才要
readonly char := System.Char
readonly list := System.List
readonly set := System.Set
readonly dict := System.Dict
readonly object := System.Object
readonly Ravel := System.Ravel   # 模块的类对象(`Math is Ravel`)—— 所有模块共用一个
readonly class := System.Type  # 别名:没有单独的 Class 类型
readonly interface := System.Interface  # 接口 —— 继承于 type,造出来的也是类对象
readonly function := System.Function
readonly Continuation := System.Continuation   # callcc 交出来的续延(是个函数的子类型)
readonly type := System.Type
readonly void := System.Void
readonly Any := System.Any
readonly Every := System.Every
readonly Exception := System.Exception
# 错误那一族(引擎报错时挑的就是它们,见 Runtime/BuiltinClasses.Errors.cs):
# 都挂在 Exception 下面,所以老的 `(e: Exception)` 一个都没坏,新的能按类型接。
readonly TypeError := System.TypeError
readonly NameError := System.NameError
readonly AttributeError := System.AttributeError
readonly IndexError := System.IndexError
readonly KeyError := System.KeyError
readonly ZeroDivisionError := System.ZeroDivisionError
readonly AssertionError := System.AssertionError
readonly AccessError := System.AccessError
readonly ArgumentError := System.ArgumentError
readonly ValueError := System.ValueError
readonly IoError := System.IoError
readonly RegexError := System.RegexError
readonly ValueType := System.ValueType
readonly BaseInterface := System.BaseInterface   # 所有接口的基类(`interface { … }` 的 parent)
readonly Json := System.Json          # JSON 值(包住一棵树,Extract () 才转原生)

# 用户自定义的模块搜索目录。**位置是有讲究的**:它写在别名之后 ——
# 注解里的名字就是作用域里的变量,而 `list` 要到上面几行才定义。
# (从前它在第一行,于是注解解析不得不内置一张 15 条的类型表来兜底;见 ResolveType。)
ReferencesPath: list = []

readonly print := System.WriteLine
readonly true := System.True
readonly false := System.False
readonly NaN := System.NaN
readonly Inf := System.Inf
readonly default := System.Default
readonly typeof := System.TypeOf
readonly cmd := System.Cmd        # 跑外部命令(走系统 shell),交回 {out err code}
readonly assert := System.Assert
readonly eval := System.Eval
readonly with := System.With
readonly ravel := System.RavelMod
readonly using := System.Using
readonly use := System.Use  # 在**当前作用域**里启用一个接口实现(出去就没了)
readonly impl := System.Impl  # 启用一个接口实现,**全局**(登记在全局作用域,处处生效)
readonly exit := System.Exit
readonly input := System.ReadLine
readonly unsafe := System.Unsafe
readonly currentScope := System.CurrentScope
readonly property := System.Property
# ── 控制流:用 Ravel 写,不占控制帧 ──
# 条件当值用:true/false 可调用,收两个块返回选中那个的结果
readonly if := (c: function t: function e: function) => {
    cond : bool = c ()
    cond t e
}

# callcc 写成独立语句:续延被调用时只是「这条语句完成」,不会重跑它,
# 所以 again 始终是那个续延;again 0 丢弃当前帧链跳回 callcc 之后 → 帧链不随迭代增长。
# (写成 again := callcc (k) => { k; } 的话,恢复时会重跑赋值、again 被覆盖成 0,循环建立不起来)
readonly while := (c: function body: function) => {
    again := (x: int) => { x; }
    callcc (k: function) => { again = k; }
    # 条件必须写在恢复点(callcc 那条语句)之后,否则 again 0 跳回来时不会重求,变成只判一次。
    # (它每次迭代都会在同一层作用域里**重跑**一遍 —— 那是**同一条定义语句**,所以不撞
    #  "`:=` 是定义不是覆盖"那一条;见 `Scope.Define` 里拿 `Site` 分辨的那种情形。)
    cond : bool = c ()
    cond { body (); again 0; } { 0; }
}
# ── 标准库:各自一个文件 ──
using "numbers.rav"
# monad 排在 iterator **前面**:`IEnumerable ::= interface IMonad { … }`(序列这一族也是 monad)
# 要在接口那一句上读到 IMonad,而它自己谁也不依赖。
using "monad.rav"
using "iterator.rav"
using "cached.rav"
using "generator.rav"   # `Generator f` —— 把"往外送值"的那段变成 IEnumerable
using "sorting.rav"
using "time.rav"      # `Time` / `Now` / `TimeFrom` —— 毫秒 + IComparable 那一套
using "keys.rav"
using "seqs.rav"      # `Seqs` 模块:摊平 / 切块 / 拉链 / 分组 / 计数
using "exceptions.rav"
using "expected.rav"   # `Expected` / `Expect`(Option 的兄弟:失败那半是报错)
using "match.rav"      # `match v [每对 条件/结果] 默认` —— 运算符节当条件

# ── `callcc`：库函数 ──
#
# 它在把续延交给用户之前先拍两份**控制状态**的快照:
#   ① 自己的 handler 栈(`Ex.HandlerStack` —— 它是这个库的状态,就在 Ravel 里那个 list 上);
#   ② 引擎的**模块加载状态**(`System.LoadingState` —— 哪个模块正在加载,那是引擎的家事)。
# 用户拿到的续延被调用时,先把这两份还原、再跳。于是:
#   * 用外层续延从 `try` 体里逃出去,那个 handler 跟着走掉,不会留下僵尸 handler
#     (僵尸会接住后面**没人接**的错误,而它的续延停在早被丢弃的链上);
#   * 从模块体里逃出去,这次加载算没发生,之后还能正常 `using` 那个模块。
# 这两件事从前靠帧的正常收尾来做,而续延一调就把帧链整个丢掉了。
#
# 还原那两句必须是**一条内置调用**(复制一份列表、把引擎那份换掉):别在中间用
# `while` / `foreach` / `try` —— 它们自己都要经过续延,会互相踩(实测死循环)。
#
# 它写在子模块**之后**:要用 `Ex.HandlerStack`,而 `Ex` 在 exceptions.rav 里。
readonly callcc := (f: function) => {
    System.CallCC (k: function) => {
        hs := Ex.HandlerStack.Copy ()
        ms := System.LoadingState ()
        # 交给用户的那枚用 `Continuation` 包一下 —— 类型上它就是**续延**(typeof 给
        # `Continuation`,能注解成 `Continuation` 的字段),而不是一个说不清的 lambda。
        # 调的走法没变:先进这枚 lambda(还原控制状态),再 `k x` 跳回捕获点。
        f (Continuation ((x: object) => {
            Ex.HandlerStack = hs.Copy ()
            System.RestoreLoading ms
            k x
        }))
    }
}

# `Ex` 那套 API 的小写别名(和 `print` / `using` 那批一个待遇:语言级名字,标 readonly)。
# 只能放在这儿 —— 上面那段 `ravel "Ex"` 得先把模块建出来,`ravel ""` 得先把作用域换回全局。
readonly try := Ex.Try
readonly throw := Ex.Throw

# ── 空值那三条:`.?` / `??` / `??=` 的落点 ──
#
# 词法和语法在引擎那层(`TokenType.QuestionDot` / `Coalesce` / `CoalesceEqual`,
# 解析期就地折成对下面这四条的调用),**"空"是什么意思、Option 要不要包回去**在这儿 ——
# 和 `if` / `while` / `foreach` 一个路子:控制流用 Ravel 写,引擎不掺和。
#
# 「空」**只有 `None` 一样**。`()` 不是空 —— 它是 Void 类型那个**值**,和 `0` / `""` 平起平坐;
# `Some ()` 更不是空(有个值,值是 `()`)。要"没设过"就明写 `None`:
#
#     Cache: Option = None
#     Cache ??= Some (算一次 ())

readonly IsNothing := (v: object) => {
    (v is Option) && (v.IsNone ())
}

# `a?.b c` → `NilChain (() => { a; }) (v) => { v.b c; }`
#
# 空(`None`)**原样**短路;`Some x` 拿着里面的值走完整条链,再**包回去** ——
# 所以 `u?.Name ()` 还是 Option,一路 `?.` 下去形状不变,最后用 `??` 收口。
# 别的值(普通对象、`()`、数、字符串)照常取成员,不包 —— 在 `()` 上取成员照旧是
# 「类型 Void 没有方法 x」,不会被悄悄吞掉。
readonly NilChain := (get: function step: function) => {
    v := get ()
    if { (IsNothing v); } { v; } { if { v is Option; } { Some (step (v.Value ())); } { step v; } }
}

# `a ?? b` → `NilOr (() => { a; }) (() => { b; })` —— 惰性:右边要用才跑
#
# 空就给后备,否则把值交出来(`Some x` 交 `x`,普通值交自己 —— `()` 也照交,它不是空)。
readonly NilOr := (get: function fallback: function) => {
    v := get ()
    if { (IsNothing v); } { fallback (); } { if { v is Option; } { v.Value (); } { v; } }
}

# `x ??= v` → `NilFill (() => { x; }) ((w) => { x = w; }) (() => { v; })`
#
# **空才写**:不空就一个字符都不碰(连 setter 都不调),原值原样交回。
# 只认 `None` —— `x: object = ()` 那种"打底用 ()"的字段**不会**被它当成没设过。
readonly NilFill := (get: function set: function fallback: function) => {
    v := get ()
    if { (IsNothing v); } { set (fallback ()); } { v; }
}

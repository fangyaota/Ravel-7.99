# `Terminal` —— 终端。**要显式引用**:`using "terminal.rav"`。
#
#     Terminal.Line (Terminal.Green "好了")            # 上色写一行(管道里自动不上色)
#     print (Terminal.Plain "[b]粗[/]")                # 只看渲染结果,不带颜色
#     print (Terminal.Panel ["一行" "两行"])            # 装进一个方框(宽度跟终端走)
#     Terminal.Ask "叫什么？"                           # 问一句、读一行
#     Terminal.Confirm "删掉？"                         # 是 / 否
#     Terminal.Choose "选一个" ["a" "b" "c"]            # 上下键挑
#     Terminal.Menu "------主菜单------" (Items ())     # 带搜索的菜单,交回序号
#     print (Terminal.Bar 3 10 20)                     # [######..............] 30%
#     Terminal.Rule (Terminal.Width ())                # 一条横线
#
# **标记就是 Spectre.Console 那套**(`[red]…[/]`、`[b]…[/]`、`[[` 表示一个方括号)——
# 不是新发明的一套,想查用法去查它的文档。`Terminal.Strip` 把标记剥掉,
# 要往日志、文件里写"同一条消息但没有颜色"就用它。
#
# 三条分得清的分工:
#
#   * **引擎那半边**(`Native.Terminal*`,在官方扩展里)只做两件事:把标记**渲染成一串**、
#     问终端要**尺寸**,外加三条**交互问答**。渲染那两条是**纯函数** —— 它们不往屏幕上写。
#   * **写出去是这一层的事**(`System.Write` / `WriteLine`)。这么分不只是好看:
#     Spectre 那台静态的 `AnsiConsole` 是"第一次用到时把 `Console.Out` 抓住"的,
#     从引擎那边直接写会**绕开** `Console.SetOut`(测试运行器换的就是它)。
#   * **策略在这一层**:什么时候上色(`Tty ()`)、问候语长什么样、进度条多宽。
#
# 一条**该知道的事**:上色与否这一层看 `Terminal.Tty ()` —— 那是**进程级**的
# "stdout 是不是真终端"。要确定性的输出(测试、往文件里写)用 `Terminal.Plain`,别用 `Render`。
using "native.rav"
using "enum.rav"
using "io.rav"        # 控制台那三个单例要实现 IFile

ravel "Terminal"

# ── 渲染与写 ──

# 渲染成**一串**(当前是终端就带颜色,否则只有文本)。要往屏幕上写用 `Write` / `Line`
readonly Render := (markup: object) => { Native.TerminalRender (string markup) (Tty ()); }

# **强制不上色** —— 测试、往文件/日志里写的时候用这个,结果是钉得住的
readonly Plain := (markup: object) => { Native.TerminalRender (string markup) false; }

# 把标记剥掉只留文本(和 `Plain` 的区别:那个还会渲染成终端宽度、处理折行那些)
readonly Strip := (markup: string) => { Native.TerminalStrip markup; }

readonly Write := (markup: object) => { System.Write (Render markup); (); }
readonly Line := (markup: object) => { System.WriteLine (Render markup); (); }
readonly ToErr := (markup: object) => { System.WriteLineErr (Render markup); (); }

# 把几行装进一个方框(宽度跟终端走)。交回的是**一整块标记**、末尾带换行 ——
# 要按行拿到手就自己过一遍 `System.SplitLines`。
# 行里可以带标记:方框只负责包边和补齐,每行的颜色照旧。
readonly Panel := (lines: list) => { Native.TerminalPanel lines (Tty ()); }

# ── 问终端 ──

# 输出是不是一个**真终端** —— 管道的另一头不是。决定要不要上色看它
readonly Tty := () => { Native.TerminalTty (); }

# 多少格宽。**看不见终端时给 80**(管道里问不到尺寸,而调用方多半是想按宽度折个行)
readonly Width := () => { Native.TerminalWidth (); }

# ── 交互 ──
#
# 这几条**要真的终端**:它们读键盘。接管道跑(`echo x | ravel a.rav`)时该走的是
# `System.ReadLine`,不是这儿。

readonly Ask := (prompt: string) => { Native.TerminalAsk prompt; }              # 读一行(空行也收)
readonly Confirm := (prompt: string) => { Native.TerminalConfirm prompt; }      # 是 / 否(默认是)
readonly Choose := (question: string choices: list) => { Native.TerminalChoose question choices; }

# 上面三条的"带默认值 / 带序号"那两版:
#
#     Terminal.AskDefault "选择代码文件" "temp.ravel"      # 回车就收那个默认值
#     Terminal.ConfirmDefault "开关显示执行结果吗？" false   # 默认值由调用方给
#     Terminal.Menu "------主菜单------" (Items ())         # 交回**选中的序号**
#
# `Menu` 是主菜单那种用法(带搜索、每屏 6 条、每项挂着序号),参数照着 Spectre 的
# `SelectionPrompt<int>` 定的 —— `lib/repl.rav` 那台主菜单走的就是它。
readonly AskDefault := (prompt: string dflt: string) => { Native.TerminalAskDefault prompt dflt; }
readonly ConfirmDefault := (prompt: string dflt: bool) => { Native.TerminalConfirmDefault prompt dflt; }
readonly Menu := (title: string items: list) => { Native.TerminalMenu title items; }

# ── 几条糖:交回的是**标记串** ──
#
#     Terminal.Line (Terminal.Red "错误: " + msg)
#
# 传进去的文本里的 `[` `]` 会**转义掉** —— 用户输入、异常消息里带个方括号是很正常的事,
# 不转义就被当成了标记、把整串搞坏。代价是**糖套糖不行**:`Terminal.Bold (Terminal.Red "x")`
# 里层那串会被当成字面量(`[red]x[/]` 原样显示出来)。
# 要嵌套就直接写标记 —— 那本来就是 Spectre 那套,糖只是最常用的那几个捷径:
#
#     Terminal.Line "[b][red]危险[/][/] —— 已经处理了"
#
# (要往标记里塞**动态**文本就自己过一遍 `Terminal.Escape`,和自己拼别处一个规矩。)

# **颜色收成一枚 enum** —— 从前每个颜色各写一串字面量(`Wrap "grey" s`),而标记里那个
# 名字是给 Spectre 看的:**拼错了要到渲染那一刻才知道**(它认不出来的颜色名是抛异常)。
# 收拢成一处之后名字只有一份,`grey` 还是 `gray`、`b` 还是 `bold` 这种事不会再各写各的。
#
#     Terminal.Red "错了"                    # 常用那几条直接调
#     Terminal.Wrap Terminal.Color.Red "错了"  # 要动态挑颜色时,拿一枚 `Color` 传进去
Color ::= enum {
    Red := "red"
    Green := "green"
    Yellow := "yellow"
    Blue := "blue"
    Magenta := "magenta"
    Cyan := "cyan"
    Grey := "grey"
    Bold := "b"
    Dim := "dim"
    Underline := "u"
}

readonly Wrap := (c: object s: object) => { "[" + c.Value + "]" + (Escape (string s)) + "[/]"; }
readonly Escape := (s: string) => { Native.TerminalEscape s; }

# 这几条**不用写 lambda**:`Wrap` 是柯里化的(收一枚颜色、再收文字),喂它颜色
# 就交回"还等着文字"的那一半 —— 那正好就是一条糖。写成 `(s) => { Wrap Color.Red s; }`
# 是把同一件事又说了一遍(而且十遍)。
readonly Red := Wrap Color.Red
readonly Green := Wrap Color.Green
readonly Yellow := Wrap Color.Yellow
readonly Blue := Wrap Color.Blue
readonly Magenta := Wrap Color.Magenta
readonly Cyan := Wrap Color.Cyan
readonly Grey := Wrap Color.Grey
readonly Bold := Wrap Color.Bold
readonly Dim := Wrap Color.Dim
readonly Underline := Wrap Color.Underline

# 几条"就这么写"的语义色 —— 拼 `Red` 那些是猜,这几条是**说事情**(好 / 警告 / 坏 / 提示)
readonly Good := Wrap Color.Green
readonly Warn := Wrap Color.Yellow
readonly Bad := Wrap Color.Red
readonly Hint := Wrap Color.Grey

# ── 几条纯 Ravel 的画 ──

# 一条横线(`n` 格宽)。`Terminal.Rule (Terminal.Width ())` 就是占满一行
readonly Rule := (n: int) => { ("─").Repeat n; }

# 进度条的字面:`[######......] 30%`。**交回的是普通文本,不是标记** ——
# 一条进度条本来就没什么要上色的;要颜色自己套一层(`Terminal.Green (Terminal.Bar …)`)。
# 要**原地刷新**就自己拿 `\r` 拼 —— 引擎那边不给"刷屏"这种原语,
# 因为它就是"写一串回车、再写一串"。
readonly Bar := (done: int total: int width: int) => {
    w := if { width < 4; } { 4; } { width; }
    frac := if { total <= 0; } { 0.0; } { (float done) / (float total); }
    if { frac < 0.0; } { frac = 0.0; } { 0; }
    if { frac > 1.0; } { frac = 1.0; } { 0; }        # 超额也算满(990% 那种数字没人想看见)
    n := (int (frac * (float w)))
    pct := (int (frac * 100.0))
    ("[" + (("#").Repeat n)) + ((".").Repeat (w - n)) + ("] " + (string pct) + "%");
}

# 原地刷一条进度 —— 行尾**不换行**,下次接着盖。收工那一下自己补个换行
readonly Tick := (done: int total: int) => {
    w := (Width ()) - 8
    System.Write ("\r" + (Bar done total w))
    ();
}

# ── 控制台也是文件 ──
# `stdout` / `stderr` / `stdin` 三个**单例值**,实现 `IFile` —— 于是对着接口写的代码直接能用:
# 把文件倒进终端 `Io.CopyTo f Terminal.Stdout`,把输入倒进文件 `Io.CopyTo Terminal.Stdin f`。
# 只写的那两个读不了、只读的那个写不了(报错说人话,和"只读的 zip 条目"是同一种取舍)。
ConsoleOut ::= class {
    Label: string = "stdout"
    ToErr: bool = false

    init = (label: string toErr: bool) => { Label = label; ToErr = toErr; this; }

    Name := () => { Label; }
    Exists := () => { true; }
    IsDir := () => { false; }
    Size := () => { throw (Exception ("控制台没有大小：" + Label)); }
    Read := () => { throw (Exception ("这是只写的（" + Label + "），读不了")); }
    Delete := () => { throw (Exception ("控制台删不掉：" + Label)); }
    Write := (text: string) => {
        if { ToErr; } { System.WriteErr text; } { System.Write text; }
        ();
    }
    Append := (text: string) => { Write text; }
}

ConsoleIn ::= class {
    Name := () => { "stdin"; }
    Exists := () => { true; }
    IsDir := () => { false; }
    Size := () => { throw (Exception "控制台没有大小：stdin"); }
    Delete := () => { throw (Exception "控制台删不掉：stdin"); }
    Write := (text: string) => { throw (Exception "这是只读的（stdin），写不了"); }
    Append := (text: string) => { throw (Exception "这是只读的（stdin），写不了"); }

    # `Read ()` 是**读到 EOF**(终端上要 Ctrl+Z / Ctrl+D 收);想读一行用 `ReadLine ()`(就是 `input`)
    Read := () => { System.ReadAllInput (); }
    ReadLine := () => { System.ReadLine (); }
    Lines := () => { System.SplitLines (System.ReadAllInput ()); }
}

impl (IFile ConsoleOut {
    ()
})
impl (IFile ConsoleIn {
    ()
})

readonly Stdout := ConsoleOut "stdout" false
readonly Stderr := ConsoleOut "stderr" true
readonly Stdin := ConsoleIn ()

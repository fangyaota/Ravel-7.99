# Monad 这一族:**形状**(`IMonad`)+ 一个实例 `Option`(要么包着一个值,要么什么都没有)。
# 由 predefined.rav 加载(名字落在全局作用域);`IoMonad.Action`(见 io.rav)是这一族的另一个实例。
#
# 「Monad 的形状」就是能进 `do { … }` 的东西 —— `do` 把 `:<` 脱糖成 `.Bind`,所以形状是
# **Map + Bind 两条槽**。写成接口之后:`x is IMonad` 能问、注解 `(m: IMonad)` 收得下、
# `IMonad.GetImplementors ()` 看得见有哪些类型在这一族里。
#
# 注意它只管"形状":`Return` 那种东西是**每个 monad 各自的构造子**(这里叫 `Some`,
# `IoMonad` 那边叫 `IoMonad.Return`),接口表达不了"某个类型有个构造子",也没必要。
IMonad ::= interface {
    by Map : function = default
    by Bind : function = default
}


# `Some 5` 有值,`None` 没有。Map / Bind / Where 对 None 一律原样放过(短路),
# 所以一长串操作里只要有一环没有值,后面全不用算。
#
# 两种情况的**类型相同**(都是 Option),`x is Option` 分不出来 —— 要问有没有值就用
# `IsSome ()`。这是有意的:能拿到值的地方才该解包,`Value ()` 在 None 上当场报错。
Option ::= class {
    Has: bool = false                    # 有没有包着值
    Inner: object = ()                   # 包着的那个值(None 时是 ())

    IsSome := () => { Has; }
    IsNone := () => { !Has; }

    # 解包。没有值就是**用错了**,当场报错,不拿 () 糊弄
    Value := () => {
        assert Has ("Option.Value: 这个 Option 里没有值（用 IsSome 先问，或改用 ValueOr）")
        Inner
    }

    # 解包,没有值就给个默认
    ValueOr := (d: object) => { if { Has; } { Inner; } { d; } }
    # 没有值就换成另一个
    OrElse := (other: Option) => { if { Has; } { this; } { other; } }

    # 映射:有值就包着装换过的值,没值原样(None 里那个函数根本不会被调)
    Map := (f: function) => { if { Has; } { Some (f Inner); } { this; } }
    # 绑定:有值就把 f 的结果**摊平**接上(f 得自己回一个 Option),没值原样
    Bind := (f: function) => { if { Has; } { f Inner; } { this; } }
    # 过滤:不满足条件就变成 None
    Where := (p: function) => { if { Has && p Inner; } { this; } { None; } }
    # 有值且满足条件 -> true
    Exists := (p: function) => { Has && p Inner; }

    init := (has: bool v: object) => {
        Has = has
        Inner = v
        this
    }
}

# 两个构造子:`Some v` 造一个带值的,`None` 是**一个值**(单例,大家共用它)。
# 注意 `None` 不是类型而是值,所以不用写 `None ()`;`Some 5` 那种写法里
# `Some` 是个普通函数(柯里化的,喂一个参数就得到 Option)。
readonly Some := (v: object) => { Option true v; }
readonly None := Option false ()

# 这个 `Option` 在 IMonad 这一族里。实现体是空的 —— 它自己那两条 Map / Bind 就是形状本身
# (`TraitSlot` 查到自己那层就先说话),这里只是**登记**一下,让 `is` / 注解 / 查询都认它。
impl (IMonad Option {
    ()
})

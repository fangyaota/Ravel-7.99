# Monad 这一族:**形状**(`IMonad`)+ 一个实例 `Option`(要么包着一个值,要么什么都没有)。
# 由 predefined.rav 加载(名字落在全局作用域);`IoMonad.Action`(见 io.rav)是这一族的另一个实例。
#
# 「Monad 的形状」就是能进 `do { … }` 的东西 —— `do` 把 `:<` 脱糖成 `.Bind`,所以形状是
# **Map + Bind 两条槽**。写成接口之后:`x is IMonad` 能问、注解 `(m: IMonad)` 收得下、
# `IMonad.GetImplementors ()` 看得见有哪些类型在这一族里。
#
# 注意它只管"形状":`Return` 那种东西是**每个 monad 各自的构造子**(这里叫 `Some`,
# `IoMonad` 那边叫 `IoMonad.Return`),接口表达不了"某个类型有个构造子",也没必要。
# 形状本身 —— 所以它俩是 `internal`:实现填进来之后,外面**读得到、写不进去**
# (只读是这里要的:换实现得回类体里改,不该从实例上顺手覆盖掉)。
# 用 `=` 覆盖它们的子接口 / 实现体**继承**这个修饰符(`=` 不清 attrs),不必再写一遍。
IMonad ::= interface {
    # **这两条给了默认实现** —— "逐个映射"和"摊平"。
    #
    # 有默认是因为**序列那一族**也要走这条路:`IEnumerable` 只是**要求** `IMonad`
    # (要求不给槽),所以每个 `impl (IEnumerable X { … })` 都得配一条
    # `impl (IMonad X { () })` —— 那条 `()` 里没有体,槽就落在这儿。
    #
    # 真正的 monad(下面的 `Option`、`io.rav` 的 `Action`、`expected.rav` 的 `Expected`、
    # `tasks.rav` 的 `TaskBase`)各自在**类体**里写自己的那对 —— **类实现大于接口实现**,
    # 自己那条先命中,这儿的默认碰不到它们。
    #
    # 体里那个 `Generator` 在这支文件里还没定义(monad 排在 iterator 前面),没关系:
    # 体是**调用时**才解析名字的,那会儿它在作用域里了。
    internal Map := (f: function) => {
        Generator (y: function) => {
            foreach instance (x: object) => { y (f x); }
        }
    }
    internal Bind := (f: function) => {
        Generator (y: function) => {
            foreach instance (x: object) => {
                foreach (f x) (v: object) => { y v; }
            }
        }
    }
}


# `Some 5` 有值,`None` 没有。Map / Bind / Where 对 None 一律原样放过(短路),
# 所以一长串操作里只要有一环没有值,后面全不用算。
#
# 两种情况的**类型相同**(都是 Option),`x is Option` 分不出来 —— 要问有没有值就用
# `IsSome ()`。这是有意的:能拿到值的地方才该解包,`Value ()` 在 None 上当场报错。
Option ::= class {
    Has: bool = false                    # 有没有包着值
    Inner: object = ()                   # 包着的那个值(None 时是 ())

    IsSome := () => { Has; }
    IsNone := () => { !Has; }

    # 解包。没有值就是**用错了**,当场报错,不拿 () 糊弄
    Value := () => {
        Has { Inner; } { throw (ValueError "Option.Value: 这个 Option 里没有值（用 IsSome 先问，或改用 ValueOr）"); }
    }

    # 解包,没有值就给个默认
    ValueOr := (d: object) => { Has { Inner; } { d; } }
    # 没有值就换成另一个
    OrElse := (other: Option) => { Has { this; } { other; } }

    # 映射:有值就包着装换过的值,没值原样(None 里那个函数根本不会被调)
    Map := (f: function) => { Has { Some (f Inner); } { this; } }
    # 绑定:有值就把 f 的结果**摊平**接上(f 得自己回一个 Option),没值原样
    Bind := (f: function) => { Has { f Inner; } { this; } }
    # 过滤:不满足条件就变成 None
    Where := (p: function) => { Has && p Inner { this; } { None; } }
    # 有值且满足条件 -> true
    Exists := (p: function) => { Has && p Inner; }

    # 它**也是 `IEnumerable`**(见 lib/iterator.rav 末尾那条 `impl`):有值就是"只含它的一串",
    # 没值就是"空的一串" —— 于是 `foreach (Some 5) …` 走一次、`Seqs.Gather (None)` 是 `[]`、
    # `(Some 5).Count ()` 是 1。整串方法(ToList / Take / First / Fold …)由 `IEnumerable` 的
    # **默认实现**给,不必在这儿再写一份;反过来那一头是 `xs.TryFirst ()` / `xs.TryFind p`。
    #
    # 注意 `Map` / `Bind` / `Where` 仍是**上面那三条**(类链上的先命中)—— 它们在这一族里
    # 的语义是"包着/摊平",不是"变一串":`(Some 5).Map f` 交回的还得是 Option。
    #
    # `Count` / `At` 同理写在类里:它们从前是 `IEnumerable` 接口体的默认实现(走一遍算),
    # 现在那两条归 `IList`(真按下标读的),而 `Option` **不是** `IList` —— 没有下标,
    # 只是"0 个或 1 个"。措辞和从前一字不差。
    Count := () => { Has { 1; } { 0; } }
    At := (k: int) => {
        (Has && (k == 0)) { Inner; } { throw (IndexError ("At: 元素不够（一共 " + (string (Count ())) + " 个）")); }
    }

    init = (has: bool v: object) => {
        Has = has
        Inner = v
        this
    }
}

# 两个构造子:`Some v` 造一个带值的,`None` 是**一个值**(单例,大家共用它)。
# 注意 `None` 不是类型而是值,所以不用写 `None ()`;`Some 5` 那种写法里
# `Some` 是个普通函数(柯里化的,喂一个参数就得到 Option)。
readonly Some := (v: object) => { Option true v; }
readonly None := Option false ()

# 这个 `Option` 在 IMonad 这一族里。实现体是空的 —— 它自己那两条 Map / Bind 就是形状本身
# (`TraitSlot` 查到自己那层就先说话),这里只是**登记**一下,让 `is` / 注解 / 查询都认它。
impl (IMonad Option default)

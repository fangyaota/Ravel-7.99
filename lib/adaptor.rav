# **`Adaptor`** —— 从 .NET 反射里**生成适配层的 C#**，并且（要的话）就地编成 dll。
#
#     using "adaptor.rav"
#
#     src := Adaptor.Cs "System.Math" "NMath" ["Max" "Min" "Sqrt"]   # 静态那半 → 模块
#     src := Adaptor.CsClass "System.Random" "Rnd" "Random" (Adaptor.AllOfClass "System.Random")
#                                                                    # ↑ 实例那半 → 类
#     Adaptor.Write src "Ravel.Generated/NMath.cs"
#     Adaptor.Build src "Ravel.Generated/NMath.cs" "out/plugins/NMath.dll"
#
# **两半是两个形状**（静态的生成模块函数，体里 `System.Math.Max (…)`；实例的生成类方法，
# 体里 `self` 先脱壳），所以是两套函数，不是一个开关。`Write` / `Build` 收的是**源码** ——
# 于是「哪一半」和「写 / 写+编」两件事**正交**地拼，加形状不用加分支。
#
# 命令行那个壳在 `tools/mkadaptor.rav`。
#
# **要显式 `using`** —— 不进 `predefined.rav`：它拖着 `Ravel.Reflect`，编 dll 那条
# 还拖着 Roslyn（`Ravel.Compile`，十几 MB）。没人用的时候一分别花。
#
# ── 三条规矩 ──
#
# 1. **重载在这里就挑定了。** 同名、静态、参数与返回值都在映射表里的，按
#    「要数组的排后面 → 参数少的在前 → 丢信息少的在前 → 签名」排一下取第一个。
#    这是相对运行期反射（`Reflect.Call`）的**主要收益**：那边是挨个试，这边是定死。
# 2. **挑不中就说，不猜。** 映射表里没有的类型**明说跳过**，把筛掉的个数也写出来。
# 3. **产物是脚手架。** 生成器注定填不满（泛型类型实参、委托、`object`），
#    所以写出来的 `.cs` 是给人接手用的，不是构建产物。

ravel "Adaptor"

using "plugins/Ravel.Reflect.dll"
using "plugins/Ravel.Compile.dll"

# ═══ 映射表 ═══
#
# 每一格三件事：**取值**（`RuntimeValue` → 本地）、**造值**（本地 → `RuntimeValue`）、
# **排位**（重载挑哪个用）。
#
# **排位是必须的，不是锦上添花。** 光按签名排序的话 `Double` 排在 `Int32` 前面
# （`D` < `I`），`Math.Max` 会挑中 `(double, double) -> double` —— 于是
# `NMath.Max 3 7` 交回一个 `real`，把已经能用的适配层**改坏**。

# **标量排 0~6、数组排 10~15** —— 两段是有意思的：挑重载时"先要标量的那个"赢
# （见 `RankKey` 里的 `arrCount`）。Ravel 侧写数组得先造个 `list`，能避开就避开：
# `String.Concat "a" "b"` 要挑 `(string, string)`，不是 `(string[])`。
#
# **一条模式一支** —— 不认就交给 `|` 试下一支，收尾那支兜底。三张表一个形状：
# 第一格是**字面量模式**（拿 `tn` 去比，比不中这一支整个不收），后面几格才是参数。
#
# 两条写法上的事：
#
# * 第一条得跟在 `:=` 那行上 —— `:=` 后面直接换行，解析器说「需要表达式」。
# * 表里全是常量，所以用 `~`（`~x` 就是 `{x;}`）—— 一张表全是短常量时才好看。
#   下面两张表是**字符串拼出来的**，`~` 只吃一个原子、得给整个表达式套括号，
#   反而更吵，所以那两张照旧写 `{ … ; }`。
readonly private RankOf := "Int32"     => ~0
                         | "Int64"     => ~1
                         | "String"    => ~2
                         | "Boolean"   => ~3
                         | "Char"      => ~4
                         | "Double"    => ~5
                         | "Single"    => ~6
                         | "String[]"  => ~10
                         | "Char[]"    => ~11
                         | "Int32[]"   => ~12
                         | "Int64[]"   => ~13
                         | "Boolean[]" => ~14
                         | "Double[]"  => ~15
                         # **`object` 排在标量/数组后面、认不出的前面**（50）—— 它转得动
                         # （走桥），但**别的重载只要能用就该赢**：`String.Concat "a" "b"`
                         # 该挑 `(string, string)` 而不是 `(object, object)`。它也照样
                         # 算进 `arrCount` 那一段（见 `RankKey`），于是"要 object 的"
                         # 和"要数组的"一样往后站。
                         | "Object"    => ~50
                         | (_)         => ~99          # 99 = 映射表里没有

# **取值**：`RuntimeValue` → 本地值。`e` 是实参名、`what` 是报错时说的那句话。
#
# 两条特别的：`Single` 那个重载要的是 `float`，而 `Num` 交回 `double` —— C# 不会自己缩，
# 所以自己加一句强转；数组那几格走 `PluginKit` 的 `Strs` / `Ints`…（把 Ravel 的 `list`
# 逐个换掉，错了说清是**第几个**元素）。
readonly private GetterOf := ("Int32" e: string what: string)     => { "PluginKit.Int (" + e + ", \"" + what + "\")"; }
                           | ("Int64" e: string what: string)     => { "PluginKit.Long (" + e + ", \"" + what + "\")"; }
                           | ("String" e: string what: string)    => { "PluginKit.Text (" + e + ", \"" + what + "\").Value"; }
                           | ("Boolean" e: string what: string)   => { "PluginKit.Bool (" + e + ", \"" + what + "\")"; }
                           | ("Char" e: string what: string)      => { "PluginKit.Char (" + e + ", \"" + what + "\")"; }
                           | ("Double" e: string what: string)    => { "PluginKit.Num (" + e + ", \"" + what + "\")"; }
                           | ("Single" e: string what: string)    => { "(float)PluginKit.Num (" + e + ", \"" + what + "\")"; }
                           | ("String[]" e: string what: string)  => { "PluginKit.Strs (" + e + ", \"" + what + "\")"; }
                           | ("Char[]" e: string what: string)    => { "PluginKit.Chars (" + e + ", \"" + what + "\")"; }
                           | ("Int32[]" e: string what: string)   => { "PluginKit.Ints (" + e + ", \"" + what + "\")"; }
                           | ("Int64[]" e: string what: string)   => { "PluginKit.Longs (" + e + ", \"" + what + "\")"; }
                           | ("Boolean[]" e: string what: string) => { "PluginKit.Bools (" + e + ", \"" + what + "\")"; }
                           | ("Double[]" e: string what: string)  => { "PluginKit.Reals (" + e + ", \"" + what + "\")"; }
                           # **`object` 参数** —— 交给 `PluginKit.ToNet`（就是那座桥）：认识的化成 .NET 值、
    # `list` 化 `object[]`、`DotNetObject` 脱壳。转不过去的那一支（**Ravel 函数**）
    # 照样抛 —— 那是引擎里"原生闭包调不了 Ravel 函数"那条硬边界，谁来了都一样。
    | ("Object" e: string what: string)    => { "PluginKit.ToNet (" + e + ")"; }
    | (_ e: string what: string)           => { "?"; }        # 哨兵：不支持

# **造值**：本地值 → `RuntimeValue`。`Int64` 那一格走 `PluginKit.Narrow` —— `long`
# 装得下就给 `int`、装不下升 `bigint`，别自己 `(int)` 硬转（静默回绕）。
# `Single` → `RealVal` 是隐式加宽，安全。
readonly private MakerOf := ("Int32" e: string)   => { "IntVal.Of (" + e + ")"; }
                          | ("Int64" e: string)   => { "PluginKit.Narrow (" + e + ")"; }
                          | ("String" e: string)  => { "new StringVal (" + e + ")"; }
                          | ("Boolean" e: string) => { "new BoolVal (" + e + ")"; }
                          | ("Char" e: string)    => { "new CharVal (" + e + ")"; }
                          | ("Double" e: string)  => { "new RealVal (" + e + ")"; }
                          | ("Single" e: string)  => { "new RealVal (" + e + ")"; }
                          | ("Void" e: string)    => { "PluginKit.Void"; }
                          # 返回值是 `object` 的那种（`Activator.CreateInstance` 之类）——
                          # 交回一个 `DotNetObject`，和"反射回来的一律 DotNetObject"一个口径。
                          | ("Object" e: string)  => { "new DotNetVal (" + e + ")"; }
                          | (_ e: string)         => { "?"; }

# `Known` = 映射表里有没有这一型。`InOk` 是"能不能当实参收下"，
# `OutOk` 多认一个 `void`（只有返回值才可能是它）。
readonly private Known  := (tn: string) => { (RankOf tn) < 90; }
readonly private InOk   := (tn: string) => { Known tn; }
readonly private OutOk  := (tn: string) => { (Known tn) || (tn == "Void"); }

# ═══ 反射：把 `MethodInfo` 拆成签名 ═══

readonly private NameOf   := (m: object) => { Reflect.Unwrap (Reflect.Call m "Name" []); }
readonly private StaticOf := (m: object) => { Reflect.Unwrap (Reflect.Call m "IsStatic" []); }
readonly private RetOf    := (m: object) => {
    Reflect.Unwrap (Reflect.Call (Reflect.Call m "ReturnType" []) "Name" []);
}
readonly private ParamsOf := (m: object) => {
    ps := Reflect.Unwrap (Reflect.Call m "GetParameters" [])
    ps.Map (p: object) => {
        Reflect.Unwrap (Reflect.Call (Reflect.Call p "ParameterType" []) "Name" []);
    }
}

# `x0 x1 x2 …`
readonly private Names := (n: int) => {
    i := 0
    out := []
    while { i < n; } {
        out.Add ("x" + (string i))
        i += 1
    }
    out
}

# 排位键里的数字要**定宽**：字符串排序里 `"10" < "2"`，不定宽的话三个参数的
# `(int,int,int)` 会排到 `(real,real)` 前面去。两段式：`00` `01` … `99`。
readonly private Pad2 := (n: int) => { n < 10 { "0" + (string n); } { string n; } }

# 一个方法的重载排位键。**四段，先后是有讲究的**：
#
#   1. `arrCount` —— 要数组的排后面。Ravel 侧写数组得先造个 `list`，能避开就避开：
#      `String.Concat "a" "b"` 该挑 `(string, string)`，不是 `(string[])`
#      （少了这一段的话，`(string[])` 只有 1 个参数、按下面第 2 段会赢）。
#      **`99`（认不出）也算在"要排后面"里** —— 它本来就是最差的那一档。
#   2. 参数个数少 —— `Math.Round (double)` 赢 `Math.Round (double, int)`。
#   3. 逐个比排位（`00` `01` … `99`，**每个都定宽**）—— "丢信息最少"，`int` 赢 `real`。
#   4. 签名兜底 —— 保证**确定性**（反射给的先后没有保证，引擎自己那趟也为此排过序）。
#
# **第 3 段别改成"排位之和"。** 加出来的数位数不一样，`Pad2` 顶不住三位：
# 字符串比较里 `"101" < "12"` —— 于是 `String.Join` 会挑中 `(String, IEnumerable)`
# （和 99+2=101）而不是能映射的 `(String, String[])`（2+10=12），把它判成"跳过"。
# 逐个定宽比就没这个毛病（`"0299"` 输给 `"0210"`，对）。
readonly private RankKey := (m: object) => {
    ps := ParamsOf m
    ranks := ps.Map (t: string) => { RankOf t; }

    arrCount := ranks.Fold 0 ((acc: int r: int) => { (r >= 10) { acc + 1; } { acc; } })
    arrStr := Pad2 arrCount
    nStr := Pad2 (ranks.Count ())
    rsStr := (ranks.Map (r: int) => { Pad2 r; }).Join ""
    retStr := Pad2 (RankOf (RetOf m))
    sig := ps.Join ","

    arrStr + "|" + nStr + "|" + rsStr + "|" + retStr + "|" + sig;
}

# ═══ 生成 ═══
#
# **当心"实参吃运算符"**：`a.Join x + y` 是 `a.Join (x + y)`，不是 `(a.Join x) + y`。
# 凡是方法调用的结果要接着 `+` 的，要么把整个调用括起来（`(a.Join x) + y`），
# 要么让它单独占一句。踩过一次，症状是字符串拼到一半、剩下的元素掉到末尾。

# 返回值那半 → 一个 **`Func<RuntimeValue>` 的 lambda 体**。
#
# **`void` 的不能走 `MakerOf`** —— `MakerOf "Void"` 交回的是 `PluginKit.Void`，
# 它不知道还有个调用要发出去；照那个拼出来是 `() => PluginKit.Void`：
# **方法根本没被调**，而且安安静静。所以 `void` 单开一条，写成块（先调、再交回）。
# 这条是写实例那半时才照出来的 —— 静态那半一直没生成过 void 的方法
# （`System.Math` / `System.String` 上就没有），所以一直没露头。
# **调用必须发出去，然后交回一个值。** `Wrapped` 管"交回的就是调用的结果"；
# 交回别的（`void`、或者 chain 那种 `self`）就得走这一格 —— 写成块：先调、再交回。
#
# **漏了这一步就是"调了等于没调"**，而且安安静静：`() => self` 看着人畜无害，
# 编译也过，`sb.Append "x"` 跑完 `sb` 里什么都没有。这一轮在 `void` 和 `self`
# 两处各犯了一次，所以提出来一个名字 —— 以后见着"不是交回调用结果"就往这儿想。
readonly private CallThen := (call: string value: string) => {
    # `call` **不能带外层括号** —— C# 里 `(f ());` 不是合法语句表达式（CS0201），
    # 而这一支正是把它当语句使的。`Wrapped` 那条不用管：`MakerOf` 的模板自己会
    # 把表达式括起来造值。
    "() => { " + call + "; return " + value + "; }";
}

readonly private Wrapped := (rt: string body: string) => {
    rt == "Void" { CallThen body "PluginKit.Void"; } {
        mk := MakerOf rt body
        mk == "?" { "?"; } { "() => " + mk; }
    }
}

readonly private EmitOne := (m: object mod: string full: string) => {
    nm := NameOf m
    ps := ParamsOf m
    names := Names (ps.Count ())

    i := 0
    gets := []
    ok := true
    while { i < (ps.Count ()); } {
        e := names.At i
        label := mod + "." + nm + " 的第 " + (string (i + 1)) + " 个实参"
        g := GetterOf (ps.At i) e label
        g == "?" { ok = false; }
        gets.Add g
        i += 1
    }

    # **每段单独算。** 串在一条 `+` 链里写，`.Join x` 后面那些 `+ …` 会被当成 `Join` 的实参。
    decls := names.Map (a: string) => { "RuntimeValue " + a; }
    decl := decls.Join (", ")
    args := gets.Join (", ")
    lam := Wrapped (RetOf m) (full + "." + nm + " (" + args + ")")
    lam == "?" { ok = false; }

    # **必须兜。** 引擎里那条老规矩是"别让 C# 异常漏到顶层"—— 漏出去会绕过 Ravel 的
    # `try`，一路打到"解释器内部错误"（`PluginKit.Guarded` 就是把 IO / 权限 / 参数 /
    # 溢出…那几族翻成 Ravel 错误的那个口子）。不兜的话，被调方一句
    # `ArgumentException` 用户接都接不住。实测踩过（`Math.Clamp 1 5 3`）。
    guarded := "PluginKit.Guarded (\"" + mod + "." + nm + "\", " + lam + ")"

    ok {
        one := "    [RavelFn(\"" + nm + "\")]"
        one = one + "\n    public static RuntimeValue " + nm + " (" + decl + ")"
        one = one + "\n        => " + guarded + ";"
        one + "\n"
    } {
        # **分开两句**：`(ParamsOf m).Join "," + " -> " + (RetOf m)` 里，
        # `Join` 的实参会一路吃到行尾 —— 分隔符成了 `", -> ValueTuple`2"`，
        # 拼出来的签名是坏的（实测踩过，症状是"参数粘连在返回类型上"）。
        ps := (ParamsOf m).Join ","
        sign := ps + " -> " + (RetOf m)
        "    // 跳过 " + nm + "：签名 " + sign + " 里有映射表没有的类型\n"
    }
}

# 一个方法能不能照这张映射表生成：参数和返回值都认得出来。
# **不含"是不是静态"** —— 那是调用方先筛掉的事（见 `EmitMember`）。
readonly private Usable := (m: object) => {
    ps := ParamsOf m
    (ps.All (t: string) => { InOk t; }) { OutOk (RetOf m); } { false; }
}

# 一个成员名 → 一段 C#（挑不中就一段注释）。
#
# **只挑静态方法。** 生成的函数体是 `System.String.Join (…)` 那个形状 —— 名字前面
# 顶的是**类型**，所以只有静态的才对得上。漏了这一筛的后果很别扭：`Substring` 那种
# 实例方法会被照静态生成出来，而生成器**报的是"写好了"**，要到 C# 编译那一刻才
# 冒出一句 CS0120「需要对象引用」—— 错在了跟这件事无关的地方（实测踩过）。
#
# 排位键同时也担着"确定性"：反射给的先后没有保证（引擎自己那趟也为此排过序）。
readonly private EmitMember := (all: list w: string mod: string full: string) => {
    same := all.Where (m: object) => { (NameOf m) == w; }
    cands := same.Where (m: object) => { StaticOf m; }
    ranked := cands.SortBy (m: object) => { RankKey m; }

    nSame := string (same.Count ())
    nSt   := string (cands.Count ())

    ranked.IsEmpty () {
        "    // 跳过 " + w + "：没有静态重载（同名方法 " + nSame + " 个，静态 0 个）\n"
    } {
        best := ranked.First ()
        Usable best {
            EmitOne best mod full
        } {
            # 同 `EmitOne` 那条：`Join` 的实参吃运算符，先 `Join` 出来再拼。
            ps := (ParamsOf best).Join ","
            sign := ps + " -> " + (RetOf best)
            "    // 跳过 " + w + "：挑中的那个签名是 " + sign
            + "，里面有映射表没有的类型（同名 " + nSame + " 个 / 静态 " + nSt + " 个）\n"
        }
    }
}

# ═══ 生成（**实例**那半）═══
#
# **两个形状，别合并**：静态那半生成**模块函数**（`[RavelFn]`，体里是
# `System.Math.Max (…)`）；实例这半生成**类方法**（`[ClassMethod]`，体里要先
# `Me (self)` 脱壳）。生成的类长这样：
#
#     [RavelModule("NSb")] [RavelClass("StringBuilder")]
#     internal static class StringBuilderAdaptor
#     {
#         private static System.Text.StringBuilder Me (RuntimeValue self)
#             => (System.Text.StringBuilder)((DotNetVal)self).Value;   // ← 脱壳那一格
#
#         [ClassCtor]  public static RuntimeValue New (RuntimeValue x0) => …;
#         [ClassMethod("Append")] public static RuntimeValue Append (RuntimeValue self, RuntimeValue x0) => …;
#     }
#
# `Me` 是 `private static` —— 装配那边只认挂了 `[ClassMethod]` / `[ClassCtor]` 的，
# 没挂的扫不到 ✓。

# 实例方法能不能生成。**比静态那半松一格**：返回值是**这个类自己**也算过得去
# （`StringBuilder.Append` 那种 chain 的 —— 交回 `self`，见 `EmitClassOne`）。
# 少了这一格的话 `Append` / `AppendLine` / `AppendJoin` 全被判成"映射表里没有"，
# 而其实它们正是这个类最常用的那几个。
readonly private UsableClass := (m: object selfName: string) => {
    ps := ParamsOf m
    (ps.All (t: string) => { InOk t; }) {
        (OutOk (RetOf m)) || ((RetOf m) == selfName);
    } { false; }
}

# 一个构造器 → `[ClassCtor]`。**`ConstructorInfo` 没有 `ReturnType`**，
# 所以排位键得单写一个（`RankKey` 里要读 `RetOf`）。
readonly private CtorKey := (c: object) => {
    ps := ParamsOf c
    ranks := ps.Map (t: string) => { RankOf t; }
    arrCount := ranks.Fold 0 ((acc: int r: int) => { (r >= 10) { acc + 1; } { acc; } })
    arrStr := Pad2 arrCount
    nStr := Pad2 (ranks.Count ())
    rsStr := (ranks.Map (r: int) => { Pad2 r; }).Join ""
    sig := ps.Join ","
    arrStr + "|" + nStr + "|" + rsStr + "|" + sig;
}

# **`[ClassCtor]` 只有一格实参。** 引擎那个特性的契约是
# `static RuntimeValue New (RuntimeValue arg)`，**不给实参时收到的是 `()`**
# （见 `Runtime/Builtins/ClassRegistry.cs` 上那条注释）—— 写成 `New ()` 这种零参数，
# 运行期会当场 `TargetParameterCountException: Parameter count mismatch`（踩过）。
#
# 于是按 .NET 构造器的参数个数分三档：
#
#   * **0 个** → `New (arg)` 收下不用（Ravel 那边就是 `类 ()`）
#   * **1 个** → `arg` 就是那个参数
#   * **2 个以上** → **生成不了**，明说：那一格递不出两个实参，得自己补一个
#     （收个 `list` 再拆也行，那是人的决定，不是生成器该猜的）
readonly private EmitCtor := (c: object mod: string net: string cls: string) => {
    ps := ParamsOf c
    n := ps.Count ()

    # **包成自己那个类**，不是泛泛的 `DotNetObject` —— 不然 `sb.Append "x"` 报
    # 「类型 'DotNetObject' 没有方法 'Append'」：值是 `DotNetObject`、方法挂在
    # `StringBuilder` 上，而成员查找沿**值自己的类**往上走（实测踩过）。
    # `PluginKit.ClassOf` 按名字拿类对象，那个名字就是 `[RavelClass("…")]` 上那个。
    # **不带 `;`** —— 0 参数那支是三元表达式，分号得等 `:` 那一半走完才落
    # （先带上就成了 `…)); : throw …`，CS1003）。
    tail := ", PluginKit.ClassOf (\"" + cls + "\"))"

    n > 1 {
        "    // 跳过构造器：它要 " + (string n) + " 个参数，而 `[ClassCtor]` 那格"
        + "只有一格实参（Ravel 那边 `类 a` 递一个）—— 要它就自己补一个收 `list` 再拆的\n"
    } {
        n == 0 {
            # **别把实参悄悄咽了**：`[ClassCtor]` 那一格总会收到点东西（不给就是 `()`），
            # 而 0 参数的 .NET 构造器用不上它。不拦的话 `类 42` 看着像"用 42 造一个"，
            # 其实 42 被丢了 —— 正是这门语言最恨的那种静默。
            "    [ClassCtor]\n    public static RuntimeValue New (RuntimeValue arg)"
            + "\n        => arg is VoidVal"
            + "\n            ? new DotNetVal (new " + net + " ()" + tail
            + "\n            : throw PluginKit.Fail (\""
            + net + " 的 .NET 构造器是 0 个参数的 —— 像 `类 ()` 那样调，别给实参\", ErrorKind.Argument);\n"
        } {
            ty := ps.First ()
            g := GetterOf ty "arg" (mod + " 的构造器参数")
            g == "?" {
                "    // 跳过构造器：那个参数是 " + ty + "，映射表里没有\n"
            } {
                "    [ClassCtor]\n    public static RuntimeValue New (RuntimeValue arg)"
                + "\n        => new DotNetVal (new " + net + " (" + g + ")" + tail + ";\n"
            }
        }
    }
}

readonly private EmitClassOne := (m: object mod: string net: string selfName: string) => {
    nm := NameOf m
    ps := ParamsOf m
    names := Names (ps.Count ())

    i := 0
    gets := []
    ok := true
    while { i < (ps.Count ()); } {
        e := names.At i
        label := mod + "." + nm + " 的第 " + (string (i + 1)) + " 个实参"
        g := GetterOf (ps.At i) e label
        g == "?" { ok = false; }
        gets.Add g
        i += 1
    }

    decls := names.Map (a: string) => { "RuntimeValue " + a; }
    selfArgs := (decls.Map (a: string) => { ", " + a; }).Join ""
    args := gets.Join ", "

    # 交回**自己**的那种（`StringBuilder.Append` 这类 chain 的）—— 交回 `self`，
    # 链式才成立；每个都新包一个 `DotNetVal` 的话，每步换个壳（而且 `sb` 和
    # `sb.Append "x"` 会变成两个不同的对象，看着一样其实不是）。
    rt := RetOf m
    call := "Me (self)." + nm + " (" + args + ")"
    lam := rt == selfName { CallThen call "self"; } { Wrapped rt call; }
    lam == "?" { ok = false; }

    ok {
        one := "    [ClassMethod(\"" + nm + "\")]"
        one = one + "\n    public static RuntimeValue " + nm + " (RuntimeValue self" + selfArgs + ")"
        one = one + "\n        => PluginKit.Guarded (\"" + mod + "." + nm + "\", " + lam + ");"
        one + "\n"
    } {
        psj := (ParamsOf m).Join ","
        sign := psj + " -> " + (RetOf m)
        "    // 跳过 " + nm + "：签名 " + sign + " 里有映射表没有的类型\n"
    }
}

# 一个成员名 → 一段 C#。挑重载：**实例** + 参数返回值都认，按排位键取第一个。
readonly private EmitClassMember := (all: list w: string mod: string net: string selfName: string) => {
    same := all.Where (m: object) => { (NameOf m) == w; }
    cands := same.Where (m: object) => { !(StaticOf m); }
    ranked := cands.SortBy (m: object) => { RankKey m; }

    nSame := string (same.Count ())
    nIn := string (cands.Count ())

    ranked.IsEmpty () {
        "    // 跳过 " + w + "：没有实例重载（同名方法 " + nSame + " 个，实例 0 个）\n"
    } {
        best := ranked.First ()
        UsableClass best selfName {
            EmitClassOne best mod net selfName
        } {
            psj := (ParamsOf best).Join ","
            sign := psj + " -> " + (RetOf best)
            "    // 跳过 " + w + "：挑中的那个签名是 " + sign
            + "，里面有映射表没有的类型（同名 " + nSame + " 个 / 实例 " + nIn + " 个）\n"
        }
    }
}

# 属性访问器 / 运算符 / 事件（`get_X` / `set_X` / `op_+` / `add_X`）—— 它们是**别的东西**，
# 挂在模块里当函数用不成（运算符该走 `[ClassOp]`，那是另一条路）。
readonly private IsSpecial := (m: object) => {
    Reflect.Unwrap (Reflect.Call m "IsSpecialName" []);
}

# ═══ 对外那几个 ═══

# 类型名 → 包着 `System.Type` 的**对象**。
#
# **为什么不自己 `System.Type.GetType`**：查不到的时候它交回 **null**，紧接着
# `null.GetMethods ()` 就是一句 NRE —— 那不是 Ravel 的异常，**`try` 接不住**，
# 一路打成"解释器内部错误"（实测：`Adaptor.Cs "查无此类.Wat" …` 当场把脚本打死）。
# `Reflect.Type` 那条路报的是人话（"核心库写全名；别的程序集先 `using` 进来，
# 再写**带程序集的全名**"），而且它还会在**已经加载的**程序集里再找一遍。
#
# **`.AsObject ()` 那一格不能省**：`Reflect.Type` 交回的是"**静态访问的把手**"
# （`Reflect.Call` 在它身上找的是**静态**成员），而 `GetMethods` / `GetParameters`
# 这些是 `Type` 自己的**实例**成员，够不着。把它当成对象拿回来，之后全是实例调用。
readonly private TypeObject := (类型: string) => {
    (Reflect.Type 类型).AsObject ();
}

# **这个类型全部该适配的静态方法名** —— 去重、排序。有了它就不用逐个列成员：
#
#     Adaptor.Dll "System.Math" "NMath" (Adaptor.AllOf "System.Math") cs路径 dll路径
#
# **滤掉的**：非静态的（见 `EmitMember`）、`IsSpecialName` 那些。
# **故意没滤的**：类型对不上的（`object` 参数 / `ref` / 泛型参数）—— 那些**留在表里**，
# 由 `EmitMember` 逐条写一行「跳过 …」。生成器的产物是**脚手架**，
# 那份"跳过了什么"正是要交给人的东西，滤掉了反倒看不见。
readonly AllOf := (类型: string) => {
    ms := Reflect.Unwrap (Reflect.Call (TypeObject 类型) "GetMethods" [])
    keep := ms.Where (m: object) => { (StaticOf m) && !(IsSpecial m); }
    ns := keep.Map (m: object) => { NameOf m; }
    Sorting.Sort (ns.Distinct ());
}

# 类型名 → 短名（`"System.Math"` → `"Math"`）。模块名没给的时候拿它兜底。
#
# **兜底要当心撞名**：`Math` / `String` 这些短名，库里、别的插件里可能已经有了 ——
# 两个模块同名的话，`using` 的先后说了算（`DefineOrReplace` 是"装进来的以库为准"），
# 那是**静默**的那种坏。所以自动取的名字，生成的时候会打出来给人看一眼。
readonly ShortName := (类型: string) => {
    Reflect.Unwrap (Reflect.Call (TypeObject 类型) "Name" []);
}

# 生成的 C# 源码（不落盘）。编不过/映射不全都写在里面的注释里，不抛。
readonly Cs := (类型: string 模块: string 成员: list) => {
    T := TypeObject 类型
    Full := Reflect.Unwrap (Reflect.Call T "FullName" [])
    All := Reflect.Unwrap (Reflect.Call T "GetMethods" [])

    Head := [
        "// <auto-generated>"
        "//   由 `Adaptor.Cs` 生成（`lib/adaptor.rav`）—— 别手改，下次生成会盖掉。"
        "//   要改行为：改那张映射表；要改这一份：把它挪出 Ravel.Generated/ 自己接着写。"
        "//"
        "//   类型 " + 类型 + " → 模块 " + 模块 + "；成员 " + (成员.Join " ")
        "// </auto-generated>"
        ""
        "namespace Ravel.Runtime;"
        ""
        "[RavelModule(\"" + 模块 + "\")]"
        "internal static class " + 模块 + "Adaptor"
        "{"
    ]

    Body := 成员.Map (w: string) => { EmitMember All w 模块 Full; }

    # 一步一句 —— 串在一条链里写，`.Concat x` 后面那个 `.Join` 会被当成 `Concat` 的实参。
    Lines := Head.Concat Body
    Lines = Lines.Concat ["}"]
    Lines.Join "\n";
}

# **`Write` / `Build` 收的是源码**，不是"类型 + 成员" —— 于是
# 「静态那半 / 实例那半」（`Cs` / `CsClass`）和「写 / 写+编」两件事**正交**地拼：
#
#     Adaptor.Write (Adaptor.Cs 类型 模块 成员) 路径
#     Adaptor.Build (Adaptor.CsClass 类型 模块 类名 成员) cs路径 dll路径
#
# 不这么抽的话命令行那边是四个分支（静态/实例 × 写/编），一加形状就翻倍。

readonly Write := (源码: string 路径: string) => { System.WriteText 路径 源码; 路径; }

readonly Build := (源码: string cs路径: string dll路径: string) => {
    System.WriteText cs路径 源码
    # **就地编**：Roslyn 当库调，不经过 `dotnet build` —— 只有 runtime 的机器上也跑得起来。
    Compile.Cs 源码 dll路径 []
    dll路径;
}

# ═══ 对外那几个（**实例**那半）═══

# 这个类型全部该适配的**实例**方法名（去重、排序、滤掉属性访问器和运算符）。
readonly AllOfClass := (类型: string) => {
    ms := Reflect.Unwrap (Reflect.Call (TypeObject 类型) "GetMethods" [])
    keep := ms.Where (m: object) => { !(StaticOf m) && !(IsSpecial m); }
    ns := keep.Map (m: object) => { NameOf m; }
    Sorting.Sort (ns.Distinct ());
}

# **实例那半**的 C# 源码：`[RavelModule]` + `[RavelClass]` + `[ClassCtor]` + `[ClassMethod]`。
# 和 `Cs`（静态那半）**是两个形状**，所以是两个函数，不是一个开关。
readonly CsClass := (类型: string 模块: string 类名: string 成员: list) => {
    # **值类型的实例不做。** 装箱之后改不了原值 —— `DateTime.AddDays` 那种交回新值的
    # 没事，可**可变结构体**的方法（`Point.Offset` 那种）会**静默无效**：调了、看着成了、
    # 原值没动。那是最难查的一种错，所以宁可不生成、当场明说。
    (Reflect.Type 类型).IsValue () {
        throw (Exception ("`" + 类型 + "` 是值类型 —— 实例那半不做：装箱之后改不了原值，"
            + "可变的那些方法会**静默失效**（`DateTime.AddDays` 那种交回新值的没事，"
            + "`Point.Offset` 那种就白调了）。要哪几个自己补。"));
    } { (); }

    T := TypeObject 类型
    Full := Reflect.Unwrap (Reflect.Call T "FullName" [])
    All := Reflect.Unwrap (Reflect.Call T "GetMethods" [])
    Ctors := Reflect.Unwrap (Reflect.Call T "GetConstructors" [])
    SelfName := ShortName 类型

    # 构造器按 `CtorKey` 排，挑**第一个**。一个就够 —— 多个构造器各给一个名字
    # 是另一件事，这一版不做（`New` 一个名字）。
    rankC := Ctors.SortBy (c: object) => { CtorKey c; }
    Ctor := rankC.IsEmpty () {
        "    // 没有公开构造器\n"
    } {
        EmitCtor (rankC.First ()) 类名 Full 类名
    }

    Head := [
        "// <auto-generated>"
        "//   由 `Adaptor.CsClass` 生成（`lib/adaptor.rav`）—— 别手改，下次生成会盖掉。"
        "//   要改行为：改那张映射表；要改这一份：把它挪出 Ravel.Generated/ 自己接着写。"
        "//"
        "//   类型 " + 类型 + " → 模块 " + 模块 + " / 类 " + 类名 + "；成员 " + (成员.Join " ")
        "//"
        "//   **这是实例那半**：`[ClassCtor]` + `[ClassMethod]`，`self` 先脱壳再调。"
        "//   静态成员在另一份里（`Adaptor.Cs`）。**属性访问器（`get_X` / `set_X`）这一版不做。**"
        "// </auto-generated>"
        ""
        "namespace Ravel.Runtime;"
        ""
        "[RavelModule(\"" + 模块 + "\")]"
        "[RavelClass(\"" + 类名 + "\")]"
        "internal static class " + 类名 + "Adaptor"
        "{"
        "    private static " + Full + " Me (RuntimeValue self)"
        "        => (" + Full + ")((DotNetVal)self).Value;"
        ""
    ]

    Body := 成员.Map (w: string) => { EmitClassMember All w 模块 Full SelfName; }

    Lines := Head.Concat [Ctor]
    Lines = Lines.Concat Body
    Lines = Lines.Concat ["}"]
    Lines.Join "\n";
}


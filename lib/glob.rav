
using "regex.rav"
using "io.rav"
ravel "Glob"

readonly Meta := ".+(){}^$|\\"

readonly private Esc := (c: char) => {
    s := string c
    Meta.Contains s { "\\" + s; } { s; }
}

readonly ToRegex := (pat: string) => {
    out := "^"
    i := 0
    n := pat.Length ()
    while { i < n; } {
        c := pat.At i
        c == '*' {
            ((i + 1) < n) && ((pat.At (i + 1)) == '*') {

                out += ".*"
                i += 2
                (i < n) && ((pat.At i) == '/') { i += 1; } { 0; }
            } {
                out += "[^/]*"
                i += 1
            }
        } {
            c == '?' {
                out += "[^/]"
                i += 1
            } {
                c == '[' {
                    piece := CharClass pat i
                    out += (piece.At 0)
                    i = piece.At 1
                } {
                    out += (Esc c)
                    i += 1
                }
            }
        }
    }
    out + "$"
}

readonly private CharClass := (pat: string i: int) => {
    j := i + 1
    n := pat.Length ()
    neg := (j < n) && ((pat.At j) == '!')
    neg { j += 1; } { 0; }
    k := j
    (k < n) && ((pat.At k) == ']') { k += 1; } { 0; }
    while { (k < n) && ((pat.At k) != ']'); } { k += 1; }
    k >= n { ["\\[" (i + 1)]; } {
        body := neg { "^"; } { ""; }
        m := j
        while { m < k; } {
            c := pat.At m
            c == '\\' { body += "\\"; } { body += (string c); }
            m += 1
        }
        ["[" + body + "]" (k + 1)];
    }
}

readonly Match := (pat: string path: string) => { (Regex.C (ToRegex pat)).IsMatch (Slash path); }

readonly private Slash := (s: string) => { s.Replace "\\" "/"; }

readonly Filter := (pat: string names: list) => {
    out := []
    names.Foreach (n: object) => { Match pat (string n) { out.Add n; } { 0; } }
    out
}

readonly Split := (pat: string names: list) => {
    hit := []
    miss := []
    names.Foreach (n: object) => { Match pat (string n) { hit.Add n; } { miss.Add n; } }
    {"hit"-> hit "miss"-> miss}
}

readonly Find := (pat: string) => { FindIn "." pat; }

readonly FindIn := (under: object pat: string) => {
    out := []
    Io.EachDir (Io.Dir (Io.PathOf under)) (p: string e: object) => {
        Match pat p { out.Add (Slash p); } { 0; }
    }
    (out).Sort ()
}

readonly Under := (dir: string pat: string) => {
    dir.IsEmpty () { pat; } { (Slash dir) + "/" + pat; }
}

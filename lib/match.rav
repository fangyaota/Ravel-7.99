# `match v cases dflt` —— 从头试每一对 `[条件 结果]`,第一对条件为真的交出它的结果;
# 一对都不真就给 `dflt`。由 predefined.rav 加载(名字落在全局作用域)。
#
# 条件是个**谓词**(拿值、回 bool),而 `is.int` 这种**运算符节**(运算符后面紧跟 `.`)
# 就是现成的谓词 —— 它就是"是不是 int"那个函数。想比值也这么写:
#
#     kind := (v: object) => match v [
#         [is.int    "整数"]
#         [is.string "字符串"]
#     ] "别的"
#
#     sign := (n: int) => match n [[<.0 "负"] [==.0 "零"] [>.0 "正"]] "?"
#
# 两点先说清:
#   * 值是**当场算好的**(列表字面量本来就全部求值),所以别把有副作用的调用摆进去 ——
#     要延迟就在那一支里再调;
#   * **条件按顺序试,第一个为真的胜出**,后面的不再问(短路)。
readonly match ::= (v: object cases: list dflt: object) => {
    hit := -1
    i := 0
    while { (i < (cases.Count ())) && (hit < 0); } {
        c := cases.At i
        if { (c.Count ()) != 2; } {
            msg := "match 的每一对要写成 [条件 结果]：第 ${i + 1} 对不是（它 ${c.Count ()} 项）"
            throw (Exception msg)
        } { 0; }
        # 实参位置只收"主表达式 + 取成员",所以 `(c.At 0)` 的括号不能省(见 lib/cached.rav 那段)
        if { (c.At 0) v; } { hit = i; } { 0; }
        i += 1
    }
    if { hit >= 0; } { (cases.At hit).At 1; } { dflt; }
}

# `match v cases dflt` —— 从头试每一对 `[条件 结果]`,第一对条件为真的交出它的结果;
# 一对都不真就给 `dflt`。由 predefined.rav 加载(名字落在全局作用域)。
#
# 条件是个**谓词**(拿值、回 bool),而 `:.int` 这种**运算符节**(运算符后面紧跟 `.`)
# 就是现成的谓词 —— 它就是"是不是 int"那个函数。想比值也这么写:
#
#     kind := (v: object) => {
#         match v [
#             [:.int    {"整数";}]
#             [:.string {"字符串";}]
#         ] {"别的";}
#     }
#
#     sign := (n: int) => {
#         match n [[<.0 {"负";}] [==.0 {"零";}] [>.0 {"正";}]] {"?";}
#     }
#
# **结果写成块就是延迟的**(命中那一支才跑)—— 这是推荐的写法,和
# `if { 条件 } { 这 } { 那 }` 一个规矩。写成别的值也认,那就是**当场算好**的
# (它在列表字面量里,进 match 之前就已经跑完了)。
#
# 另外两条:条件按顺序试、**第一个为真的胜出**(后面的不再问);每对必须**正好两项**,
# 不是就当场报错(说清是第几对)。
#
# (要"测 + 绑"合在一起的那种分派,用**带模式的参数**:
#  `([x y]) => … | ({a b}) => … | (_) => …` —— 见 CONTEXT 的「解构」一节。)
readonly match ::= (v: object cases: list dflt: object) => {
    # 形状当场查:每一支结果、以及默认值,都得**可调用**。查的是"能不能调",不是"是块"——
    # 块和 lambda 都行(块 `is function` 成立),普通值不成立。
    checkArm := (arm: object what: string) => {
        if { !(arm : function); } {
            throw (Exception "${what}要写成块（块里最后一条语句的值就是它的值）")
        } { 0; }
    }

    checkArm dflt "match 的默认值"

    hit := -1
    i := 0
    while { (i < (cases.Count ())) && (hit < 0); } {
        c := cases.At i
        if { (c.Count ()) != 2; } {
            msg := "match 的每一对要写成 [条件 结果]：第 ${i + 1} 对不是（它 ${c.Count ()} 项）"
            throw (Exception msg)
        } { 0; }
        checkArm (c.At 1) "match 第 ${i + 1} 对的结果"
        # 实参位置只收"主表达式 + 取成员",所以 `(c.At 0)` 的括号不能省(见 lib/cached.rav 那段)
        if { (c.At 0) v; } { hit = i; } { 0; }
        i += 1
    }

    # 到这儿才真跑:命中那一支的结果(或默认那一支)
    if { hit >= 0; } { ((cases.At hit).At 1) (); } { dflt (); }
}

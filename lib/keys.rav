readonly IKey ::= interface {
    by Key : function = _
}

impl (IKey int {;})
impl (IKey real {;})
impl (IKey bigint {;})
impl (IKey fraction {;})
impl (IKey bigfraction {;})
impl (IKey char {;})
impl (IKey string {;})

readonly IDict ::= interface {
    internal Get : function = _
    internal Set : function = _
    internal Has : function = _
    internal Remove : function = _
    internal GetOr : function = _
}

ravel "Keys"

readonly Of := (k: object) => {
    c := k.Key ()
    c : IValue { c; } {
        throw (Exception ("`Key` 要交回一个值类型的键（数 / 串 / 字符 / 布尔 / `()`），得到 " + (string (typeof c))))
    }
}

impl (IDict dict {
    Get = (k: object) => { instance.At k; }
    Set = (k: object) => {
        (v: object) => { instance.SysSet k v; }
    }
    Has = (k: object) => { instance.SysHas k; }
    Remove = (k: object) => { instance.SysRemove k; }
    GetOr = (k: object) => {
        (dflt: object) => { (instance.SysGetOr k) dflt; }
    }
})

impl (IDict System.Scope {
    Get = (k: object) => { ((instance.Lookup (Of k)).Get ()); }
    Set = (k: object) => {
        (v: object) => {
            n := Of k
            inThere := try { (instance.Lookup n); true; } (e: Exception) => { false; }

            inThere { 0; } { instance.Define n (typeof v); }
            ((instance.Lookup n).Set v)
            ()
        }
    }
    Has = (k: object) => { try { (instance.Lookup (Of k)); true; } (e: Exception) => { false; } }
    Remove = (k: object) => { instance.Remove (Of k); }
    GetOr = (k: object) => {
        (dflt: object) => {
            try { (instance.Lookup (Of k)).Get (); } (e: Exception) => { dflt; }
        }
    }
})

readonly Keyed ::= class {
    Index: dict = {->}
    Data: dict = {->}

    Set := (k: object v: object) => {
        c := Of k
        Index.Set c k
        Data.Set c v
        ()
    }
    Get := (k: object) => { Data.Get (Of k); }
    Has := (k: object) => { Data.Has (Of k); }
    GetOr := (k: object dflt: object) => { (Data.GetOr (Of k)) dflt; }
    Remove := (k: object) => {
        c := Of k
        Index.Remove c
        Data.Remove c
    }
    Keys := () => { Index.Values (); }
    Values := () => { Data.Values (); }
    Count := () => { Data.Count (); }
    Clear := () => {
        Index.Clear ()
        Data.Clear ()
    }
}

impl (IDict Keyed {;})

ravel ""

readonly Keyed := Keys.Keyed

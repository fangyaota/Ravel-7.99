# `DocSite` —— 把 `docs/tutorial/*.md` 生成一个静态文档站。
#
# **这是个模块**(`ravel "DocSite"`),自己什么都不干 —— 调 `DocSite.Build "site"` 才动手。
# 三个现成的入口:
#
#     ravel examples/site.rav            # 只生成到 site/(= `DocSite.Build "site"`)
#     ravel examples/serve.rav           # 生成 + 起服务器,浏览器里直接看(见那个文件)
#     REPL 的「教程」那一项              # 生成 + 用默认浏览器打开
#
# **它住在 `lib/` 而不是 `examples/`** —— 因为 REPL(`lib/repl.rav`)要用它。`examples/`
# 那一格是"给你看着玩"的脚本,标准库反过来依赖它就把方向搞反了。而它和 `repl.rav` 一样,
# 属于"这个发行版自带的东西",不是通用库 —— 放 `lib/` 里正合适。
#
# **零依赖**:纯静态 HTML + 一个 CSS,没有 JS、没有 CDN —— 双击就能看,也能直接挂 Pages。
# (runoob 页面上那些"在线运行"按钮做不了:那要在浏览器里跑一个 Ravel,得先编到 wasm。)
#
# markdown 只认这份文档用到的**子集**:标题、表格、``` 代码块、`-` 列表、段落;
# 行内认 `code` / **粗** / [文字](链接)。认得的少,错得也少。
#
# **HTML 那一半交给 `lib/html.rav`**(`using "html.rav"`)。这份文件从前是手写拼串的,
# 还自带一份 `H` 做转义 —— 现在两样都是 `Html` 的事:块级函数交回**节点**,`Html.Pretty`
# 负责拼成文本,转义在渲染那一步统一做(所以字符串里的 `<` 不用自己操心了)。
#
# 写这个文件时踩到的四条语言脾气 —— 都不是 bug,是这门口的规矩,后面全按着它们写:
#
#   * **`X ().Y` 要写 `(X ()).Y`** —— `.成员` 比并列的调用绑得紧(教程 3.9),所以
#     `t.Trim ().StartsWith "a"` 会被读成 `t.Trim (().StartsWith "a")`。这条最坑,
#     报出来的错是"类型 'Void' 没有方法",指着的却是 `.Trim`。
#   * **`[…]` 里空格是元素分隔符** —— `[f 1 2]` 是**三个**元素,要一个调用当一格就得自己
#     加括号:`[(f 1 2)]`。这个文件里到处是"孩子是一串节点",所以这条几乎每行都躲不开。
#   * **`Slice [a..b]` 是闭区间**,和 `[1..3]` 那个 Range 一个规矩 —— 差一格的事全收进
#     `Sub` / `Mid` / `Tail` 三个小函数里,别在每个调用点各算一遍。
#   * **长表达式别跨行** —— 只在括号里才续行,行尾的 `+` 不管用。每句都短,要拼长东西
#     先拆临时变量。
ravel "DocSite"

using "html.rav"
using "io.rav"
using "glob.rav"

# 哪儿找 markdown —— 源目录写死在这儿(这个模块就是为这份教程写的);要换地方就
# 改这一行。**落点是 `Build out` 的参数**,不在这儿。
SRC := "docs/tutorial"
SITE := "Ravel 语言教程"

# ═══ 小工具 ═══

# 取子串。**`Slice` 是闭区间**(和 `[1..3]` 那个 Range 一个规矩),差一格的事全收进
# 这三个里,别在每个调用点各算一遍。
Sub := (s: string i: int n: int) => {
    if { n <= 0; } { ""; } { s.Slice [i..((i + n) - 1)]; }
}
Mid := (s: string i: int j: int) => { Sub s i (j - i); }      # [i, j)

# 第 i 行,越界就是空串。(`&&` 是**真短路**的,所以这不是为了兜它 —— 是为了读起来
# 不用每处都先想一遍"这个 i 会不会越界"。)
LineAt := (lines: list i: int) => {
    if { i < (lines.Count ()); } { lines.At i; } { ""; }
}
Tail := (s: string n: int) => { Sub s n ((s.Length ()) - n); }  # 从第 n 个到末尾

# 从 `from` 起找 `sub`,交回位置;没有就是 -1
Find := (s: string sub: string from: int) => {
    at := -1
    i := from
    n := s.Length ()
    m := sub.Length ()
    while { ((i + m) <= n) && (at < 0); } {
        if { (Sub s i m) == sub; } { at = i; } { 0; }
        i += 1
    }
    at;
}

# ═══ 行内 ═══
#
# 交回的是**一串节点**,不是字符串 —— 文本走 `Html.Text`(渲染时转义),标签走 `Html`。
# 手写拼串那份连同 `H` 一起删了:字符串里的 `<` / `&` 现在不用在这儿操心。
#
#   `x`       → <code>x</code>
#   **x**     → <strong>x</strong>
#   [x](url)  → <a href="url">x</a>
#
# 三条各拆成"交回节点"和"下一个位置"两半:认不出的情况(没有收尾记号)照样得往前走一格,
# 不然会死循环。
Inline := (s: string) => {
    out := []
    i := 0
    n := s.Length ()
    while { i < n; } {
        c := Mid s i (i + 1)
        # `\[` 这种:反斜杠是"下一个字符照字面来",本身不是内容。**这条得排在最前面** ——
        # 不然那个 `[` 会被当成链接的开头,而 `\[…\]` 根本不是链接(教程里写"值 \[…\] 不是函数"
        # 就是这么写的)。末尾孤零零一个 `\` 就当一个普通字符走。
        if { c == "\\"; } {
            if { (i + 1) < n; } { out.Add (Html.Text (Mid s (i + 1) (i + 2))); i += 2; } { i += 1; }
        } {
            if { c == "`"; } {
                out.Add (Code s i)
                i = CodeEnd s i
            } {
                if { c == "*"; } {
                    out.Add (Bold s i)
                    i = BoldEnd s i
                } {
                    if { c == "["; } {
                        out.Add (LinkAt s i)
                        i = LinkEnd s i
                    } {
                        out.Add (Html.Text c)
                        i += 1
                    }
                }
            }
        }
    }
    out;
}

Code := (s: string i: int) => {
    j := Find s "`" (i + 1)
    if { j < 0; } { Html.Text (Mid s i (i + 1)); } { Html.Code (Mid s (i + 1) j); }
}
CodeEnd := (s: string i: int) => {
    j := Find s "`" (i + 1)
    if { j < 0; } { i + 1; } { j + 1; }
}

Bold := (s: string i: int) => {
    j := Find s "**" (i + 2)
    if { j < 0; } { Html.Text (Mid s i (i + 1)); } { Html.El "strong" {} (Inline (Mid s (i + 2) j)); }
}
BoldEnd := (s: string i: int) => {
    j := Find s "**" (i + 2)
    if { j < 0; } { i + 1; } { j + 2; }
}

LinkAt := (s: string i: int) => {
    j := Find s "]" (i + 1)
    k := if { j < 0; } { -1; } { Find s "(" (j + 1); }
    e := if { k < 0; } { -1; } { Find s ")" (k + 1); }
    if { e < 0; } { Html.Text (Mid s i (i + 1)); } {
        Html.A (Mid s (k + 1) e) (Inline (Mid s (i + 1) j));
    }
}
LinkEnd := (s: string i: int) => {
    j := Find s "]" (i + 1)
    k := if { j < 0; } { -1; } { Find s "(" (j + 1); }
    e := if { k < 0; } { -1; } { Find s ")" (k + 1); }
    if { e < 0; } { i + 1; } { e + 1; }
}

# ═══ 块级 ═══

# 锚点用行号:标题是中文,做不出好看的 slug
Head := (lvl: int at: int text: string) => {
    Html.El ("h" + (string lvl)) {"id": ("s" + (string at))} (Inline text);
}

# 一行 `| a | b |` 拆成单元格
Cells := (line: string) => {
    t := line.Trim ()
    inner := if { t.EndsWith "|"; } { Mid t 1 ((t.Length ()) - 1); } { Mid t 1 (t.Length ()); }
    (System.SplitLines (inner.Replace "|" "\n")).Map ((c: string) => { c.Trim (); }) |> .ToList ();
}

# 表格:第一行表头,第二行是 `|---|---|` 那种分隔(扔掉),其余是数据行
Table := (rows: list) => {
    head := []
    foreach (Cells (rows.At 0)) (c: string) => { head.Add (Html.El "th" {} (Inline c)); }
    body := []
    i := 2
    while { i < (rows.Count ()); } {
        cells := []
        foreach (Cells (rows.At i)) (c: string) => { cells.Add (Html.El "td" {} (Inline c)); }
        body.Add (Html.El "tr" {} cells)
        i += 1
    }
    Html.El "table" {} [
        (Html.El "thead" {} [(Html.El "tr" {} head)])
        (Html.El "tbody" {} body)
    ]
}

# 正文:逐行走一遍状态机,交回**一串块节点**。几条判据**平铺**着写(它们互斥,
# `#### ` 不以 `### ` 开头),每行至多命中一条,靠 `done` 拦住后面的段落分支。
Md := (text: string) => {
    lines := System.SplitLines text
    out := []
    i := 0
    n := lines.Count ()
    while { i < n; } {
        t := (LineAt lines i).Trim ()
        at := i + 1
        done := false

        if { t.StartsWith "```"; } {
            i += 1
            code := []
            while { (i < n) && !(((LineAt lines i).Trim ()).StartsWith "```"); } {
                code.Add (LineAt lines i)
                i += 1
            }
            i += 1
            out.Add (Html.Pre (code.Join "\n"))
            done = true
        } { 0; }

        if { !done && (t.StartsWith "|"); } {
            rows := []
            while { (i < n) && (((LineAt lines i).Trim ()).StartsWith "|"); } {
                rows.Add (LineAt lines i)
                i += 1
            }
            out.Add (Table rows)
            done = true
        } { 0; }

        if { !done && (t.StartsWith "#### "); } { out.Add (Head 4 at (Tail t 5)); i += 1; done = true; } { 0; }
        if { !done && (t.StartsWith "### "); }  { out.Add (Head 3 at (Tail t 4)); i += 1; done = true; } { 0; }
        if { !done && (t.StartsWith "## "); }   { out.Add (Head 2 at (Tail t 3)); i += 1; done = true; } { 0; }
        if { !done && (t.StartsWith "# "); }    { out.Add (Head 1 at (Tail t 2)); i += 1; done = true; } { 0; }

        if { !done && (t.StartsWith "- "); } {
            items := []
            while { (i < n) && (((LineAt lines i).Trim ()).StartsWith "- "); } {
                items.Add (Inline (Tail ((LineAt lines i).Trim ()) 2))
                i += 1
            }
            out.Add (Html.Ul items)
            done = true
        } { 0; }

        if { done; } { 0; } {
            if { t == ""; } { i += 1; } {
                out.Add (Html.P (Inline t))
                i += 1
            }
        }
    }
    out;
}

# 抽 `##` / `###` 给左侧导航用
Toc := (text: string) => {
    out := []
    lines := System.SplitLines text
    i := 0
    while { i < (lines.Count ()); } {
        t := (LineAt lines i).Trim ()
        id := "s" + (string (i + 1))
        if { t.StartsWith "### "; } { out.Add {"lvl": 3 "id": id "text": (Tail t 4)}; } { 0; }
        if { t.StartsWith "## "; }  { out.Add {"lvl": 2 "id": id "text": (Tail t 3)}; } { 0; }
        i += 1
    }
    out;
}

# ═══ 页面 ═══

# `prev` / `next` 是**节点**(没有就是 `None`,渲染时会跳过)—— 从前是拼好的字符串,
# 现在连那一对 `<a href="…">` 都交给 `Html.A`。
Page := (title: string nav: object body: object prev: object next: object) => {
    head := [
        (Html.El "meta" {"name": "viewport" "content": "width=device-width, initial-scale=1"} [])
        (Html.El "title" {} [title])
        (Html.CssLink "style.css")
    ]
    Html.Doc "zh" head [
        (Html.El "header" {} [(Html.A "index.html" [SITE])])
        (Html.El "div" {"class": "wrap"} [
            (Html.El "nav" {} nav)
            (Html.El "main" {} body)
        ])
        (Html.El "footer" {} [prev (Html.El "span" {} []) next])
    ]
}

# 样子照 runoob 那种:左边目录、右边正文、代码块浅灰、表格带框
CSS := """
    :root { --fg:#333; --dim:#777; --line:#e3e3e3; --link:#0087bd; --code-bg:#f6f6f6; }
    * { box-sizing: border-box; }
    body { margin:0; font:15px/1.75 -apple-system,"Segoe UI","Microsoft YaHei",sans-serif; color:var(--fg); }
    header { padding:14px 24px; border-bottom:1px solid var(--line); font-weight:700; font-size:17px; }
    header a { color:var(--fg); text-decoration:none; }
    .wrap { display:flex; align-items:flex-start; max-width:1180px; margin:0 auto; }
    nav { flex:0 0 236px; padding:20px 12px 60px; position:sticky; top:0; max-height:100vh;
          overflow:auto; font-size:14px; border-right:1px solid var(--line); }
    nav a { display:block; padding:5px 10px; color:var(--fg); text-decoration:none; border-radius:4px; }
    nav a:hover { background:var(--code-bg); }
    nav a.on { background:#e8f4fa; color:var(--link); font-weight:600; }
    nav a.sub { padding-left:26px; font-size:13px; color:#555; }
    main { flex:1 1 auto; min-width:0; padding:24px 34px 80px; }
    h1 { font-size:26px; border-bottom:1px solid var(--line); padding-bottom:10px; }
    h2 { font-size:21px; margin-top:34px; }
    h3 { font-size:17px; margin-top:26px; }
    h4 { font-size:15px; margin-top:22px; color:#555; }
    a { color:var(--link); }
    code { background:var(--code-bg); padding:2px 5px; border-radius:3px;
           font:13.5px/1.5 Consolas,"Courier New",monospace; }
    pre { background:var(--code-bg); border:1px solid var(--line); border-radius:4px;
          padding:12px 14px; overflow:auto; }
    pre code { background:none; padding:0; }
    table { border-collapse:collapse; margin:14px 0; }
    th,td { border:1px solid var(--line); padding:6px 12px; text-align:left; }
    th { background:var(--code-bg); }
    footer { max-width:1180px; margin:0 auto; padding:18px 34px 40px; border-top:1px solid var(--line);
             display:flex; justify-content:space-between; font-size:14px; }
    @media (max-width:820px) { .wrap { display:block; }
        nav { position:static; max-height:none; border-right:0; border-bottom:1px solid var(--line); } }
"""

# ═══ 跑起来 ═══

Save := (out: string rel: string text: string) => {
    (Io.File (out + "/" + rel)).Write text;
    print ("  " + rel);
}

# 一章的标题:头一行 `# …`
TitleOf := (src: string) => {
    t := (LineAt (System.SplitLines src) 0)
    if { t.StartsWith "# "; } { Tail t 2; } { t; }
}

# `01-start.md` → `01-start.html`。
# **不叫 `Html`** —— 那个名字现在是 `html.rav` 的模块名,盖住它这份文件就没法拼页面了。
PageOf := (md: string) => { md.Replace ".md" ".html"; }

Chapters := (Glob.Find (SRC + "/*.md") |> .ToList ()) |> .Sort ();

# 左侧导航:每章一条;当前那一章再展开它自己的小节
Nav := (cur: string src: string) => {
    out := []
    foreach Chapters (p: string) => {
        name := (Io.File p).Name ()
        attrs := if { name == cur; } { {"href": (PageOf name) "class": "on"}; } { {"href": (PageOf name)}; }
        out.Add (Html.El "a" attrs [(TitleOf ((Io.File p).Read ()))])
        if { name == cur; } {
            foreach (Toc src) (h: dict) => {
                if { (h.Get "lvl") == 3; } {
                    href := "#" + (string (h.Get "id"))
                    out.Add (Html.El "a" {"href": href "class": "sub"} [(string (h.Get "text"))])
                } { 0; }
            }
        } { 0; }
    }
    out;
}

# 生成到 `out/`:一章一个 HTML + 一个首页目录 + 一份 CSS。
#
# 只做"写文件"这一件事 —— 想让它起个服务器给人看,见 `examples/serve.rav`。
Build := (out: string) => {
    # **一章都没搜到就别装作成功。** 从前是照样生成一个只有 `index.html` 的空站、还印一句
    # "好了" —— 而原因通常只是**跑错地方了**:`SRC` 是**相对当前目录**的,从 `out/` 跑就得
    # 那儿也有 `docs/`(构建时拷过去了,见 `Ravel.csproj` 的 `CopyDocs`)。
    if { Chapters.IsEmpty (); } {
        throw (Exception ("找不到 markdown 源:" + SRC + " —— 在仓库根跑,或者把 docs/ 一起带上"))
    } { 0; }
    print ("生成到 " + out + "/");
    while { !(System.DirExists out); } { System.CreateDir out; }

    i := 0
    while { i < (Chapters.Count ()); } {
        p := Chapters.At i
        src := (Io.File p).Read ()
        name := (Io.File p).Name ()
        # 标 `object`:**光写 `None` 会被推成 `Option`**,后面赋一个节点就报"无法将 Dict
        # 赋值给 'next'(声明为 Option)"。这两个格子装的是"节点或者没有"。
        prev: object = None
        next: object = None
        if { i > 0; } {
            prev = Html.A (PageOf ((Io.File (Chapters.At (i - 1))).Name ())) ["← 上一章"]
        } { 0; }
        if { i < ((Chapters.Count ()) - 1); } {
            next = Html.A (PageOf ((Io.File (Chapters.At (i + 1))).Name ())) ["下一章 →"]
        } { 0; }
        Save out (PageOf name) ((Html.Pretty (Page (TitleOf src) (Nav name src) (Md src) prev next)) + "\n")
        i += 1
    }

    # 首页 = 目录
    entries := []
    foreach Chapters (p: string) => {
        name := (Io.File p).Name ()
        entries.Add (Html.El "a" {"href": (PageOf name)} [(TitleOf ((Io.File p).Read ()))])
    }
    idx := [(Html.H1 SITE) (Html.Ul entries)]
    Save out "index.html" ((Html.Pretty (Page SITE [] idx None None)) + "\n")
    Save out "style.css" CSS
    print ("好了 —— " + out + "/index.html");
}

ravel ""

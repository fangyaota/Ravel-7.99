# `Tasks` —— **协作式任务**。要显式引用:`using "tasks.rav"`。
#
#     using "tasks.rav"
#
#     Tasks.Cycle [
#         Tasks.Task (group: Tasks.TaskGroup) => {
#             print "a"
#             group.Await (Tasks.After 1000)
#             print "a 完了"
#         }
#         Tasks.Task (group: Tasks.TaskGroup) => {
#             print "b"
#             group.Await (Tasks.After 300)
#             print "b 完了"
#         }
#     ]
#
# 一个 OS 线程,任务只在**挂起点**换人(`group.Await`)。于是等待能重叠(两个 400ms 的等待
# 叠起来 ≈ 0.6s,串起来 0.8s 起),而交替顺序是钉得住的 —— 协作式的好处:顺序由代码决定。
#
# ## Task 分两种
#
# **自动推进的**:`Tasks.After ms` 这种 —— 底下是 OS 的计时器 / IO 句柄,它在**操作系统
# 那边**自己往前走。组管不了它、也不用管它,只需要**看**它完没完(`System.WaitAny`),
# 完了把等着的人放回就绪队列。
#
# **自创的**:`Tasks.Task (group) => { … }` 这种 —— 只有组**跑**它才前进。它停在哪儿由一枚
# 续延记着(`Step`),组下次挑到它就接着跑。
#
# 两种共用**一张脸**(`ITask`)、一套 `group.Await`。脸共用一个是有道理的:都是"一件还没完的
# 活儿",差别只在**谁让它往前走** —— 而那句话落在两个**类**上(`Task` / `SysTask`),
# 不是一个真假标记。`ITask` 上写的就是组要的全部东西(见下面"分三层"那段)。
#
# ## 只有"等"这一个挂起点,**没有**"主动让出"
#
# 一个任务只在 `group.Await` 上停住。要别人跑,你总得先等点什么 —— `Tasks.After 0`
# 就是"让一轮"。等一个**自创任务**时,组会顺手把它挂进来跑(所以 `Await` 从不需要
# 先 `Add`)。这一条是有意的:另一条路(任务主动 `Yield`)在这门语言的调度器上
# 实测会踩到帧链的坑(任务与调度器共用一条链),而"只在等句柄时停"这条路
# 在实测里一次都没出过事。等引擎那条修好再谈公平轮转。
#
# ## 续延那套写法照抄 `lib/generator.rav` 的 `GeneratorCursor`
#
# 挂起/恢复库里已经有一份跑得好的(`Generator (y) => { while { true; } { y n; n += 1 } }`
# 那种"在循环体里挂起再接着跑"就是它撑着)。三条规矩照抄,一条都别自作聪明:
#
#   ① **一律用库里的 `callcc`**(不是引擎的 `System.CallCC`)—— 它交出来的续延被调用时
#      会先还原**控制状态**(`Ex.HandlerStack` / 模块加载状态,见 `predefined.rav`),
#      于是"每个任务自己一套 handler 栈"是白拿的,这儿一个字都不用管。
#   ② **状态收进对象的字段**,别散在模块作用域上:任务换来换去,谁读谁写说不清。
#   ③ **两侧都是"在 lambda 里抓、抓完立刻跳到对面"**。
#
# **模块作用域上一格状态都没有** —— 组是对象,状态在它的字段里;"等"只有 `group.Await`
# 一个入口(连 `t.Value` 都不等:没算完就报错,去 `Await` 等)。理由是同一句老话:
# 藏在 by-property 里的让出,读代码的人看不见。
ravel "Tasks"

# ── 一个任务:一件"还没完的活儿" ──
#
# 分三层。不是为了好看,是为了**同一件事不写两遍**:
#
#   `ITask`     组认的那张脸 —— 它上面**只写组要求的**(完没完、结果是什么、
#               收尾那几格、"怎么被等"),于是 `TaskGroup` 的每个参数都注解成它,
#               传错东西在**调用点**就报。存句柄的变量也注解成它(`t : Tasks.ITask = …`)。
#   `TaskBase`  共用的**那一半实现**:那几格状态 + `IsDone` / `Value` 的体。
#               它把 `ITask` 实现了(一句 `impl`,两个子类跟着认)——
#               **实现类是普通字段 / 普通方法就能满足那些槽**,不必写成 property(实测)。
#   `Task` / `SysTask`  各自的**机制**:自创的带 `Body` / `Step` / `Started`,
#               自动推进的带 `Job`。脸和状态全是继承来的,自己只写一件事:`WaitOn`。
#
# 于是"两种任务"落在**类**上,而不是一个 `HasJob: bool` 真假标记 ——
# 调度器那一句 `t.WaitOn this` 就是全部的分派。
#
# 它上面写的就是"**能被组调度的东西**"的全部要求 —— 组里每个参数都注解成它,
# 于是"传了个不是任务的东西"当场在**调用点**报,而不是跑到里面某一行才炸。
# (实现类是普通字段 / 普通方法就能满足这些槽,不必写成 property —— 实测。)
ITask ::= interface {
    # 收尾那几格:组要读(`Run` 末尾那两道检查)、也要写(`Await` 认领)
    by Done : function = default
    by Ok : function = default
    by Err : function = default
    by Claimed : function = default

    # 用户读的那两个 —— 都不阻塞
    by IsDone : function = default
    by Value : function = default

    # **怎么被等**:值是一个 `(group) => …`。这是"两种任务不一样"的唯一一处,
    # 子类各写各的,组只管调它(`t.WaitOn this`)。
    by WaitOn : function = default
}

# 共用那一半。**它自己不该被实例化** —— `WaitOn` 那份只会报错的默认体就是拦这个的。
TaskBase ::= class {
    # 结果那一格:Done 之后 Ok / Val / Err 才有意义
    Done: bool = false
    Ok: bool = true
    Val: object = ()
    Err: object = ()

    # 有没有人来接过我的结果(`Await` 过 / 读过 `Value`)。
    # 它是"任务失败了但没人知道"那道闸的凭据:没人接的错到 `Run` 收尾时会当场报出来,
    # 不会像"没人接的错误"那样烂在这儿。
    Claimed: bool = false

    # 完没完 —— **不阻塞**,随手就能探
    by IsDone := property (() => { Done; }) ((v: bool) => { (); })

    # 取值 —— **检查过的读**:完了就交值,没完就报错,**不等**。
    #
    # 要等就用 `group.Await t`(它才是那个挂起点)。这里不等是有意的:
    # 一个 by-property 悄悄把当前任务挂起来,读代码的人看不见"这一句会让出";
    # 而"等"是调度的事,该在**调度器那一句**上明写。
    by Value := property (() => {
        if { Done; } { 0; } {
            throw (Exception ("这个任务还没完 —— 要等它就用 `group.Await t`,"
                              + "只想探一下就 `t.IsDone`"))
        }
        # 到这儿才认领:**读到了结果或错**才算"有人接"。上面那句"还没完"不算 ——
        # 它只是探了一下,没接过任何东西。
        Claimed = true
        if { Ok; } { Val; } { throw Err; }
    }) ((v: object) => { (); })

    # **怎么被等** —— "两种任务不一样"只在这一个地方,子类各写各的。
    # 基类这一份是兜底:走到这儿说明有人造了个没实现的 Task 家族类型,别装死。
    WaitOn := (group: TaskGroup) => {
        throw (Exception ("这个类型没法被等 —— `WaitOn` 没实现"))
    }
}

# 自创的:`Tasks.Task (group) => { … }`。只有组**跑**它才前进。
#
# `Step` 是"我停在哪儿"那一枚续延,起手是 `default`(还没到手的哨兵:一调就报错,
# 不会静默什么都不做 —— 见 `predefined.rav` 的 callcc)。
Task ::= class TaskBase {
    Body: function = () => { (); }
    Step: Continuation = default
    Started: bool = false

    # 谁在等我。自动推进的那一类用不上 —— 它等着的是组的等待集合(`Waiting`)。
    Waiters: list = []

    # 进过组没有。**一个任务只能跑一遍**:它的续延是多发的,再跑一遍等于跳回上一次
    # 留下的那条帧链 —— 实测是**死循环**(第二遍把第一遍整段重放,一遍又一遍)。
    # 这条闸在 `Add` 上,传进来的那一刻就拦住。
    Queued: bool = false

    init = (body: function) => {
        Body = body
        Step = default
        Started = false
        Queued = false
        this;
    }

    # 挂到它的 `Waiters` 上 —— 它收工(`Finish`)时会把我放回就绪队列。
    #
    # **顺手把自己挂进这个组**(没进过的话)。"等到它完"就蕴含"得有人推它",而此刻
    # 只有这一个组在跑 —— 少了这一步,`g.Await (Http.GetTask url)` 这种最自然的写法
    # 就永远等不到(报得清楚,但明明不用报)。
    #
    # 已经进过组的不动(`Queued`):那意味着有**别的**组在推它,再塞一份会让它被挑到
    # 两次 —— `Add` 那边会当场拦下来。
    WaitOn = (group: TaskGroup) => {
        if { Queued; } { 0; } { group.Add this; }
        callcc (kp: Continuation) => {
            group.Current.Step = kp
            Waiters.Add group.Current
            group.Back ()
        }
    }
}

# 自动推进的:`Tasks.After ms` 这种。底下是 OS 的计时器 / IO 句柄,它在**操作系统那边**
# 自己往前走;组管不了它、也不用管它,只需要**看**它完没完(`System.WaitAny`)。
SysTask ::= class TaskBase {
    Job: object = ()

    init = () => { Job = (); this; }

    # 挂到**组的等待集合**上,等 OS 那边。回到这儿 = 句柄完成了。
    # **结果在这一头取** —— 于是 IO 失败(超时、连不上)是在**这个任务里**抛出来的,
    # 不会把组带走;同时也把结果记到自己身上,之后谁读 `Value` 都是白拿。
    # (`HandleValue` 可以重复调,读的就是那个已完成任务的结果。)
    WaitOn = (group: TaskGroup) => {
        callcc (kp: Continuation) => {
            group.Current.Step = kp
            group.Waiting.Add (Pending group.Current Job)
            group.Back ()
        }
        Val = System.HandleValue Job
        Ok = true
        Done = true
    }
}

# 两个子类跟着认 `ITask` —— 基类登记一次就够(实测子类继承那句 `impl`)。
# (那个 `{ () }` 得**另起一行**:同一行里它会被当成 set 字面量。)
impl (ITask TaskBase {
    ()
})

# 组在等的一件"操作系统那边的事":谁在等 + 等的是哪个句柄
Pending ::= class {
    Who: Task = default
    Job: object = ()
    init = (who: Task job: object) => { Who = who; Job = job; this; }
}

# **组** —— 调度器。就绪队列 + 等待集合,外加一格"此刻在跑谁"。
#
# 组**不自己起任务**:它只跑你交给它的(`TaskGroup [ … ]`)、以及跑着跑着自己加进来的
# (`group.Add`)。于是"这组活儿什么时候算完"是个能被看出来的问题(见 `Run` 末尾那道死锁检查)。
TaskGroup ::= class {
    All: list = []                 # 组里所有任务(含跑着加进来的),给死锁检查用
    Ready: list = []               # 就绪队列:挑到谁就跑谁
    Waiting: list = []             # 等着 OS 句柄的:每项一个 `Pending`
    Current: Task = default        # 此刻在跑的那个(它一挂起就往它身上记"接着跑")
    Back: Continuation = default   # 任务让出时跳回来的那一枚(见 `Run`)

    init = (tasks: list) => {
        All = []
        Ready = []
        Waiting = []
        Current = default
        Back = default
        # 走 `Add` 而不是直接往队列里塞 —— 那道"一个任务只能跑一遍"的闸在那儿
        foreach tasks (t: Task) => { Add t; }
        this;
    }

    # 往组里加一个任务。**不立刻跑** —— 排到队尾,到下一个切换点才轮到它
    # (协作式的规矩:发起的人接着跑自己的,等它自己走到挂起点)。
    #
    # 跑着的时候也能调(`group.Add anotherTask`):有些活儿本来就是"等我这儿有数了,
    # 才知道要开几个"。交回任务本身,于是 `t := group.Add (Tasks.Task …)  # 之后 t.Value` 读得通。
    #
    # **只收自创的那种**(参数写着 `Task`)。自动推进的加进就绪队列没有意义 ——
    # 它的完成不靠谁去跑它,而是操作系统那边的事;真想等它,`group.Await` 就够了
    # (`Await` 收的是两种都认的 `ITask`)。从前这儿是 `object`,于是
    # `group.Add (Tasks.After 100)` 要到组挑到它、跑 `t.Started` 的时候才炸,
    # 报的是「类型 'SysTask' 没有方法 'Started'」—— 现在传错在**这一行**就报。
    Add := (t: Task) => {
        # **一个任务只能跑一遍**,两个方向都拦:
        #   * 已经跑完了:再跑就是跳回上一次留下的帧链(续延是多发的)—— 实测死循环;
        #   * 已经在组里(还挂着):再加一份会让它被挑到两次,`Step` 也跟着乱。
        # 要同样的活儿再来一遍,就再造一个 `Tasks.Task (…)` —— 任务是**一次性的**,
        # 和 `Generator`(体是配方,每次遍历从头)不是一个东西。
        if { t.Done; } {
            throw (Exception ("这个任务已经跑完了 —— 一个任务只能跑一遍(要再来一次就再造一个)"))
        } { 0; }
        if { t.Queued; } {
            throw (Exception ("这个任务已经在组里了 —— 别加第二遍"))
        } { 0; }
        t.Queued = true
        All.Add t
        Ready.Add t
        t
    }

    # **唯一的挂起点**:等一个任务完。
    #
    # 怎么挂由**那个任务自己说了算**(`t.WaitOn this`,见 `Task` / `SysTask`):
    # 自创的挂到自己的 `Waiters` 上(跑完时 `Finish` 把等着的人放回就绪队列),
    # 自动推进的挂到组的等待集合上(`Poll` 在 OS 那边等着,谁先完成谁先回来)。
    #
    # **自创任务不用先 `Add`**:`Await` 会替你把它挂进这个组(见 `Task.WaitOn`)——
    # "等到它完"就蕴含"得有人推它",而此刻只有这一个组在跑。
    #
    # 真会卡住的是**互相等**(A 等 B、B 等 A)那种 —— `Run` 末尾那道检查当场报出来,
    # 不会让你干等。
    Await := (t: ITask) => {
        t.Claimed = true
        # **挂起怎么挂,问那个任务自己**(`WaitOn`)—— "两种任务不一样"只在它那里,
        # 这一句里没有"是哪种"这个概念。
        if { t.Done; } { 0; } { t.WaitOn this; }
        # 到这儿它一定完了。**交回它的结果** —— 就是 `Value` 那个"检查过的读":
        # 那边抛了的话,在这一头重抛(谁等它,谁接到那个错)。
        # 于是 `r := g.Await (Http.GetTask url)` 一步到位,不用再 `t.Value` 一下。
        t.Value;
    }

    # 就绪的都挑完了,剩下的在等 OS:阻塞着等**最先完成**的那一个,把它的任务放回就绪队列。
    # 占住 OS 线程是**故意**的 —— 没活干的时候本来就该把线程交给操作系统去等,
    # 这既是"空转不烧 CPU"的那条闸,也是真等待能重叠的原因。
    Poll := () => {
        done := System.WaitAny (Waiting.Map ((w: object) => { w.Job; }) |> .ToList ())
        w := Waiting.Where ((x: object) => { x.Job == done; }) |> .First ()
        Waiting.Remove (Waiting.IndexOf w)
        Ready.Add w.Who
    }

    # 跑一个任务:按 `Started` 分叉(新的跑 `Body`,老的从 `Step` 接着跑)。
    #
    # 体的错**在这儿收住**(记进任务、不往外冒):一个任务把自己搞砸了,不该把整组带走。
    # 谁 `group.Await` 它 / 谁读它的 `Value`,谁在**那一头**接到这个错。
    Start := (t: Task) => {
        if { t.Started; } { t.Step (); } {
            t.Started = true
            try { t.Val = (t.Body this); } (e: Exception) => { t.Ok = false; t.Err = e; (); }
            Finish t
        }
    }

    # 一个任务收工:记上"完了",把等着它的都放回就绪队列。
    Finish := (t: Task) => {
        t.Done = true
        foreach t.Waiters (w: object) => { Ready.Add w; }
        t.Waiters = []
        ()
    }

    # **驱动整个组**:一轮一轮挑任务跑,直到没活儿了。
    #
    # 任务让出时跳的都是 `Back` 这一枚 —— 于是回来的落点永远是同一条链上的同一个地方,
    # 而当前那条链整个丢掉(帧链不随切换增长)。
    Run := () => {
        callcc (kc: Continuation) => { Back = kc; }
        while { !((Ready.IsEmpty ()) && (Waiting.IsEmpty ())); } {
            if { Ready.IsEmpty (); } { Poll (); } {
                Current = Ready.Remove 0
                Start Current
            }
        }
        # 走到这儿 = 没活儿可干了。**但如果还有任务没完**,那不是跑完了,是卡住了:
        # 它停在某个 `Await` 上,而没有任何东西能把它叫醒(典型:在等一个没进组、
        # 也不会有人去完成的自创任务)。当场报出来 —— 干等比报错难查得多。
        stuck := All.Where ((t: Task) => { !(t.Done); }) |> .ToList ()
        if { (stuck.Count ()) == 0; } { (); } {
            throw (Exception ("死锁:还有 " + (string (stuck.Count ())) + " 个任务没完,"
                              + "但已经没有谁能推进它们了 —— 多半是在互相等,或者在等一件没人会去做的事"))
        }
        # 还有个更难堪的情形:**任务失败了,但没人接**。没人 `Await` 它、也没人读它的 `Value`
        # —— 那个错就烂在它身上,程序照常往下跑。和"没人接的错误"是同一个毛病,
        # 所以照同一个口径:当场报出来。
        dropped := All.Where ((t: Task) => { t.Done && !(t.Ok) && !(t.Claimed); }) |> .ToList ()
        if { (dropped.Count ()) == 0; } { (); } {
            throw (Exception ("有 " + (string (dropped.Count ())) + " 个任务失败了,而没人接它的错:"
                              + (dropped.First ()).Err.Message
                              + " —— 谁起的任务谁负责等它(`group.Await` / `.Value`)"))
        }
    }
}

# `Tasks.After ms` —— 一个**毫秒后自动完成**的任务。
#
# 名字说的是它是**什么**(一个将来的 Task),不是它做**什么**:`System.Sleep` 才是"睡",
# 这一条压根不睡,它只是**交回一个将来会醒的东西**。所以 `After 1000` 单独一句什么都不会
# 发生 —— 得像别的任务一样 `group.Await` 它。(这个坑和"光写个函数名没调用"是一类。)
After := (ms: int) => {
    t := SysTask ()
    t.Job = System.Sleepable ms
    t
}

# `Tasks.Of h` —— 把一个**本机句柄**(`Waitable`)包成任务。`After` 是它的一个特例
# (`Of (System.Sleepable ms)` 就是它),而库那一层拿到的句柄都走这儿:
#
#     group.Await (Tasks.Of (Native.HttpReqTask spec))
#
# —— 不过平时不用这么写:`Http` / `Io` / `cmd` 各自都有交回任务的现成入口
# (`Http.GetTask` 那种),它们是薄薄一层,底下就是这个。
#
# 句柄要**是句柄**:给了别的东西(数、字符串)`WaitAny` 那一头才报 —— 这里不先查一遍,
# 是因为 `Waitable` 是个类型,注解上写得出来,传错在**调用点**就拦住了。
Of := (h: System.Waitable) => {
    t := SysTask ()
    t.Job = h
    t
}

# 开一个组,把这批任务跑到底,交回 `()`。
#
# **`Run` 只交回 `()` 是有意的**:结果在**任务自己身上**(`t.Value`),不在组身上 ——
# 组管调度,不管收成。要收成就把任务先兜在变量里:`t := Tasks.Task (…)`、之后 `t.Value`。
#
# `Tasks.Cycle [ … ]` —— "建一个组,跑完"的糖。元素和 `TaskGroup` 一样是任务。
Cycle := (tasks: list) => {
    (TaskGroup tasks).Run ()
}

# ── 摆到全局的那个名字(和 `keys.rav` 的 `Keyed` / `exceptions.rav` 的 `try` 一个路子)──
#
# 一条命令变成一个任务。**要摆成全局是因为这儿没别的家**:`cmd` 是 `predefined.rav` 里
# 一个光杆的全局别名(没有 `Cmd` 模块),而 `predefined.rav` 又够不着这个模块 ——
# 那是核心,不该为了一个便捷名去 `using` 一个库。
#
# 它交回的是**任务**(和 `Http.GetTask` / `Io.ReadTask` 一样),不是句柄 ——
# `System.CmdTask` 那个原语交回来的才是句柄:
#
#     g.Await (cmdTask "ls -l")
ravel ""
readonly cmdTask := (c: string) => { Tasks.Of (System.CmdTask c); }

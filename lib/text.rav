# `Text` —— 按**行**和**词**摆弄文本。**要显式引用**:`using "text.rav"`。
#
# 单串的那批(`Split` / `Slice` / `Trim` / `Replace` …)在 `String` 上就有,这里管的是
# "一整段文字"这层:拆行、拆词、按宽度折行、缩进、截断、加引号。写文档、拼报错信息、
# 排版终端输出,天天都用得着这几件。
#
#     Text.Lines "a\nb"                # ["a" "b"](顺带把 Windows 的 \r 去掉)
#     Text.Words "a  b\tc"             # ["a" "b" "c"](空白折成一个分隔)
#     Text.Wrap "…很长一段…" 20         # 按 20 个字符折行(词为单位)
#     Text.Indent "a\nb" 4             # 每行前加 4 个空格(空行不动)
#     Text.Dedent "    a\n    b"       # 去掉公共缩进 → "a\nb"
#     Text.Truncate "abcdef" 4         # "abc…"
#     Text.Quote "说不清\"的话"          # "\"说不清\\\"的话\""
#     Text.IsBlank "  \n"              # true
#
# 还有一棵**树**(任意结构,只要你说得出"它的子节点是谁""这一行写什么"):
#
#     print (Text.Tree "a" ((x: string) => { ["b" "c"]; }) ((x: string) => { x; }))
#     a
#     ├── b
#     └── c
#
# 一件**没做**的事:折行不硬切长词。一个比宽度还长的词自己占一行,不切开 ——
# 切开会把一个词劈成两半(URL、代码标识符这类切了就废),宁可那一行超一点点。
ravel "Text"

# ── 行 ──
# 按 `\n` 切,行尾的 `\r` 顺手去掉(Windows 上写的文件在别处读,不该多出一个字符)。
readonly Lines := (s: string) => {
    out := []
    (s.Split "\n").Foreach (line: string) => {
        out.Add (line.EndsWith "\r" { line.Slice [0..((line.Length ()) - 1)); } { line; })
    }
    out
}

# ── 词 ──
# 空白(空格 / tab / 换行)**折成一个**分隔 —— 所以 `Lines` 出来的行直接喂给它也行。
readonly Words := (s: string) => {
    blank := [" " "\t" "\n" "\r"]
    out := []
    cur := ""
    i := 0
    n := s.Length ()
    while { i < n; } {
        c := string (s.At i)
        blank.Contains c {
            # 词结束:收一个(空的那一串不要)
            cur.IsEmpty () { 0; } { out.Add cur; cur = ""; }
        } {
            cur += c
        }
        i += 1
    }
    cur.IsEmpty () { 0; } { out.Add cur; }
    out
}

# 是不是"全是空白"(空串也算一张白纸)
readonly IsBlank := (s: string) => { (Words s).IsEmpty (); }

# ── 折行 ──
# 词为单位贪心填:填不下就换行。**原有的换行保留**(空行也保留,段落之间才看得出空)。
readonly Wrap := (s: string width: int) => {
    assert (width >= 1) ("Text.Wrap: 宽度至少是 1，得到 " + (string width))
    out := []
    (Lines s).Foreach (line: string) => {
        words := Words line
        words.IsEmpty () { out.Add ""; } {
            cur := ""
            words.Foreach (w: string) => {
                # 这一行还放得下(算上一个空格)就接着放
                cur.IsEmpty () {
                    cur = w
                } {
                    (((cur.Length ()) + 1 + (w.Length ())) <= width) {
                        cur += " " + w
                    } {
                        out.Add cur
                        cur = w
                    }
                }
            }
            out.Add cur
        }
    }
    out.Join "\n"
}

# ── 缩进 ──
# 每行前面加 n 个空格。**空行不加**(不然 `Dedent (Indent s 4)` 回不到原样:空行会多出四个空格,
# 而 Dedent 去的是非空行的公共缩进,四个空格就成了"公共缩进"的一部分)。
readonly Indent := (s: string n: int) => {
    pad := (" ").Repeat n
    out := []
    (Lines s).Foreach (line: string) => {
        line.IsEmpty () { out.Add ""; } { out.Add (pad + line); }
    }
    out.Join "\n"
}

# 去掉**公共**缩进:看所有非空行,谁最短就按谁去。全是空行就原样交回。
readonly Dedent := (s: string) => {
    lines := Lines s
    least := 0 - 1
    lines.Foreach (line: string) => {
        (IsBlank line) { 0; } {
            k := 0
            while { (k < (line.Length ())) && ((string (line.At k)) == " "); } { k += 1; }
            (least < 0) || (k < least) { least = k; } { 0; }
        }
    }
    (least <= 0) { s; } {
        out := []
        lines.Foreach (line: string) => {
            (line.Length ()) >= least { out.Add (line.Skip least); } { out.Add line; }
        }
        out.Join "\n"
    }
}

# ── 截断 ──
# 太长就切掉、缀一个 `…`(`…` 只占一个字符,但看着是一个字)。够短原样。
readonly Truncate := (s: string n: int) => {
    assert (n >= 1) ("Text.Truncate: 宽度至少是 1，得到 " + (string n))
    (s.Length ()) <= n { s; } { (s.Take (n - 1)) + "…"; }
}

# ── 引号 ──
# 给一段文字套上引号,顺手把里面的**换行 / tab / 反斜杠 / 引号**转义成看得见的样子 ——
# 拼报错信息、写测试期望、打日志时最常用这一下。
readonly Quote := (s: string) => {
    out := "\""
    i := 0
    n := s.Length ()
    while { i < n; } {
        c := s.At i
        # 条件里带运算符时**要加括号**:`c == '\\' { … }` 会被读成 `c == ('\\' { … })`
        # —— `{` 粘在字符字面量上,报「值 92 不是函数」。这一层括号是给解析器看的。
        (c == '\\') { out += "\\\\"; } {
            (c == '"') { out += "\\\""; } {
                (c == '\n') { out += "\\n"; } {
                    (c == '\t') { out += "\\t"; } {
                        out += (string c)
                    }
                }
            }
        }
        i += 1
    }
    out + "\""
}

# ── 树 ──
# 把一棵树画成**一串行**(交回字符串 —— 要打印就 `print (Text.Tree …)`)。三样:
# 根、`children`(一个节点 → 它**直接**子节点那一串)、`label`(一个节点 → 这一行写什么)。
#
# 行首是 `├── ` / `└── `,子层缩进 4 格(最后一个子节点那支不画竖线),和
# `Types.PrintTree` 画的是同一种树 —— 那条路径就是**这个函数加两枚 lambda**(见 lib/types.rav)。
#
# `children` 交回什么顺序就照什么顺序画,不重排(输出才稳)。它只照着画,**不做环检测**:
# 有环的结构得自己在 `children` 里管"这个展开过没有"(见 `examples/refgraph.rav`)。
readonly Tree := (root: object children: function label: function) => {
    # **括号不能省**:`[label root]` 是"两个元素的 list"(list 字面量里空格是分隔符),
    # 要的是"根那一行",所以得写成 `[(label root)]`。
    out := [(label root)]

    # 递归自己:lambda 体里读 `sub`,调用时才解析 —— 那时它已经在作用域里了
    sub := (nodes: object prefix: string) => {
        i := 0
        while { i < (nodes.Count ()); } {
            n := nodes.At i
            i == ((nodes.Count ()) - 1) {
                out.Add (prefix + "└── " + (label n))
                sub (children n) (prefix + "    ")
            } {
                out.Add (prefix + "├── " + (label n))
                sub (children n) (prefix + "│   ")
            }
            i += 1
        }
    }

    sub (children root) ""
    out.Join "\n"
}
